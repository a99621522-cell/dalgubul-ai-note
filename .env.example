# 로컬 실행용 키 파일 견본. 이 파일을 .env 로 복사해 값을 채운다. .env 는 .gitignore 에 있어 커밋되지 않는다.
# GitHub Actions 는 같은 이름의 Secrets 를 환경변수로 넣어 준다. 값 뒤에 공백·따옴표·줄바꿈을 붙이지 말 것.

# 매일 수집 (collect.py)
BIZINFO_KEY=
GEMINI_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 공시·재무 (collect_dart.py, dart_match.py, dart_financials.py) — OpenDART 인증키
DART_KEY=

# 기업 사전 출처 — 지금은 공공데이터포털 '파일'을 키 없이 받으므로 미사용. 오픈API 로 바꿀 때를 위해 자리만 둔다
NPS_KEY=
VENTURE_KEY=

# 과제 이력 — NTIS 오픈API. API 마다 키가 따로 발급된다 (과제검색 / 수행기관현황 / 성과검색)
NTIS_KEY_PROJECT=
NTIS_KEY_ORG=
NTIS_KEY_OUTCOME=

# 입찰 — 나라장터(조달청, data.go.kr)
G2B_KEY=
