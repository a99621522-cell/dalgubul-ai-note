# 필수
ANTHROPIC_API_KEY=            # 서버에만 둔다. 브라우저로 나가지 않음
# 모델·시간
DIVINATION_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_MS=90000     # 단계 하나의 호출 시간 제한
PORT=8787
# 보호(기본값)
MAX_INFLIGHT=4                 # 동시에 도는 풀이 수. 넘으면 503 + retry-after
MAX_DIVINE_PER_DAY=500         # 서버 전체 하루 풀이 상한(비용 보호). 넘으면 503
RATE_DIVINE_PER_MIN=6          # IP 당 풀이 분당 한도
RATE_DIVINE_PER_DAY=60         # IP 당 풀이 하루 한도
RATE_CAST_PER_MIN=60
RATE_CAST_PER_DAY=2000
CACHE_MAX=500                  # 같은 질문·시각·재료 결과 캐시 항목 수
CACHE_TTL_MIN=1440             # 캐시 보관 시간(분)
TRUST_PROXY=0                  # 리버스 프록시 뒤면 1 (X-Forwarded-For 첫 값을 IP 로)
ALLOWED_ORIGIN=                # 화면을 다른 도메인에 둘 때만 그 origin
METRICS_TOKEN=                 # 있으면 GET /metrics 에 x-metrics-token 헤더로 접근
USAGE_LOG=                     # 있으면 그 파일에 JSONL 한 줄씩(토큰 수·상태·유형만, 질문·IP 없음)
