---
import Base from '../layouts/Base.astro';
import { welfareData, facet, GUGUN, lifeKey } from '../lib/welfare';
/** 첫 화면 — 서비스 찾기. 복지 공무원이 주민 상황(나이·가구·구군)을 한 줄로 넣으면 중앙부처·대구시·구군 복지서비스 중 확인해 볼 후보를 추린다.
 *  규칙 필터 + 낱말 일치만(AI 판정 없음). 값은 복지로 오픈API 그대로. 자격 판정이 아니다. */
const D = welfareData();
const items = D?.items ?? [];
const n = (v: number) => v.toLocaleString('ko-KR');
const LIFE_ORDER = ['영유아', '아동', '청소년', '청년', '중장년', '노년', '임신·출산'];
const lifes = LIFE_ORDER.filter(l => items.some(s => s.life.some(v => lifeKey(v) === l)));
const targets = facet(items, s => s.target).slice(0, 14);
const themes = facet(items, s => s.theme).slice(0, 16);
---
<Base title="대구 복지서비스 찾기" description="복지 공무원용 — 주민 상황을 한 줄로 적으면 중앙부처·대구시·구군 복지서비스 중 확인해 볼 후보를 추립니다.">
  <h1>어떤 주민을 상담하시나요?</h1>
  <p class="meta">{D ? `복지로 ${D.fetchedAt} 기준 · 중앙부처 ${n(D.counts.central)} · 대구시 ${n(D.counts.city)} · 구·군 ${n(D.counts.gugun)}개 서비스` : '자료 수집 대기 중'}</p>

  {!D ? (
    <p class="empty">복지서비스 자료를 아직 받지 못했습니다. 공공데이터포털 수집(매일 새벽)이 끝나면 채워집니다.</p>
  ) : (
    <>
      <form id="wf" class="wf no-print" onsubmit="return false" data-gugun={JSON.stringify(GUGUN)}>
        <label class="q"><span class="lb">주민 상황을 한 줄로</span>
          <input id="wf-q" type="search" placeholder="예: 78세 혼자 사는 어르신, 기초생활수급, 수성구" autocomplete="off" />
        </label>
        <p class="hint" id="wf-read" aria-live="polite"></p>
        <div class="row">
          <label><span class="lb">담당 구·군 <small>(기억해 둠)</small></span>
            <select id="wf-g"><option value="">대구 전체</option>{GUGUN.map(g => <option value={g}>{g}</option>)}</select>
          </label>
          <label><span class="lb">생애주기</span>
            <select id="wf-l"><option value="">전체</option>{lifes.map(l => <option value={l}>{l}</option>)}</select>
          </label>
          <label><span class="lb">관심 주제</span>
            <select id="wf-th"><option value="">전체</option>{themes.map(t => <option value={t.name}>{t.name}</option>)}</select>
          </label>
          <label><span class="lb">범위</span>
            <select id="wf-sc"><option value="">중앙+대구</option><option value="중앙">중앙부처만</option><option value="local">대구시·구군만</option></select>
          </label>
        </div>
        <fieldset class="chips"><legend class="lb">가구·대상 특성(여럿 고르기)</legend>
          {targets.map(t => <label class="chip"><input type="checkbox" name="wf-t" value={t.name} /><span>{t.name}</span></label>)}
        </fieldset>
        <label class="tog"><input type="checkbox" id="wf-new" /> 최근 30일 안에 새로 생기거나 바뀐 서비스만</label>
      </form>

      <div class="res-head no-print">
        <b id="wf-count">불러오는 중…</b>
        <span class="acts"><button type="button" id="wf-copy" class="btn" disabled>고른 것 복사</button><button type="button" id="wf-print" class="btn" disabled>고른 것 인쇄</button><button type="button" id="wf-reset" class="btn">조건 지우기</button></span>
      </div>
      <p class="meta no-print">카드 왼쪽 네모를 누르면 상담 기록용으로 골라 둘 수 있습니다(복사하면 서비스명·소관·신청 방법·원문 주소가 한 줄씩 들어갑니다).</p>
      <ol id="wf-list" class="list"></ol>
      <button type="button" id="wf-more" class="btn btn-more no-print" hidden>더 보기</button>
      <div id="wf-print-area" class="print-only"></div>
    </>
  )}

  <script>
    type D = { target?: string; crit?: string; benefit?: string; how?: string; contacts?: string[]; laws?: string[] };
    type It = { i: string; sc: string; g: string; n: string; o: string; dp: string; sm: string; l: string[]; t: string[]; th: string[]; cy: string; pv: string; ap: string; ct: string; v: number; m: string; u: string; d: D | null };
    const form = document.getElementById('wf') as HTMLFormElement | null;
    if (form) {
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const q = $<HTMLInputElement>('wf-q'), sg = $<HTMLSelectElement>('wf-g'), sl = $<HTMLSelectElement>('wf-l'), sth = $<HTMLSelectElement>('wf-th'), ssc = $<HTMLSelectElement>('wf-sc'), snew = $<HTMLInputElement>('wf-new');
      const list = $<HTMLOListElement>('wf-list'), cnt = $<HTMLElement>('wf-count'), more = $<HTMLButtonElement>('wf-more'), read = $<HTMLElement>('wf-read');
      const bCopy = $<HTMLButtonElement>('wf-copy'), bPrint = $<HTMLButtonElement>('wf-print');
      const GUGUN: string[] = JSON.parse(form.dataset.gugun || '[]');
      const tChecks = () => [...form.querySelectorAll<HTMLInputElement>('input[name="wf-t"]')];
      const esc = (s: string) => (s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
      const para = (s?: string) => s ? esc(s).replace(/\n{2,}/g, '\n').replace(/\n/g, '<br>') : '';
      const store = { get(k: string) { try { return localStorage.getItem(k); } catch { return null; } }, set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* 저장 못 해도 동작 */ } } };
      const saved = store.get('wf-gugun'); if (saved && GUGUN.includes(saved)) sg.value = saved;

      const AGE = (a: number) => a <= 5 ? '영유아' : a <= 12 ? '아동' : a <= 18 ? '청소년' : a <= 39 ? '청년' : a <= 64 ? '중장년' : '노년';
      const SYN: [RegExp, RegExp][] = [
        [/혼자|독거|1인|홀로/, /1인|독거/], [/장애/, /장애/], [/한부모|조손|미혼모|미혼부/, /한부모|조손/],
        [/다문화|결혼이민|외국인|탈북|북한이탈/, /다문화|탈북|북한/], [/수급|차상위|저소득|기초생활|생계|의료급여/, /저소득/],
        [/다자녀|셋째|세\s*자녀/, /다자녀/], [/보훈|유공|참전/, /보훈/], [/임신|임산부|출산|산모/, /임신|출산/],
        [/질병|환자|암|치매|희귀|중증/, /질환|질병|환자/], [/실직|실업|구직|퇴직|폐업/, /실업|실직|구직/],
      ];
      const STOP = new Set(['어르신', '사는', '받음', '받는', '있음', '없음', '대구', '대구시', '주민', '가구', '세대', '혼자', '살고', '분']);
      let words: string[] = [];
      function parseQ() {
        const s = q.value.trim(); const notes: string[] = [];
        const age = s.match(/(\d{1,3})\s*(세|살)/);
        if (age) { const lf = AGE(+age[1]); if ([...sl.options].some(o => o.value === lf)) { sl.value = lf; notes.push(`${age[1]}세 → ${lf}`); } }
        else if (/어르신|노인|할머니|할아버지/.test(s) && [...sl.options].some(o => o.value === '노년')) { sl.value = '노년'; notes.push('노년'); }
        else if (/아기|영아|유아/.test(s) && [...sl.options].some(o => o.value === '영유아')) { sl.value = '영유아'; notes.push('영유아'); }
        const g = GUGUN.find(x => s.includes(x));
        if (g) { sg.value = g; notes.push(g); }
        for (const [re, chip] of SYN) if (re.test(s)) for (const c of tChecks()) if (chip.test(c.value) && !c.checked) { c.checked = true; notes.push(c.value); }
        words = s.replace(/\d{1,3}\s*(세|살)/g, ' ').split(/[\s,·.\/]+/).map(w => w.replace(/(은|는|이|가|을|를|의|에|과|와|도|로|으로)$/, '')).filter(w => w.length >= 2 && !STOP.has(w) && !GUGUN.includes(w));
        read.textContent = notes.length ? `읽은 조건: ${notes.join(' · ')}` + (words.length ? ` / 낱말: ${words.join(', ')}` : '') : (words.length ? `낱말: ${words.join(', ')}` : '');
      }

      const recent = (() => { const d = new Date(Date.now() - 30 * 864e5); return `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`; })();
      let all: It[] = [], hits: It[] = [], shown = 0; const picked = new Map<string, It>();
      const PAGE = 30;
      function score(it: It): number {
        const g = sg.value, lf = sl.value, th = sth.value, sc = ssc.value;
        if (sc === '중앙' && it.sc !== '중앙') return -1;
        if (sc === 'local' && it.sc === '중앙') return -1;
        if (it.sc === '구군' && g && it.g !== g) return -1;
        if (lf && it.l.length && !it.l.includes(lf)) return -1;
        if (th && !it.th.includes(th)) return -1;
        if (snew.checked && !(it.m && it.m.replace(/\D/g, '').slice(0, 8) >= recent)) return -1;
        const ts = tChecks().filter(c => c.checked).map(c => c.value);
        let s = 0;
        if (ts.length) { const m = ts.filter(t => it.t.includes(t)).length; if (!m) return -1; s += m * 10; }
        if (lf && it.l.includes(lf)) s += 4;
        if (it.sc === '구군' && g && it.g === g) s += 6; else if (it.sc === '대구시') s += 3;
        if (words.length) {
          const hay = `${it.n} ${it.sm} ${it.t.join(' ')} ${it.th.join(' ')} ${it.d?.target ?? ''} ${it.d?.crit ?? ''}`;
          const m = words.filter(w => hay.includes(w)).length;
          s += m * 5;
          if (!m && !ts.length && !lf && !g) return -1;
        }
        return s;
      }
      const whereTxt = (it: It) => it.sc === '중앙' ? '중앙' : it.sc === '대구시' ? '대구시' : it.g;
      function card(it: It): string {
        const cls = it.sc === '중앙' ? 'b-c' : it.sc === '대구시' ? 'b-s' : 'b-g';
        const org = [it.o, it.dp].filter(Boolean).map(esc).join(' · ');
        const tags = [...it.l, ...it.t].map(t => `<span class="tg">${esc(t)}</span>`).join('');
        const d = it.d; const rows: string[] = [];
        if (d?.target) rows.push(`<dt>지원 대상</dt><dd>${para(d.target)}</dd>`);
        if (d?.crit) rows.push(`<dt>선정 기준</dt><dd>${para(d.crit)}</dd>`);
        if (d?.benefit) rows.push(`<dt>지원 내용</dt><dd>${para(d.benefit)}</dd>`);
        if (d?.how || it.ap) rows.push(`<dt>신청 방법</dt><dd>${para(d?.how || it.ap)}</dd>`);
        if (d?.contacts?.length || it.ct) rows.push(`<dt>문의</dt><dd>${(d?.contacts?.length ? d.contacts : [it.ct]).map(esc).join('<br>')}</dd>`);
        if (d?.laws?.length) rows.push(`<dt>근거</dt><dd>${d.laws.map(esc).join('<br>')}</dd>`);
        const meta = [it.cy, it.pv].filter(Boolean).map(esc).join(' · ');
        return `<li class="card"><div class="ch"><label class="pk"><input type="checkbox" data-pick="${esc(it.sc)}|${esc(it.i)}" ${picked.has(it.sc + '|' + it.i) ? 'checked' : ''} aria-label="상담 기록용으로 고르기"></label><span class="b ${cls}">${esc(whereTxt(it))}</span><h3>${esc(it.n)}</h3></div>`
          + (org ? `<p class="org">${org}</p>` : '')
          + (it.sm ? `<p class="sm">${esc(it.sm)}</p>` : '')
          + (tags ? `<p class="tgs">${tags}</p>` : '')
          + (rows.length ? `<details><summary>대상·기준·신청 방법 보기${meta ? ` <span class="mt">${meta}</span>` : ''}</summary><dl>${rows.join('')}</dl></details>` : (meta ? `<p class="mt">${meta}</p>` : ''))
          + `<p class="lk"><a href="${esc(it.u)}" target="_blank" rel="noopener">복지로 원문 ↗</a></p></li>`;
      }
      function run() {
        hits = all.map(it => [score(it), it] as const).filter(([s]) => s >= 0).sort((a, b) => b[0] - a[0] || b[1].v - a[1].v).map(([, it]) => it);
        shown = 0; list.innerHTML = ''; page();
        const c = hits.filter(h => h.sc === '중앙').length;
        cnt.textContent = `${hits.length.toLocaleString('ko-KR')}개 (중앙 ${c.toLocaleString('ko-KR')} · 대구시·구군 ${(hits.length - c).toLocaleString('ko-KR')})`;
      }
      function page() { list.insertAdjacentHTML('beforeend', hits.slice(shown, shown + PAGE).map(card).join('')); shown += PAGE; more.hidden = shown >= hits.length; }
      function syncPick() { const k = picked.size; bCopy.disabled = bPrint.disabled = !k; bCopy.textContent = k ? `고른 ${k}개 복사` : '고른 것 복사'; bPrint.textContent = k ? `고른 ${k}개 인쇄` : '고른 것 인쇄'; }
      list.addEventListener('change', e => {
        const el = e.target as HTMLInputElement; const k = el.dataset.pick; if (!k) return;
        const it = all.find(x => x.sc + '|' + x.i === k); if (!it) return;
        el.checked ? picked.set(k, it) : picked.delete(k); syncPick();
      });
      const lineOf = (it: It) => `${it.n} (${whereTxt(it)}${it.o && it.sc !== '중앙' ? '' : it.o ? ' · ' + it.o : ''}${it.dp ? ' · ' + it.dp : ''}) — 신청: ${(it.d?.how || it.ap || '원문 확인').replace(/\s+/g, ' ').slice(0, 80)} — ${it.u}`;
      bCopy.addEventListener('click', async () => {
        const txt = [`[복지서비스 안내 후보] ${new Date().toLocaleDateString('ko-KR')}`, ...[...picked.values()].map((it, i) => `${i + 1}. ${lineOf(it)}`), '※ 자격은 원문·담당 부서 확인 필요'].join('\n');
        try { await navigator.clipboard.writeText(txt); bCopy.textContent = '복사했습니다'; setTimeout(syncPick, 1500); } catch { prompt('복사해 쓰세요', txt); }
      });
      bPrint.addEventListener('click', () => {
        const area = $<HTMLElement>('wf-print-area');
        area.innerHTML = `<h2>복지서비스 안내 후보 (${new Date().toLocaleDateString('ko-KR')})</h2><ol class="list">${[...picked.values()].map(card).join('')}</ol><p>※ 자격을 판정한 것이 아닙니다. 선정기준·소득 기준은 복지로 원문과 담당 부서로 확인하세요.</p>`;
        area.querySelectorAll('details').forEach(d => (d as HTMLDetailsElement).open = true);
        document.body.classList.add('printing'); window.print(); document.body.classList.remove('printing');
      });
      more.addEventListener('click', page);
      let tm = 0;
      q.addEventListener('input', () => { clearTimeout(tm); tm = window.setTimeout(() => { parseQ(); run(); }, 250); });
      sg.addEventListener('change', () => { store.set('wf-gugun', sg.value); run(); });
      [sl, sth, ssc, snew].forEach(e => e.addEventListener('change', run));
      form.addEventListener('change', e => { if ((e.target as HTMLInputElement).name === 'wf-t') run(); });
      $<HTMLButtonElement>('wf-reset').addEventListener('click', () => { const g = sg.value; form.reset(); sg.value = g; words = []; read.textContent = ''; run(); });
      fetch('/services.json').then(r => r.json()).then(j => { all = j.items; run(); }).catch(() => { cnt.textContent = '목록을 불러오지 못했습니다. 새로고침해 주세요.'; });
    }
  </script>
  <style>
    .empty { padding: 16px; border: 1px dashed var(--line-strong); border-radius: var(--r); color: var(--muted); }
    .wf { display: grid; gap: var(--s3); padding: 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); margin: var(--s3) 0; }
    .wf label { display: grid; gap: 4px; }
    .lb { font-size: var(--small); color: var(--muted); font-weight: 600; }
    .lb small { font-weight: 400; }
    .wf input[type=search], .wf select { font: inherit; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: 10px; background: var(--card); color: var(--ink); min-width: 0; }
    .q input { font-size: 1.1rem; padding: 14px; }
    .hint { margin: -8px 0 0; font-size: var(--small); color: var(--pri); min-height: 1.2em; }
    .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s2); }
    .chips { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .chips legend { margin-bottom: 6px; }
    .chip input { position: absolute; opacity: 0; pointer-events: none; }
    .chip span { display: inline-block; padding: 7px 12px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--card); font-size: var(--small); cursor: pointer; }
    .chip input:checked + span { background: var(--pri); border-color: var(--pri); color: var(--pri-ink); }
    .chip input:focus-visible + span { outline: 2px solid var(--pri); outline-offset: 2px; }
    .wf .tog { display: flex; align-items: center; gap: 8px; font-size: var(--small); }
    .res-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin: var(--s3) 0 var(--s1); }
    .acts { display: flex; gap: 6px; flex-wrap: wrap; }
    .btn { font: inherit; font-size: var(--small); padding: 8px 12px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--card); color: var(--ink); cursor: pointer; }
    .btn:disabled { opacity: 0.5; cursor: default; }
    .btn-more { display: block; width: 100%; margin: var(--s3) 0; padding: 12px; }
    .list { list-style: none; padding: 0; margin: var(--s2) 0 0; display: grid; gap: var(--s2); }
    .list :global(.card) { padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
    .list :global(.ch) { display: flex; gap: 8px; align-items: center; }
    .list :global(.pk input) { width: 20px; height: 20px; accent-color: var(--pri); }
    .list :global(h3) { margin: 0; font-size: 1.05rem; }
    .list :global(.b) { flex: none; font-size: 0.75rem; padding: 2px 8px; border-radius: 6px; font-weight: 700; }
    .list :global(.b-c) { background: var(--bg); border: 1px solid var(--line-strong); color: var(--muted); }
    .list :global(.b-s) { background: var(--pri); color: var(--pri-ink); }
    .list :global(.b-g) { border: 1px solid var(--pri); color: var(--pri); }
    .list :global(.org), .list :global(.mt) { margin: 4px 0 0; font-size: var(--small); color: var(--muted); }
    .list :global(.sm) { margin: 6px 0 0; }
    .list :global(.tgs) { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 4px; }
    .list :global(.tg) { font-size: 0.75rem; padding: 1px 7px; border-radius: 4px; background: var(--pri-soft); color: var(--ink); }
    .list :global(details) { margin-top: 10px; }
    .list :global(summary) { cursor: pointer; font-size: var(--small); font-weight: 600; color: var(--pri); }
    .list :global(dl) { margin: 8px 0 0; display: grid; grid-template-columns: 6em 1fr; gap: 6px 10px; font-size: var(--small); }
    .list :global(dt) { color: var(--muted); font-weight: 600; }
    .list :global(dd) { margin: 0; overflow-wrap: anywhere; }
    .list :global(.lk) { margin: 8px 0 0; font-size: var(--small); }
    @media (max-width: 520px) { .list :global(dl) { grid-template-columns: 1fr; } .list :global(dd) { margin-bottom: 6px; } }
    .print-only { display: none; }
