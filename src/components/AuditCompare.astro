---
/** /listed/audit/ — 대구 비상장 외감·상장 제조업 재무 현황과 전국 비교
 *  (운영자 지시 2026-11-03 '대구 비상장 재무 현황표 조사해봐' → '전국과 비교하는 것도 구현해야지' → '진행해'
 *   → '같은 회사 여러 해 추이·규모별·국민연금 고용·이자보상비율 100% 미만 비중·한국은행 법인 전수와 빠진 층·내려받기').
 *  대구일보 「대구·경북 CSAI」(2026-11-03 보도)의 '무엇을 재고 어떻게 묶나'만 참고 — 회사별 위험 판정·우수기업 선정·사분면 칸 이름은 쓰지 않는다.
 *  값은 scripts/audit_compare.py 결과 그대로. 회사 이름·순위 없음, 작은 칸은 비움, 판정 낱말 없음. */
import { auditCompare, cell, f1, diff, inRange, ksicName, KSIC2, ym, eokJo, type Scope } from '../lib/dartAudit';
const A = auditCompare();
const IND = A?.indicators ?? [];
const T = A?.total;
const S = A?.summary?.daegu;
const SM = A?.sample ?? {};
const bok = A?.bok?.by ?? {};
const bokYear = A?.bok?.year ?? '';
const yrs = A?.years;
const minShare = A?.min_share ?? 20;
const n = (s?: Scope) => (s ? s.n : 0);
const medTxt = (s: Scope | undefined, k: string) => { const c = cell(s, k); return c?.med == null ? (c && c.n > 0 ? '표본 적음' : '—') : f1(c.med); };
const iqr = (s: Scope | undefined, k: string) => { const c = cell(s, k); return c?.q1 == null ? '' : `${f1(c.q1)} ~ ${f1(c.q3)}`; };
const nOf = (s: Scope | undefined, k: string) => cell(s, k)?.n ?? 0;
const SCOPES = [['daegu_listed', '대구 상장'], ['national_listed', '전국 상장'], ['daegu_unlisted', '대구 비상장 외감'], ['national_unlisted', '전국 비상장 외감(표본)']] as const;
const REG = A?.bok_region;
const SCALES = ['종합', '대기업', '중기업', '소기업'].filter(x => REG?.by_scale?.[x]);
const COV = A?.coverage;
const TR = A?.trend ?? {};
const EMP = A?.employment;
const low = (s?: Scope) => s?.icr_low;

/** 업종 중분류 덤벨 그림(대구 비상장 ● · 전국 비상장 표본 ○) — 지표 하나, 업종 코드 순서(값 크기 정렬 아님) */
function dumbbell(key: string, name: string): string {
  const rows = (A?.by_ksic ?? []).map(r => ({ code: r.code, label: KSIC2[r.code] ?? r.code, d: cell(r.daegu_unlisted, key)?.med, nat: cell(r.national_unlisted, key)?.med }))
    .filter(r => r.d != null || r.nat != null);
  if (rows.length < 2) return '';
  const vals = rows.flatMap(r => [r.d, r.nat]).filter((v): v is number => v != null);
  let lo = Math.min(0, ...vals), hi = Math.max(0, ...vals);
  const pad = (hi - lo) * 0.08 || 1; lo -= pad; hi += pad;
  const W = 680, L = 170, R = 24, top = 30, rowH = 26, H = top + rows.length * rowH + 30;
  const x = (v: number) => L + (v - lo) / (hi - lo) * (W - L - R);
  const ticks = 5, step = (hi - lo) / ticks;
  let g = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${name} 업종 중분류별 중앙값 — 대구 비상장 외감과 전국 비상장 외감 표본" xmlns="http://www.w3.org/2000/svg" font-family="Pretendard, sans-serif" font-size="12">`;
  g += `<rect width="${W}" height="${H}" fill="var(--color-surface-1, #fff)"/>`;
  for (let i = 0; i <= ticks; i++) { const v = lo + step * i; g += `<line x1="${x(v)}" x2="${x(v)}" y1="${top - 6}" y2="${H - 26}" stroke="var(--border, #ddd)" stroke-width="1"/><text x="${x(v)}" y="${H - 10}" text-anchor="middle" fill="var(--muted, #666)">${f1(v)}</text>`; }
  g += `<line x1="${x(0)}" x2="${x(0)}" y1="${top - 6}" y2="${H - 26}" stroke="var(--text, #333)" stroke-width="1"/>`;
  g += `<circle cx="${L}" cy="12" r="5" fill="var(--chart-1)"/><text x="${L + 10}" y="16" fill="var(--text, #222)">대구 비상장 외감</text>`;
  g += `<circle cx="${L + 140}" cy="12" r="5" fill="var(--color-surface-1, #fff)" stroke="var(--chart-2)" stroke-width="2.5"/><text x="${L + 150}" y="16" fill="var(--text, #222)">전국 비상장 외감(표본)</text>`;
  rows.forEach((r, i) => {
    const y = top + i * rowH + rowH / 2;
    g += `<text x="${L - 8}" y="${y + 4}" text-anchor="end" fill="var(--text, #222)">${r.code} ${r.label}</text>`;
    if (r.d != null && r.nat != null) g += `<line x1="${x(r.d)}" x2="${x(r.nat)}" y1="${y}" y2="${y}" stroke="var(--muted, #999)" stroke-width="2"/>`;
    if (r.nat != null) g += `<circle cx="${x(r.nat)}" cy="${y}" r="6" fill="var(--color-surface-1, #fff)" stroke="var(--chart-2)" stroke-width="2.5"><title>${r.code} 전국 비상장 표본 ${f1(r.nat)}%</title></circle>`;
    if (r.d != null) g += `<circle cx="${x(r.d)}" cy="${y}" r="6" fill="var(--chart-1)" stroke="var(--color-surface-1, #fff)" stroke-width="2"><title>${r.code} 대구 비상장 ${f1(r.d)}%</title></circle>`;
  });
  return g + '</svg>';
}
---
{!A ? <p class="meta">자료를 받는 중입니다. DART 감사보고서 수집(dart_audit.yml)이 끝나면 이 페이지에 표가 생깁니다.</p> : (<>
<section id="audit">
  <p class="lede">본사가 대구인 <strong>비상장 외부감사 대상 제조업 회사</strong>의 감사보고서 재무를 대구·전국 상장 제조업, 전국 비상장 외감 표본, 한국은행 「기업경영분석」과 같은 지표로 나란히 놓았습니다. 묶음별 중앙값·합계 비율·비중만 싣고 회사 이름·순위·평가는 싣지 않습니다. <a href="#download">집계표 내려받기</a></p>

  <details class="basis" open>
    <summary>이 숫자의 기준</summary>
    <dl>
      <dt>대구 비상장 외감 {n(T?.daegu_unlisted)}곳 ({yrs?.daegu_unlisted} 사업연도)</dt>
      <dd>DART 에 감사보고서를 낸 비상장 회사{S ? ` ${S.filers.toLocaleString('ko-KR')}곳` : ''} 가운데 이 사이트 기업 사전의 회사 이름과 일치하고{S ? `(${S.name_matched.toLocaleString('ko-KR')}곳)` : ''} 기업개황 본사 주소가 대구인 제조업(업종 10~34) 회사{S ? ` ${S.daegu_mfg.toLocaleString('ko-KR')}곳` : ''}의 최근 2건 별도 감사보고서 값입니다(보고서마다 당기·전기가 있어 세 사업연도). 외부감사는 법정 기준(자산·매출·부채·종업원 규모)을 넘는 회사만 받아 소규모 회사는 빠지고, 이름이 기업 사전과 다른 회사도 빠질 수 있습니다. 소재지는 본사 기준입니다.</dd>
      <dt>상장 제조업 — 대구 {n(T?.daegu_listed)}곳 · 전국 {n(T?.national_listed)}곳 ({yrs?.listed} 사업연도)</dt>
      <dd>유가증권·코스닥 상장 제조업 회사의 사업보고서 <strong>별도</strong>재무제표(비상장 감사보고서와 같은 기준 — 다른 상장기업 탭은 연결 우선이라 값이 다를 수 있습니다). 전국은 대구를 포함한 전수입니다.</dd>
      <dt>전국 비상장 외감 표본 {n(T?.national_unlisted)}곳 ({yrs?.national_unlisted} 사업연도)</dt>
      <dd>감사보고서 제출 비상장 회사{SM.population ? ` ${SM.population.toLocaleString('ko-KR')}곳` : ''} 전체에서 고정 시드({SM.seed}) 무작위 순서로 {SM.looked?.toLocaleString('ko-KR')}곳을 보고 제조업만, 업종 묶음당 최대 {SM.cap_per_group}곳까지 읽었습니다. 표본이라 중앙값 옆에 부트스트랩 95% 범위를 적습니다.</dd>
      <dt>한국은행 「기업경영분석」</dt>
      <dd>법인세 신고 법인 <strong>전수</strong>(외감 여부와 무관, 소규모 법인 포함)의 재무비율입니다. 전국 분위수(KOSIS DT_501Y086, {bokYear})와 대구 지역별 값(ECOS 지역별 기업경영분석{REG?.year ? `, ${REG.year}` : ''}, 규모별 합계 비율)을 씁니다. 대상이 넓어 외감·상장 회사와 같은 집단이 아니며, 그 차이가 이 사이트 자료에 빠진 층의 모습입니다.</dd>
      <dt>지표</dt>
      <dd>매출액 증가율 = (당기 매출 ÷ 전기 매출 − 1) × 100, 매출액 영업이익률 = 영업이익 ÷ 매출 × 100, 영업현금흐름 대 매출액 = 영업활동현금흐름 ÷ 매출 × 100, 부채비율 = 부채총계 ÷ 자본총계 × 100(자본 0 이하 제외), 이자보상비율 = 영업이익 ÷ 이자비용 × 100(이자비용 0 제외, 한국은행과 같은 %). 중앙값은 회사마다 비율을 구한 가운데 값, 합계 비율은 묶음의 분자 합 ÷ 분모 합입니다. 중앙값은 {A.min_n}곳, 비중·고용은 {minShare}곳 미만인 칸을 비웠습니다(작은 칸은 어느 회사인지 짐작될 수 있어서).</dd>
    </dl>
  </details>

  <div class="section-head"><h2>지표별 중앙값 — 대구와 전국</h2><span class="meta">% · 차이는 대구 − 전국(%p) · 괄호 안은 1~3사분위</span></div>
  <div class="scroll-x"><table class="data-table" data-title="대구·전국 제조업 재무 지표 중앙값(상장·비상장 외감)">
    <thead>
      <tr><th rowspan="2">지표</th><th colspan="3" class="c">상장 제조업</th><th colspan="3" class="c">비상장 외감 제조업</th><th rowspan="2" class="n">한국은행<br />전국 제조업<br />중위수({bokYear})</th></tr>
      <tr><th class="n">대구<br />({n(T?.daegu_listed)}곳)</th><th class="n">전국<br />({n(T?.national_listed)}곳)</th><th class="n">차이</th><th class="n">대구<br />({n(T?.daegu_unlisted)}곳)</th><th class="n">전국 표본<br />({n(T?.national_unlisted)}곳)</th><th class="n">차이</th></tr>
    </thead>
    <tbody>{IND.map(i => { const dl = cell(T?.daegu_listed, i.key), nl = cell(T?.national_listed, i.key), du = cell(T?.daegu_unlisted, i.key), nu = cell(T?.national_unlisted, i.key); return (
      <tr>
        <th scope="row">{i.name}</th>
        <td class="n">{medTxt(T?.daegu_listed, i.key)}<span class="meta"> {iqr(T?.daegu_listed, i.key) && `(${iqr(T?.daegu_listed, i.key)})`}</span></td>
        <td class="n">{medTxt(T?.national_listed, i.key)}<span class="meta"> {iqr(T?.national_listed, i.key) && `(${iqr(T?.national_listed, i.key)})`}</span></td>
        <td class="n">{diff(dl?.med, nl?.med)}</td>
        <td class="n">{medTxt(T?.daegu_unlisted, i.key)}<span class="meta"> {iqr(T?.daegu_unlisted, i.key) && `(${iqr(T?.daegu_unlisted, i.key)})`}</span></td>
        <td class="n">{medTxt(T?.national_unlisted, i.key)}{nu?.ci && <span class="meta"> 범위 {f1(nu.ci[0])}~{f1(nu.ci[1])}</span>}</td>
        <td class="n">{diff(du?.med, nu?.med)}{inRange(du?.med, nu?.ci) && <span class="meta"> 표본 범위 안</span>}</td>
        <td class="n">{f1(bok[i.key]?.med)}</td>
      </tr>); })}</tbody>
  </table></div>
  <p class="meta">'표본 범위 안'은 대구 중앙값이 전국 표본 중앙값의 부트스트랩 95% 범위 안에 든다는 뜻으로, 표본만으로는 둘의 차이를 가르기 어렵다는 표시입니다. 비율을 가리는 판정이 아닙니다.</p>

  <div class="section-head" id="layer"><h2>대구 법인 전체와 견주기 — 빠진 층</h2><span class="meta">합계 비율(%) · 한국은행 지역별 기업경영분석{REG?.year ? ` ${REG.year}` : ''}</span></div>
  {COV && (
    <div class="cards static">
      <div class="card"><span class="big">{f1(COV.unlisted_share)}%</span><span class="meta">대구 제조업 법인 전체 매출({eokJo(COV.bok_sales_won)}) 가운데<br />이 사이트가 읽은 비상장 외감 {COV.unlisted_n}곳의 매출</span></div>
      <div class="card"><span class="big">{f1(COV.listed_share)}%</span><span class="meta">같은 해 대구 상장 제조업 {COV.listed_n}곳(별도)의 매출</span></div>
      <div class="card"><span class="big">{f1(COV.unlisted_share != null && COV.listed_share != null ? Math.max(0, 100 - COV.unlisted_share - COV.listed_share) : null)}%</span><span class="meta">나머지 — 외감 대상이 아니거나 이름이 이어지지 않은 법인</span></div>
    </div>)}
  {SCALES.length > 0 ? (<>
  <div class="scroll-x"><table class="data-table" data-title="대구 제조업 법인 전체(한국은행)와 이 사이트 외감·상장 회사의 합계 비율">
    <thead><tr><th rowspan="2">지표</th><th colspan={SCALES.length} class="c">한국은행 — 대구 제조업 법인 전체({REG?.year})</th><th colspan="2" class="c">이 사이트(같은 정의: 합계 비율)</th></tr>
      <tr>{SCALES.map(s => <th class="n">{s}</th>)}<th class="n">대구 비상장 외감</th><th class="n">대구 상장</th></tr></thead>
    <tbody>{IND.filter(i => i.key !== 'ocf').map(i => <tr><th scope="row">{i.name}</th>{SCALES.map(s => <td class="n">{f1(REG?.by_scale?.[s]?.[i.key])}</td>)}<td class="n">{f1(cell(T?.daegu_unlisted, i.key)?.pooled ?? null)}</td><td class="n">{f1(cell(T?.daegu_listed, i.key)?.pooled ?? null)}</td></tr>)}</tbody>
  </table></div>
  <p class="meta">한국은행 값은 대구에 본점을 둔 제조업 법인 전수(법인세 신고 기준)의 합계 비율이며, 기업 규모는 한국은행 구분(대기업·중기업·소기업)입니다. '소기업' 열이 외부감사를 받지 않아 이 사이트 자료에 거의 들어오지 않는 층입니다. 사업연도는 이 사이트 자료({yrs?.daegu_unlisted})와 다를 수 있고, 한국은행 집계는 연결·별도와 무관한 개별 법인 기준입니다. 영업현금흐름 비율은 한국은행 지역별 표에 없어 뺐습니다.</p>
  </>) : <p class="meta">한국은행 지역별 기업경영분석(대구) 값을 받는 중입니다.</p>}

  <div class="section-head" id="trend"><h2>세 사업연도 추이</h2><span class="meta">중앙값(%) · '같은 회사'는 세 해 모두 자료가 있는 회사만</span></div>
  {IND.map((i, idx) => (
  <details open={idx === 1}>
    <summary>{i.name}</summary>
    <div class="scroll-x"><table class="data-table" data-title={`${i.name} 중앙값 — 세 사업연도`}>
      <thead><tr><th>묶음</th><th>회사</th>{(TR.daegu_unlisted?.years ?? TR.national_listed?.years ?? []).map(y => <th class="n">{y}</th>)}</tr></thead>
      <tbody>{SCOPES.flatMap(([k, nm]) => { const t = TR[k]; if (!t) return []; return [
        <tr><th scope="row">{nm}</th><td>그해 있는 회사</td>{t.years.map(y => <td class="n">{medTxt(t.all[y], i.key)}<span class="meta"> {nOf(t.all[y], i.key) > 0 && `${nOf(t.all[y], i.key)}곳`}</span></td>)}</tr>,
        <tr><th scope="row">{nm}</th><td>같은 회사 {t.same_n}곳</td>{t.years.map(y => <td class="n">{medTxt(t.same[y], i.key)}</td>)}</tr>]; })}</tbody>
    </table></div>
  </details>))}
  <p class="meta">감사보고서 한 건에는 당기와 전기 값이 함께 있어, 최근 두 건으로 세 사업연도를 만듭니다(가장 앞 해는 다음 해 보고서의 전기 비교 값). 가장 앞 해의 매출액 증가율은 그 전 해 매출이 없어 비는 경우가 많습니다.</p>

  <div class="section-head" id="size"><h2>매출 규모별</h2><span class="meta">{yrs?.daegu_unlisted} 사업연도 매출액 구간 · 중앙값(%)</span></div>
  <div class="scroll-x"><table class="data-table" data-title="매출 규모별 제조업 재무 지표 중앙값">
    <thead><tr><th rowspan="2">매출 구간</th><th colspan="2" class="c">회사 수</th>{IND.map(i => <th colspan="2" class="c">{i.name}</th>)}</tr>
      <tr><th class="n">대구 비상장</th><th class="n">전국 표본</th>{IND.map(() => <><th class="n">대구</th><th class="n">전국 표본</th></>)}</tr></thead>
    <tbody>{(A.by_band ?? []).map(r => <tr><th scope="row">{r.band}</th><td class="n">{n(r.daegu_unlisted)}</td><td class="n">{n(r.national_unlisted)}</td>{IND.map(i => <><td class="n">{medTxt(r.daegu_unlisted, i.key)}</td><td class="n">{medTxt(r.national_unlisted, i.key)}</td></>)}</tr>)}</tbody>
