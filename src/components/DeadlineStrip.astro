---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
const today = new Date(); today.setHours(0,0,0,0);
const upcoming = posts
  .filter(p => p.data.deadline && p.data.deadline >= today)
  .sort((a, b) => a.data.deadline!.getTime() - b.data.deadline!.getTime())
  .slice(0, 5);
const dday = (d: Date) => { const n = Math.round((d.getTime() - today.getTime()) / 86400000); return n === 0 ? '오늘 마감' : `D-${n}`; };
---
{upcoming.length > 0 && (
  <section class="deadline-strip" aria-label="마감 임박 공모">
    <h2>마감이 다가오는 공모·지원사업</h2>
    <ol>
      {upcoming.map(p => (
        <li><span class="dday">{dday(p.data.deadline!)}</span><a href={`/posts/${p.id}/`}>{p.data.title}</a></li>
      ))}
    </ol>
  </section>
)}
