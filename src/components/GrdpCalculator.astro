---
import { grdpCalcData, ioDaegu, structureCalc } from '../lib/grdp';
/** 대구 GRDP 성장 목표 계산기(운영자 지시 2026-10-05). 목표 성장률을 넣으면 생산 측(경제활동별) 또는 지출 측(소비·투자·순이출)
 *  항목별로 필요한 기여도(%p)·성장률(%)을 가정별로 계산한다. 기여도 = 최근 연도 명목 비중 × 실질 성장률(근사).
 *  전망·달성 가능성 판단이 아니라 가정에 따른 계산이다. 브라우저 안에서만 계산. */
const P = grdpCalcData('prod'), E = grdpCalcData('exp');
const d = P;
const f1 = (v: number) => v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const over5 = d.growth.filter(x => x.g >= 5).length;
const best = [...d.growth].sort((a, b) => b.g - a.g)[0];
const net = E.items.find(i => i.key === '재화와 서비스 순이출');
const cons = E.items.filter(i => i.key.endsWith('최종소비지출')).reduce((a, i) => a + i.share, 0);
const IO = ioDaegu();
const trendSum = P.items.reduce((a, i) => a + i.avgc, 0);
const SC = structureCalc();   // 분모(명목 GRDP)는 위 계산기들과 같은 값(공통 기준)
const data = { prod: P.items, exp: E.items, defFill: { prod: '제조업', exp: '설비투자' }, nom: SC ? SC.gdpEok / 10000 : P.nomTrillion, gva: SC ? SC.gvaEok / 10000 : P.nomTrillion, trendSum, io: IO };   // gva: 지출 상자 분모(공통 기준, 2026-10-07)
---
{d.items.length > 0 && (
<section id="calc">
  <div class="section-head"><h2>목표 계산기 — 목표에서 거꾸로</h2><span class="meta">대구 GRDP · {d.y1}년 기준</span></div>
  <p class="meta">목표 실질 성장률을 넣으면 항목마다 몇 %p를 보태야 합이 목표가 되는지 계산합니다. 기여도 = {d.y1}년 명목 비중 × 실질 성장률입니다. 가정에 따른 계산일 뿐 전망이나 달성 가능성 판단이 아닙니다.</p>
  <p class="meta">참고: {d.y0}→{d.y1}년 연평균 실질 성장률 {f1(d.cagr)}% · 가장 높았던 해 {best?.y}년 {f1(best?.g ?? 0)}% · 5% 이상인 해 {over5}번 · {d.y1}년 명목 GRDP {f1(d.nomTrillion)}조 원</p>

  <div class="calc-tools">
    {E.items.length > 0 && <div class="seg" role="radiogroup" aria-label="나누는 방법">
      <label><input type="radio" name="gside" value="prod" checked /> 생산 측(산업별)</label>
      <label><input type="radio" name="gside" value="exp" /> 지출 측(소비·투자·순이출)</label>
    </div>}
    <label>목표 성장률 <input id="gt" type="number" step="0.1" value="5" inputmode="decimal" /> %</label>
    <label>가정 <select id="gassume">
      <option value="even">고른 성장</option>
      <option value="trend">추세 확대</option>
      <option value="fill">한 항목이 차이를 메움</option>
      <option value="custom">직접 입력</option>
    </select></label>
    <label id="gfw" hidden>메울 항목 <select id="gf"></select></label>
  </div>
  <p id="gsum" class="calc-sum" aria-live="polite"></p>
  <div class="scroll-x"><table class="data-table compact" id="gtab" data-title="대구 GRDP 성장 목표 계산">
    <thead><tr><th id="gcol">산업</th><th class="n">필요 기여(%p)</th><th class="n">필요 성장(%)</th><th class="n">비중(%)</th><th class="n">10년 평균 성장(%)</th></tr></thead>
    <tbody></tbody>
    <tfoot><tr><th scope="row">합계</th><td class="n" id="gtc"></td><td class="n"></td><td class="n">100.0</td><td class="n">{f1(d.cagr)}</td></tr></tfoot>
  </table></div>
  {E.items.length > 0 && net && (
    <p class="meta" id="gexpnote" hidden>지출 측은 같은 GRDP 를 누가 썼는지로 나눈 것입니다. 대구는 {E.y1}년 소비(민간+정부)가 GRDP 의 {f1(cons)}%이고, 순이출(대구 밖으로 판 것 − 대구 밖에서 사 온 것)이 {f1(net.share)}%로 마이너스입니다. 순이출은 금액이 마이너스라 '필요 성장'을 적지 않고 기여도만 봅니다. 순이출 기여가 플러스라는 것은 역외 적자가 줄어든다는 뜻입니다.</p>
  )}
  {IO && IO.vaIn != null && (
  <div class="budget-box" id="gbud">
    <h3>예산·사업 규모로 보기</h3>
    <p class="meta">한 해 새로 늘어나는 지출(시비·국비·민간 매칭을 합한 금액)을 넣으면, 한국은행 지역산업연관표의 대구 유발계수로 대구 안에 생기는 부가가치와 GRDP 기여를 계산합니다. 위 '정책 과제' 계산기와 같은 계수·분모라 같은 금액이면 같은 %p 가 나옵니다.</p>
    <div class="calc-tools">
      <label>늘어나는 지출 <input id="gb" type="number" step="100" value="1000" inputmode="decimal" /> 억 원</label>
      <label>대구 안 부가가치 유발계수 <input id="gk" type="number" step="0.01" value={IO.vaIn} inputmode="decimal" /></label>
    </div>
    <ul class="budget-out" id="gbo" aria-live="polite"></ul>
    <p class="meta">유발계수 {IO.vaIn}(대구 안)·{IO.vaOut}(다른 지역)은 대구 최종수요(소비·투자·수출 전체) 1단위의 평균으로, 지출 성격별 계수는 공표 책에 없습니다. 건설·소비·기업 지원은 실제 값이 다를 수 있어 계수 칸을 바꿔 볼 수 있습니다. 대구 최종수요는 {IO.localShare}%가 대구 생산, {IO.inflowShare}%가 다른 지역 생산, {IO.importShare}%가 수입품이며, 계수는 국산품 1단위 기준이라 수입품 몫({IO.importShare}%)을 빼고 곱합니다. 한 번 쓴 지출은 그 해 GRDP 수준을 올릴 뿐이라, 성장률로 이어지려면 다음 해에 그보다 더 늘어나야 합니다. 이미 해 오던 지출은 지난 10년 추세에 들어 있으므로 새로 늘어나는 몫만 넣습니다. 출처: <a href={IO.url} rel="noopener">{IO.source}</a> {IO.vaPage}·{IO.empPage}쪽.</p>
  </div>)}
  <details class="stat-details">
    <summary>계산 방법과 주의</summary>
    <ul class="meta">
      <li><strong>생산 측</strong>은 어느 산업이 부가가치를 만들었는지(경제활동 19개 + 순생산물세), <strong>지출 측</strong>은 그 생산물을 누가 썼는지(민간·정부 소비, 건설·설비·지식재산 투자, 재고, 순이출)로 같은 GRDP 를 나눈 것입니다. 두 쪽 합계는 같습니다.</li>
      <li>가정 — 고른 성장: 모든 항목이 목표와 같은 비율로 성장. 추세 확대: 지난 10년 공표 실질기여도 평균이 플러스인 항목만 같은 배율로 키우고 마이너스인 항목은 추세 그대로. 한 항목이 차이를 메움: 나머지는 지난 10년 평균 기여, 차이는 고른 항목이 냄. 직접 입력: 항목별 성장률을 넣어 합계를 봅니다.</li>
      <li>필요 성장(%) = 필요 기여(%p) ÷ 명목 비중 × 100. 비중이 아주 작거나 마이너스인 항목(광업·재고·순이출·통계상 불일치)은 성장률을 적지 않거나 크게 흔들리니 참고만 하세요.</li>
      <li>{d.y1}년 비중으로 다음 한 해를 계산한 근사입니다. 실질 값이 연쇄가중이라 공표 방식과 소수점 아래가 조금 다를 수 있고, {d.y1}년 값은 다음 공표에서 고쳐질 수 있습니다.</li>
    </ul>
  </details>
  <p class="meta">출처: {d.url ? <a href={d.url} rel="noopener">{d.source}</a> : d.source}{E.url && <> · <a href={E.url} rel="noopener">{E.source}</a></>} · 계산: 다잇다</p>
  <script type="application/json" id="grdp-data" set:html={JSON.stringify(data)} />
</section>)}
<script>
  type Item = { key: string; name: string; share: number; cagr: number | null; avgc: number };
  const el = document.getElementById('grdp-data');
  if (el) {
    const D = JSON.parse(el.textContent || '{}') as { prod: Item[]; exp: Item[]; defFill: Record<string, string>; nom: number; trendSum: number; io: any };
    const $ = (id: string) => document.getElementById(id) as any;
    const gt = $('gt') as HTMLInputElement, gs = $('gassume') as HTMLSelectElement, gf = $('gf') as HTMLSelectElement;
    const gfw = $('gfw') as HTMLElement, sum = $('gsum') as HTMLElement, tc = $('gtc') as HTMLElement;
    const tbody = document.querySelector('#gtab tbody') as HTMLElement;
    const fmt = (v: number | null, d = 1) => v != null && Number.isFinite(v) ? v.toLocaleString('ko-KR', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—';
    let side: 'prod' | 'exp' = 'prod';
    const custom: Record<string, Record<string, number>> = { prod: {}, exp: {} };
    for (const s of ['prod', 'exp'] as const) for (const i of D[s] || []) custom[s][i.key] = i.cagr != null ? Math.round(i.cagr * 10) / 10 : 0;
    const growthOk = (i: Item) => i.share >= 0.5;   // 비중이 아주 작거나 마이너스인 항목(광업·농림어업·재고·순이출·통계상 불일치)은 성장률을 적지 않는다
    const build = () => {
      const items = D[side];
      $('gcol').textContent = side === 'prod' ? '산업' : '지출 항목';
      const note = document.getElementById('gexpnote'); if (note) note.hidden = side !== 'exp';
      gf.innerHTML = items.map(i => `<option value="${i.key}"${i.key === D.defFill[side] ? ' selected' : ''}>${i.name}</option>`).join('');
      tbody.innerHTML = items.map(i => `<tr data-key="${i.key}"><th scope="row">${i.name}</th><td class="n c"></td><td class="n g"></td><td class="n">${fmt(i.share)}</td><td class="n">${fmt(i.cagr)}</td></tr>`).join('');
      calc();
    };
    const calc = () => {
      const items = D[side];
      const T = Number(gt.value), mode = gs.value;
      gfw.hidden = mode !== 'fill';
      const c: Record<string, number> = {};
      if (mode === 'even') items.forEach(i => (c[i.key] = i.share * T / 100));
      else if (mode === 'trend') {
        const pos = items.filter(i => i.avgc > 0).reduce((a, i) => a + i.avgc, 0);
        const neg = items.filter(i => i.avgc <= 0).reduce((a, i) => a + i.avgc, 0);
        const k = pos > 0 ? (T - neg) / pos : NaN;
        items.forEach(i => (c[i.key] = i.avgc > 0 ? i.avgc * k : i.avgc));
      } else if (mode === 'fill') {
        const others = items.filter(i => i.key !== gf.value).reduce((a, i) => a + i.avgc, 0);
        items.forEach(i => (c[i.key] = i.key === gf.value ? T - others : i.avgc));
      } else items.forEach(i => (c[i.key] = i.share * (custom[side][i.key] ?? 0) / 100));
      let total = 0;
      for (const r of tbody.querySelectorAll<HTMLTableRowElement>('tr')) {
        const i = items.find(x => x.key === r.dataset.key)!;
        total += c[i.key];
        (r.querySelector('.c') as HTMLElement).textContent = fmt(c[i.key], 2);
        const g = r.querySelector('.g') as HTMLElement;
        if (mode === 'custom' && growthOk(i)) {
          if (!g.querySelector('input')) {
            g.innerHTML = '';
            const inp = document.createElement('input');
            inp.type = 'number'; inp.step = '0.1'; inp.value = String(custom[side][i.key]); inp.setAttribute('aria-label', `${i.name} 성장률`);
            inp.addEventListener('input', () => { custom[side][i.key] = Number(inp.value) || 0; calc(); });
            g.appendChild(inp);
          }
        } else g.textContent = growthOk(i) ? fmt(c[i.key] / i.share * 100) : '—';
      }
      tc.textContent = fmt(total, 2);
      if (mode === 'custom') {
        const gap = T - total;
        sum.textContent = `넣은 성장률로 계산한 GRDP 성장률은 ${fmt(total, 2)}%입니다. 목표 ${fmt(T)}%와 ${fmt(Math.abs(gap), 2)}%p ${gap > 0 ? '모자랍니다' : gap < 0 ? '넘습니다' : '같습니다'}. (처음 값은 각 항목의 10년 연평균 실질 성장률)`;
      } else if (mode === 'fill') {
        const x = items.find(i => i.key === gf.value)!;
        sum.textContent = `${x.name}이(가) ${fmt(c[x.key], 2)}%p${growthOk(x) ? `, 곧 실질 ${fmt(c[x.key] / x.share * 100)}% 성장` : ''}을 내야 합계가 ${fmt(T)}%가 됩니다(나머지는 지난 10년 평균 기여).`;
      } else if (mode === 'trend') sum.textContent = `지난 10년 기여가 플러스인 항목을 같은 배율로 키워 합계 ${fmt(T)}%를 맞춘 값입니다.`;
      else sum.textContent = `모든 항목이 ${fmt(T)}% 성장할 때의 기여입니다(기여 = 비중 × ${fmt(T)}%).`;
    };
    const gb = document.getElementById('gb') as HTMLInputElement | null, gk = document.getElementById('gk') as HTMLInputElement | null;
    const gbo = document.getElementById('gbo');
    const budget = () => {
      const io = (D as any).io; if (!gb || !gk || !gbo || !io) return;
      const amt = Number(gb.value) || 0, k = Number(gk.value) || 0, T = Number(gt.value);
      const nomEok = (D as any).gva * 10000;                 // 조 원 → 억 원 — 분모는 명목 총부가가치(위 계산기들과 같은 공통 기준)
      const dom = 1 - (io.importShare ?? 0) / 100;              // 계수는 국산품 최종수요 1단위 기준 — 수입품 몫은 뺀다
      const va = amt * dom * k, out = amt * dom * (io.vaOut ?? 0);
      const pp = va / nomEok * 100, gap = T - (D as any).trendSum;
      const need = gap > 0 && k > 0 ? gap / 100 * nomEok / (k * dom) : NaN;
      const jobs = io.empIn != null ? amt * dom / 10 * io.empIn : NaN;     // 10억 원당
      gbo.innerHTML = [
        `대구 안 부가가치 <strong>${fmt(va, 0)}억 원</strong> (다른 지역으로 나가는 부가가치 ${fmt(out, 0)}억 원)`,
        `대구 GRDP 기여 <strong>${fmt(pp, 3)}%p</strong> (명목 총부가가치 ${fmt((D as any).gva)}조 원 대비, 순생산물세는 비례)`,
        gap > 0 ? `목표 ${fmt(T)}%와 지난 10년 추세(${fmt((D as any).trendSum, 2)}%p)의 차이 ${fmt(gap, 2)}%p 가운데 <strong>${fmt(pp / gap * 100)}%</strong>` : `목표가 지난 10년 추세(${fmt((D as any).trendSum, 2)}%p) 이하입니다`,
        Number.isFinite(jobs) ? `대구 안 취업 유발 약 ${fmt(jobs, 0)}명 (10억 원당 ${io.empIn}명)` : '',
        Number.isFinite(need) ? `차이 ${fmt(gap, 2)}%p를 새 지출만으로 메운다면 한 해 약 <strong>${fmt(need / 10000, 1)}조 원</strong>이 더 필요합니다(같은 계수 가정)` : '',
      ].filter(Boolean).map(x => `<li>${x}</li>`).join('');
    };
    [gb, gk].forEach(x => x?.addEventListener('input', budget));
    gt.addEventListener('input', budget);
    document.querySelectorAll<HTMLInputElement>('input[name="gside"]').forEach(r => r.addEventListener('change', () => { side = r.value as 'prod' | 'exp'; build(); }));
    [gt, gs, gf].forEach(x => x.addEventListener('input', () => {
      if (gs.value !== 'custom') tbody.querySelectorAll('.g').forEach(g => { if (g.querySelector('input')) g.innerHTML = ''; });
      calc();
    }));
    build();
    budget();
  }
</script>
<style>
  .calc-tools { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: var(--s2) 0; }
  .calc-tools label { display: flex; align-items: center; gap: 6px; min-width: 0; max-width: 100%; }
  .calc-tools label[hidden] { display: none; }
  .calc-tools input[type=number], .calc-tools select, #gtab input { font: inherit; padding: 4px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .calc-tools input[type=number] { width: 5em; }
  .calc-tools select { min-width: 0; max-width: 100%; }
  .seg { display: flex; flex-wrap: wrap; gap: 4px 12px; width: 100%; }
  #gtab input { width: 5em; text-align: right; }
  #gtab.compact th, #gtab.compact td { padding-top: 5px; padding-bottom: 5px; }
  #gtab tbody th { font-weight: 500; }
  .calc-sum { font-weight: 600; margin: 6px 0; }
  .budget-box { border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; margin: var(--s2) 0; }
  .budget-box h3 { margin: 0 0 4px; font-size: 1rem; }
  .budget-out { margin: 6px 0; padding-left: 1.2em; }
  .budget-out li { margin: 2px 0; }
</style>
