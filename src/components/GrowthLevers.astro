---
import { grdpCalcData, ioDaegu, tourismOutsider, mfgScenarios } from '../lib/grdp';
/** 성장 시나리오 계산기(/growth/, 운영자 지시 2026-10-05: 보고서가 아니라 계산기로 메뉴에). 업종별 성장률·외지인 관광소비·새 지출을 바꾸면
 *  대구 실질 GRDP 성장률이 어떻게 되는지 브라우저에서 계산한다. 출발점은 지난 10년 공표 실질기여도 평균의 합(추세),
 *  업종 변화분 = 최근 연도 명목 비중 × (가정 성장률 − 10년 연평균 성장률), 관광소비·지출은 한국은행 지역산업연관표 대구 계수.
 *  전망·달성 가능성 판단이 아니라 넣은 가정에 따른 계산이다. 대구시 예산액은 싣지 않는다. */
const P = grdpCalcData('prod');
const MS = mfgScenarios();
const IO = ioDaegu();
const TOUR = tourismOutsider();
const base = P.items.reduce((a, i) => a + i.avgc, 0);
const FOCUS = ['보건업 및 사회복지 서비스업', '금융 및 보험업', '전문 과학 및 기술 서비스업', '사업시설 관리 사업 지원 및 임대 서비스업',
  '교육 서비스업', '숙박 및 음식점업', '예술 스포츠 및 여가관련 서비스', '정보통신업'];
type Row = { id: string; group: 'mfg' | 'svc' | 'etc'; name: string; share: number; g: number; gn?: number; top3?: number };
const rows: Row[] = [
  ...(MS?.rows ?? []).map((r, i) => ({ id: `m${i}`, group: 'mfg' as const, name: r.name, share: r.share, g: r.g, gn: r.gn, top3: r.top3 })),
  ...FOCUS.map(k => P.items.find(i => i.key === k)).filter(i => i && i.cagr != null).map((i, j) => ({ id: `s${j}`, group: 'svc' as const, name: i!.name, share: i!.share, g: i!.cagr! })),
  ...P.items.filter(i => !FOCUS.includes(i.key) && i.key !== '제조업' && i.key !== '순생산물세' && i.cagr != null)
    .map((i, j) => ({ id: `e${j}`, group: 'etc' as const, name: i.name, share: i.share, g: i.cagr! })),
];
const f1 = (v: number) => v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const f2 = (v: number) => v.toLocaleString('ko-KR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const data = { base, nom: P.nomTrillion, rows, io: IO, tour: TOUR };
const GROUPS: [Row['group'], string, string][] = [
  ['mfg', '제조업 업종', '작은 글씨의 전국·상위3은 전국 같은 업종과 17개 시도 가운데 그 업종 10년 성장률이 높았던 세 곳 평균(비교 기준, 순위·평가 아님)'],
  ['svc', '서비스업(외지 수요·기여가 컸던 업종)', ''],
  ['etc', '그 밖의 산업', ''],
];
---
{rows.length > 0 && (
<section id="levers">
  <div class="lv-result" aria-live="polite">
    <div class="lv-big"><span id="lvg">{f1(base)}</span><small>%</small></div>
    <div>
      <div class="lv-lab">가정에 따른 대구 실질 GRDP 성장률(한 해)</div>
      <div class="meta" id="lvs">지난 10년 추세 {f2(base)}%p 그대로입니다. 아래에서 업종 성장률이나 관광소비·지출을 바꿔 보세요.</div>
    </div>
    <label class="lv-target">목표 <input id="lvt" type="number" step="0.1" value="5" inputmode="decimal" /> %</label>
  </div>
  <div class="lv-bar" aria-hidden="true"><span id="lvbar"></span><i id="lvmark"></i></div>

  <div class="lv-presets" role="group" aria-label="가정 한꺼번에 넣기">
    <button type="button" class="btn secondary" data-p="reset">모두 추세로</button>
    <button type="button" class="btn secondary" data-p="stop">제조업 감소 멈춤</button>
    <button type="button" class="btn secondary" data-p="nat">제조업 전국 수준</button>
    <button type="button" class="btn secondary" data-p="top3">제조업 상위 3개 시도 수준</button>
    <button type="button" class="btn secondary" data-p="svc1">서비스업 +1%p</button>
  </div>

  {GROUPS.map(([g, title, note]) => { const rs = rows.filter(r => r.group === g); return rs.length > 0 && (
  <details class="stat-details lv-group" open={g !== 'etc'}>
    <summary>{title} <span class="meta" data-sum={g}></span></summary>
    {note && <p class="meta">{note}</p>}
    <div class="scroll-x"><table class="compact lv-tab">
      <thead><tr><th>업종 <span class="tiny">(GRDP 비중 · 10년 연평균 성장)</span></th><th class="n">가정 성장(%)</th><th class="n">변화(%p)</th></tr></thead>
      <tbody>{rs.map(r => (
        <tr>
          <th scope="row">{r.name}<div class="tiny muted">{f1(r.share)}% · {f1(r.g)}%{r.gn != null && <> · 전국 {f1(r.gn)} · 상위3 {f1(r.top3 ?? 0)}</>}</div></th>
          <td class="n"><input type="number" step="0.5" value={r.g.toFixed(1)} data-id={r.id} inputmode="decimal" aria-label={`${r.name} 가정 성장률`} /></td>
          <td class="n" data-d={r.id}>0.00</td>
        </tr>))}</tbody>
    </table></div>
  </details>); })}

  {IO && IO.vaIn != null && (
  <details class="stat-details lv-group" open>
    <summary>대구 밖에서 들어오는 돈 · 새 지출 <span class="meta" data-sum="dem"></span></summary>
    <div class="lv-dem">
      {TOUR && <label>외지인 관광소비 증가 <input id="lvtour" type="number" step="1" value="0" inputmode="decimal" /> % <span class="tiny muted">{TOUR.year}년 {f2(TOUR.eok / 10000)}조 원</span></label>}
      <label>새로 늘어나는 지출(시비·국비·민간) <input id="lvspend" type="number" step="500" value="0" inputmode="decimal" /> 억 원</label>
    </div>
    <p class="meta">금액 × (1 − 수입품 {IO.importShare}%) × 대구 부가가치유발계수 {IO.vaIn} ÷ 명목 GRDP {f1(P.nomTrillion)}조 원. 업종 성장률을 이미 올렸다면 관광소비·지출 효과가 그 안에 들어 있을 수 있어 겹쳐 셀 수 있습니다.</p>
  </details>)}

  <div class="lv-break">
    <h3>무엇이 얼마나 바꾸나</h3>
    <ul id="lvlist"></ul>
  </div>

  <details class="stat-details">
    <summary>계산 방법과 주의</summary>
    <ul class="meta">
      <li>출발점: 지난 10년({P.y0}→{P.y1}년) 경제활동별 공표 실질기여도 평균의 합 {f2(base)}%p. 아무것도 바꾸지 않으면 이 값입니다.</li>
      <li>업종 변화(%p) = {P.y1}년 명목 비중 × (가정 성장률 − 대구 10년 연평균 실질 성장률) ÷ 100. 제조업은 7개 업종으로 나눠 넣습니다.</li>
      <li>단추는 지금 칸의 값에 겹쳐 넣습니다('모두 추세로'로 되돌림). 감소 멈춤: 마이너스인 제조업 업종을 0%로. 전국 수준: 지금 값이 전국 같은 업종 10년 성장률보다 낮은 업종만 전국 값으로. 상위 3개 시도 수준: 지금 값이 17개 시도 가운데 그 업종 10년 성장률이 높았던 세 곳의 평균보다 낮은 업종만 그 값으로. 서비스업 +1%p: 위 서비스업 업종을 지금 값보다 1%p 높게.</li>
      <li>관광소비·지출: 한국은행 「2020년 지역산업연관표」 대구 계수(국산품 최종수요 1단위 평균)를 씁니다. 한 해에 늘어난 몫이 그 해 성장률에 더해지며, 해마다 기여하려면 해마다 그만큼 더 늘어야 합니다.</li>
      <li>한 해 성장률의 근사 계산입니다. 업종 사이의 파급(한 업종이 크면 다른 업종도 커지는 효과)은 넣지 않았고, 전망이나 달성 가능성 판단이 아닙니다.</li>
    </ul>
  </details>
  <p class="meta">출처: {P.url ? <a href={P.url} rel="noopener">{P.source}</a> : P.source}{IO && <> · <a href={IO.url} rel="noopener">{IO.source}</a></>}{TOUR && <> · {TOUR.url ? <a href={TOUR.url} rel="noopener">{TOUR.source}</a> : TOUR.source}</>} · 계산: 다잇다</p>
  <script type="application/json" id="lv-data" set:html={JSON.stringify(data)} />
</section>)}
<script>
  type Row = { id: string; group: string; name: string; share: number; g: number; gn?: number; top3?: number };
  const el = document.getElementById('lv-data');
  if (el) {
    const D = JSON.parse(el.textContent || '{}') as { base: number; nom: number; rows: Row[]; io: any; tour: any };
    const fmt = (v: number, d = 1) => v.toLocaleString('ko-KR', { minimumFractionDigits: d, maximumFractionDigits: d });
    const sgn = (v: number, d = 2) => (v > 0 ? '+' : v < 0 ? '−' : '') + fmt(Math.abs(v), d);
    const inputs = new Map<string, HTMLInputElement>();
    document.querySelectorAll<HTMLInputElement>('#levers input[data-id]').forEach(i => inputs.set(i.dataset.id!, i));
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
    const nomEok = D.nom * 10000;
    const dom = D.io ? 1 - (D.io.importShare ?? 0) / 100 : 1;
    const demand = (eok: number) => D.io ? eok * dom * D.io.vaIn / nomEok * 100 : 0;
    const calc = () => {
      const T = Number($('lvt')?.value) || 0;
      const parts: { name: string; d: number }[] = [];
      const gsum: Record<string, number> = {};
      for (const r of D.rows) {
        const v = Number(inputs.get(r.id)?.value);
        const d = Number.isFinite(v) ? r.share * (v - r.g) / 100 : 0;
        const cell = document.querySelector(`[data-d="${r.id}"]`);
        if (cell) cell.textContent = Math.abs(d) < 0.005 ? '0.00' : sgn(d);
        gsum[r.group] = (gsum[r.group] ?? 0) + d;
        if (Math.abs(d) >= 0.005) parts.push({ name: r.name, d });
      }
      const tr = Number($('lvtour')?.value) || 0, sp = Number($('lvspend')?.value) || 0;
      const td = D.tour ? demand(D.tour.eok * tr / 100) : 0, sd = demand(sp);
      if (Math.abs(td) >= 0.005) parts.push({ name: `외지인 관광소비 ${sgn(tr, 0)}%`, d: td });
      if (Math.abs(sd) >= 0.005) parts.push({ name: `새 지출 ${fmt(sp, 0)}억 원`, d: sd });
      gsum.dem = td + sd;
      document.querySelectorAll<HTMLElement>('[data-sum]').forEach(s => { const v = gsum[s.dataset.sum!] ?? 0; s.textContent = Math.abs(v) < 0.005 ? '' : `${sgn(v)}%p`; });
      const add = parts.reduce((a, p) => a + p.d, 0), g = D.base + add, gap = T - g;
      const out = $('lvg'); if (out) out.textContent = fmt(g);
      const s = document.getElementById('lvs');
      if (s) s.textContent = `지난 10년 추세 ${fmt(D.base, 2)}%p ${parts.length ? `${sgn(add)}%p(바꾼 가정)` : '그대로'} · ` + (gap > 0.005 ? `목표 ${fmt(T)}%까지 ${fmt(gap, 2)}%p 남음` : `목표 ${fmt(T)}% 이상`);
      const bar = document.getElementById('lvbar'), mark = document.getElementById('lvmark');
      const scale = Math.max(T, g, 1) * 1.1;
      if (bar) { bar.style.width = `${Math.max(0, Math.min(100, g / scale * 100))}%`; bar.classList.toggle('ok', g >= T); }
      if (mark) mark.style.left = `${Math.min(100, T / scale * 100)}%`;
      const list = document.getElementById('lvlist');
      if (list) {
        const all = [{ name: '지난 10년 추세', d: D.base }, ...parts.sort((a, b) => b.d - a.d)];
        const mx = Math.max(...all.map(p => Math.abs(p.d)), 0.01);
        list.innerHTML = all.map(p => `<li><span class="nm">${p.name}</span><span class="bw"><span class="b${p.d < 0 ? ' neg' : ''}" style="width:${Math.abs(p.d) / mx * 100}%"></span></span><span class="v">${sgn(p.d)}%p</span></li>`).join('')
          + (parts.length ? '' : '<li class="meta">아직 바꾼 가정이 없습니다.</li>');
      }
    };
    const cur = (r: Row) => { const v = Number(inputs.get(r.id)?.value); return Number.isFinite(v) ? v : r.g; };
    const set = (f: (r: Row) => number | null) => { for (const r of D.rows) { const v = f(r); const i = inputs.get(r.id); if (i && v != null) i.value = v.toFixed(1); } calc(); };
    document.querySelectorAll<HTMLButtonElement>('.lv-presets button').forEach(b => b.addEventListener('click', () => {
      const p = b.dataset.p;
      if (p === 'reset') { set(r => r.g); const t = $('lvtour'), s = $('lvspend'); if (t) t.value = '0'; if (s) s.value = '0'; calc(); }
      else if (p === 'stop') set(r => r.group === 'mfg' ? Math.max(cur(r), 0) : null);
      else if (p === 'nat') set(r => r.group === 'mfg' ? Math.max(cur(r), r.gn ?? r.g) : null);
      else if (p === 'top3') set(r => r.group === 'mfg' ? Math.max(cur(r), r.top3 ?? r.g) : null);
      else if (p === 'svc1') set(r => r.group === 'svc' ? cur(r) + 1 : null);
    }));
    document.querySelectorAll<HTMLInputElement>('#levers input').forEach(i => i.addEventListener('input', calc));
    calc();
  }
</script>
<style>
  .lv-result { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); padding: var(--s2) var(--s3); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); position: sticky; top: 0; z-index: 2; }
  .lv-big { font-size: var(--num-xl); font-weight: 700; line-height: 1; color: var(--primary); font-variant-numeric: tabular-nums; }
  .lv-big small { font-size: 0.5em; margin-left: 2px; }
  .lv-lab { font-weight: 600; }
  .lv-result > div:nth-child(2) { flex: 1 1 200px; }
  .lv-target input { width: 4.5em; }
  .lv-bar { position: relative; height: 10px; margin: 8px 0 var(--s2); background: var(--line); border-radius: 5px; }
  .lv-bar span { display: block; height: 100%; background: var(--primary); border-radius: 5px; transition: width .2s; }
  .lv-bar span.ok { background: var(--chart-2); }
  .lv-bar i { position: absolute; top: -4px; width: 2px; height: 18px; background: var(--ink); }
  .lv-presets { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--s2) 0; }
  .lv-presets .btn { min-height: 36px; padding: 0 12px; font-size: var(--small); }
  .lv-tab input, .lv-dem input, .lv-target input { width: 5em; padding: 4px 6px; text-align: right; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .lv-tab th, .lv-tab td { padding-top: 5px; padding-bottom: 5px; }
  .lv-tab tbody th { font-weight: 500; }
  .lv-group summary { font-weight: 600; }
  .lv-dem { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 8px 0; }
  .lv-break { margin: var(--s3) 0 var(--s2); }
  .lv-break h3 { font-size: 1rem; margin-bottom: 6px; }
  #lvlist { list-style: none; margin: 0; padding: 0; }
  #lvlist :global(li) { display: grid; grid-template-columns: minmax(7em, 11em) 1fr 4.5em; gap: 8px; align-items: center; margin: 3px 0; font-size: var(--small); }
  #lvlist :global(.bw) { background: var(--surface); height: 12px; border-radius: 0 3px 3px 0; }
  #lvlist :global(.b) { display: block; height: 100%; background: var(--primary); border-radius: 0 3px 3px 0; }
  #lvlist :global(.b.neg) { background: var(--muted-2); }
  #lvlist :global(.v) { text-align: right; font-variant-numeric: tabular-nums; }
  @media (max-width: 600px) {
    .lv-result { flex-wrap: nowrap; gap: 10px; padding: 8px 10px; }
    .lv-big { font-size: 2.1rem; }
    .lv-lab { display: none; }
    .lv-result .meta { font-size: var(--tiny); }
    .lv-target { white-space: nowrap; font-size: var(--small); }
    .lv-target input { width: 3.6em; }
  }
  .lv-tab tbody th { min-width: 9em; }
  .lv-tab td:last-child { min-width: 4.2em; }
</style>
