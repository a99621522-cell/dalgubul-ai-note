---
import { grdpCalcData, pathBench } from '../lib/grdp';
/** 목표 달성 경로(테크트리, /growth/, 운영자 지시 2026-10-05: 분야별로 어떤 섹터가 얼마 기여하고 몇 % 성장해야 하는지, 어떤 전략인지 테크트리·표로).
 *  지난 10년 추세에서 출발해 비교 기준(전국 같은 업종 → 17개 시도 상위 3곳 평균)으로 단계마다 업종 성장률을 올려 누적 성장률을 계산하고,
 *  목표에 닿는 단계와 그때 업종별 필요 성장·추가 기여를 보여 준다. 정책 수단은 검토할 수 있는 예시이고 평가·권고가 아니다. */
const P = grdpCalcData('prod');
const B = pathBench();
const base = P.items.reduce((a, i) => a + i.avgc, 0);
const FIELDS: Record<string, { name: string; tools: string[]; kpi: string[] }> = {
  base: { name: '제조 기반(섬유·금속·목재종이·음식료)', tools: ['감소 업종의 사업 전환·고부가 품목 전환 지원', '공정 자동화·스마트공장으로 생산성 높이기', '뿌리 공정(주조·금형·표면처리) 공동 설비·인력'], kpi: ['업종별 생산·출하지수(통계 › 제조업)', '업종별 사업체·종사자 수'] },
  core: { name: '주력·첨단 제조(기계·운송장비·전기전자·화학)', tools: ['미래차·로봇·반도체 소재부품으로의 품목 전환', '시설투자 유치와 공급망(협력사) 연계', '시험·인증·실증 기반'], kpi: ['생산·출하지수, 설비투자(GRDP 지출 측)', '대구 본사 기업 시설투자 공시(기업 사전 › 공시 기업)'] },
  ext: { name: '역외 수요 서비스(보건·교육·관광)', tools: ['외국인·다른 지역 환자 유입(의료관광·협진망)', '유학생·다른 지역 학생 유치와 졸업 뒤 정착', '체류형 관광·MICE(숙박·야간·행사 연계)'], kpi: ['외지인 관광소비(통계 › 서비스업)', '외국인 환자 수, 유학생 수'] },
  know: { name: '지식·생산자 서비스(전문·사업지원·정보통신·금융)', tools: ['제조–서비스 연계(설계·엔지니어링·SW 를 대구 기업에서)', '실적을 바탕으로 한 역외 판매', '지역 투자 펀드·기술금융'], kpi: ['전문·과학·기술 사업체·종사자 수', '예금은행 원화대출금(통계 › 경기 동향)'] },
  life: { name: '생활·기반 산업(도소매·부동산·건설·운수·공공 등)', tools: ['주로 지역 소득을 따라 움직이는 업종 — 위 분야 성장의 파급', '물류·교통망(운수), 기반시설(건설)'], kpi: ['소매판매·서비스업생산지수', '건설수주'] },
};
const STAGES = [
  { key: 's1', title: '제조업 감소 멈춤', desc: '10년 성장이 마이너스인 제조업 업종이 0%에 머묾' },
  { key: 's2', title: '제조업 전국 수준', desc: '제조업 업종이 전국 같은 업종 10년 성장률만큼(대구가 더 높으면 그대로)' },
  { key: 's3', title: '서비스·기타 산업 전국 수준', desc: '제조업 밖 업종이 전국 같은 업종 10년 성장률만큼' },
  { key: 's4', title: '제조업 상위 3개 시도 수준', desc: '제조업 업종이 17개 시도 가운데 그 업종 10년 성장률이 높았던 세 곳의 평균만큼' },
  { key: 's5', title: '서비스·기타 산업 상위 3개 시도 수준', desc: '제조업 밖 업종도 그 업종 상위 세 곳 평균만큼' },
];
const f1 = (v: number) => v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const data = { base, rows: B?.rows ?? [], fields: FIELDS };
---
{B && B.rows.length > 0 && (
<section id="path">
  <div class="section-head"><h2>목표 달성 경로 — 테크트리</h2><span class="meta">대구 GRDP · {B.y0}→{B.y1}년 10년 성장 기준</span></div>
  <p class="meta">지난 10년 추세({f1(base)}%)에서 출발해 업종 성장률을 비교 기준에 맞춰 한 단계씩 올렸을 때 성장률이 어떻게 쌓이는지 보여 줍니다. 비교 기준은 전국 같은 업종과 17개 시도 가운데 그 업종 성장률이 높았던 세 곳의 평균입니다(순위·평가가 아니라 다른 지역에서 실제 나온 성장률). 참고로 같은 10년 GRDP 연평균 성장률은 전국 {f1(B.natTot)}%, 17개 시도 상위 세 곳 평균 {f1(B.top3Tot)}%, 가장 높은 시도 {f1(B.bestTot)}%였습니다.</p>
  <label class="tp-target">목표 성장률 <input id="tpt" type="number" step="0.1" value="5" inputmode="decimal" /> %</label>
  <p id="tpsum" class="calc-sum" aria-live="polite"></p>

  <ol class="tp-tree">
    <li class="tp-node tp-root"><div class="tp-dot"></div><div class="tp-body"><div class="tp-head"><strong>출발: 지난 10년 추세</strong><span class="tp-cum">{f1(base)}%</span></div><div class="meta">경제활동별 공표 실질기여도 평균의 합</div></div></li>
    {STAGES.map((s, i) => (
    <li class="tp-node" data-stage={i}>
      <div class="tp-dot"></div>
      <div class="tp-body">
        <div class="tp-head"><strong>{i + 1}단계 · {s.title}</strong><span class="tp-add" data-add={i}></span><span class="tp-cum" data-cum={i}></span></div>
        <div class="meta">{s.desc}</div>
        <div class="tp-flag" data-flag={i}></div>
        <details class="tp-det"><summary>바뀌는 업종 보기</summary><div class="scroll-x"><table class="compact tp-tab"><thead><tr><th>업종</th><th class="n">성장(%)</th><th class="n">기여(%p)</th></tr></thead><tbody data-rows={i}></tbody></table></div></details>
      </div>
    </li>))}
    <li class="tp-node tp-rest"><div class="tp-dot"></div><div class="tp-body"><div class="tp-head"><strong>남은 차이</strong><span class="tp-cum" id="tprest"></span></div><div class="meta" id="tpresttxt"></div></div></li>
  </ol>

  <h3 class="tp-h">목표 <span id="tpt2">5.0</span>%에 맞춘 분야별 필요 성장·기여와 정책 수단</h3>
  <p class="meta">위 경로에서 목표에 닿는 지점까지의 업종 성장률입니다(마지막 단계는 필요한 만큼만). 기여 = 비중 × 필요 성장. 정책 수단은 검토할 수 있는 예시입니다.</p>
  <div id="tpfields"></div>
  <details class="stat-details"><summary>업종별 표 보기</summary>
  <div class="scroll-x"><table class="data-table compact" id="tptab" data-title="대구 GRDP 목표 달성 경로 — 업종별 필요 성장">
    <thead><tr><th>업종</th><th class="n">비중(%)</th><th class="n">10년 성장(%)</th><th class="n">필요 성장(%)</th><th class="n">기여(%p)</th><th class="n">추세 대비(%p)</th></tr></thead>
    <tbody></tbody>
  </table></div></details>
  <p class="meta">계산: 업종 기여 변화 = {B.y1}년 명목 비중 × (가정 성장률 − 대구 10년 연평균 성장률). 업종 사이 파급은 넣지 않았고, 비중이 아주 작은 업종(광업·농림어업 등)의 상위 세 곳 값은 크게 흔들립니다. 세종처럼 기반이 작은 시도가 상위에 들 수 있습니다. 전망이나 달성 가능성 판단이 아닙니다. 출처: {P.url ? <a href={P.url} rel="noopener">{P.source}</a> : P.source} · 계산: 다잇다</p>
  <script type="application/json" id="tp-data" set:html={JSON.stringify(data)} />
</section>)}
<script>
  type R = { key: string; name: string; mfg: boolean; field: string; share: number; g: number; gn: number; t3: number };
  const el = document.getElementById('tp-data');
  if (el) {
    const D = JSON.parse(el.textContent || '{}') as { base: number; rows: R[]; fields: Record<string, { name: string; tools: string[]; kpi: string[] }> };
    const fmt = (v: number, d = 1) => v.toLocaleString('ko-KR', { minimumFractionDigits: d, maximumFractionDigits: d });
    const sg = (v: number, d = 2) => (v > 0 ? '+' : v < 0 ? '−' : '') + fmt(Math.abs(v), d);
    const STEP: ((r: R, c: number) => number)[] = [
      (r, c) => r.mfg ? Math.max(c, 0) : c,
      (r, c) => r.mfg ? Math.max(c, r.gn) : c,
      (r, c) => !r.mfg ? Math.max(c, r.gn) : c,
      (r, c) => r.mfg ? Math.max(c, r.t3) : c,
      (r, c) => !r.mfg ? Math.max(c, r.t3) : c,
    ];
    const contrib = (cur: number[]) => D.rows.reduce((a, r, i) => a + r.share * (cur[i] - r.g) / 100, 0);
    const $ = (s: string) => document.querySelector(s) as HTMLElement | null;
    const calc = () => {
      const T = Number((document.getElementById('tpt') as HTMLInputElement).value) || 0;
      let cur = D.rows.map(r => r.g), cum = D.base, final: number[] | null = null, reachedAt = -1;
      if (cum >= T) { final = cur.slice(); reachedAt = -0.5; }
      STEP.forEach((f, k) => {
        const prev = cur.slice(), next = D.rows.map((r, i) => f(r, prev[i]));
        const add = contrib(next) - contrib(prev), before = cum;
        cum += add; cur = next;
        const a = $(`[data-add="${k}"]`), c = $(`[data-cum="${k}"]`), flag = $(`[data-flag="${k}"]`), node = $(`[data-stage="${k}"]`);
        if (a) a.textContent = `${sg(add)}%p`;
        if (c) c.textContent = `${fmt(cum)}%`;
        let note = '';
        if (!final && cum >= T) {
          const fr = add > 0 ? (T - before) / add : 1;
          final = D.rows.map((_, i) => prev[i] + fr * (next[i] - prev[i]));
          reachedAt = k;
          note = `여기서 목표 ${fmt(T)}%에 닿음 — 이 단계의 ${fmt(fr * 100, 0)}%만큼`;
        }
        if (flag) flag.textContent = note;
        node?.classList.toggle('reach', reachedAt === k);
        node?.classList.toggle('after', reachedAt >= -0.5 && k > reachedAt && reachedAt !== -1);
        const tb = $(`[data-rows="${k}"]`);
        if (tb) tb.innerHTML = D.rows.map((r, i) => ({ r, p: prev[i], n: next[i] })).filter(x => Math.abs(x.n - x.p) > 0.001)
          .map(x => `<tr><th scope="row">${x.r.name}</th><td class="n">${fmt(x.p)} → ${fmt(x.n)}</td><td class="n">${sg(x.r.share * (x.n - x.p) / 100)}</td></tr>`).join('') || '<tr><td colspan="3" class="meta">바뀌는 업종 없음</td></tr>';
      });
      let rest = 0;
      if (!final) { rest = T - cum; final = cur.map(c => c + rest); }
      const rr = $('#tprest'), rt = $('#tpresttxt'), rn = $('.tp-rest');
      if (rr) rr.textContent = rest > 0.005 ? `${sg(rest)}%p` : '없음';
      if (rt) rt.textContent = rest > 0.005 ? `모든 업종이 상위 3개 시도 수준에 더해 해마다 ${fmt(rest, 2)}%p씩 더 성장해야 ${fmt(T)}%가 됩니다.` : '위 단계 안에서 목표에 닿습니다.';
      rn?.classList.toggle('after', rest <= 0.005);
      const s = $('#tpsum');
      if (s) s.textContent = reachedAt === -0.5 ? `목표 ${fmt(T)}%는 지난 10년 추세(${fmt(D.base)}%) 이하입니다.`
        : reachedAt >= 0 ? `목표 ${fmt(T)}%는 ${reachedAt + 1}단계에서 닿습니다.` : `5단계를 모두 거쳐도 ${fmt(cum)}%이고, ${fmt(rest, 2)}%p가 남습니다.`;
      const t2 = $('#tpt2'); if (t2) t2.textContent = fmt(T);
      // 분야별 표
      const order = ['core', 'base', 'ext', 'know', 'life'];
      const rows = D.rows.map((r, i) => ({ r, need: final![i], add: r.share * (final![i] - r.g) / 100 }));
      const tb = document.querySelector('#tptab tbody');
      if (tb) tb.innerHTML = order.map(f => `<tr class="tp-grp"><th colspan="6" scope="rowgroup">${D.fields[f].name}</th></tr>` + rows.filter(x => x.r.field === f).sort((a, b) => b.add - a.add).map(x =>
        `<tr><th scope="row">${x.r.name}</th><td class="n">${fmt(x.r.share)}</td><td class="n">${fmt(x.r.g)}</td><td class="n">${fmt(x.need)}</td><td class="n">${fmt(x.r.share * x.need / 100, 2)}</td><td class="n">${sg(x.add)}</td></tr>`).join('')).join('');
      const fb = document.getElementById('tpfields');
      if (fb) fb.innerHTML = order.map(f => {
        const xs = rows.filter(x => x.r.field === f), add = xs.reduce((a, x) => a + x.add, 0), sh = xs.reduce((a, x) => a + x.r.share, 0);
        const g0 = xs.reduce((a, x) => a + x.r.share * x.r.g, 0) / (sh || 1), g1 = xs.reduce((a, x) => a + x.r.share * x.need, 0) / (sh || 1);
        const F = D.fields[f];
        return `<div class="tp-field"><div class="tp-fh"><strong>${F.name}</strong><span>${sg(add)}%p</span></div>
          <div class="meta">GRDP 비중 ${fmt(sh)}% · 성장 ${fmt(g0)}% → <strong>${fmt(g1)}%</strong></div>
          <details><summary>정책 수단 예시 · 볼 지표</summary><ul class="meta">${F.tools.map(t => `<li>${t}</li>`).join('')}</ul><p class="meta">지표: ${F.kpi.join(' · ')}</p></details></div>`;
      }).join('');
    };
    document.getElementById('tpt')?.addEventListener('input', calc);
    calc();
  }
</script>
<style>
  .tp-target input { width: 4.5em; padding: 4px 6px; text-align: right; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .tp-tree { list-style: none; margin: var(--s2) 0; padding: 0; position: relative; }
  .tp-node { position: relative; display: grid; grid-template-columns: 22px 1fr; gap: 8px; padding-bottom: 12px; }
  .tp-node::before { content: ''; position: absolute; left: 10px; top: 16px; bottom: -2px; width: 2px; background: var(--line-strong); }
  .tp-node:last-child::before { display: none; }
  .tp-dot { width: 14px; height: 14px; margin: 4px 0 0 4px; border-radius: 50%; background: var(--bg); border: 3px solid var(--primary); position: relative; z-index: 1; }
  .tp-root .tp-dot { background: var(--primary); }
  .tp-node.reach .tp-dot { background: var(--chart-2); border-color: var(--chart-2); }
  .tp-node.after { opacity: 0.5; }
  .tp-body { border: 1px solid var(--line); border-radius: var(--radius); padding: 8px 12px; background: var(--bg); }
  .tp-node.reach .tp-body { border-color: var(--chart-2); box-shadow: 0 0 0 1px var(--chart-2); }
  .tp-head { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
  .tp-head strong { flex: 1 1 12em; }
  .tp-add { font-variant-numeric: tabular-nums; color: var(--muted); }
  .tp-cum { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--primary); font-size: 1.1rem; }
  .tp-flag { font-weight: 600; font-size: var(--small); }
  .tp-flag:empty { display: none; }
  .tp-det summary { font-size: var(--small); cursor: pointer; margin-top: 4px; }
  .tp-tab :global(th), .tp-tab :global(td) { padding-top: 4px; padding-bottom: 4px; font-size: var(--small); }
  .tp-tab :global(tbody th) { font-weight: 500; }
  .tp-h { font-size: 1.05rem; margin: var(--s3) 0 6px; }
  #tpfields { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px; margin: 8px 0 var(--s2); }
  #tpfields :global(.tp-field) { border: 1px solid var(--line); border-radius: var(--radius); padding: 8px 12px; }
  #tpfields :global(.tp-fh) { display: flex; justify-content: space-between; gap: 8px; }
  #tpfields :global(.tp-fh span) { font-weight: 700; color: var(--primary); font-variant-numeric: tabular-nums; white-space: nowrap; }
  #tpfields :global(summary) { font-size: var(--small); cursor: pointer; margin-top: 4px; }
  #tpfields :global(ul) { margin: 4px 0; padding-left: 1.2em; }
  #tptab { min-width: 540px; }
  #tptab :global(tbody th[scope="row"]) { font-weight: 500; min-width: 9em; }
  #tptab :global(.tp-grp th) { background: var(--surface); font-size: var(--small); color: var(--muted); }
</style>
