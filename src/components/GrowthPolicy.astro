  items: ITEMS.map(i => ({ id: i.id, task: i.task, kind: i.kind, ramp: i.ramp, leaves: i.leaves ?? [], alloc: i.alloc ?? '', mult: i.mult ?? 1, ratio: i.ratio ?? null, ex: i.ex ?? 0, hx: i.hx ?? 0, per: i.per ?? 0, unit: i.unit ?? '', io: P.ioByItem[i.id] ?? null })) } : null;
const years = Array.from({ length: Y1 - Y0 + 1 }, (_, i) => Y0 + i);
---
{S && data && (
<section id="gp">
  <h2>정책 과제를 넣으면 — 성장률·고용·산업구조</h2>
  <p class="meta">대구 열린시장실 '주요 추진과제'의 산업 관련 과제를 지역소득 부문에 연결했습니다(번호는 과제 번호, '제안'은 과제 밖이지만 대구 밖 돈을 들여오는 항목). 값·시작 연도·순증 비율을 넣으면 {Y0}~{Y1}년 해마다의 성장률과 고용, 그리고 산업구조지수 리포트의 지표(고부가 3부문 비중·산업집중도·고부가 변화속도)가 바뀝니다. 출발은 위 계산기와 같은 {S.y0}→{S.y1}년 연평균 {S.base.toFixed(2)}%, 성장률 몫은 부가가치 증가 ÷ 명목 총부가가치 {f1(S.gvaEok / 10000)}조 원(모든 계산기 공통, 순생산물세는 부가가치에 비례)입니다.</p>

  <div class="gp-res" aria-live="polite">
    <p class="gp-ex" data-o="exbanner" hidden>예시 값이 들어 있습니다 — 계산을 보여 주기 위한 값이지 목표·전망이 아닙니다. 값을 고치면 이 표시가 사라집니다.</p>
    <div class="gp-top">
      <div class="gp-k"><span class="tl">첫 해 성장률</span><b data-o="g1">—</b><span class="tiny muted" data-o="g1s"></span></div>
      <div class="gp-k"><span class="tl">{Y0}~{Y1}년 연평균</span><b data-o="g5">—</b><span class="tiny muted" data-o="g5s"></span></div>
      <div class="gp-k"><span class="tl">{Y1}년 GRDP 규모</span><b data-o="lv">—</b><span class="tiny muted" data-o="lvs"></span></div>
      <div class="gp-k"><span class="tl">취업 유발(완성 때)</span><b data-o="jb">—</b><span class="tiny muted" data-o="jbs"></span></div>
    </div>
    <div class="gp-tiles">
      <div><span class="tl">고부가 3부문 비중</span><b data-o="hi">—</b><span class="tiny muted" data-o="hi2"></span></div>
      <div><span class="tl">산업집중도</span><b data-o="hh">—</b><span class="tiny muted" data-o="hh2"></span></div>
      <div><span class="tl">고부가 변화속도</span><b data-o="sc">—</b><span class="tiny muted" data-o="sc2"></span></div>
      <div><span class="tl">고부가 집중도</span><b data-o="hq">—</b><span class="tiny muted" data-o="hq2"></span></div>
    </div>
    <p class="tiny muted">구조 지표는 모든 과제가 완성된 해 기준(다음 해 비중 = 부가가치 × (1+추세) + 증가분, 다시 나눔). 범위는 자료 차이(직접분만 / 평균 계수, 2015·2020년 표)로 본 폭입니다.</p>
    <div class="gp-th"><div class="tl">고부가 부문이 산업집중도를 끌어올리는 문턱(비중이 산업집중도 ÷ 100보다 커야 함)</div><ul data-o="thr"></ul></div>
    <p class="gp-rep" data-o="rep"></p>
    <div class="gp-labor"><div class="tl">노동 공급 점검 — 이 취업 유발을 대구 안에서 채울 수 있나</div><p data-o="labor" class="gp-labor-txt"></p></div>
  </div>

  <div class="gp-btns">
    <button type="button" class="btn secondary" data-fill="hx">고부가 집중 예시</button>
    <button type="button" class="btn secondary" data-fill="ex">모든 과제 예시</button>
    <button type="button" class="btn secondary" data-fill="zero">모두 0으로</button>
    <span class="gp-sep"></span>
    <button type="button" class="btn secondary" data-scn="saveA" title="지금 넣은 값 묶음을 이 브라우저에 'A' 이름으로 기억">지금 값을 A로 기억</button>
    <button type="button" class="btn secondary" data-scn="saveB" title="지금 넣은 값 묶음을 이 브라우저에 'B' 이름으로 기억">지금 값을 B로 기억</button>
    <button type="button" class="btn secondary" data-scn="loadA" title="A 로 기억해 둔 값을 다시 불러옴">A 불러오기</button>
    <button type="button" class="btn secondary" data-scn="loadB" title="B 로 기억해 둔 값을 다시 불러옴">B 불러오기</button>
    <button type="button" class="btn secondary" data-scn="link">링크 복사</button>
    <button type="button" class="btn secondary" data-scn="pdf">한 쪽 요약 PDF</button>
    <span class="tiny muted" data-o="scnmsg"></span>
  </div>
  <p class="tiny muted">A·B 는 '입력값 묶음 두 개를 이 브라우저에 기억해 두는 자리'입니다. 쓰는 법: ① 과제 몇 개에 값을 넣고 「지금 값을 A로 기억」 ② 다른 조합을 넣고 「B로 기억」 ③ 아래 '시나리오 비교' 표에서 추세·A·B·지금 입력값의 성장률·고용·구조 지표를 나란히 봅니다. 「링크 복사」는 지금 입력값이 든 주소를 복사해 다른 사람에게 보낼 때 씁니다. 서버에 저장되지 않습니다.</p>

  <div class="gp-list">{ITEMS.map(i => (
    <div class="gp-item" data-id={i.id}>
      <div class="gp-h"><span class="gp-no">{i.no}</span><b>{i.task}</b></div>
      <div class="tiny muted">{i.lever} → {i.alloc === 'tour' ? '관광소비 업종 구성대로(도소매·숙박음식·운수·여가 등)' : (i.leaves ?? []).length === 7 ? '제조업 7개 업종' : (i.leaves ?? []).map(k => leafName[k]).join('·')}</div>
      <div class="gp-in">
        {i.kind === 'stop' ? <label class="gp-chk"><input type="checkbox" data-in="v" /> 감소를 멈춤(성장률 0%)</label> : <label>{i.unit} <input type="number" data-in="v" value="0" step="any" inputmode="decimal" /></label>}
        {i.kind === 'people' && <label>1인 지출 <input type="number" data-in="p" value={i.per ?? 0} step="any" inputmode="decimal" /> {i.perUnit}</label>}
      </div>
      <div class="gp-in gp-in2">
        <label>시작 <select data-in="s">{years.map(y => <option value={y}>{y}</option>)}</select></label>
        <label>순증 <input type="number" data-in="n" value="100" min="0" max="100" step="5" inputmode="decimal" /> %</label>
        <label>투입액 <input type="number" data-in="c" value="" placeholder="선택" step="any" inputmode="decimal" /> 억 원</label>
      </div>
      <div class="tiny muted">
        {i.kind === 'plant' && <>× 부가가치율 {pctR(i.ratio ?? null)}({i.ratioNote}, 광업·제조업조사 대구 {P.mfgYear}년) = 직접분{(() => { const io = P.ioByItem[i.id]; return io && io.k != null && io.va != null ? ` + 간접분 × ${Math.max(0, io.k - io.va).toFixed(3)}(${io.sector} 대구 지역내 부가가치유발계수 ${io.k.toFixed(3)} − 직접 부가가치율 ${io.va.toFixed(3)}, 한국은행 2020 지역산업연관표)` : ` · 간접분(${io ? io.sector : '해당 부문'} 대구 지역내 유발계수)은 통계표를 받으면 더해짐 — 지금은 범위 위쪽에 평균 계수만`; })()}{(() => { const io = P.ioByItem[i.id]; return io && io.empNat != null ? ` · 참고 취업 = 연 매출 ÷ 10억 원 × ${io.empNat.toFixed(1)}명(${io.sector} 전국 취업유발계수, 취업계수 ${io.empNatDirect?.toFixed(1) ?? '—'}명 — 한국은행 2020년 고용표, 전국 값)` : ''; })()}{i.ramp === 'build3' ? ' · 시작 해 건설, 2년째 50%, 3년째 100% 가동' : ''}</>}
        {i.kind === 'firm' && <>× 대구 부가가치 계수 {S.k.toFixed(3)}(한국은행 지역산업연관표 평균 — 이 업종 계수는 조사 항목){i.ramp === 'build3' ? ' · 시작 해 건설, 2년째 50%, 3년째 100% 가동' : ''}{i.note ? ` · ${i.note}` : ''}</>}
        {i.kind === 'people' && <>{i.perNote} · × 대구 부가가치 계수 {S.k.toFixed(3)}</>}
        {i.kind === 'spend' && <>× 대구 부가가치 계수 {S.k.toFixed(3)}{i.note ? ` · ${i.note}` : ''}</>}
        {i.kind === 'grow' && <>부문 부가가치 × 추가 성장 — 시작 해부터 해마다</>}
        {i.kind === 'stop' && <>10년 추세 감소분만큼 덜 줄어듦 — 시작 해부터 해마다</>}
      </div>
      <div class="gp-r"><span>부가가치 <b data-o="va">0</b>억 원</span><span>성장률 <b data-o="pp">0.00</b>%p</span><span>취업 <b data-o="jb">0</b>명<span class="tiny muted" data-o="jbn"></span></span><span class="tiny muted" data-o="eff"></span></div>
      <div class="tiny muted">추적 지표: {i.metric}</div>
    </div>))}</div>

  <h3 class="gp-h3">{Y0}~{Y1}년 경로</h3>
  <div class="scroll-x"><table class="data-table compact" id="gp-path" data-title={`대구 GRDP 경로 ${Y0}~${Y1} — 정책 과제 시나리오`}>
    <thead><tr><th>연도</th><th class="n">추세 성장률(%)</th><th class="n">정책 성장률(%)</th><th class="n">차이(%p)</th><th class="n">GRDP(조 원, {S.y1}년 가격)</th><th class="n">추세보다(억 원)</th></tr></thead>
    <tbody></tbody>
  </table></div>
  <p class="tiny muted">기준 해 {S.y1}년 명목 GRDP {f1(S.gdpEok / 10000)}조 원에서 출발해 추세 {S.base.toFixed(2)}%로 자란다고 보고, 과제 효과를 더합니다. 공장·사람·지출 같은 '수준' 효과는 한 번 올라간 뒤 그대로이고(실질), 업종 '성장' 효과는 해마다 쌓입니다. 성장률을 계속 높이려면 해마다 새 과제가 더해져야 합니다.</p>

  <details class="stat-details" id="gp-cmp">
    <summary>시나리오 비교 (추세 · A · B · 지금)</summary>
    <div class="scroll-x"><table class="data-table compact" data-title="정책 과제 시나리오 비교"><thead><tr><th>지표</th><th class="n">추세</th><th class="n">A</th><th class="n">B</th><th class="n">지금</th></tr></thead><tbody data-o="cmp"></tbody></table></div>
    <p class="tiny muted">A·B 는 이 브라우저에만 저장됩니다. '링크 복사'는 지금 입력값을 주소에 넣어 다른 사람과 같은 화면을 볼 수 있게 합니다.</p>
  </details>

  <ul class="tiny muted gp-notes">
    <li>성장률 몫 = 부가가치 증가 ÷ 명목 총부가가치({f1(S.gvaEok / 10000)}조 원, {S.y1}년; 순생산물세 {f1((1 - S.gvaEok / S.gdpEok) * 100)}%는 부가가치에 비례해 함께 는다고 봄 — 위 계산기·목표 계산기와 같은 기준). 경로 표의 GRDP 금액은 그 비율만큼 부가가치 증가를 키워 더합니다. 업종 성장은 '부문 부가가치 × 추세보다 더 성장한 몫', 기업 유치는 '연 매출 × 대구 같은 업종 부가가치율'(그 기업 자체의 부가가치 = 직접분; 범위의 위쪽은 평균 계수로 본 직·간접 — 제조업 공장은 광업·제조업조사 중분류 부가가치율, 데이터센터·본사·물류·호텔 같은 서비스 기업·시설은 업종별 자료가 없어 대구 평균 부가가치유발계수), 사람·지출은 '지출 × 한국은행 지역산업연관표 대구 부가가치 계수(수입품 몫 뺌)'입니다. 공장 유치의 <b>간접분</b>(대구 안 공급 부문에 생기는 부가가치)은 그 부문의 대구 지역내 부가가치유발계수에서 직접 부가가치율을 뺀 몫으로 더합니다 — {P.ioFilled ? '업종별 계수는 한국은행 2020년 지역산업연관표 통계표의 대구 열' : '업종별 대구 지역내 계수는 한국은행 지역산업연관표 통계표(엑셀)에만 있어 아직 비어 있고, 채워지기 전에는 직접분만 계산하고 평균 계수를 범위 위쪽으로 보입니다(책자·ECOS 에는 없음, 2026-10-06 확인)'}.</li>
    <li>순증 비율: 대구 안에서 옮겨 온 소비·정책 없이도 생겼을 몫을 뺀 비율입니다(예비타당성·사업평가의 순증 판단). 기본 100%이며 근거가 있으면 낮춰 넣습니다. 여러 과제가 같은 부문을 키우면 더하고, 같은 기업을 두 번 세는 겹침은 빼지 않았습니다.</li>
    <li>취업 유발 = 부가가치 증가 ÷ 계수 {S.k.toFixed(3)} ÷ 10억 원 × {S.empIn ?? '—'}명(한국은행 2020 지역산업연관표 대구 취업유발계수, 직·간접 근사). {S.employed && `대구 취업자 ${S.employed.year}년 ${f1(S.employed.thousand)}천 명(경제활동인구조사)과 견줍니다.`} <b>노동 공급 점검</b>: 취업 유발에서 대구 실업자({S.unemployed ? `${S.unemployed.year}년 ${f1(S.unemployed.thousand)}천 명` : '자료 없음'})를 뺀 나머지를 '필요 순유입'으로 보이고, 최근 12개월 순이동({S.netMig ? `${S.netMig.from}~${S.netMig.to} ${S.netMig.persons.toLocaleString('ko-KR')}명` : '자료 없음'}, 국내인구이동통계)과 견줍니다. 실업자가 모두 그 일자리에 맞지는 않고 비경제활동인구의 취업·기존 기업에서 옮겨 오는 몫도 있어 근사이며, 유입이 필요한 시나리오는 그만큼 주거·정주 조건이 전제라는 뜻입니다. 공장 유치 항목에는 <b>전국 2020년 고용표의 품목별 취업유발계수</b>(한국은행 보도자료 「2020년 고용표 작성 결과」 2024-06-25, 명/10억 원 — 예: 컴퓨터·전자·광학기기 3.9, 운송장비 6.6, 기계·장비 7.2, 화학제품 5.2, 금속가공제품 7.8)로 본 취업을 '참고'로 나란히 적습니다. 대구 업종별 취업유발계수는 공개 자료(지역산업연관표 통계표에는 고용표가 없음)에 없어 전국 값이며, 대구 안 취업만이 아니라 전국에 생기는 직·간접 취업이라 합계에는 더하지 않습니다.</li>
    <li>투입액은 사용자가 넣는 값이며 대구시 예산액을 싣지 않습니다. '억 원당'은 투입 1억 원당 부가가치·취업입니다.</li>
    <li>관광·환자 수는 이동통신·건강보험 집계라 같은 사람이 여러 번 잡힐 수 있고, 데이터랩은 총량보다 추세로 보라고 안내합니다. 예시 값은 계산을 보여 주기 위한 것이지 목표·전망이 아닙니다.</li>
    <li>리포트 패널 추정({S.y0 + 1}~{S.y1}년 17개 시도)은 산업집중도 변화와 성장률이 함께 움직인 크기(연관)라 위 성장률에 더하지 않습니다.</li>
  </ul>
  <script type="application/json" id="gp-data" set:html={JSON.stringify(data)} />
</section>)}
<script>
  type R = { key: string; name: string; share: number; g: number; high: boolean; va: number };
  type I = { id: string; task: string; kind: string; ramp: string; leaves: string[]; alloc: string; mult: number; ratio: number | null; ex: number; hx: number; per: number; unit: string; io: { sector: string; va: number | null; k: number | null; empNat: number | null; empNatDirect: number | null } | null };
  type St = Record<string, { v: number; p: number; n: number; s: number; c: number }>;
  const el = document.getElementById('gp-data');
  if (el) {
    const D = JSON.parse(el.textContent || '{}') as { k: number; kAlt: number | null; empIn: number | null; gdpEok: number; gvaEok: number; unemployed: { year: string; thousand: number } | null; netMig: { from: string; to: string; persons: number } | null; y1: number; base: number; hhiAvg: number | null; highNat: number | null; scih: number | null; scihAvg: number | null;
      panel: { grdp?: number | null; grdpSe?: number | null; prod?: number | null; exp?: number | null }; tourMix: Record<string, number>; employed: { year: string; thousand: number } | null; Y0: number; Y1: number; rows: R[]; items: I[] };
    const fmt = (v: number, d = 1) => v.toLocaleString('ko-KR', { minimumFractionDigits: d, maximumFractionDigits: d });
    const sg = (v: number, d = 2) => (v > 0 ? '+' : v < 0 ? '−' : '') + fmt(Math.abs(v), d);
    const n0 = (v: number) => Math.round(v).toLocaleString('ko-KR');
    const row = (id: string) => document.querySelector<HTMLElement>(`#gp .gp-item[data-id="${id}"]`);
    const o = (k: string, r: ParentNode = document.getElementById('gp')!) => r.querySelector<HTMLElement>(`[data-o="${k}"]`);
    const byKey = new Map(D.rows.map(r => [r.key, r]));
    const shares = (vals: Map<string, number>) => { const t = [...vals.values()].reduce((a, b) => a + b, 0); return new Map([...vals].map(([k, v]) => [k, v / t * 100])); };
    const now = shares(new Map(D.rows.map(r => [r.key, r.va])));
    const T0 = [...now.values()].reduce((a, s) => a + s * s, 0);
    const BIG = D.rows.filter(r => now.get(r.key)! > T0 / 100).sort((a, b) => now.get(b.key)! - now.get(a.key)!).map(r => `${r.name} ${fmt(now.get(r.key)!)}%`).join(', ');
    const b = D.base / 100, TAX = D.gdpEok / D.gvaEok;
    const jobsOf = (va: number) => D.empIn != null && D.k > 0 ? va / D.k / 10 * D.empIn : 0;

    // ── 상태 읽기·쓰기 ──
    const read = (): St => Object.fromEntries(D.items.map(it => {
      const tr = row(it.id)!;
      const inp = tr.querySelector<HTMLInputElement>('[data-in="v"]');
      return [it.id, { v: it.kind === 'stop' ? (inp?.checked ? 1 : 0) : Number(inp?.value) || 0, p: Number(tr.querySelector<HTMLInputElement>('[data-in="p"]')?.value) || 0,
        n: Number(tr.querySelector<HTMLInputElement>('[data-in="n"]')?.value) || 0, s: Number(tr.querySelector<HTMLSelectElement>('[data-in="s"]')?.value) || D.Y0, c: Number(tr.querySelector<HTMLInputElement>('[data-in="c"]')?.value) || 0 }];
    }));
    const write = (st: St) => { for (const it of D.items) { const tr = row(it.id); const x = st[it.id]; if (!tr || !x) continue;
      const inp = tr.querySelector<HTMLInputElement>('[data-in="v"]'); if (inp) { if (it.kind === 'stop') inp.checked = x.v > 0; else inp.value = String(x.v); }
      const p = tr.querySelector<HTMLInputElement>('[data-in="p"]'); if (p && x.p) p.value = String(x.p);
      const n = tr.querySelector<HTMLInputElement>('[data-in="n"]'); if (n) n.value = String(x.n);
      const s = tr.querySelector<HTMLSelectElement>('[data-in="s"]'); if (s) s.value = String(x.s);
      const c = tr.querySelector<HTMLInputElement>('[data-in="c"]'); if (c) c.value = x.c ? String(x.c) : ''; } };

    // ── 과제 하나의 효과: 완성 때 부가가치(억 원, 순증 반영)·범위·업종 배분·증가 유형 ──
    type Eff = { va: number; lo: number; hi: number; parts: Map<string, number>; growth: { key: string; d: number }[]; start: number; ramp: string; cost: number; jobsNat: number | null };
    const effect = (it: I, x: { v: number; p: number; n: number; s: number; c: number }): Eff => {
      const net = Math.max(0, Math.min(100, x.n)) / 100;
      const parts = new Map<string, number>(); const growth: { key: string; d: number }[] = [];
      let lo = 0, hi = 0, jobsNat: number | null = null;
      if (it.kind === 'grow') for (const k of it.leaves) { const r = byKey.get(k); if (r) { parts.set(k, r.va * x.v / 100 * net); growth.push({ key: k, d: x.v * net }); } }
      if (it.kind === 'stop' && x.v) for (const k of it.leaves) { const r = byKey.get(k); if (r && r.g < 0) { parts.set(k, r.va * -r.g / 100 * net); growth.push({ key: k, d: -r.g * net }); } }
      if (it.kind === 'plant' && it.ratio) {
        const direct = x.v * it.ratio * net; parts.set(it.leaves[0], direct);
        // 간접분(운영자 지시 2026-10-06): 그 부문의 대구 지역내 부가가치유발계수(k) − 산업연관표 기준 직접 부가가치율(va) = 대구 안 공급 부문에 생기는 부가가치.
        // 계수가 채워져 있으면 더하고(부가가치 비중대로 다른 부문에 배분), 없으면 직접분만 쓰고 평균 계수를 범위 위쪽으로만 보인다
        if (it.io && it.io.k != null && it.io.va != null) {
          const ind = x.v * Math.max(0, it.io.k - it.io.va) * net;
          const tot = D.rows.reduce((a, r) => a + r.va, 0);
          for (const r of D.rows) if (tot > 0) parts.set(r.key, (parts.get(r.key) ?? 0) + ind * r.va / tot);   // 같은 부문의 공급 기업에도 생기므로 전 부문에 배분(합 = 간접분)
          lo = direct; hi = direct + ind;
        } else { lo = Math.min(direct, x.v * D.k * net); hi = Math.max(direct, x.v * D.k * net); }
        // 참고 취업(2026-10-06): 전국 2020년 고용표 품목별 취업유발계수(명/10억 원) × 연 매출(억 원 ÷ 10). 대구 업종별 취업유발계수는 공개 자료에 없어 전국 계수를 참고로만 보인다
        if (it.io && it.io.empNat != null) jobsNat = x.v / 10 * it.io.empNat * net;
      }
      if (it.kind === 'firm') { const eok = x.v * D.k * net; parts.set(it.leaves[0], eok); const alt = x.v * (D.kAlt ?? D.k) * net; lo = Math.min(eok, alt); hi = Math.max(eok, alt); }
      if (it.kind === 'people' || it.kind === 'spend') {
        const dem = (it.kind === 'spend' ? x.v : x.v * it.mult * x.p / 1e8) * net;
        const eok = dem * D.k;
        if (it.alloc === 'tour') for (const [k, w] of Object.entries(D.tourMix)) parts.set(k, eok * w); else parts.set(it.leaves[0], eok);
        const alt = dem * (D.kAlt ?? D.k); lo = Math.min(eok, alt); hi = Math.max(eok, alt);
      }
      const va = [...parts.values()].reduce((a, c) => a + c, 0);
      if (it.kind === 'grow' || it.kind === 'stop') { lo = va; hi = va; }
      return { va, lo, hi, parts, growth, start: x.s, ramp: it.ramp, cost: x.c, jobsNat };
    };
    const rampAt = (e: Eff, y: number) => y < e.start ? 0 : e.ramp === 'build3' ? Math.min(1, (y - e.start) * 0.5) : 1;
    // ── 연차 경로: 추세 경로 + 수준 효과(완성 비율) + 성장 효과(해마다 쌓임) ──
    const path = (effs: Map<string, Eff>) => {
      const ys: number[] = []; for (let y = D.y1; y <= D.Y1; y++) ys.push(y);
      return ys.map(y => {
        const t = y - D.y1, trend = D.gdpEok * (1 + b) ** t;
        let add = 0;
        for (const [id, e] of effs) {
          const it = D.items.find(i => i.id === id)!;
          if (it.kind === 'grow' || it.kind === 'stop') { for (const g of e.growth) { const r = byKey.get(g.key)!; const n = y - e.start + 1; if (n > 0) add += r.va * ((1 + r.g / 100 + g.d / 100) ** n - (1 + r.g / 100) ** n); } }
          else add += e.va * rampAt(e, y);
        }
        return { y, trend, g: trend + add * TAX };   // 부가가치 증가 × (GRDP ÷ 총부가가치): 순생산물세가 비례해 는다고 봄(공통 기준)
      });
    };
    const metrics = (add: Map<string, number>) => {
      const nx = shares(new Map(D.rows.map(r => [r.key, r.va * (1 + r.g / 100) + (add.get(r.key) ?? 0)])));
      const hhi = [...nx.values()].reduce((a, s) => a + s * s, 0);
      const high = D.rows.filter(r => r.high).reduce((a, r) => a + nx.get(r.key)!, 0);
      const sci = D.rows.filter(r => r.high).reduce((a, r) => a + Math.abs(nx.get(r.key)! - now.get(r.key)!) / 100, 0) / 2;
      const hq = D.rows.filter(r => r.high).reduce((a, r) => a + nx.get(r.key)! ** 2, 0);
      return { hhi, high, sci, hq, nx };
    };
    /** 상태 → 결과 묶음(화면·비교·PDF 공용) */
    const evaluate = (st: St) => {
      const effs = new Map<string, Eff>();
      const add = new Map<string, number>();
      let total = 0, lo = 0, hi = 0, jobs = 0, cost = 0, jobsNat = 0, jobsNatBase = 0;   // jobsNat: 전국 업종 계수로 본 공장 항목 취업(참고), jobsNatBase: 같은 항목의 대구 평균 계수 취업
      for (const it of D.items) { const e = effect(it, st[it.id]); effs.set(it.id, e); total += e.va; lo += e.lo; hi += e.hi; jobs += jobsOf(e.va); cost += e.cost; if (e.jobsNat != null && e.va > 0) { jobsNat += e.jobsNat; jobsNatBase += jobsOf(e.va); } for (const [k, v] of e.parts) add.set(k, (add.get(k) ?? 0) + v); }
      const pth = path(effs);
      const starts = D.items.filter(i => effs.get(i.id)!.va > 0).map(i => st[i.id].s);
      const y1 = starts.length ? Math.min(...starts) : D.Y0;
      const at = (y: number) => pth.find(p => p.y === y)!;
      const firstYear = Math.max(y1, D.y1 + 1);
      const first = (at(firstYear).g / at(firstYear - 1).g - 1) * 100;
      const yr5 = pth.find(p => p.y === D.Y0 - 1)!, yr9 = pth.find(p => p.y === D.Y1)!;
      const avg5 = ((yr9.g / yr5.g) ** (1 / (D.Y1 - D.Y0 + 1)) - 1) * 100;
      const cum = pth.filter(p => p.y >= D.Y0).reduce((a, p) => a + (p.g - p.trend), 0);
      return { effs, add, total, lo, hi, jobs, cost, jobsNat, jobsNatBase, pth, firstYear, first, avg5, end: yr9, cum, A: metrics(add), T: metrics(new Map()), pp: total / D.gvaEok * 100, ppLo: lo / D.gvaEok * 100, ppHi: hi / D.gvaEok * 100 };
    };

    let example = false; let exKind = '';
    const calc = () => {
      const st = read();
      const E = evaluate(st);
      for (const it of D.items) { const tr = row(it.id)!, e = E.effs.get(it.id)!;
        o('va', tr)!.textContent = n0(e.va) + (e.hi > e.lo + 0.5 ? ` (${n0(e.lo)}~${n0(e.hi)})` : '');
        o('pp', tr)!.textContent = fmt(e.va / D.gvaEok * 100, 2);
        o('jb', tr)!.textContent = n0(jobsOf(e.va));
        o('jbn', tr)!.textContent = e.jobsNat != null && e.va > 0 ? ` (전국 업종 계수로는 ${n0(e.jobsNat)}명, 참고)` : '';
        o('eff', tr)!.textContent = e.cost > 0 && e.va > 0 ? `투입 1억 원당 부가가치 ${fmt(e.va / e.cost, 2)}억 원 · 취업 ${fmt(jobsOf(e.va) / e.cost, 2)}명` : ''; }
      o('exbanner')!.hidden = !example; if (example) o('exbanner')!.textContent = `${exKind || '예시 값'}가 들어 있습니다 — 계산을 보여 주기 위한 값이지 목표·전망이 아닙니다. 값을 고치면 이 표시가 사라집니다.`;
      o('g1')!.textContent = `${fmt(E.first, 2)}%`;
      o('g1s')!.textContent = `${E.firstYear}년 · 추세 ${fmt(D.base, 2)}% ${sg(E.first - D.base)}%p · 모두 완성 때 ${sg(E.pp)}%p${E.ppHi > E.ppLo + 0.005 ? ` (범위 ${sg(E.ppLo)}~${sg(E.ppHi)})` : ''}`;
      o('g5')!.textContent = `${fmt(E.avg5, 2)}%`;
      o('g5s')!.textContent = `추세 ${fmt(D.base, 2)}% ${sg(E.avg5 - D.base)}%p`;
      o('lv')!.textContent = `${fmt(E.end.g / 10000, 1)}조`;
      o('lvs')!.textContent = `추세대로면 ${fmt(E.end.trend / 10000, 1)}조 · ${sg((E.end.g / E.end.trend - 1) * 100, 1)}% · ${D.Y0}~${D.Y1} 누적 +${n0(E.cum)}억 원`;
      o('jb')!.textContent = `${n0(E.jobs)}명`;
      o('jbs')!.textContent = (D.employed ? `대구 취업자 ${fmt(D.employed.thousand, 0)}천 명(${D.employed.year})의 ${fmt(E.jobs / (D.employed.thousand * 1000) * 100, 2)}%` + (E.cost > 0 ? ` · 투입 ${n0(E.cost)}억 원 → 1억 원당 ${fmt(E.total / E.cost, 2)}억 원·${fmt(E.jobs / E.cost, 2)}명` : '') : '')
        + (E.jobsNatBase > 0 ? ` · 공장 유치 항목을 전국 2020년 고용표 업종별 취업유발계수로 보면 ${n0(E.jobsNat)}명(대구 평균 계수로는 ${n0(E.jobsNatBase)}명, 참고)` : '');
      // 노동 공급 점검(2026-10-07): 취업 유발 − 실업자 = 필요 순유입, 최근 12개월 순이동과 견줌
      const lab = o('labor');
      if (lab) {
        if (E.jobs < 0.5) lab.textContent = '과제 값을 넣으면 취업 유발을 대구 실업자·최근 순이동과 견줍니다.';
        else {
          const un = D.unemployed ? D.unemployed.thousand * 1000 : null, nm = D.netMig;
          const need = un != null ? Math.max(0, E.jobs - un) : null;
          const s1 = `취업 유발 ${n0(E.jobs)}명` + (un != null ? (need! > 0 ? ` — 대구 실업자 ${n0(un)}명(${D.unemployed!.year}년)을 모두 채운다고 해도 ${n0(need!)}명은 대구 밖에서 와야 합니다(필요 순유입).` : ` — 대구 실업자 ${n0(un)}명(${D.unemployed!.year}년)보다 적어 대구 안에서 채워질 수 있는 규모입니다.`) : '');
          const s2 = nm ? ` 최근 12개월 순이동은 ${nm.persons < 0 ? '순유출 ' : '순유입 '}${n0(Math.abs(nm.persons))}명(${nm.from}~${nm.to})` + (need! > 0 ? (nm.persons < 0 ? `으로, 유출이 유입으로 바뀌고도 그만큼 더 들어와야 성립합니다.` : `이라 필요 순유입은 지금 유입의 ${fmt(need! / nm.persons, 1)}배입니다.`) : '입니다.') : '';
          lab.textContent = s1 + s2 + ' 실업자가 모두 그 일자리에 맞지는 않고 비경제활동인구 취업·기존 기업 이동도 있어 근사입니다.';
        }
      }
      const { A, T } = E;
      o('hi')!.textContent = `${fmt(A.high)}%`; o('hi2')!.textContent = `추세대로면 ${fmt(T.high)}%${D.highNat != null ? ` · 전국 ${fmt(D.highNat)}%` : ''}`;
      o('hh')!.textContent = `${Math.round(A.hhi)}`; o('hh2')!.textContent = `추세대로면 ${Math.round(T.hhi)}${D.hhiAvg != null ? ` · 17개 시도 평균 ${D.hhiAvg}` : ''}`;
      o('sc')!.textContent = A.sci.toFixed(4); o('sc2')!.textContent = `추세대로면 ${T.sci.toFixed(4)}${D.scih != null ? ` · 대구 10년 평균 ${D.scih.toFixed(4)}` : ''}${D.scihAvg != null ? ` · 17개 시도 평균 ${D.scihAvg.toFixed(4)}` : ''}`;
      const H0 = D.rows.filter(r => r.high).reduce((a, r) => a + now.get(r.key)! ** 2, 0);
      o('hq')!.textContent = `${Math.round(A.hq)}`; o('hq2')!.textContent = `추세대로면 ${Math.round(T.hq)} · 지금 ${Math.round(H0)} — 산업집중도 가운데 고부가 3부문 몫, ${fmt(A.hq / A.hhi * 100)}%`;
      const t = A.hhi / 100, G = D.rows.reduce((a, r) => a + r.va, 0);
      const semi = D.items.find(i => i.id === 'semi');
      o('thr')!.innerHTML = D.rows.filter(r => r.high).map(r => {
        const s0 = now.get(r.key)!, s1 = A.nx.get(r.key)!;
        const need = Math.max(0, (t / 100 * G - r.va) / (1 - t / 100));
        const eq = r.key.startsWith('전기 전자') && semi?.ratio ? ` · 전자부품 공장 연 매출로 약 ${fmt(need / semi.ratio / 10000, 1)}조 원` : '';
        return `<li><b>${r.name}</b> 비중 ${fmt(s0)}% → ${fmt(s1)}% (문턱 ${fmt(t)}%) — ${s1 > t ? '<span class="gp-ok">집중도를 올리는 쪽</span>' : `문턱까지 부가가치 ${n0(need)}억 원(지금의 ${fmt(need / r.va, 1)}배${eq}) 더`}</li>`;
      }).join('');
      const dl = Math.log(A.hhi / T.hhi) * 100, Pn = D.panel, parts: string[] = [];
      const dq = A.hq - T.hq;
      if (dq > 0.5) parts.push(A.hhi > T.hhi
        ? `고부가 부문을 축으로 산업집중도가 오르는 조합입니다(고부가 집중도 ${Math.round(T.hq)} → ${Math.round(A.hq)}, 산업집중도 ${Math.round(T.hhi)} → ${Math.round(A.hhi)}) — 리포트 시사점의 '고부가 부문 중심 집적'과 같은 방향입니다.`
        : `고부가 비중은 오르지만(고부가 집중도 ${Math.round(T.hq)} → ${Math.round(A.hq)}) 전체 산업집중도는 ${Math.round(T.hhi)} → ${Math.round(A.hhi)}로 내려갑니다. 고부가 부문이 아직 작아서(문턱 ${fmt(t)}% 아래) 키울수록 분산되는 단계입니다 — 위 문턱을 넘는 고부가 부문이 생겨야 고부가 중심으로 집중도가 오릅니다.`);
      if (Math.abs(dl) >= 0.01 && Pn.grdp != null) { const se = Pn.grdpSe ?? 0; parts.push(`산업집중도가 추세보다 ${sg(dl, 2)}% 달라집니다. 리포트 패널 추정으로는 집중도 1% 상승이 실질 GRDP ${fmt(Pn.grdp, 2)}%p(표준오차 ${fmt(se, 2)}, 범위 ${fmt(Pn.grdp - 2 * se, 2)}~${fmt(Pn.grdp + 2 * se, 2)})${Pn.prod != null ? `·노동생산성 ${fmt(Pn.prod, 2)}%p` : ''}${Pn.exp != null ? `·수출 ${fmt(Pn.exp, 2)}%p` : ''} 높은 성장과 함께 나타났으므로, 이만큼의 집중도 변화는 성장률 ${sg(Pn.grdp * dl)}%p(범위 ${sg((Pn.grdp - 2 * se) * dl)}~${sg((Pn.grdp + 2 * se) * dl)})와 함께 움직인 크기입니다(연관, 위 성장률에 더하지 않음).`); }
      if (D.scihAvg != null && A.sci > T.sci + 0.00005) parts.push(`고부가 변화속도 ${A.sci.toFixed(4)}는 17개 시도 평균(${D.scihAvg.toFixed(4)})${A.sci.toFixed(4) === D.scihAvg.toFixed(4) ? '과 같은 수준입니다' : A.sci > D.scihAvg ? '을 넘습니다' : '에 못 미칩니다'} — 리포트에서 고부가 변화속도가 빠른 지역은 성장률이 대체로 높았습니다(상관계수 0.43).`);
      if (Math.abs(dl) >= 0.01) parts.push(`산업집중도는 지금 비중이 ${fmt(T0 / 100, 1)}%(집중도 ÷ 100)보다 큰 부문이 커질 때 오르고 작은 부문이 커지면 내려갑니다 — 큰 부문: ${BIG}.`);
      o('rep')!.textContent = parts.join(' ') || '과제 값을 넣으면 리포트 지표로 본 변화가 여기에 나옵니다.';
      const tb = document.querySelector('#gp-path tbody');
      if (tb) tb.innerHTML = E.pth.filter(p => p.y >= D.Y0).map(p => { const prev = E.pth.find(q => q.y === p.y - 1)!; const rp = (p.g / prev.g - 1) * 100, rt = (p.trend / prev.trend - 1) * 100;
        return `<tr><th scope="row">${p.y}</th><td class="n">${fmt(rt, 2)}</td><td class="n">${fmt(rp, 2)}</td><td class="n">${sg(rp - rt)}</td><td class="n">${fmt(p.g / 10000, 1)}</td><td class="n">${n0(p.g - p.trend)}</td></tr>`; }).join('');
      compare(E);
    };
    // ── 시나리오 A·B 저장·비교·링크 ──
    const KEY = 'gp-scn';
    const load = (): Record<string, St> => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
    const compare = (E: ReturnType<typeof evaluate>) => {
      const saved = load();
      const cols: [string, ReturnType<typeof evaluate> | null][] = [['추세', null], ['A', saved.A ? evaluate(saved.A) : null], ['B', saved.B ? evaluate(saved.B) : null], ['지금', E]];
      const trendEnd = E.pth.find(p => p.y === D.Y1)!.trend;
      const rowsC: [string, (x: ReturnType<typeof evaluate> | null) => string][] = [
        ['첫 해 성장률(%)', x => x ? fmt(x.first, 2) : fmt(D.base, 2)], [`${D.Y0}~${D.Y1} 연평균(%)`, x => x ? fmt(x.avg5, 2) : fmt(D.base, 2)],
        [`${D.Y1}년 GRDP(조 원)`, x => fmt((x ? x.end.g : trendEnd) / 10000, 1)], ['완성 때 부가가치(억 원)', x => x ? n0(x.total) : '0'], ['취업 유발(명)', x => x ? n0(x.jobs) : '0'],
        ['고부가 3부문 비중(%)', x => fmt((x ? x.A : E.T).high)], ['산업집중도', x => String(Math.round((x ? x.A : E.T).hhi))], ['고부가 집중도', x => String(Math.round((x ? x.A : E.T).hq))]];
      const tb = o('cmp'); if (tb) tb.innerHTML = rowsC.map(([n, f]) => `<tr><th scope="row">${n}</th>${cols.map(([, x], i) => `<td class="n">${i > 0 && i < 3 && !x ? '—' : f(x)}</td>`).join('')}</tr>`).join('');
    };
    const msg = (t: string) => { const m = o('scnmsg'); if (m) { m.textContent = t; setTimeout(() => { if (m.textContent === t) m.textContent = ''; }, 4000); } };
    document.querySelectorAll<HTMLButtonElement>('#gp [data-scn]').forEach(bt => bt.addEventListener('click', async () => {
      const a = bt.dataset.scn;
      if (a === 'saveA' || a === 'saveB') { const s = load(); s[a.slice(-1)] = read(); try { localStorage.setItem(KEY, JSON.stringify(s)); msg(`지금 값을 ${a.slice(-1)} 로 기억했습니다`); } catch { msg('저장할 수 없습니다'); } calc(); }
      if (a === 'loadA' || a === 'loadB') { const s = load(); const st = s[a.slice(-1)]; if (!st) { msg(`${a.slice(-1)} 로 기억해 둔 값이 없습니다`); } else { write(st); msg(`${a.slice(-1)} 를 불러왔습니다`); calc(); } }
      if (a === 'link') { const u = new URL(location.href); u.hash = 'gp=' + encodeURIComponent(JSON.stringify(read())); try { await navigator.clipboard.writeText(u.toString()); msg('링크를 복사했습니다'); } catch { history.replaceState(null, '', u.toString()); msg('주소창의 링크를 복사하세요'); } }
      if (a === 'pdf') { try { await pdf(); } catch (e) { msg('PDF 를 만들지 못했습니다'); console.error(e); } }
    }));
    const pdf = async () => {
      const { buildPdf, downloadPdf, p, table, today } = await import('../scripts/pdf');
      const st = read(), E = evaluate(st);
      const inRows = D.items.filter(i => E.effs.get(i.id)!.va > 0).map(i => { const x = st[i.id], e = E.effs.get(i.id)!; return [i.task, i.kind === 'stop' ? '감소 멈춤' : `${fmt(x.v, 0)} ${i.unit}${i.kind === 'people' ? ` × 1인 ${n0(x.p)}원` : ''}`, `${x.s}년`, `${x.n}%`, x.c ? n0(x.c) : '—', n0(e.va), fmt(e.va / D.gvaEok * 100, 2), n0(jobsOf(e.va)) + (e.jobsNat != null ? ` (전국 ${n0(e.jobsNat)})` : '')]; });
      const blocks = [
        p('kicker', ['성장 계산기  ·  정책 과제 시나리오 요약', 'kicker']), p('title', [`대구 GRDP 정책 과제 시나리오 (${today()})`, 'title']),
        p('body', [`출발: ${D.y1 - 9}→${D.y1}년 대구 실질 GRDP 연평균 ${fmt(D.base, 2)}%, ${D.y1}년 명목 GRDP ${fmt(D.gdpEok / 10000)}조 원. 가정에 따른 계산이며 전망·평가가 아닙니다.${example ? ' 예시 값입니다(목표 아님).' : ''}`, 'body']),
        p('h3', ['입력', 'h3']),
        table([['과제', '넣은 값', '시작', '순증', '투입(억 원)', '부가가치(억 원)', '성장률(%p)', '취업(명)'], ...(inRows.length ? inRows : [['(입력 없음)', '', '', '', '', '', '', '']])], { widths: [14000, 12000, 4500, 4000, 5500, 6500, 5500, 5188] }),
        p('h3', ['결과', 'h3']),
        table([['지표', '추세', '시나리오'], ['첫 해 성장률(%)', fmt(D.base, 2), `${fmt(E.first, 2)} (${E.firstYear}년)`], [`${D.Y0}~${D.Y1}년 연평균(%)`, fmt(D.base, 2), fmt(E.avg5, 2)],
          [`${D.Y1}년 GRDP(조 원, ${D.y1}년 가격)`, fmt(E.end.trend / 10000, 1), fmt(E.end.g / 10000, 1)], ['완성 때 부가가치 증가(억 원)', '0', `${n0(E.total)}${E.hi > E.lo + 0.5 ? ` (범위 ${n0(E.lo)}~${n0(E.hi)})` : ''}`],
          ['취업 유발(명, 직·간접 근사)', '0', n0(E.jobs)], ['필요 순유입(명) = 취업 유발 − 대구 실업자', '0', D.unemployed ? `${n0(Math.max(0, E.jobs - D.unemployed.thousand * 1000))} (실업자 ${n0(D.unemployed.thousand * 1000)}명, ${D.unemployed.year}년${D.netMig ? `; 최근 12개월 순이동 ${n0(D.netMig.persons)}명` : ''})` : '—'], ...(E.jobsNatBase > 0 ? [['공장 유치 — 전국 업종 계수로 본 취업(명, 참고)', '0', `${n0(E.jobsNat)} (대구 평균 계수 ${n0(E.jobsNatBase)})`]] : []), ['고부가 3부문 비중(%)', fmt(E.T.high), fmt(E.A.high)], ['산업집중도', String(Math.round(E.T.hhi)), String(Math.round(E.A.hhi))], ['고부가 집중도', String(Math.round(E.T.hq)), String(Math.round(E.A.hq))]], { widths: [22000, 17000, 18188] }),
        p('h3', ['계산 방법', 'h3']),
        p('note', [`성장률 몫 = 부가가치 증가 ÷ 명목 총부가가치(순생산물세는 부가가치에 비례해 함께 는다고 봄, 모든 계산기 공통). 업종 성장 = 부문 부가가치 × 추가 성장(해마다 쌓임). 기업 유치 = 연 매출 × 광업·제조업조사 대구 업종 부가가치율(직접분) + 업종별 대구 지역내 유발계수가 있으면 간접분(서비스 기업·시설은 대구 평균 부가가치유발계수). 사람·지출 = 지출 × 대구 부가가치유발계수 ${D.k.toFixed(3)}(한국은행 2020 지역산업연관표, 수입품 몫 제외). 취업 = 부가가치 ÷ 계수 ÷ 10억 원 × ${D.empIn ?? '—'}명(대구 평균). 괄호의 '전국'은 공장 유치 항목을 전국 2020년 고용표 업종별 취업유발계수로 본 참고 값(대구 업종별 값은 공개 자료에 없음)이며 합계에 더하지 않음. 순증 비율은 사용자 입력. 구조 지표는 모두 완성된 해 기준이며 리포트 패널 계수는 연관으로만 봅니다.`, 'note']),
        p('src', [`자료: 국가데이터처 지역소득(KOSIS) · 한국은행 2020년 지역산업연관표 · 광업·제조업조사 · 한국관광 데이터랩 · 국민건강보험공단 지역별 의료이용통계 · 대구 열린시장실 주요 추진과제. 계산: daitda.co.kr/growth/`, 'src']),
      ];
      downloadPdf(`성장계산기 정책과제 시나리오 ${today()}.pdf`, await buildPdf(blocks, '성장 계산기 — 정책 과제 시나리오'));
    };
    document.querySelectorAll<HTMLButtonElement>('#gp [data-fill]').forEach(bt => bt.addEventListener('click', () => {
      const f = bt.dataset.fill;
      for (const it of D.items) { const inp = row(it.id)?.querySelector<HTMLInputElement>('[data-in="v"]'); if (!inp) continue;
        if (it.kind === 'stop') inp.checked = f === 'ex' && it.ex > 0; else inp.value = String(f === 'ex' ? it.ex : f === 'hx' ? it.hx : 0); }
      example = f !== 'zero'; exKind = f === 'hx' ? '고부가 3부문(전기·전자·정밀기기, 정보통신, 금융·보험)에 닿는 과제에만 값을 넣은 예시' : f === 'ex' ? '모든 과제에 값을 넣은 예시' : ''; calc();
    }));
    document.querySelectorAll<HTMLInputElement>('#gp .gp-item input, #gp .gp-item select').forEach(i => i.addEventListener('input', () => { example = false; calc(); }));
    const m = location.hash.match(/^#gp=(.+)$/);
    if (m) { try { write(JSON.parse(decodeURIComponent(m[1]))); } catch { /* 무시 */ } }
    calc();
  }
</script>
<style>
  #gp { margin-top: var(--s4); }
  #gp h2 { margin-bottom: 4px; }
  .gp-res { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 10px 14px; margin: var(--s2) 0; }
  .gp-ex { margin: 0 0 8px; padding: 6px 10px; border-radius: 6px; background: var(--warn-bg, #fff4d6); color: var(--ink); font-size: var(--small); font-weight: 600; }
  .gp-top { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .gp-k { display: flex; flex-direction: column; gap: 1px; }
  .gp-k b { font-size: var(--num-xl, 2rem); font-weight: 700; color: var(--primary); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .gp-k:not(:first-child) b { font-size: 1.4rem; }
  .gp-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 8px; }
  .gp-tiles div { display: flex; flex-direction: column; gap: 1px; border-top: 1px solid var(--line); padding-top: 6px; }
  .tl { font-size: var(--tiny); color: var(--muted); }
  .gp-tiles b { font-size: 1.1rem; font-variant-numeric: tabular-nums; }
  .gp-rep { margin: 8px 0 0; font-size: var(--small); }
  .gp-labor { margin-top: 8px; border-top: 1px solid var(--line); padding-top: 6px; }
  .gp-labor-txt { margin: 2px 0 0; font-size: var(--small); }
  .gp-th { margin-top: 8px; font-size: var(--small); border-top: 1px solid var(--line); padding-top: 6px; }
  .gp-th ul { margin: 4px 0 0; padding-left: 1.1em; }
  .gp-th :global(.gp-ok) { color: var(--primary); font-weight: 700; }
  .gp-btns { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin: 4px 0 var(--s2); }
  .gp-btns .btn { min-height: 36px; font-size: var(--small); }
  .gp-sep { width: 1px; height: 24px; background: var(--line); }
  .gp-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 8px; }
  .gp-item { border: 1px solid var(--line); border-radius: var(--radius); padding: 8px 12px; display: flex; flex-direction: column; gap: 4px; background: var(--bg); }
  .gp-h { display: flex; gap: 6px; align-items: baseline; }
  .gp-no { flex: none; font-size: var(--tiny); color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; }
  .gp-in { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .gp-in label { display: flex; align-items: center; gap: 4px; font-size: var(--small); }
  .gp-in2 label { font-size: var(--tiny); }
  .gp-in input[type="number"], .gp-in select { padding: 3px 6px; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); color: var(--ink); font: inherit; }
  .gp-in input[type="number"] { width: 7.5em; text-align: right; }
  .gp-in2 input[type="number"] { width: 5.5em; }
  .gp-r { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 8px; border-top: 1px solid var(--line); padding-top: 4px; font-size: var(--small); }
  .gp-r b { font-variant-numeric: tabular-nums; }
  .gp-h3 { font-size: 1.02rem; margin: var(--s3) 0 6px; }
  #gp-path { min-width: 560px; }
  .gp-notes { padding-left: 1.1em; margin: 6px 0; }
  @media (max-width: 760px) { .gp-top, .gp-tiles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .gp-top, .gp-tiles { grid-template-columns: 1fr; } .gp-k b { font-size: 1.6rem; } }
</style>
