---
import { structureCalc, tourismOutsider } from '../lib/grdp';
/** 산업구조와 성장 계산기(/growth/, 운영자 지시 2026-10-05: 산업구조지수 리포트와 논리적으로 같은 계산기, 단계식은 보기 어려워 한 화면으로).
 *  정의는 리포트와 같다(src/lib/grdp.ts structureCalc). 업종 성장률 가정 → ① 성장률(리포트의 2015→2024 대구 연평균에서 출발, 변화분 = 비중 × (가정 − 업종 연평균))
 *  ② 다음 해 산업구조 지표(고부가 3부문 비중·산업집중도·고부가 변화속도) ③ 목표에 닿는 길별 필요 성장률·금액. 전망·평가가 아니라 가정에 따른 계산. */
const S = structureCalc();
const TOUR = tourismOutsider();
const f1 = (v: number) => v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const sg2 = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(2);
const data = S ? { ...S, io: undefined, backtest: undefined, tour: TOUR ? { eok: TOUR.eok, year: TOUR.year } : null } : null;
const GROUPS: [string, string][] = [['high', '고부가 3부문'], ['mfg', '제조업(고부가 제외)'], ['spec', '특화 부문(입지계수 1 이상, 제조업 제외)'], ['rest', '그 밖의 부문']];
const groupOf = (r: { high: boolean; mfg: boolean; spec: boolean }) => r.high ? 'high' : r.mfg ? 'mfg' : r.spec ? 'spec' : 'rest';
---
{S && data && (
<section id="gs">
  <details class="gs-more">
    <summary>업종별 가정 넣어 보기 — 25개 부문·시나리오 단추·기준 기간 (결과: 성장률·고부가 비중·산업집중도)</summary>
  <div class="gs-sticky" aria-live="polite">
    <div class="gs-main">
      <div class="gs-big"><span id="gsg">{S.base.toFixed(2)}</span><small>%</small></div>
      <div class="gs-txt"><div class="gs-lab">가정에 따른 대구 실질 GRDP 성장률(한 해)</div><div class="meta" id="gss"></div></div>
    </div>
    <div class="gs-tiles">
      <div><span class="tl">고부가 3부문 비중(다음 해)</span><b id="gsh">{f1(S.high)}%</b><span class="tiny muted">지금 {f1(S.high)}% · 전국 {S.highNat != null ? f1(S.highNat) : '—'}%</span></div>
      <div><span class="tl">산업집중도(다음 해)</span><b id="gsc">{S.hhi}</b><span class="tiny muted">지금 {S.hhi} · 17개 시도 평균 {S.hhiAvg ?? '—'}</span></div>
      <div><span class="tl">고부가 비중 전국 수준까지</span><b id="gsv">—</b><span class="tiny muted">같은 성장률이 이어질 때</span></div>
    </div>
  </div>

  <details class="gs-def" open>
    <summary>고부가 3부문이란 — 한국은행 자료의 정의와 산업군</summary>
    <p class="meta">한국은행 전북본부 「지역 산업구조 특성이 경제성장에 미치는 영향 — 산업구조지수를 중심으로」(조사연구보고서, 2026-09-08)는 고부가 산업을 <b>OECD 분류(기술집약 제조업·지식집약 서비스업)를 지역소득 경제활동 부문에 맞춰</b> 아래 세 부문으로 정의합니다. 이 사이트의 산업구조지수 리포트와 이 계산기도 같은 세 부문을 씁니다(OECD 분류의 의약품·항공우주 등은 지역소득 부문에서 따로 떼어낼 수 없어 들어가지 않음).</p>
    <div class="scroll-x"><table class="data-table compact" data-title="고부가 3부문 정의(한국은행 자료)와 대구 비중">
      <thead><tr><th>고부가 부문(지역소득 경제활동 부문)</th><th>포함 산업(한국표준산업분류)</th><th class="n">대구 비중(%, {S.y1}년)</th><th class="n">입지계수</th></tr></thead>
      <tbody>{[
        ['전기 전자 및 정밀기기 제조업', '전자부품·컴퓨터·영상·음향·통신장비(C26), 의료·정밀·광학기기·시계(C27), 전기장비(C28)'],
        ['정보통신업', '출판, 영상·방송, 통신, 컴퓨터 프로그래밍·시스템 통합, 정보서비스(J58~J63)'],
        ['금융 및 보험업', '금융업, 보험·연금업, 금융·보험 관련 서비스업(K64~K66)'],
      ].map(([k, ksic]) => { const r = S.rows.find(x => x.key === k); return (<tr><th scope="row">{r?.name ?? k}</th><td class="wrap">{ksic}</td><td class="n">{r ? f1(r.share) : '—'}</td><td class="n">{r ? r.lq.toFixed(2) : '—'}</td></tr>); })}</tbody>
    </table></div>
    <p class="meta">비중은 25개 부문 명목 총부가가치 합 대비(리포트 정의), 입지계수는 전국 대비(1 이상이면 특화). 같은 자료의 결론은 '고부가 핵심 특화산업으로의 자원 집중'이며, 이 계산기의 고부가 변화속도·고부가 집중도는 그 정의로 계산한 값입니다. 자료의 수치는 전북 분석이 중심이라 대구 값은 KOSIS 지역소득에서 이 사이트가 계산했습니다.</p>
  </details>

  <p class="meta">출발점은 <a href={S.report}>산업구조지수 리포트</a>와 같은 {S.y0}→{S.y1}년 대구 실질 GRDP 연평균 성장률 {S.base.toFixed(2)}%입니다(전국 {S.natGrowth.toFixed(2)}%{S.metro6 != null && <>, 6개 광역시 평균 {S.metro6.toFixed(2)}%</>}).{S.perCapita && <> 1인당으로는 같은 기간 연평균 {S.perCapita.pcCagr.toFixed(2)}%(주민등록 인구 연평균 {S.perCapita.popCagr.toFixed(2)}%, {S.y0}년 {Math.round(S.perCapita.pop0 / 10000)}만 명 → {S.y1}년 {Math.round(S.perCapita.pop1 / 10000)}만 명) — 과거 참고 숫자이며, 아래 계산은 미래 인구를 전망하지 않습니다.</>} 업종 성장률을 바꾸면 성장률과 다음 해 산업구조 지표가 함께 바뀝니다. 리포트처럼 산업집중도는 업종 비중 제곱합, 고부가 3부문은 전기·전자·정밀기기·정보통신·금융보험입니다.</p>

  <div class="gs-per"><label>기준 기간 <select id="gsper" aria-label="기준 기간">{S.periods.map((pd, i) => <option value={i}>{pd.label} · 대구 {pd.base.toFixed(2)}%</option>)}</select></label><span class="tiny muted" id="gspernote"></span></div>
  <div class="gs-presets" role="group" aria-label="시나리오">
    <button type="button" class="btn secondary" data-p="trend">추세 그대로</button>
    <button type="button" class="btn secondary" data-p="stop">감소 업종 멈춤</button>
    <button type="button" class="btn secondary" data-p="nat">전국보다 낮은 업종 → 전국 수준</button>
    <button type="button" class="btn secondary" data-p="high3">고부가 3부문 → 상위 3개 시도 수준</button>
    <button type="button" class="btn secondary" data-p="mfg3">제조업 → 상위 3개 시도 수준</button>
    <button type="button" class="btn secondary" data-p="all3">모든 업종 → 상위 3개 시도 수준</button>
  </div>
  <p class="tiny muted">단추는 추세에서 새로 시작합니다. 단추 아래 숫자는 그 시나리오의 성장률입니다. '상위 3개 시도'는 17개 시도 가운데 그 업종 10년 성장률이 높았던 세 곳의 평균으로, 비교 기준이지 순위·평가가 아닙니다.</p>


  <details class="stat-details" open>
    <summary>25개 부문 가정 칸</summary>
    {GROUPS.map(([g, title]) => { const rs = S.rows.filter(r => groupOf(r) === g); return rs.length > 0 && (<>
      <h4 class="gs-gh">{title} <span class="meta" data-sum={g}></span></h4>
      <div class="scroll-x"><table class="compact gs-tab">
        <thead><tr><th>업종 <span class="tiny">(비중 · 입지계수)</span></th><th class="n">10년 성장(%)</th><th class="n">가정(%)</th><th class="n">변화(%p)</th></tr></thead>
        <tbody>{rs.map(r => (
          <tr><th scope="row">{r.name}<div class="tiny muted">{f1(r.share)}% · LQ {r.lq.toFixed(2)}</div></th>
            <td class="n">{f1(r.g)}<div class="tiny muted">전국 {f1(r.gn)}<br />상위3 {f1(r.t3)}</div></td>
            <td class="n"><input type="number" step="0.5" value={r.g.toFixed(1)} data-k={r.key} inputmode="decimal" aria-label={`${r.name} 가정 성장률`} /></td>
            <td class="n" data-d={r.key}>0.0</td></tr>))}</tbody>
      </table></div></>); })}
    {S.k != null && (<>
      <h4 class="gs-gh">대구 밖에서 들어오는 돈 · 새 지출 <span class="meta" data-sum="dem"></span></h4>
      <div class="gs-dem">
        {TOUR && <label>외지인 관광소비 증가 <input id="gstour" type="number" step="1" value="0" inputmode="decimal" /> % <span class="tiny muted">{TOUR.year}년 {(TOUR.eok / 10000).toFixed(2)}조 원</span></label>}
        <label>새로 늘어나는 지출 <input id="gsspend" type="number" step="500" value="0" inputmode="decimal" /> 억 원</label>
      </div>
      <p class="tiny muted">금액 × 대구 부가가치유발계수 {S.k.toFixed(3)} ÷ 명목 총부가가치. 계수는 한국은행 2020 지역산업연관표의 대구 안 부가가치유발계수 {S.io?.vaIn}(국산품 최종수요 1단위 기준, 58쪽)에 최종수요 가운데 수입품으로 바로 사는 몫 {S.io?.importShare}%(표 IV-7, 55쪽)를 뺀 값이며, 중간재 수입 누출은 계수 안에 이미 들어 있습니다. 업종 성장률을 이미 올렸다면 겹쳐 셀 수 있습니다.</p>
    </>)}
  </details>

  <div class="gs-break"><h3 class="gs-h">무엇이 얼마나 바꾸나</h3><ul id="gslist"></ul></div>
  <p class="meta" id="gsref"></p>

  </details>
  <script type="application/json" id="gs-data" set:html={JSON.stringify(data)} />
</section>)}
<script>
  type R = { key: string; name: string; share: number; w: number; va: number; g: number; gn: number; t3: number; gmax: number; high: boolean; spec: boolean; mfg: boolean };
  const el = document.getElementById('gs-data');
  if (el) {
    const D = JSON.parse(el.textContent || '{}') as { base: number; rows: R[]; gdpEok: number; gvaEok: number; k: number | null; tour: { eok: number; year: string } | null; hhiCoef: number | null; high: number; highNat: number | null; scih: number | null;
      periods: { a: number; b: number; label: string; base: number; nat: number; g: Record<string, { g: number; gn: number; t3: number; gmax: number }> }[] };
    const BASE0 = D.base, G0 = new Map(D.rows.map(r => [r.key, { g: r.g, gn: r.gn, t3: r.t3, gmax: r.gmax }]));
    const fmt = (v: number, d = 1) => v.toLocaleString('ko-KR', { minimumFractionDigits: d, maximumFractionDigits: d });
    const sg = (v: number, d = 1) => (v > 0.0499 ? '+' : v < -0.0499 ? '−' : '') + fmt(Math.abs(v), d);
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
    const inputs = new Map<string, HTMLInputElement>();
    document.querySelectorAll<HTMLInputElement>('#gs input[data-k]').forEach(i => inputs.set(i.dataset.k!, i));
    const grp = (r: R) => r.high ? 'high' : r.mfg ? 'mfg' : r.spec ? 'spec' : 'rest';
    const S0 = D.rows.reduce((a, r) => a + r.share, 0);
    // 지표: 다음 해 비중(%) → 고부가 비중·HHI·변화속도
    const next = (gs: number[]) => { const w = D.rows.map((r, i) => r.share * (1 + gs[i] / 100)); const t = w.reduce((a, b) => a + b, 0); return w.map(x => x / t * S0); };
    const ind = (gs: number[]) => {
      const s1 = next(gs), s0 = D.rows.map(r => r.share);
      return { high: D.rows.reduce((a, r, i) => a + (r.high ? s1[i] : 0), 0) / S0 * 100, hhi: s1.reduce((a, s) => a + (s / S0 * 100) ** 2, 0),
        scih: D.rows.reduce((a, r, i) => a + (r.high ? Math.abs(s1[i] - s0[i]) : 0), 0) / S0 / 2 };
    };
    // 성장 기여 가중치 w = 총부가가치 대비 비중(합 100%, 순생산물세는 부가가치에 비례). 모든 계산기 공통 기준: ΔVA ÷ 명목 총부가가치(2026-10-07)
    const growth = (gs: number[]) => D.base + D.rows.reduce((a, r, i) => a + r.w / 100 * (gs[i] - r.g), 0);
    const trend = D.rows.map(r => r.g);
    const T0 = ind(trend);
    const P: Record<string, (r: R) => number> = {
      trend: r => r.g, stop: r => Math.max(r.g, 0), nat: r => Math.max(r.g, r.gn),
      high3: r => r.high ? Math.max(r.g, r.t3) : r.g, mfg3: r => r.mfg ? Math.max(r.g, r.t3) : r.g, all3: r => Math.max(r.g, r.t3),
    };
    const labelPresets = () => document.querySelectorAll<HTMLButtonElement>('#gs .gs-presets button').forEach(b => {
      const f = P[b.dataset.p!]; if (!f) return;
      const gv = growth(D.rows.map(f)); b.innerHTML = `${b.dataset.label}<span class="pv">${Math.abs(gv - D.base) < 0.005 ? fmt(D.base, 2) : fmt(gv)}%</span>`;
    });
    document.querySelectorAll<HTMLButtonElement>('#gs .gs-presets button').forEach(b => {
      b.dataset.label = b.textContent ?? '';
      const f = P[b.dataset.p!]; if (!f) return;
      b.addEventListener('click', () => { D.rows.forEach(r => { const i = inputs.get(r.key); if (i) i.value = f(r).toFixed(1); }); calc(); });
    });
    labelPresets();
    // 기준 기간 바꾸기: 업종·전체 성장률을 그 기간 값으로 바꾸고 칸을 추세로 되돌린다(리포트 기간은 리포트 값)
    const per = document.getElementById('gsper') as HTMLSelectElement | null;
    per?.addEventListener('change', () => {
      const i = Number(per.value);
      const pd = D.periods[i];
      if (i === 0 || !pd) { D.base = BASE0; D.rows.forEach(r => Object.assign(r, G0.get(r.key))); }
      else { D.base = pd.base; D.rows.forEach(r => { const x = pd.g[r.key]; if (x) { r.g = x.g; r.gn = x.gn; r.t3 = x.t3; r.gmax = x.gmax; } }); }
      D.rows.forEach(r => { const x = inputs.get(r.key); if (x) x.value = r.g.toFixed(1); const c = x?.closest('tr')?.querySelector('td'); if (c) c.innerHTML = `${fmt(r.g)}<div class="tiny muted">전국 ${fmt(r.gn)}<br />상위3 ${fmt(r.t3)}</div>`; });
      const note = document.getElementById('gspernote'); if (note) note.textContent = i === 0 ? '' : `기준 기간을 ${pd.label}로 바꿨습니다: 대구 연평균 ${fmt(pd.base, 2)}%, 전국 ${fmt(pd.nat, 2)}%. 비중·구조 지표는 2024년 값 그대로이고, 해설·리포트는 2015→2024 기준입니다.`;
      labelPresets(); calc();
    });
    const demand = (eok: number) => D.k ? eok * D.k / D.gvaEok * 100 : 0;   // 분모는 총부가가치(공통 기준)
    const calc = () => {
      const T = Number($('gst')?.value) || 0;
      // 칸의 값이 추세를 소수 한 자리로 적은 값 그대로면 추세(반올림 오차가 성장률을 흔들지 않게)
      const gs = D.rows.map(r => { const t = inputs.get(r.key)?.value ?? ''; const v = Number(t); return t === r.g.toFixed(1) || !Number.isFinite(v) ? r.g : v; });
      const parts: { name: string; d: number }[] = [], sums: Record<string, number> = {};
      D.rows.forEach((r, i) => {
        const d = r.w / 100 * (gs[i] - r.g);
        const c = document.querySelector(`[data-d="${CSS.escape(r.key)}"]`); if (c) c.textContent = Math.abs(d) < 0.05 ? (Math.abs(d) < 0.005 ? '0.0' : sg(d, 2)) : sg(d);
        sums[grp(r)] = (sums[grp(r)] ?? 0) + d;
        if (Math.abs(d) >= 0.005) parts.push({ name: r.name, d });
      });
      const tr = Number($('gstour')?.value) || 0, sp = Number($('gsspend')?.value) || 0;
      const td = D.tour ? demand(D.tour.eok * tr / 100) : 0, sd = demand(sp);
      if (Math.abs(td) >= 0.005) parts.push({ name: `외지인 관광소비 ${sg(tr, 0)}%`, d: td });
      if (Math.abs(sd) >= 0.005) parts.push({ name: `새 지출 ${fmt(sp, 0)}억 원`, d: sd });
      sums.dem = td + sd;
      document.querySelectorAll<HTMLElement>('#gs [data-sum]').forEach(s => { const v = sums[s.dataset.sum!] ?? 0; s.textContent = Math.abs(v) < 0.05 ? '' : `${sg(v)}%p`; });
      const g = growth(gs) + td + sd, I = ind(gs);
      const o = document.getElementById('gsg'); if (o) o.textContent = parts.length ? fmt(g) : fmt(D.base, 2);
      const s = document.getElementById('gss'); if (s) s.textContent = `추세 ${fmt(D.base, 2)}%${parts.length ? ` ${sg(g - D.base)}%p` : ''} · ` + (T - g > 0.05 ? `목표 ${fmt(T)}%까지 ${fmt(T - g)}%p` : `목표 ${fmt(T)}% 이상`);
      const h = document.getElementById('gsh'); if (h) h.textContent = `${fmt(I.high)}%`;
      const c = document.getElementById('gsc'); if (c) c.textContent = Math.round(I.hhi).toLocaleString('ko-KR');
      // 고부가 비중이 전국 수준에 닿는 해(같은 성장률이 이어진다고 할 때)
      let yrs = '', cur = gs.slice(), sh = D.rows.map(r => r.share);
      if (D.highNat != null) { for (let y = 1; y <= 60; y++) { const w = sh.map((x, i) => x * (1 + cur[i] / 100)); const t = w.reduce((a, b) => a + b, 0); sh = w.map(x => x / t * S0); const hs = D.rows.reduce((a, r, i) => a + (r.high ? sh[i] : 0), 0) / S0 * 100; if (hs >= D.highNat) { yrs = `${y}년`; break; } } }
      const vv = document.getElementById('gsv'); if (vv) vv.textContent = yrs || '60년 넘음';
      const list = document.getElementById('gslist');
      if (list) {
        const all = [{ name: `추세(2015→2024 연평균)`, d: D.base }, ...parts.sort((a, b) => b.d - a.d)];
        const mx = Math.max(...all.map(p => Math.abs(p.d)), 0.01);
        list.innerHTML = all.slice(0, 14).map(p => `<li><span class="nm">${p.name}</span><span class="bw"><span class="b${p.d < 0 ? ' neg' : ''}" style="width:${Math.abs(p.d) / mx * 100}%"></span></span><span class="v">${sg(p.d)}%p</span></li>`).join('')
          + (parts.length ? '' : '<li class="meta">업종 가정을 바꾸거나 위 시나리오 단추를 누르세요.</li>');
      }
      const ref = document.getElementById('gsref');
      if (ref) {
        const dl = Math.log(I.hhi / T0.hhi) * 100;
        ref.textContent = `구조 지표(다음 해): 고부가 3부문 비중 ${fmt(I.high)}%(추세대로면 ${fmt(T0.high)}%)` + (D.highNat != null ? ` — 이 성장률이 이어지면 전국 수준(${fmt(D.highNat)}%)까지 ${yrs || '60년 넘게 걸림'}` : '')
          + ` · 산업집중도 ${Math.round(I.hhi)}(추세대로면 ${Math.round(T0.hhi)})` + (D.hhiCoef != null && Math.abs(dl) > 0.01 ? ` · 리포트 패널 추정으로 보면 집중도 변화 ${sg(dl, 2)}%는 성장률 ${sg(D.hhiCoef * dl, 2)}%p 와 함께 움직인 크기(연관, 위 성장률에 더하지 않음)` : '');
      }
      route(T);
    };
    const route = (T: number) => {
      const groups: [string, (r: R) => boolean][] = [['all', () => true], ['high', r => r.high], ['mfg', r => r.mfg], ['spec', r => r.spec]];
      const ts = [2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0];
      if (!ts.some(x => Math.abs(x - T) < 0.05)) { ts.push(Math.round(T * 10) / 10); ts.sort((a, b) => a - b); }
      const tb = document.querySelector('#gsroute tbody');
      if (!tb) return;
      // 머리 글자를 칸마다 data-label 로 — 표를 다시 그릴 때마다 붙인다(휴대폰 카드 보기에서 '모든 업종' 같은 이름이 빠지던 것, 운영자 지적 2026-10-08)
      const heads = Array.from(document.querySelectorAll('#gsroute thead th')).map(th => (th.textContent ?? '').trim());
      const one = (t: number) => {   // 목표 t 에 대해 묶음마다 [지금 추세, 필요 성장률, 더할 몫, 시도 최고, 범위 밖]
        const E = t - D.base;
        return groups.map(([, f]) => {
          const rs = D.rows.filter(f), sh = rs.reduce((a, r) => a + r.w, 0);   // 묶음의 총부가가치 대비 비중(모든 업종 = 100)
          const ss = rs.reduce((a, r) => a + r.share, 0);
          const avg = rs.reduce((a, r) => a + r.share * r.g, 0) / ss;
          const cap = rs.reduce((a, r) => a + r.share * r.gmax, 0) / ss;   // 실현 가능성 띠: 묶음 업종마다 17개 시도 최고 10년 성장률의 비중 가중 평균(관측된 범위의 위쪽)
          const add = E > 0 ? E / sh * 100 : 0, need = avg + add;
          return { avg, need, add, cap, out: E > 0 && need > cap + 0.05 };
        });
      };
      let outCount = 0;
      tb.innerHTML = ts.map(t => {
        const E = t - D.base;
        const cells = one(t).map((c, i) => {
          const lab = heads[i + 1] ?? '';
          if (E <= 0) return `<td class="n" data-label="${lab}">${fmt(c.avg)}</td>`;
          if (c.out) outCount++;
          return `<td class="n${c.out ? ' gs-out' : ''}" data-label="${lab}">${fmt(c.need)}<div class="tiny muted">(+${fmt(c.add)}%p)${c.out ? `<br>관측 범위 밖 · 시도 최고 ${fmt(c.cap)}%` : ''}</div></td>`;
        }).join('');
        return `<tr${Math.abs(t - T) < 0.05 ? ' class="gs-cur"' : ''}><th scope="row">${fmt(t)}%</th>${cells}<td class="n" data-label="${heads[5] ?? ''}">${fmt(D.gdpEok * t / 100 / 10000)}</td><td class="n" data-label="${heads[6] ?? ''}">${E > 0 ? fmt(D.gdpEok * E / 100 / 10000) : '—'}</td></tr>`;
      }).join('');
      // 쉬운 답(고른 목표 하나): 운영자 지적 2026-10-08 '이게 무슨 말이야? 어려워'
      const pl = document.getElementById('gsplain');
      if (pl) {
        const E = T - D.base, cs = one(T);
        const NAMES: [string, string][] = [
          ['모든 업종이 함께', '농업·제조업·서비스업 전부'],
          ['고부가 3부문만', '전기·전자·정밀기기, 정보통신, 금융·보험'],
          ['제조업만', '공장에서 물건을 만드는 업종'],
          ['특화 부문만', '대구가 전국보다 비중이 큰 업종(입지계수 1 이상)'],
        ];
        if (E <= 0) {
          pl.innerHTML = `<p class="ap-gap">목표 ${fmt(T)}%는 지금 추세(${fmt(D.base, 2)}%)보다 낮거나 같습니다. 지금 속도만 이어져도 닿는 값입니다.</p>`;
        } else {
          pl.innerHTML = `<p class="ap-gap">목표 ${fmt(T)}%까지 해마다 <span class="ap-num"><b>${fmt(E, 2)}%p</b></span> 모자랍니다. 이 차이를 누가 메우느냐에 따라 키워야 할 속도가 달라집니다.</p><ul>`
            + cs.map((c, i) => `<li><span class="ap-name">${NAMES[i][0]} 키우면</span><span class="ap-what">${NAMES[i][1]}</span>`
              + `<span class="ap-num">지금 해마다 ${fmt(c.avg)}% → <b>${fmt(c.need)}%</b>로</span>`
              + (c.out ? `<span class="ap-out">17개 시도 어디서도 10년 동안 이 속도로 큰 적이 없습니다(시도 최고 ${fmt(c.cap)}%).</span>` : '')
              + (i === 0 && Math.abs(c.avg - D.base) >= 0.05 ? `<span class="ap-out">업종을 모두 더한 부가가치는 해마다 ${fmt(c.avg)}% 컸고, 세금(순생산물세)까지 넣은 GRDP 는 ${fmt(D.base, 2)}% 컸습니다. 그래서 두 숫자가 다릅니다.</span>` : '') + `</li>`).join('')
            + `</ul><p class="ap-money">금액으로는 대구 GRDP 가 한 해 약 ${fmt(D.gdpEok * T / 100 / 10000)}조 원 늘어야 합니다. 지금 추세보다 ${fmt(D.gdpEok * E / 100 / 10000)}조 원 더입니다(${pl.dataset.y1 ?? ""}년 명목 GRDP 기준).</p>`;
        }
      }
      const sh = (f: (r: R) => boolean) => fmt(D.rows.filter(f).reduce((a, r) => a + r.share, 0) / S0 * 100);
      const n = document.getElementById('gsroutenote');
      if (n) n.textContent = `묶음 비중: 고부가 3부문 ${sh(r => r.high)}% · 제조업 ${sh(r => r.mfg)}% · 특화 부문 ${sh(r => r.spec)}%(부가가치 기준). 비중이 작은 묶음일수록 같은 차이를 메우는 데 높은 성장률이 필요합니다.`
        + (outCount ? ` 회색 칸은 필요 성장률이 '관측 범위 밖' — 그 묶음의 업종마다 17개 시도 가운데 가장 높았던 10년 성장률을 비중대로 평균한 값(시도 최고)보다 큽니다. 어느 시도도 낸 적 없는 값이라는 뜻이지 평가가 아닙니다.` : '');
    };
    document.querySelectorAll<HTMLInputElement>('#gs input').forEach(i => i.addEventListener('input', calc));
    document.getElementById('gst')?.addEventListener('input', calc);   // 목표 칸은 첫 화면(GrowthAsk)에 있다(2026-10-07)
    calc();
  }
</script>
<style>
  .gs-sticky { position: sticky; top: 0; z-index: 2; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 14px; margin-bottom: var(--s2); }
  .gs-main { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .gs-big { font-size: var(--num-xl); font-weight: 700; color: var(--primary); line-height: 1; font-variant-numeric: tabular-nums; }
  .gs-big small { font-size: 0.5em; margin-left: 2px; }
  .gs-txt { flex: 1 1 200px; }
  .gs-lab { font-weight: 600; }
  .gs-target input, .gs-tab input, .gs-dem input { width: 4.6em; padding: 4px 6px; text-align: right; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .gs-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px; }
  .gs-tiles div { display: flex; flex-direction: column; gap: 1px; border-top: 1px solid var(--line); padding-top: 6px; }
  .gs-tiles .tl { font-size: var(--tiny); color: var(--muted); }
  .gs-tiles b { font-size: 1.1rem; font-variant-numeric: tabular-nums; }
  .gs-more > summary { cursor: pointer; font-weight: 700; padding: 10px 0; }
  .gs-def { margin: var(--s2) 0 0; } .gs-def > summary { cursor: pointer; font-weight: 600; font-size: var(--small); }
  .gs-per { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; margin: var(--s2) 0 0; font-size: var(--small); }
  .gs-per select { padding: 4px 6px; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--bg); color: var(--ink); font: inherit; max-width: 100%; }
  .gs-presets { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--s2) 0 4px; }
  .gs-presets .btn { min-height: 40px; padding: 4px 12px; font-size: var(--small); flex-direction: column; line-height: 1.25; white-space: normal; text-align: center; }
  .gs-presets :global(.pv) { font-weight: 700; font-size: 1rem; }
  .gs-h { font-size: 1.05rem; margin: var(--s3) 0 6px; }
  .gs-gh { font-size: 0.95rem; margin: var(--s2) 0 4px; }
  #gsroute { min-width: 640px; }
  #gsroute :global(tr.gs-cur) { background: var(--surface); font-weight: 700; }
  #gsroute :global(td.gs-out) { color: var(--muted); background: var(--surface); }
  .gs-tab th, .gs-tab td { padding-top: 5px; padding-bottom: 5px; }
  .gs-tab tbody th { font-weight: 500; min-width: 7em; }
  .gs-dem { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 6px 0; }
  #gslist { list-style: none; margin: 0; padding: 0; }
  #gslist :global(li) { display: grid; grid-template-columns: minmax(7em, 11em) 1fr 4.5em; gap: 8px; align-items: center; margin: 3px 0; font-size: var(--small); }
  #gslist :global(.bw) { background: var(--surface); height: 12px; }
  #gslist :global(.b) { display: block; height: 100%; background: var(--primary); border-radius: 0 3px 3px 0; }
  #gslist :global(.b.neg) { background: var(--muted-2); }
  #gslist :global(.v) { text-align: right; font-variant-numeric: tabular-nums; }
  @media (max-width: 600px) {
    .gs-big { font-size: 2.1rem; }
    .gs-lab { display: none; }
    .gs-tiles b { font-size: 0.95rem; }
  }
</style>
