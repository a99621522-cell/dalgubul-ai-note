---
/** 대구 주력·미래 신산업 현황(대구정책연구원 연구 보고서 값) — /stats/industry/#bundles 와 /policy/dpi-industry/ 가 같이 쓴다.
 *  운영자 지시 2026-10-09 '산업통계부문이 안맞아, 로봇산업 숫자도 너무 많아 전국인지 대구인지, 2016년 이런 과거 자료는 필요 없어,
 *  그냥 대구정책연구원 자료만 올려': 통계청 중분류 대조표는 빼고, 보고서의 최근 연도(2023) 대구 값만 한 표로. 전국 값·연도별 추이는 싣지 않는다.
 *  데이터 data/dpi/university_industry.json(보고서 4장 표 값 그대로). 단위 바꿈(백만 원 → 억 원)만, 평가·순위 없음. */
import fs from 'node:fs';

type S = (number | null)[];
type Bundle = { name: string; role: string; page: number; codes: { ksic: string; name: string }[]; codes_stated: number | null; daegu: { est: S; emp: S; prod: S; va: S } };
const D = (() => { try { return JSON.parse(fs.readFileSync('data/dpi/university_industry.json', 'utf-8')) as {
  source: { publisher: string; title: string; series: string; published: string }; years: number[]; bundles: Bundle[] }; } catch { return null; } })();
const n = (v: number | null | undefined) => v == null ? '—' : v.toLocaleString('ko-KR');
const eok = (v: number | null | undefined) => v == null ? '—' : Math.round(v / 100).toLocaleString('ko-KR');
const i = D ? D.years.length - 1 : 0;
const Y = D ? D.years[i] : '';
const src = D ? `${D.source.publisher} 「${D.source.title}」(${D.source.series}, ${D.source.published.replace('-', '.')})` : '';
/** 산업 이름 밑 한 줄: 몇 개 업종을 묶었는지와 앞 업종 이름 — 운영자 지적 2026-10-09 '로봇산업 수가 너무 많잖아'(로봇 = 산업용 로봇 외 기계·측정기기 등 10개 업종 묶음) */
const short = (s: string) => s.replace(/ 제조업$| 개발 및 공급업$| 서비스업$/, '').replace(/^그 외 기타 /, '');
const inc = (b: Bundle) => {
  const FIRST = ['29280', '29299', '29210'];   // 로봇 묶음은 산업용 로봇과 기업이 많은 기계 업종을 앞에(기업 사전 2026-09: 29299 186곳·29210 121곳·29280 84곳)
  const lead = [...b.codes.filter(c => FIRST.includes(c.ksic)).sort((x, y) => FIRST.indexOf(x.ksic) - FIRST.indexOf(y.ksic)), ...b.codes.filter(c => !FIRST.includes(c.ksic))];
  return `${b.codes_stated ?? b.codes.length}개 업종: ${lead.slice(0, 3).map(c => short(c.name)).join('·')} 등`;
};
interface Props { heading?: boolean }
const { heading = true } = Astro.props;
---
{D && <section class="ib" id="bundles">
  {heading && <div class="section-head"><h2>대구 주력·미래 신산업 현황</h2><span class="meta">대구 · {Y}년 · 대구정책연구원 연구 보고서</span></div>}
  <p class="meta">{src}에 실린 대구의 산업별 값({Y}년)을 그대로 옮겼습니다. 모두 <b>대구</b> 값입니다.</p>
  <div class="scroll-x"><table class="data-table" data-title={`대구 주력·미래 신산업 현황(${Y}년, 대구정책연구원)`}>
    <thead><tr><th>산업</th><th data-pri="3">구분</th><th class="n">사업체(개)</th><th class="n">종사자(명)</th><th class="n">생산액(억 원)</th><th class="n">부가가치(억 원)</th></tr></thead>
    <tbody>{D.bundles.map(b => <tr>
      <th scope="row">{b.name}<div class="tiny muted">{inc(b)}</div></th><td>{b.role}</td>
      <td class="n">{n(b.daegu.est[i])}</td><td class="n">{n(b.daegu.emp[i])}</td><td class="n">{eok(b.daegu.prod[i])}</td><td class="n">{eok(b.daegu.va[i])}</td>
    </tr>)}</tbody>
  </table></div>
  <ul class="meta ib-notes">
    <li>사업체·종사자는 1인 이상 전체, 생산액·부가가치는 종사자 10인 이상 사업체 기준입니다(보고서 표 주).</li>
    <li><b>산업 이름은 업종 묶음입니다.</b> 예를 들어 '로봇'은 산업용 로봇 제조업 1개에 특수목적용 기계·농업용 기계·측정·제어기기 등 9개 업종을 더한 값이라 로봇 제조 기업 수가 아닙니다(산업별 업종은 아래 펼쳐 보기).</li>
    <li>산업마다 업종이 일부 겹쳐 산업별 값을 더하면 안 됩니다. ABB 의 생산액·부가가치는 제조 업종만의 값입니다.</li>
  </ul>
  <details class="ib-codes">
    <summary>산업별 업종(세세분류 코드) 보기</summary>
    <div class="scroll-x"><table class="data-table compact" data-title="대구 주력·미래 신산업 업종 정의(대구정책연구원)">
      <thead><tr><th>산업</th><th>업종(코드)</th></tr></thead>
      <tbody>{D.bundles.map(b => <tr><th scope="row">{b.name}</th><td class="wrap tiny">{b.codes.map(c => c.ksic + ' ' + c.name).join(', ')}</td></tr>)}</tbody>
    </table></div>
  </details>
  <p class="meta">출처: {src}. 보고서 값 그대로이며 평가·순위가 아닙니다.</p>
</section>}
<style>
  .ib { margin-top: var(--s5); }
  .ib-notes { padding-left: 1.2em; margin: var(--s2) 0; overflow-wrap: anywhere; }
  .ib-notes li { margin: 2px 0; }
  .ib-codes { margin: var(--s2) 0; }
  .ib-codes > summary { cursor: pointer; font-weight: 600; padding: 4px 0; }
</style>
