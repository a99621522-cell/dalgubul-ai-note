---
/** 대구 주력·미래 신산업 현황(대구정책연구원 연구 보고서 값) — /stats/industry/#bundles 와 /policy/dpi-industry/ 가 같이 쓴다.
 *  운영자 지시 2026-10-09 '산업통계부문이 안맞아, 로봇산업 숫자도 너무 많아 전국인지 대구인지, 2016년 이런 과거 자료는 필요 없어,
 *  그냥 대구정책연구원 자료만 올려': 통계청 중분류 대조표는 빼고, 보고서의 최근 연도(2023) 대구 값만 한 표로. 전국 값·연도별 추이는 싣지 않는다.
 *  데이터 data/dpi/university_industry.json(보고서 4장 표 값 그대로). 단위 바꿈(백만 원 → 억 원)만, 평가·순위 없음. */
import fs from 'node:fs';
import { companies, normName } from '../lib/csv';

type S = (number | null)[];
type Bundle = { name: string; role: string; page: number; codes: { ksic: string; name: string }[]; codes_stated: number | null; daegu: { est: S; emp: S; prod: S; va: S } };
const D = (() => { try { return JSON.parse(fs.readFileSync('data/dpi/university_industry.json', 'utf-8')) as {
  source: { publisher: string; title: string; series: string; published: string }; years: number[]; bundles: Bundle[] }; } catch { return null; } })();
const n = (v: number | null | undefined) => v == null ? '—' : v.toLocaleString('ko-KR');
const eok = (v: number | null | undefined) => v == null ? '—' : Math.round(v / 100).toLocaleString('ko-KR');
const i = D ? D.years.length - 1 : 0;
const Y = D ? D.years[i] : '';
const src = D ? `${D.source.publisher} 「${D.source.title}」(${D.source.series}, ${D.source.published.replace('-', '.')})` : '';
/** 산업 이름 밑 두 줄 — 운영자 지적 2026-10-09 '로봇산업 수가 너무 많잖아' → '다른 산업도 다시 검토해'.
 *  ① 묶은 업종 수와 대구 공장등록 기업이 많은 업종 3개(기업 사전으로 순서만 정함, 숫자는 싣지 않음)
 *  ② 산업 이름과 다른 업종이 섞인 점(보고서 업종 목록을 그대로 읽은 사실). 검토 근거: 업종별 대구 공장등록 수(2026-09)·전국 세세분류 생산액(KOSIS 2023) */
const cnt = new Map<string, number>();
for (const c of companies()) { const k = (c.sector_code || '').trim().slice(0, 5); if (k) cnt.set(k, (cnt.get(k) ?? 0) + 1); }
/** 기업 사전 공장등록 기업 수(운영자 지시 2026-10-09 '1과 2 해'): 팩토리온 공장등록 기록 중 대표 업종 코드가 묶음 업종에 든 곳을
 *  회사 이름(법인 표기 뺌)으로 한 번씩 센다. 보고서 값(전국사업체조사, 1인 이상 사업체)과 근거·기준월이 달라 따로 칸을 둔다. */
const fo = companies().filter(c => c.source.startsWith('팩토리온'));
const foAsOf = fo.map(c => c.as_of).sort().at(-1) ?? '';
const foCount = (b: Bundle) => { const cs = new Set(b.codes.map(c => c.ksic)); return new Set(fo.filter(c => cs.has((c.sector_code || '').trim().slice(0, 5))).map(c => normName(c.name))).size; };
const short = (s: string) => s.replace(/ 제조업$| 개발 및 공급업$| 서비스업$/, '').replace(/^그 외 기타 /, '');
const inc = (b: Bundle) => {
  const lead = [...b.codes].sort((x, y) => (cnt.get(y.ksic) ?? 0) - (cnt.get(x.ksic) ?? 0));
  return `${b.codes_stated ?? b.codes.length}개 업종: ${lead.slice(0, 3).map(c => short(c.name)).join('·')} 등`;
};
const NOTE: Record<string, string> = {
  '전기·자율 모빌리티부품': '일반 자동차 부품(엔진·차체·동력전달·그 외)·전동기·시스템 소프트웨어를 묶음 — 자동차용 전기장치 업종은 들어 있지 않음',
  '기계요소 소재부품': '절삭가공·도금 업종이 기업 수의 대부분, 이차전지 2개 업종이 함께 들어 있음',
  '디지털 의료기기': '의료기기 업종 외에 안경·응용 소프트웨어·기타 직물제품 업종이 들어 있음',
  '미래모빌리티': '자동차 부품 외에 배전반·전기장비·화학제품·비철금속·항공기 부품 업종이 들어 있음, 전기·자율 모빌리티부품 6개 업종 중 4개와 겹침',
  '로봇': '산업용 로봇 제조업 1개에 특수목적용 기계·농업용 기계·측정·제어기기 등 9개 업종을 더한 값 — 로봇 제조 기업 수가 아님(로봇산업 실태조사 기준 대구 로봇기업은 아래 주)',
  '헬스케어': '의료기기·의약품 업종, 업종 번호는 옛 분류(10차) 기준',
  '반도체': '반도체 소자 외에 반도체·디스플레이 제조용 기계와 발광 다이오드 업종이 들어 있음',
  'ABB': '소프트웨어·IT 서비스 업종과 전자부품·무선 통신장비 업종을 묶음 — 생산액·부가가치는 제조 업종(전자부품·무선 통신장비)만',
};
interface Props { heading?: boolean }
const { heading = true } = Astro.props;
---
{D && <section class="ib" id="bundles">
  {heading && <div class="section-head"><h2>대구 주력·미래 신산업 현황</h2><span class="meta">대구 · {Y}년 · 대구정책연구원 연구 보고서</span></div>}
  <p class="meta">{src}에 실린 대구의 산업별 값을 그대로 옮겼습니다. 모두 <b>대구</b> 값이고, {Y}년은 이 보고서에 실린 가장 최근 연도입니다. 주력산업 3개는 보고서가 정한 업종 묶음이고, 미래 신산업 5개는 보고서가 대구테크노파크의 산업 분류를 따른 묶음입니다.</p>
  <div class="scroll-x"><table class="data-table" data-title={`대구 주력·미래 신산업 현황(${Y}년, 대구정책연구원)`}>
    <thead>
      <tr><th rowspan="2">산업</th><th rowspan="2">구분</th><th colspan="4">대구정책연구원 보고서({Y}년)</th><th>기업 사전({foAsOf.replace('-', '.')})</th></tr>
      <tr><th class="n">사업체(개)</th><th class="n">종사자(명)</th><th class="n">생산액(억 원)</th><th class="n">부가가치(억 원)</th><th class="n">공장등록 기업(곳)</th></tr>
    </thead>
    <tbody>{D.bundles.map(b => <tr>
      <th scope="row">{b.name}<div class="tiny muted tt-skip">{inc(b)}</div>{NOTE[b.name] && <div class="tiny ib-warn tt-skip">{NOTE[b.name]}</div>}</th><td class="ib-role">{b.role}</td>
      <td class="n">{n(b.daegu.est[i])}</td><td class="n">{n(b.daegu.emp[i])}</td><td class="n">{eok(b.daegu.prod[i])}</td><td class="n">{eok(b.daegu.va[i])}</td><td class="n">{n(foCount(b))}</td>
    </tr>)}</tbody>
  </table></div>
  <ul class="meta ib-notes">
    <li>사업체·종사자는 1인 이상 전체, 생산액·부가가치는 종사자 10인 이상 사업체 기준입니다(보고서 표 주).</li>
    <li><b>산업 이름은 보고서가 정한 업종 묶음입니다.</b> 이름과 다른 업종이 함께 들어 있는 경우가 많아, 산업 이름 밑에 묶은 업종(대구 공장등록 기업이 많은 순)과 섞인 업종을 적었습니다. 전체 목록은 아래 펼쳐 보기.</li>
    <li>산업마다 업종이 일부 겹쳐 산업별 값을 더하면 안 됩니다.</li>
    <li><b>공장등록 기업</b>은 이 사이트 기업 사전(팩토리온 공장등록, {foAsOf.replace('-', '.')})에서 대표 업종이 같은 업종 묶음에 드는 곳을 회사 이름 기준으로 센 수입니다. 공장을 등록한 제조 기업만 잡히고(사무실·서비스 업종은 빠짐) 대표 업종 하나로만 나누므로, 보고서의 사업체 수(전국사업체조사, 1인 이상 전체)와 기준이 달라 견주거나 빼서 쓰지 않습니다.</li>
    <li>로봇: 같은 연구원의 「대구 뿌리산업 대전환 전략 연구」(2026, 115쪽)는 로봇산업 실태조사 기준 <b>대구 로봇기업 251개사(2023년)</b>를 싣고 있습니다. 로봇 제조·부품·서비스 기업을 조사한 수라, 기계 업종까지 묶은 위 표의 로봇 사업체 수와 정의가 다릅니다. 산업마다 출처별 숫자는 아래 <a href="#count-compare">숫자가 기관마다 다른 이유</a>에 모았습니다.</li>
  </ul>
  <details class="ib-codes">
    <summary>산업별 업종(세세분류 코드) 보기</summary>
    <div class="scroll-x"><table class="data-table compact" data-title="대구 주력·미래 신산업 업종 정의(대구정책연구원)">
      <thead><tr><th>산업</th><th class="n">업종 수</th><th>업종(코드)</th></tr></thead>
      <tbody>{D.bundles.map(b => <tr><th scope="row">{b.name}</th><td class="n">{b.codes_stated && b.codes_stated !== b.codes.length ? b.codes_stated + '(목록 ' + b.codes.length + ')' : b.codes.length}</td><td class="wrap tiny">{b.codes.map(c => c.ksic + ' ' + c.name).join(', ')}</td></tr>)}</tbody>
    </table></div>
    <p class="meta">업종 수가 '35(목록 34)'처럼 적힌 산업은 보고서 본문이 밝힌 업종 수와 표에서 읽은 코드 수가 다른 경우입니다. 업종 이름·번호는 보고서 표기 그대로입니다.</p>
  </details>
  <p class="meta">출처: {src}. 보고서 값 그대로이며 평가·순위가 아닙니다.</p>
</section>}
<style>
  .ib { margin-top: var(--s5); }
  .ib-notes { padding-left: 1.2em; margin: var(--s2) 0; overflow-wrap: anywhere; }
  .ib-notes li { margin: 2px 0; }
  .ib th[scope="row"] { white-space: normal; min-width: 14em; max-width: 30em; }
  .ib-role { white-space: nowrap; }
  .ib-warn { color: var(--ink); margin-top: 2px; font-weight: 400; }
  .ib-codes { margin: var(--s2) 0; }
  .ib-codes > summary { cursor: pointer; font-weight: 600; padding: 4px 0; }
</style>
