---
/** 숫자가 기관마다 다른 이유 — 산업별 '대구 ○○ 기업 수'를 출처마다 나란히(운영자 지시 2026-10-09 '기관마다 통계가 다 다르네' → '넣어, 다른 산업도 같이 해').
 *  /stats/industry/#bundles 아래와 /policy/dpi-industry/ 가 같이 쓴다. 값은 각 자료 그대로(기업 사전은 빌드 때 세기), 맞고 틀림·평가 없음.
 *  손으로 옮긴 값은 출처 쪽수와 함께(data/refs/dpi-2026-ppuri-industry-transformation.json — 인쇄 쪽 = PDF 쪽 − 10). */
import fs from 'node:fs';
import { companies, normName } from '../lib/csv';

type Bundle = { name: string; codes: { ksic: string }[]; codes_stated: number | null; daegu: { est: (number | null)[] } };
const D = (() => { try { return JSON.parse(fs.readFileSync('data/dpi/university_industry.json', 'utf-8')) as { years: number[]; bundles: Bundle[] }; } catch { return null; } })();
const P = (() => { try { return JSON.parse(fs.readFileSync('data/participation/summary.json', 'utf-8')) as { programs: { key: string; n: number; n_firm: number; n_org: number; subs: [string, number][]; as_of: string; source: string }[] }; } catch { return null; } })();
const csvRows = (f: string) => { try { const [h, ...ls] = fs.readFileSync(f, 'utf-8').trim().split('\n'); const k = h.split(','); return ls.map(l => Object.fromEntries(l.split(',').map((v, j) => [k[j], v]))); } catch { return []; } };
const kosis = csvRows('data/kosis/mining-mfg-survey-sido.csv').filter(r => r.C1_NM === '대구광역시' && r.ITM_NM === '사업체수');
const kosisY = kosis.map(r => r.PRD_DE).sort().at(-1) ?? '';
const mfds = csvRows('data/mfds/device_region.csv').filter(r => r.scope === '전체' && r.kind === '생산' && r.region === '대구').sort((a, b) => Number(a.year) - Number(b.year)).at(-1);

const all = companies();
const fo = all.filter(c => c.source.startsWith('팩토리온'));
const foAsOf = fo.map(c => c.as_of).sort().at(-1) ?? '';
const ym = (s: string) => s.replace('-', '.');
const code = (c: { sector_code: string }) => (c.sector_code || '').trim().slice(0, 5);
const uniq = (list: typeof all) => new Set(list.map(c => normName(c.name))).size;
const foBy = (test: (k: string) => boolean, list = fo) => uniq(list.filter(c => test(code(c))));

type Row = { n: string; when: string; src: string; what: string; names: boolean; url?: string };
const fmt = (v: number | null | undefined) => v == null ? '—' : v.toLocaleString('ko-KR');
const dpiSrc = '대구정책연구원 「지역과 대학의 상생발전을 위한 전략 수립」';
const ppuri = '대구정책연구원 「대구 뿌리산업 대전환 전략 연구」';
const kRow = (nm: string, label: string): Row | null => { const r = kosis.find(x => x.PRD_DE === kosisY && x.C2_NM === nm); return r ? { n: fmt(Number(r.DT)), when: `${kosisY}년`, src: '통계청 광업·제조업조사', what: `${label} 중분류 전체, 종사자 10인 이상 사업체 — 업종 범위가 묶음과 다름`, names: false } : null; };
const pRow = (key: string, what: string, sub?: string): Row | null => {
  const p = P?.programs.find(x => x.key === key); if (!p) return null;
  const n = sub ? p.subs.find(s => s[0] === sub)?.[1] : p.n; if (n == null) return null;
  // 출처는 기관 자료만(보도 매체 이름은 싣지 않음 — 운영자 지시 2026-10-08 펀드 절과 같은 원칙)
  const src = p.source.replace(/\(공공데이터포털[^)]*\)/g, '').split(/,\s+/).map(x => x.trim()).filter(x => x && !/TV|신문|일보|뉴스|「/.test(x)).join(', ');
  return { n: fmt(n) + (sub ? '' : (p.n_org ? ` (기업 ${p.n_firm}·기관 ${p.n_org})` : '')), when: p.as_of ? ym(p.as_of) : '—', src, what, names: true };
};
const mRow = (): Row | null => mfds ? { n: fmt(Number(mfds.firms)), when: `${mfds.year}년`, src: '식품의약품안전처 의료기기 생산·수출입 실적', what: '의료기기 생산 실적을 보고한 대구 업체(안경·의약품 없음)', names: false } : null;
/** 운영자 지시 2026-10-09 '미래차와 알파시티는 출처를 넣어서 반영해' → 알파시티는 '홈페이지로 해': 누리집 기업현황 '전체 311건'(2026-09-25 저장 화면 scripts/data/alphacity/page01.mht). 기관 발표·기관 누리집 값(보도 매체 아님) */
const fmtsMembers: Row = { n: '212', when: '2025.03', src: '대구광역시 보도자료 「자동차부품기업의 미래차전환 원스톱 지원 강화」(2025-04)', what: '대구 미래차전환종합지원센터(지능형자동차부품진흥원) 회원사 — 가입 기준이라 업종 기업 수가 아님', names: false, url: 'https://info.daegu.go.kr/newshome/mtnmain.php?aid=270689&mtnkey=articleview&mkey=todaylist' };
const alphaFirms: Row = { n: '311', when: '2026.09', src: '수성알파시티 누리집 기업현황', what: '수성알파시티 입주 기업(누리집 기업현황 게시 건수, 대학 등 일부 기관 포함) — 단지 입주 기준이라 업종이 섞임', names: false, url: 'https://alphacity.or.kr/boardList?type=1' };
const autoParts = (): Row => ({ n: fmt(foBy(k => k.startsWith('303'))), when: ym(foAsOf), src: '기업 사전(팩토리온 공장등록)', what: '자동차 신품 부품 업종(303)만 — 묶음에 든 화학·배전반·소프트웨어 등은 뺌', names: true });

/** 산업마다 더하는 줄. 묶음 두 줄(보고서·공장등록)은 모든 산업에 공통으로 앞에 붙는다 */
const EXTRA: Record<string, (Row | null)[]> = {
  '전기·자율 모빌리티부품': [autoParts(), kRow('자동차 및 트레일러 제조업', '자동차 및 트레일러 제조업'), pRow('motor', '전기차 모터 소부장 특화단지 투자협약 앵커기업(협력기업 명단은 비공개)'), fmtsMembers],
  '기계요소 소재부품': [
    { n: '9,266', when: '2024년', src: `${ppuri} 41쪽`, what: '뿌리산업 14개 공정(국가뿌리산업진흥센터 기준 73개 세세분류) 사업체, 전국사업체조사 다시 집계', names: false },
    { n: '3,741 / 1,552', when: '2024년', src: `${ppuri} 45쪽`, what: '그중 정밀가공 / 표면처리 공정 사업체', names: false },
    kRow('금속가공제품 제조업; 기계 및 가구 제외', '금속가공제품 제조업'),
  ],
  '디지털 의료기기': [
    { n: fmt(foBy(k => k.startsWith('271') && k !== '27195')), when: ym(foAsOf), src: '기업 사전(팩토리온 공장등록)', what: '의료용 기기 업종(271)만, 안경 제외 — 묶음에 든 안경·소프트웨어·직물은 뺌', names: true },
    mRow(), kRow('의료 정밀 광학기기 및 시계 제조업', '의료·정밀·광학기기 및 시계 제조업'),
    pRow('kmedi', '대구 첨단의료복합단지 입주 기업 중 의료기기', '의료기기'), pRow('rfz', '스마트 웰니스 규제자유특구 특구사업자(기관 포함)', '스마트 웰니스'),
  ],
  '미래모빌리티': [autoParts(), kRow('자동차 및 트레일러 제조업', '자동차 및 트레일러 제조업'), pRow('motor', '전기차 모터 소부장 특화단지 투자협약 앵커기업(협력기업 명단은 비공개)'), fmtsMembers],
  '로봇': [
    { n: fmt(foBy(k => k === '29280')), when: ym(foAsOf), src: '기업 사전(팩토리온 공장등록)', what: '산업용 로봇 제조업 한 업종만', names: true },
    { n: '251', when: '2023년', src: `로봇산업 실태조사(한국로봇산업진흥원), ${ppuri} 115쪽 인용`, what: '로봇 제품을 만들거나 파는 기업(부품·소프트웨어·서비스 포함) — 업종 코드가 아니라 품목으로 판정, 표본조사 추정', names: false },
    { n: '89', when: '2024년', src: `${ppuri} 45쪽`, what: "뿌리산업 14개 공정 중 '로봇' 공정 사업체", names: false },
    pRow('grfz', 'AI로봇 글로벌 혁신특구 특구사업자(대구 밖 포함)'), pRow('rfz', '이동식 협동로봇 규제자유특구 특구사업자(기관 포함)', '이동식 협동로봇'),
  ],
  '헬스케어': [
    { n: fmt(foBy(k => /^21(1|2[0-3]|3)/.test(k) && !['21213', '21219'].includes(k))), when: ym(foAsOf), src: '기업 사전(팩토리온 공장등록)', what: '의약품·의료용품 업종(21)만', names: true },
    mRow(), kRow('의료용 물질 및 의약품 제조업', '의료용 물질 및 의약품 제조업'), pRow('kmedi', '대구 첨단의료복합단지 입주 기업(의료기기·제약·바이오)'),
  ],
  '반도체': [
    { n: fmt(foBy(k => k.startsWith('261'))), when: ym(foAsOf), src: '기업 사전(팩토리온 공장등록)', what: '반도체 소자 업종(261, 발광 다이오드 포함)만 — 묶음에 든 제조용 기계는 뺌', names: true },
    kRow('전자부품 컴퓨터 영상 음향 및 통신장비 제조업', '전자부품·컴퓨터·영상·음향·통신장비 제조업'),
  ],
  'ABB': [
    { n: fmt(foBy(k => k.startsWith('582') || k.startsWith('620'), all)), when: ym(foAsOf), src: '기업 사전(공장등록 + 국민연금 사업장 등)', what: '소프트웨어 개발·컴퓨터 프로그래밍 업종(582·620) — 공장이 없는 사무실 기업은 국민연금 등으로 들어온 곳만', names: true },
    alphaFirms,
  ],
};
const tables = D ? D.bundles.map(b => {
  const cs = new Set(b.codes.map(c => c.ksic));
  const base: Row[] = [
    { n: fmt(b.daegu.est[D.years.length - 1]), when: `${D.years.at(-1)}년`, src: dpiSrc, what: `${b.codes_stated ?? b.codes.length}개 업종 묶음 사업체(전국사업체조사, 1인 이상)`, names: false },
    { n: fmt(foBy(k => cs.has(k))), when: ym(foAsOf), src: '기업 사전(팩토리온 공장등록)', what: '같은 업종 묶음이 대표 업종인 공장등록 회사', names: true },
  ];
  return { name: b.name, rows: [...base, ...(EXTRA[b.name] ?? []).filter((r): r is Row => !!r)] };
}) : [];
---
{tables.length > 0 && <section class="icc" id="count-compare">
  <div class="section-head"><h2>숫자가 기관마다 다른 이유</h2><span class="meta">같은 산업의 대구 기업 수, 출처별</span></div>
  <p class="meta">같은 '대구 ○○ 기업'이라도 자료마다 숫자가 다릅니다. 어느 숫자가 맞고 틀린 것이 아니라 세는 대상이 다릅니다.</p>
  <ul class="meta icc-why">
    <li><b>무엇을 그 산업으로 보나</b> — 업종 한 개만인지, 여러 업종 묶음인지, 업종 코드가 아니라 품목(실제로 그 제품을 만드는지)으로 보는지</li>
    <li><b>세는 단위</b> — 사업체(사업장마다), 공장, 회사(이름 기준)</li>
    <li><b>조사 방식</b> — 전수조사(전국사업체조사), 표본조사 추정(로봇산업 실태조사), 행정 등록(공장등록·식약처 실적 보고), 신청·지정(특구·단지)</li>
    <li><b>포함 기준</b> — 1인 이상 전체, 종사자 10인 이상, 공장을 등록한 곳, 특구에 등록한 곳</li>
    <li><b>시점</b> — 자료마다 기준 연도가 다름</li>
  </ul>
  <p class="meta">고르는 법: 그 제품을 실제로 만드는 기업 규모는 품목 기준 자료(로봇산업 실태조사·식약처 생산 실적), 관련 업종 전체의 규모는 업종 묶음(보고서·통계청), 회사 이름을 하나씩 확인할 명단은 '명단' 칸이 '있음'인 자료(기업 사전·특구·단지).</p>
  {tables.map((t, j) => <details class="icc-ind" open={t.name === '로봇' || undefined}>
    <summary>{t.name} <span class="muted tiny">{t.rows.length}개 숫자</span></summary>
    <div class="scroll-x"><table class="data-table compact" data-title={`대구 ${t.name} 기업 수 — 출처별`}>
      <thead><tr><th class="n">숫자(곳)</th><th>기준</th><th>출처</th><th>무엇을 셌나</th><th>명단</th></tr></thead>
      <tbody>{t.rows.map(r => <tr><td class="n">{r.n}</td><td class="icc-when">{r.when}</td><td>{r.url ? <a href={r.url} rel="noopener">{r.src}</a> : r.src}</td><td>{r.what}</td><td>{r.names ? '있음' : '없음'}</td></tr>)}</tbody>
    </table></div>
  </details>)}
  <p class="meta">기업 사전 숫자는 회사 이름(법인 표기 뺌) 기준으로 한 번씩 셌고 대표 업종 하나로만 나눴습니다. 통계청 광업·제조업조사는 대구 값이 중분류까지만 공개돼 묶음보다 넓은 업종입니다. '명단 있음'은 이 사이트 기업 사전이나 참여 사업별 기업(지원받은 기업 › 참여 사업별)에서 회사 이름을 볼 수 있다는 뜻입니다. 값은 각 자료 그대로이며 평가·순위가 아닙니다.</p>
</section>}
<style>
  .icc { margin-top: var(--s5); }
  .icc-why { padding-left: 1.2em; margin: var(--s2) 0; }
  .icc-why li { margin: 2px 0; }
  .icc-ind { margin: var(--s2) 0; }
  .icc-ind > summary { cursor: pointer; font-weight: 600; padding: 4px 0; }
  .icc td { white-space: normal; }
  .icc td.n, .icc-when { white-space: nowrap; }
</style>
