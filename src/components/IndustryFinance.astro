---
import { industryShares, loanIndex, loanSeries, industryCards, qLabel, qShort, OTHER, SECTORS, TABLE_ONLY, type CardItem } from '../lib/industryFinance';
/** /stats/industry/ #finance — 산업별 자금 흐름(운영자 지시 2026-10-14). ① 업종별 은행 대출·부가가치·종사자 비중 나란히 ② 업종별 대출 잔액 지수(2020년 말 = 100) 작은 그래프.
 *  값은 원 통계 그대로, 비중·지수는 나눗셈만. 평가 문장 없음 — 배치로만 나란히 보인다. */
const sh = industryShares();
const ix = loanIndex();
const f1 = (v: number | null) => (v == null ? '—' : v.toFixed(1));
const f0 = (v: number | null) => (v == null ? '—' : Math.round(v).toLocaleString('ko-KR'));
const eok = (v: number | null) => (v == null ? '—' : `${(v / 10000).toFixed(1)}조 원`);
const maxSh = sh ? Math.max(...sh.rows.flatMap(r => [r.shLoanBase ?? 0, r.shGva ?? 0, r.shEmp ?? 0])) : 1;
const w = (v: number | null) => `${v == null ? 0 : Math.max(0.4, (v / maxSh) * 100)}%`;

// 작은 그래프: 모든 업종이 같은 세로축(비교용)
const all = ix.series.flatMap(s => s.points.map(p => p.idx));
const yMin = Math.min(80, Math.floor(Math.min(...all, 100) / 20) * 20);
const yMax = Math.ceil(Math.max(...all, 100) / 20) * 20;
const W = 300, H = 150, pl = 30, pr = 44, pt = 10, pb = 22;
const n = ix.periods.length;
const X = (i: number) => pl + (i / Math.max(1, n - 1)) * (W - pl - pr);
const Y = (v: number) => pt + (1 - (v - yMin) / (yMax - yMin)) * (H - pt - pb);
const ticks = [yMin, 100, yMax].filter((v, i, a) => a.indexOf(v) === i);
const brk = ix.periods.indexOf('2025-Q4');
const yearTicks = ix.periods.map((p, i) => ({ p, i })).filter(o => o.p === '2020' || o.p.endsWith('Q4')).filter((_, k, a) => k === 0 || k === a.length - 1 || k % 2 === 0);
const tablePeriods = ix.periods.filter(p => p === '2020' || p.endsWith('Q4') || p >= `${ix.periods[n - 1]?.slice(0, 4)}-Q1`);
const lastP = ix.periods[n - 1] ?? '';
const ic = industryCards();
const arrow = (c: number | null) => (c == null ? '' : Math.abs(c) < 0.05 ? '–' : c > 0 ? '▲' : '▼');
const dir = (c: number | null) => (c == null ? '' : Math.abs(c) < 0.05 ? '변동 없음' : c > 0 ? '증가' : '감소');
const chgTxt = (it: CardItem) => (it.chg == null ? '—' : `${it.chg > 0 ? '+' : ''}${it.chgUnit === '%' ? it.chg.toFixed(1) : Math.round(it.chg)}${it.chgUnit}`);
---
{sh && (
<section id="finance" aria-labelledby="h-finance">
  <div class="section-head"><h2 id="h-finance">산업별 자금 흐름</h2><span class="meta">한국은행 대구 예금은행 산업별 대출금 · KOSIS 지역소득 · 전국사업체조사</span></div>
  <p class="lede">대구 예금은행이 업종별로 빌려준 돈(기업 대출 잔액)을 같은 업종의 경제 규모(부가가치)·고용(종사자) 옆에 나란히 놓았습니다. 세 값은 근거 통계가 달라 서로 더하거나 바꿔 쓰지 않습니다. 비중은 원 값의 나눗셈이고 평가·순위가 아닙니다.</p>

  <h3 class="sub">① 업종별 비중 — 대출 · 부가가치 · 종사자</h3>
  <ul class="legend" aria-label="범례">
    <li><span class="sw s1"></span>은행 대출 비중({qLabel(sh.base)})</li>
    <li><span class="sw s2"></span>부가가치 비중({sh.gvaYear}년)</li>
    <li><span class="sw s3"></span>종사자 비중({sh.empYear}년)</li>
  </ul>
  <div class="bars" role="img" aria-label={`대구 업종별 은행 대출·부가가치·종사자 비중(%). 표는 아래에 있습니다.`}>
    {sh.rows.map(r => (
      <div class="row">
        <div class="lab">{r.key}</div>
        <div class="trio">
          <div class="b"><span class="bar s1" style={`width:${w(r.shLoanBase)}`}></span><span class="v">{f1(r.shLoanBase)}%</span></div>
          <div class="b"><span class="bar s2" style={`width:${w(r.shGva)}`}></span><span class="v">{f1(r.shGva)}%</span></div>
          <div class="b"><span class="bar s3" style={`width:${w(r.shEmp)}`}></span><span class="v">{f1(r.shEmp)}%</span></div>
        </div>
      </div>
    ))}
  </div>
  <details>
    <summary>표로 보기</summary>
    <div class="scroll-x"><table class="data-table" data-title="대구 업종별 은행 대출·부가가치·종사자 비중">
      <thead><tr><th>업종</th><th class="n">대출 잔액<br />{qLabel(sh.base)}(억 원)</th><th class="n">대출 비중(%)</th><th class="n">대출 잔액<br />{qLabel(sh.latest)}{sh.prelimLatest && 'p'}(억 원)</th><th class="n">대출 비중(%)</th><th class="n" data-pri="2">부가가치<br />{sh.gvaYear}년(백만 원)</th><th class="n">부가가치 비중(%)</th><th class="n" data-pri="2">종사자<br />{sh.empYear}년(명)</th><th class="n">종사자 비중(%)</th></tr></thead>
      <tbody>
        {sh.rows.map(r => <tr class={r.key === OTHER ? 'oth' : ''}><th scope="row">{r.key}</th><td class="n">{f0(r.loanBase)}</td><td class="n">{f1(r.shLoanBase)}</td><td class="n">{f0(r.loanLatest)}</td><td class="n">{f1(r.shLoanLatest)}</td><td class="n">{f0(r.gva)}</td><td class="n">{f1(r.shGva)}</td><td class="n">{f0(r.emp)}</td><td class="n">{f1(r.shEmp)}</td></tr>)}
        <tr class="tot"><th scope="row">합계</th><td class="n">{f0(sh.totals.loanBase)}</td><td class="n">100.0</td><td class="n">{f0(sh.totals.loanLatest)}</td><td class="n">100.0</td><td class="n">{f0(sh.totals.gva)}</td><td class="n">100.0</td><td class="n">{f0(sh.totals.emp)}</td><td class="n">100.0</td></tr>
      </tbody>
    </table></div>
  </details>
  <ul class="notes">
    <li><b>대출</b>: 한국은행 대구경북본부 「대구경북지역 주요 경제지표」 대구 예금은행 산업별 대출금(분기 말 잔액). 은행 간·정부 대출을 뺀 민간 원화대출이고, 합계는 업종별 소계(기업 대출, 가계 대출 제외)입니다. 비은행·정책자금·회사채는 들어 있지 않습니다. 부가가치와 같은 해({sh.gvaYear}년) 말 값으로 막대를 그렸고, 최근 분기({qLabel(sh.latest)}) 값은 표에 함께 적었습니다.</li>
    <li><b>부가가치</b>: KOSIS 「시도별 경제활동별 지역내총생산」 대구 명목, 총부가가치(기초가격) 대비. <b>종사자</b>: 전국사업체조사 대구, 전체 산업 대비(농림어업은 개인 경영 농가가 빠짐). 세 값의 기준 연도가 다릅니다.</li>
    <li>'{OTHER}'은 합계에서 표의 10개 업종을 뺀 나머지입니다(정보통신·전문서비스·사업서비스·교육·보건·공공행정 등). 대출 자료에 업종이 따로 나오지 않습니다.</li>
    <li>제조업은 대출 자료가 하나로만 나와 자동차부품·기계 같은 세부 업종으로 나누지 않습니다.</li>
  </ul>

  <h3 class="sub">② 업종별 대출 잔액 추이 — 2020년 말 = 100</h3>
  <p class="meta">금액 크기가 달라도 늘어난 속도를 견줄 수 있게 2020년 말 잔액을 100으로 두었습니다. 모든 그래프의 세로축이 같습니다({yMin}–{yMax}). 점선 가로줄은 100, 세로 점선은 2025년 4분기입니다. 전기·가스·증기(잔액 3천억 원대, 2021년 4분기에 한 분기만 크게 튐)와 광업(수백억 원)은 잔액이 작아 표에만 둡니다.</p>
  <div class="sm">
    {ix.series.map(s => { const last = s.points[s.points.length - 1]; const d = s.points.map((p, k) => `${k ? 'L' : 'M'}${X(ix.periods.indexOf(p.p)).toFixed(1)},${Y(p.idx).toFixed(1)}`).join(' '); return (
      <figure class="panel">
        <figcaption><b>{s.key}</b> <span class="meta">{last ? `${qLabel(last.p)} ${f1(last.idx)} · ${eok(last.v)}` : ''}</span></figcaption>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${s.key} 대출 잔액 지수, 2020년 말 100에서 ${last ? qLabel(last.p) + ' ' + f1(last.idx) : ''}`}>
          {ticks.map(t => <g><line x1={pl} x2={W - pr} y1={Y(t)} y2={Y(t)} class={t === 100 ? 'base' : 'grid'} /><text x={pl - 4} y={Y(t) + 3} class="ax" text-anchor="end">{t}</text></g>)}
          {brk >= 0 && <line x1={X(brk)} x2={X(brk)} y1={pt} y2={H - pb} class="brk" />}
          {yearTicks.map(o => <text x={X(o.i)} y={H - 6} class="ax" text-anchor="middle">{o.p === '2020' ? '20말' : o.p.slice(2, 4)}</text>)}
          <path d={d} class="ln" />
          {s.points.map(p => <circle cx={X(ix.periods.indexOf(p.p))} cy={Y(p.idx)} r="5" class="hit"><title>{`${s.key} ${qLabel(p.p)}: 지수 ${f1(p.idx)}, 잔액 ${f0(p.v)}억 원`}</title></circle>)}
          {last && <circle cx={X(ix.periods.indexOf(last.p))} cy={Y(last.idx)} r="3" class="dot" />}
          {last && <text x={X(ix.periods.indexOf(last.p)) + 5} y={Y(last.idx) + 4} class="lv">{Math.round(last.idx)}</text>}
        </svg>
      </figure>
    ); })}
  </div>
  <details>
    <summary>표로 보기 (잔액, 억 원)</summary>
    <div class="scroll-x"><table class="data-table" data-title="대구 예금은행 업종별 대출 잔액(억 원)">
      <thead><tr><th>업종</th>{tablePeriods.map(p => <th class="n">{qShort(p)}</th>)}</tr></thead>
      <tbody>
        {ix.series.map(s => <tr><th scope="row">{s.key}</th>{tablePeriods.map(p => { const pt0 = s.points.find(x => x.p === p); return <td class="n">{pt0 ? f0(pt0.v) : '—'}</td>; })}</tr>)}
        {SECTORS.filter(s => TABLE_ONLY.includes(s.key)).map(s => <tr><th scope="row">{s.key}</th>{tablePeriods.map(p => <td class="n">{f0(loanSeries().val(s.loan, p))}</td>)}</tr>)}
      </tbody>
    </table></div>
  </details>
  <p class="callout warn">2025년 4분기에 업종별 소계가 한 분기 사이 4조 5천억 원가량 줄었습니다(부동산업·금융보험업·건설업 중심). 원 자료에 사유가 적혀 있지 않아 상환·매각·분류 변경 가운데 무엇인지 알 수 없습니다. 이 분기를 지나는 1년 전 대비 증감은 이 변동의 영향을 크게 받습니다. 최근 분기({qLabel(lastP)})는 잠정치입니다.</p>

  <h3 class="sub" id="cards">③ 업종 카드 — 대출·실물·체감·규모</h3>
  <p class="meta">기업 대출의 82%를 차지하는 다섯 업종입니다. 칸마다 최근 값과 1년 전(같은 달·분기) 대비 증감을 적고, 화살표는 방향만 표시합니다(좋고 나쁨이 아님). 지표마다 기준 시점이 다르고, 체감 지수(BSI)는 대구·경북을 합친 값입니다.</p>
  <div class="cards">
    {ic.cards.map(c => (
      <article class="icard">
        <h4>{c.key}</h4>
        <ul>
          {c.items.map(it => (
            <li>
              <span class="il"><span class="nm">{it.label}</span><span class="pd">{it.period}</span></span>
              <span class="iv">{it.value}</span>
              <span class="ic" aria-label={`1년 전 대비 ${dir(it.chg)} ${chgTxt(it)}`}><span class="ar" aria-hidden="true">{arrow(it.chg)}</span>{chgTxt(it)}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
  <p class="meta">업종 구분 없는 자금 용도(대구 예금은행 중소기업 대출, 전 업종): {ic.common.map(it => `${it.label} ${it.value}(${it.period}, 1년 전 대비 ${chgTxt(it)})`).join(' · ')}. 시설자금은 설비 투자, 운전자금은 원재료·인건비 같은 운영비에 쓰입니다.</p>
  <details>
    <summary>표로 보기 (카드 값과 출처)</summary>
    <div class="scroll-x"><table class="data-table" data-title="대구 업종 카드 — 대출·실물·체감·규모">
      <thead><tr><th>업종</th><th>지표</th><th>기준 시점</th><th class="n">값</th><th class="n">1년 전 대비</th><th data-pri="2">출처</th></tr></thead>
      <tbody>
        {ic.cards.flatMap(c => c.items.map((it, j) => <tr><th scope="row">{j === 0 ? c.key : ''}</th><td>{it.label}{it.note ? ` (${it.note})` : ''}</td><td>{it.period}</td><td class="n">{it.value}</td><td class="n">{chgTxt(it)}</td><td>{it.source}</td></tr>))}
        {ic.common.map((it, j) => <tr><th scope="row">{j === 0 ? '전 업종(참고)' : ''}</th><td>{it.label}</td><td>{it.period}</td><td class="n">{it.value}</td><td class="n">{chgTxt(it)}</td><td>{it.source}</td></tr>)}
      </tbody>
    </table></div>
  </details>
  <ul class="notes">
    <li>실물 지표: 제조업은 광공업 생산·출하지수(월, 원지수), 도소매·숙박음식·부동산은 서비스업 생산지수(분기, 불변지수), 건설은 건설수주액(월, 국가데이터처 건설경기동향조사), 도소매는 대형소매점 판매액지수(월)도 함께. 건설수주액은 한 달 값이라 큰 공사 한두 건에 크게 흔들립니다.</li>
    <li>규모: 전국사업체조사 종사자·사업체(최근 연도와 첫 연도 대비). 대출 증감과 실물 지표가 같은 방향인지 다른 방향인지는 읽는 사람이 판단합니다.</li>
  </ul>
  <p class="meta">출처: 한국은행 대구경북본부 「대구경북지역 주요 경제지표」(경제통계) 2.2.4 산업별 대출금(대구) · 국가데이터처 KOSIS 시도별 경제활동별 지역내총생산 · 전국사업체조사. 원 표 11개는 <a href="/stats/monthly/#bok-daegu">경기 동향 › 한국은행 대구 금융 지표</a>에 있습니다.</p>
</section>
)}
<style>
  .sub { font-size: var(--fs-h3, 1.1rem); margin: 1.4rem 0 .4rem; }
  .legend { display: flex; flex-wrap: wrap; gap: .3rem 1rem; list-style: none; padding: 0; margin: .3rem 0 .6rem; font-size: var(--small); color: var(--ink); }
  .legend li { display: flex; align-items: center; gap: .35rem; }
  .sw { width: .9rem; height: .55rem; border-radius: 2px; display: inline-block; }
  .s1 { background: var(--chart-1); } .s2 { background: var(--chart-2); } .s3 { background: var(--chart-3); }
  .bars { display: grid; gap: .55rem; margin-bottom: .6rem; }
  .row { display: grid; grid-template-columns: 8.5rem 1fr; gap: .6rem; align-items: center; }
  .lab { font-size: var(--small); text-align: right; line-height: 1.25; }
  .trio { display: grid; gap: 2px; }
  .b { display: flex; align-items: center; gap: .35rem; min-width: 0; }
  .bar { display: block; height: .55rem; border-radius: 0 4px 4px 0; flex: 0 0 auto; max-width: calc(100% - 3.2rem); }
  .v { font-size: .74rem; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 480px) { .row { grid-template-columns: 1fr; gap: .2rem; } .lab { text-align: left; font-weight: 600; } }
  tr.oth th, tr.oth td { color: var(--muted); }
  tr.tot th, tr.tot td { font-weight: 600; background: var(--surface); }
  .notes { font-size: var(--small); color: var(--muted); padding-left: 1.1rem; margin: .5rem 0 0; }
  .notes li { margin: .2rem 0; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: .8rem; margin: .5rem 0; }
  .icard { border: 1px solid var(--line); border-radius: var(--radius-2, 8px); padding: .6rem .75rem .4rem; background: var(--bg); }
  .icard h4 { margin: 0 0 .35rem; font-size: 1rem; }
  .icard ul { list-style: none; margin: 0; padding: 0; }
  .icard li { display: grid; grid-template-columns: 1fr auto 5.2rem; gap: .5rem; align-items: baseline; padding: .32rem 0; border-top: 1px solid var(--line); font-size: var(--small); }
  .icard li:first-child { border-top: 0; }
  .il { display: flex; flex-direction: column; min-width: 0; }
  .il .pd { color: var(--muted); font-size: .74rem; }
  .iv, .ic { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .iv { font-weight: 600; }
  .ic .ar { display: inline-block; width: 1em; margin-right: .15rem; color: var(--muted); }
  .sm { display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: .8rem; margin: .5rem 0; }
  .panel { margin: 0; border: 1px solid var(--line); border-radius: var(--radius-2, 8px); padding: .45rem .5rem .2rem; background: var(--bg); }
  .panel figcaption { font-size: var(--small); margin-bottom: .1rem; }
  .panel figcaption .meta { display: block; font-size: .78rem; }
  .panel svg { width: 100%; height: auto; display: block; }
