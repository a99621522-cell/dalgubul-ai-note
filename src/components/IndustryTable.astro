---
/** 산업 그룹별 기업 수·고용 인원·전월 증감·전년 증감 표. 행의 산업명이 산업별 페이지 링크. */
import Delta from './Delta.astro';
import { monthly, fmt, monthLabel } from '../lib/stats';
import { industryGroups } from '../lib/industry';
interface Props { month?: string; compact?: boolean }
const { month, compact = false } = Astro.props;
const m = monthly(month);
const groups = industryGroups();
const rows = m ? groups.filter(g => m.by_industry[g.name]).map(g => ({ ...g, s: m.by_industry[g.name] })) : [];
// 전월·전년 열은 값이 하나라도 있을 때만 (자료가 1개월뿐이면 '자료 없음' 열 두 개가 표를 차지한다)
const hasMom = !!m && (m.total.mom?.employment != null || rows.some(r => r.s.mom?.employment != null));
const hasYoy = !!m && (m.total.yoy?.employment != null || rows.some(r => r.s.yoy?.employment != null));
---
{m ? (
  <div class="scroll-x">
    <table class:list={["data-table", "industry-table", { wide: hasMom || hasYoy, compact: compact && !hasMom && !hasYoy }]}>
      <thead>
        <tr>
          <th scope="col">산업</th>
          <th scope="col" class="n">기업 수</th>
          <th scope="col" class="n">고용 인원</th>
          {hasMom && <th scope="col" class="n">전월 대비</th>}
          {hasYoy && <th scope="col" class="n">전년 동월 대비</th>}
          {!compact && <th scope="col" class="n col-opt">집계 대상</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map(r => (
          <tr>
            <th scope="row"><a href={`/industry/${r.key}/`}>{r.name}</a></th>
            <td class="n">{fmt(r.s.firms)}</td>
            <td class="n">{fmt(r.s.employment)}</td>
            {hasMom && <td class="n"><Delta d={r.s.mom?.employment ?? null} /></td>}
            {hasYoy && <td class="n"><Delta d={r.s.yoy?.employment ?? null} /></td>}
            {!compact && <td class="n col-opt">{fmt(r.s.covered)} / {fmt(r.s.firms)}</td>}
          </tr>
        ))}
        <tr class="total">
          <th scope="row">전체</th>
          <td class="n">{fmt(m.total.firms)}</td>
          <td class="n">{fmt(m.total.employment)}</td>
          {hasMom && <td class="n"><Delta d={m.total.mom?.employment ?? null} /></td>}
          {hasYoy && <td class="n"><Delta d={m.total.yoy?.employment ?? null} /></td>}
          {!compact && <td class="n col-opt">{fmt(m.total.covered)} / {fmt(m.total.firms)}</td>}
        </tr>
      </tbody>
    </table>
  </div>
) : <p class="empty">통계가 아직 없습니다. scripts/build_stats.py 를 먼저 실행하세요.</p>}
{m && !hasMom && <p class="meta table-note">전월·전년 대비는 월간 자료가 2개월 이상 쌓이면 표시됩니다(지금 {monthLabel(m.month)} 1개월).</p>}
<style>
  .table-note { margin: var(--s1) 0 0; }
  .industry-table th[scope="row"] { font-weight: 600; }
  .industry-table th[scope="row"] a { display: inline-flex; align-items: center; min-height: 28px; }
</style>
