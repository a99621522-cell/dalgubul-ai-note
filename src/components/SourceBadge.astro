---
/** 숫자 꼬리표(운영자 지시 2026-10-17): 국가통계 / 기관 자료 / 행정자료 / 이 사이트 계산 — 정의는 src/lib/keyIndicators.ts BADGE_DESC. 색이 아니라 글자·테두리 모양으로 가른다. */
import { BADGE_DESC, type Badge } from '../lib/keyIndicators';
interface Props { kind: Badge }
const { kind } = Astro.props;
const cls = { '국가통계': 'nat', '기관 자료': 'org', '행정자료': 'adm', '이 사이트 계산': 'calc' }[kind];
---
<span class={`sbadge sb-${cls}`} title={BADGE_DESC[kind]}>{kind}</span>
