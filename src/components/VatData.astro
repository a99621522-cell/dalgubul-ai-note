---
import { vatRules, vatPresets, vatOrgNumbers, vatCases, vatBai } from '../lib/vat';
/** 부가세 점검기 규칙(data/vat/rules.yml)을 페이지에 JSON 으로 묻는다 — src/scripts/vat_rules.ts loadData() 가 읽는다 */
const R = vatRules();
const json = JSON.stringify({ ...(R ?? {}), presets: vatPresets(), orgs: vatOrgNumbers(), cases: vatCases(), bai: vatBai().reports.map(r => ({ srno: r.srno, title: r.title, openDt: r.openDt, field: r.field, kind: r.kind, url: r.url, n: r.hits.length, core: r.core, heads: [...new Set(r.hits.map(h => h.head).filter(Boolean))].slice(0, 4) })) }).replace(/</g, '\\u003c');
---
<script type="application/json" id="vat-data" set:html={json}></script>
