---
import '../styles/global.css';
import { NAV, NAV_GROUPS, UTIL_LINKS, navItem } from '../nav';
import { latestMonth, monthLabel } from '../lib/stats';
import hwpxCompat from '../../data/hwpx/compat.json';   // 한글(HWPX) 승인 관문: approved 일 때만 HWP 단추(2026-10-06)
interface Props { title?: string; seoTitle?: string; description?: string; current?: string; tags?: string[]; jsonld?: object[]; ogType?: string; crumb?: string; nocrumb?: boolean; wide?: boolean }
const { title, seoTitle, description = '대구 산업단지·기업 현황과 산업별 고용 통계, 기업 사전, 지원사업 공고', current = '', tags = [], jsonld = [], ogType = 'website', crumb, nocrumb = false, wide = false } = Astro.props;
/** 브레드크럼(디자인·UI 개선 2차 2026-10-06): 홈 › 묶음 › 메뉴 › (crumb). 첫 화면과 nocrumb 페이지는 없음 */
/** 독립 사이트 모드(운영자 지시 2026-10-28 '새로운 사이트에 올려'): 빌드 때 VAT_SITE=1 이면 지자체 부가세 절감 점검기만 있는 사이트(.github/workflows/deploy_vat.yml — dist/vat 만 추려 별도 Cloudflare Pages 프로젝트에 올림)로, 헤더·유틸리티 바·드로어·바닥글을 점검기용으로 바꾼다. 다른 메뉴로 가는 링크가 없어야 한다 */
const VAT = !!process.env.VAT_SITE;
/** 다잇다 빌드에서는 점검기를 내린다(운영자 지시 2026-10-28 '다잇다 사이트에서는 내려. 성격이 다르잖아'): current='vat' 페이지는 본문 대신 옮김 안내(새 사이트 링크 + 5초 뒤 넘김)만 낸다 */
const VAT_PUBLIC = 'https://vat-daitda.pages.dev';
const MOVED = !VAT && current === 'vat';
const SITE_NAME = VAT ? '지자체 부가세 절감 점검기' : '다잇다';
const crumbMenu = NAV.find(n => n.key === current);
const crumbGroup = VAT || !crumbMenu ? undefined : NAV_GROUPS.find(g => (g.items as readonly string[]).includes(current));
const isHome = Astro.url.pathname === (VAT ? '/vat/' : '/');
const fullTitle = (seoTitle || title) ? `${seoTitle || title} — ${SITE_NAME}` : (VAT ? '지자체 부가세 절감 점검기 — 시·군·구 매입세액 점검' : '다잇다 — 대구 산업·기업 현황');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const lm = latestMonth();
const built = new Date().toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<!doctype html>
<html lang="ko" data-hwpx={hwpxCompat.approved ? '1' : undefined}>
<head>
  <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />{VAT && <meta name="robots" content="noindex" />}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
  {canonical && <link rel="canonical" href={MOVED ? VAT_PUBLIC + Astro.url.pathname : canonical} />}
  {MOVED && <meta http-equiv="refresh" content={`5;url=${VAT_PUBLIC}${Astro.url.pathname}`} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
  {!VAT && <link rel="alternate" type="application/rss+xml" title="다잇다" href="/rss.xml" />}
  {jsonld.map(obj => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  {!VAT && <div class="util-bar" aria-label="출처 기관 바로가기">
    <div class="wrap util-row">
      <ul>{UTIL_LINKS.map(u => <li><a href={u.href} rel="noopener">{u.name}</a></li>)}</ul>
      <ul><li><a href={VAT_PUBLIC + '/vat/'} rel="noopener">지자체 부가세 절감 점검기 ↗</a></li><li><a href="/posts/2026-09-13-about/">이 사이트에 대하여</a></li><li><a href="/search/">통합 검색</a></li></ul>
    </div>
  </div>}
  <header class="site-head">
    <div class="wrap row">
      {VAT ? <a class="brand" href="/vat/">지자체 부가세 절감 점검기<span class="tagline">신고하는 공무원용 · 브라우저 안 계산</span></a> : <a class="brand" href="/">다잇다<span class="tagline">대구 산업·기업 자료</span></a>}
      {VAT && <nav class="vat-ext" aria-label="바깥 링크"><a href="https://daitda.co.kr/" rel="noopener">다잇다 ↗ <span class="note">대구 산업·기업 자료</span></a></nav>}
      {!VAT && <nav class="nav" aria-label="주요 메뉴">
        {NAV_GROUPS.map(g => g.href ? <a class="ng-link" href={g.href} aria-current={g.items.includes(current as any) ? 'page' : undefined}>{g.name}</a> : (
          <div class="ng" data-open={g.items.includes(current as any) ? 'cur' : undefined}>
            <button type="button" class="ng-btn" aria-expanded="false" aria-controls={`ng-${g.key}`} aria-current={g.items.includes(current as any) ? 'true' : undefined}>{g.name}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
            <div class="ng-panel" id={`ng-${g.key}`} hidden>{g.items.map(k => { const n = navItem(k); return <a href={n.href} aria-current={current === k ? 'page' : undefined}>{n.name}</a>; })}</div>
          </div>))}
      </nav>}
      {!VAT && <a class="nav-search" href="/search/" aria-label="통합 검색" aria-current={current === 'search' ? 'page' : undefined}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg></a>}
      {!VAT && <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-drawer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span class="nt-m">메뉴</span><span class="nt-d">전체 메뉴</span></button>}
    </div>
    {!VAT && <div id="site-drawer" class="drawer" hidden>
      <div class="drawer-head wrap"><span>전체 메뉴</span><button type="button" class="drawer-close" aria-label="메뉴 닫기">✕</button></div>
      <nav aria-label="전체 메뉴" class="wrap drawer-grid">
        {NAV_GROUPS.map(g => <section class="drawer-g"><h2>{g.name}</h2><ul>{g.items.map(k => { const n = navItem(k); return <li><a href={n.href} aria-current={current === k ? 'page' : undefined}>{n.name}</a></li>; })}</ul></section>)}
        <section class="drawer-g"><h2>더 보기</h2><ul><li><a href={VAT_PUBLIC + '/vat/'} rel="noopener">지자체 부가세 절감 점검기 ↗ <span class="note">(별도 사이트)</span></a></li><li><a href="/search/">통합 검색</a></li><li><a href="/posts/">전체 글</a></li><li><a href="/supply-map/">대구·경북 품목 지도</a></li><li><a href="/posts/2026-09-13-about/">이 사이트에 대하여</a></li></ul></section>
      </nav>
    </div>}
  </header>
  <script>
    // 헤더: 묶음 펼침(클릭·키보드, 바깥 클릭·Esc 로 닫힘), 모바일 드로어. 서버 없음
    const head = document.querySelector('.site-head');
    if (head) {
      const groups = [...head.querySelectorAll<HTMLElement>('.ng')];
      const close = (except?: HTMLElement) => groups.forEach(g => { if (g !== except) { g.querySelector('button')!.setAttribute('aria-expanded', 'false'); g.querySelector<HTMLElement>('.ng-panel')!.hidden = true; } });
      groups.forEach(g => {
        const b = g.querySelector('button')!, p = g.querySelector<HTMLElement>('.ng-panel')!;
        b.addEventListener('click', () => { const open = b.getAttribute('aria-expanded') === 'true'; close(g); b.setAttribute('aria-expanded', String(!open)); p.hidden = open; if (!open) p.querySelector('a')?.focus({ preventScroll: true }); });
        g.addEventListener('keydown', e => { if (e.key === 'Escape') { close(); b.focus(); } });
        g.addEventListener('focusout', e => { if (!g.contains(e.relatedTarget as Node)) close(); });
      });
      document.addEventListener('click', e => { if (!head.contains(e.target as Node)) close(); });
      const tg = head.querySelector<HTMLButtonElement>('.nav-toggle'), dr = head.querySelector<HTMLElement>('#site-drawer'), cl = head.querySelector<HTMLButtonElement>('.drawer-close');
      const setDrawer = (open: boolean) => { if (!tg || !dr) return; tg.setAttribute('aria-expanded', String(open)); dr.hidden = !open; document.body.classList.toggle('drawer-open', open); (open ? cl : tg)?.focus({ preventScroll: true }); };
      tg?.addEventListener('click', () => setDrawer(tg.getAttribute('aria-expanded') !== 'true'));
      cl?.addEventListener('click', () => setDrawer(false));
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && dr && !dr.hidden) setDrawer(false); });
    }
  </script>
  <script>
    // 페이지 행동(리디자인 v3: 참조 디자인의 공유·인쇄 아이콘 — 아이콘 단독이 아니라 글자와 함께). 위치 표시 드롭다운은 하나만 열고 바깥 클릭·Esc 로 닫는다
    document.querySelectorAll<HTMLButtonElement>('.pa-btn').forEach(b => b.addEventListener('click', async () => {
      if (b.dataset.pa === 'print') { window.print(); return; }
      const span = b.querySelector('span')!; const old = span.textContent;
      try { await navigator.clipboard.writeText(location.href); span.textContent = '복사했습니다'; } catch { span.textContent = '주소창에서 복사'; }
      setTimeout(() => { span.textContent = old; }, 1800);
    }));
    const dds = [...document.querySelectorAll<HTMLDetailsElement>('.cr-dd')];
    dds.forEach(d => d.addEventListener('toggle', () => { if (d.open) dds.forEach(o => { if (o !== d) o.open = false; }); }));
    document.addEventListener('click', e => dds.forEach(d => { if (!d.contains(e.target as Node)) d.open = false; }));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') dds.forEach(d => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } }); });
  </script>
  <script>window.addEventListener('beforeprint', () => document.querySelectorAll('details').forEach(d => { d.open = true; }));</script>
  <script>import '../scripts/table_tools';</script>
  <script>import '../scripts/typeahead';</script>
  <script>import '../scripts/grid';</script>
  <script>import '../scripts/chart_tools';</script>
  <main id="main" class:list={['wrap', { wide }]}>
    {!isHome && (
      <div class="loc-row">
        {!nocrumb && (crumbMenu || crumb || title) ? (
        <nav class="crumbs" aria-label="현재 위치"><a href={VAT ? '/vat/' : '/'} class="cr-home">{VAT ? '시작' : '홈'}</a>
          {crumbGroup && (crumbGroup.href ? null : <> <span class="cr-sep" aria-hidden="true">›</span> <details class="cr-dd"><summary>{crumbGroup.name}</summary><ul>{NAV_GROUPS.map(g => <li><a href={g.href ?? navItem(g.items[0]).href} aria-current={g === crumbGroup ? 'true' : undefined}>{g.name}</a></li>)}</ul></details></>)}
          {crumbMenu && <> <span class="cr-sep" aria-hidden="true">›</span> {crumbGroup && crumbGroup.items.length > 1
            ? <details class="cr-dd"><summary aria-current={crumb ? undefined : 'page'}>{crumbMenu.name}</summary><ul>{crumbGroup.items.map(k => { const n = navItem(k); return <li><a href={n.href} aria-current={k === current ? 'page' : undefined}>{n.name}</a></li>; })}</ul></details>
            : (crumb ? <a href={crumbMenu.href}>{crumbMenu.name}</a> : <span aria-current="page">{crumbMenu.name}</span>)}</>}
          {crumb && <> <span class="cr-sep" aria-hidden="true">›</span> <span aria-current="page">{crumb}</span></>}
          {!crumbMenu && !crumb && title && <> <span class="cr-sep" aria-hidden="true">›</span> <span aria-current="page">{title}</span></>}
        </nav>) : <span></span>}
        <div class="page-acts" role="group" aria-label="이 페이지">
          <button type="button" class="pa-btn" data-pa="share"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg><span>링크 복사</span></button>
          <button type="button" class="pa-btn" data-pa="print"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2M6 14h12v7H6z"/></svg><span>인쇄</span></button>
        </div>
      </div>)}
    {MOVED ? <div class="section-head"><h1>지자체 부가세 절감 점검기는 따로 운영합니다</h1></div><p class="lede">이 도구는 대구 산업·기업 자료와 성격이 달라 별도 사이트로 옮겼습니다. <a href={VAT_PUBLIC + Astro.url.pathname}>{VAT_PUBLIC + Astro.url.pathname}</a> 에서 같은 화면이 열립니다(5초 뒤 자동으로 넘어갑니다). 이 브라우저에 두었던 설정·기록은 사이트(주소)마다 따로 저장되므로, 옮긴 뒤에는 <strong>인수인계 꾸러미(zip)</strong>나 org.json 파일로 가져가세요.</p><p class="meta"><a class="btn" href={VAT_PUBLIC + Astro.url.pathname}>새 사이트로 가기</a></p> : <slot />}
  </main>
  {VAT ? <footer class="site-foot"><div class="wrap">
      <p>지자체(시·군·구)와 시설관리공단이 내는 부가가치세의 매입세액을 조문대로 빠짐없이 공제하도록 돕는 도구입니다. 판정은 부가가치세법·시행령·시행규칙 조문의 참고용 계산이며 기관의 판단이 아니고, 신고 책임은 신고인에게 있습니다. 서버가 없어 입력은 이 브라우저와 내려받는 파일에만 남습니다. 담당자 이름·전화·개별 기관의 신고 금액은 싣지 않습니다.</p>
      <p><a href="https://daitda.co.kr/" rel="noopener">다잇다(대구 산업·기업 자료)</a>와 같은 저장소에서 만듭니다. 사이트 갱신일 {built}.</p>
    </div></footer> : <footer class="site-foot">
    <div class="wrap">
      <ul aria-label="출처와 안내">
        <li><a href="/posts/2026-09-13-about/">이 사이트에 대하여</a></li>
        <li><a href="/posts/2026-09-13-about/">정정 요청</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href={VAT_PUBLIC + '/vat/'} rel="noopener">지자체 부가세 절감 점검기(별도 사이트) ↗</a></li>
      </ul>
      <p>출처: 한국산업단지공단 팩토리온 입주업체현황{lm && ` (${monthLabel(lm)} 기준)`}, 기업마당·부처 사업설명자료·보도자료(공공누리 조건에 따라 출처 표시). 공개 자료를 같은 형식으로 옮긴 것이며 평가·순위·추천을 하지 않습니다.</p>
      <p>"AI 작성" 표시가 있는 글은 자동으로 쓰고 사람이 검토한 뒤 발행한 것입니다. 개인 의견은 소속 기관의 입장이 아닙니다. 사이트 갱신일 {built}.</p>
    </div>
  </footer>}
</body>
</html>
