---
import '../styles/global.css';
import { NAV, NAV_GROUPS, navItem } from '../nav';
import { latestMonth, monthLabel } from '../lib/stats';
interface Props { title?: string; seoTitle?: string; description?: string; current?: string; tags?: string[]; jsonld?: object[]; ogType?: string }
const { title, seoTitle, description = '대구 산업단지·기업 현황과 산업별 고용 통계, 기업 사전, 지원사업 공고', current = '', tags = [], jsonld = [], ogType = 'website' } = Astro.props;
const fullTitle = (seoTitle || title) ? `${seoTitle || title} — 다잇다` : '다잇다 — 대구 산업·기업 현황';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const lm = latestMonth();
const built = new Date().toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="다잇다" />
  <meta property="og:locale" content="ko_KR" />
  <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
  <link rel="alternate" type="application/rss+xml" title="다잇다" href="/rss.xml" />
  {jsonld.map(obj => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="site-head">
    <div class="wrap row">
      <a class="brand" href="/">다잇다<span class="tagline">대구 산업·기업 자료</span></a>
      <nav class="nav" aria-label="주요 메뉴">
        {NAV_GROUPS.map(g => g.href ? <a class="ng-link" href={g.href} aria-current={g.items.includes(current as any) ? 'page' : undefined}>{g.name}</a> : (
          <div class="ng" data-open={g.items.includes(current as any) ? 'cur' : undefined}>
            <button type="button" class="ng-btn" aria-expanded="false" aria-controls={`ng-${g.key}`} aria-current={g.items.includes(current as any) ? 'true' : undefined}>{g.name}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
            <div class="ng-panel" id={`ng-${g.key}`} hidden>{g.items.map(k => { const n = navItem(k); return <a href={n.href} aria-current={current === k ? 'page' : undefined}>{n.name}</a>; })}</div>
          </div>))}
      </nav>
      <a class="nav-search" href="/search/" aria-label="통합 검색" aria-current={current === 'search' ? 'page' : undefined}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg></a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-drawer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>메뉴</button>
    </div>
    <div id="site-drawer" class="drawer" hidden>
      <div class="drawer-head"><span>메뉴</span><button type="button" class="drawer-close" aria-label="메뉴 닫기">✕</button></div>
      <nav aria-label="전체 메뉴">
        {NAV_GROUPS.map(g => <section class="drawer-g"><h2>{g.name}</h2><ul>{g.items.map(k => { const n = navItem(k); return <li><a href={n.href} aria-current={current === k ? 'page' : undefined}>{n.name}</a></li>; })}</ul></section>)}
        <section class="drawer-g"><ul><li><a href="/search/">통합 검색</a></li><li><a href="/posts/">전체 글</a></li></ul></section>
      </nav>
    </div>
  </header>
  <script>
    // 헤더: 묶음 펼침(클릭·키보드, 바깥 클릭·Esc 로 닫힘), 모바일 드로어. 서버 없음
    const head = document.querySelector('.site-head');
    if (head) {
      const groups = [...head.querySelectorAll<HTMLElement>('.ng')];
      const close = (except?: HTMLElement) => groups.forEach(g => { if (g !== except) { g.querySelector('button')!.setAttribute('aria-expanded', 'false'); g.querySelector<HTMLElement>('.ng-panel')!.hidden = true; } });
      groups.forEach(g => {
        const b = g.querySelector('button')!, p = g.querySelector<HTMLElement>('.ng-panel')!;
        b.addEventListener('click', () => { const open = b.getAttribute('aria-expanded') === 'true'; close(g); b.setAttribute('aria-expanded', String(!open)); p.hidden = open; if (!open) p.querySelector('a')?.focus({ preventScroll: true }); });
        g.addEventListener('keydown', e => { if (e.key === 'Escape') { close(); b.focus(); } });
        g.addEventListener('focusout', e => { if (!g.contains(e.relatedTarget as Node)) close(); });
      });
      document.addEventListener('click', e => { if (!head.contains(e.target as Node)) close(); });
      const tg = head.querySelector<HTMLButtonElement>('.nav-toggle'), dr = head.querySelector<HTMLElement>('#site-drawer'), cl = head.querySelector<HTMLButtonElement>('.drawer-close');
      const setDrawer = (open: boolean) => { if (!tg || !dr) return; tg.setAttribute('aria-expanded', String(open)); dr.hidden = !open; document.body.classList.toggle('drawer-open', open); (open ? cl : tg)?.focus({ preventScroll: true }); };
      tg?.addEventListener('click', () => setDrawer(tg.getAttribute('aria-expanded') !== 'true'));
      cl?.addEventListener('click', () => setDrawer(false));
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && dr && !dr.hidden) setDrawer(false); });
    }
  </script>
  <script>window.addEventListener('beforeprint', () => document.querySelectorAll('details').forEach(d => { d.open = true; }));</script>
  <script>import '../scripts/table_tools';</script>
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="site-foot">
    <div class="wrap">
      <ul aria-label="출처와 안내">
        <li><a href="/posts/2026-09-13-about/">이 사이트에 대하여</a></li>
        <li><a href="/posts/2026-09-13-about/">정정 요청</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
      <p>출처: 한국산업단지공단 팩토리온 입주업체현황{lm && ` (${monthLabel(lm)} 기준)`}, 기업마당·부처 사업설명자료·보도자료(공공누리 조건에 따라 출처 표시). 공개 자료를 같은 형식으로 옮긴 것이며 평가·순위·추천을 하지 않습니다.</p>
      <p>"AI 작성" 표시가 있는 글은 자동으로 쓰고 사람이 검토한 뒤 발행한 것입니다. 개인 의견은 소속 기관의 입장이 아닙니다. 사이트 갱신일 {built}.</p>
    </div>
  </footer>
</body>
</html>
