---
// 없는 주소용 페이지. 이 파일이 있어야 Astro 가 dist/404.html 을 만들고,
// Cloudflare Pages 가 없는 주소에 진짜 404 를 돌려준다.
// (없으면 Pages 는 SPA 로 간주해 모든 주소에 첫 화면을 200 으로 내준다 — 검색엔진에 soft-404)
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../categories';
---
<Base title="페이지를 찾을 수 없습니다" description="요청하신 주소에 글이 없습니다. 첫 화면이나 분류 목록에서 다시 찾아보세요.">
  <div class="section-head"><h1>페이지를 찾을 수 없습니다</h1></div>
  <p class="meta">주소가 바뀌었거나 글이 내려갔을 수 있습니다. 아래에서 다시 찾아보세요.</p>
  <ul>
    <li><a href="/">첫 화면</a></li>
    {Object.entries(CATEGORIES).map(([id, c]) => (
      <li><a href={`/category/${id}/`}>{c.name}</a></li>
    ))}
    <li><a href="/companies/">기업 사전</a></li>
    <li><a href="/rss.xml">RSS</a></li>
  </ul>
</Base>
