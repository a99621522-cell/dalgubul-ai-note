---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import DeadlineStrip from '../../components/DeadlineStrip.astro';
import IndustrialCard from '../../components/IndustrialCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, type CategoryKey } from '../../categories';
export function getStaticPaths() {
  return Object.keys(CATEGORIES).map(cat => ({ params: { cat } }));
}
const cat = Astro.params.cat as CategoryKey;
const info = CATEGORIES[cat];
const posts = (await getCollection('posts', p => !p.data.draft && p.data.category === cat)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title={info.name} description={info.desc} current={cat}>
  <div class="section-head"><h1>{info.name}</h1></div>
  <p class="meta">{info.desc}</p>
  {cat === 'grants' && <DeadlineStrip posts={posts} />}
  {cat === 'economy' && <IndustrialCard compact={true} />}
  <PostList posts={posts} />
</Base>
