---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { companies, shortComplex, supportOf, recentSupport, fmtAmount, financialsOf, fmtEokWon, normName } from '../../lib/csv';
import { futureDisclosures, ymd, employeesOf, n0, mil, rndOf, investOf, purposeOf } from '../../lib/dart';
import { partners } from '../../lib/partners';
import { tagName, tagDesc } from '../../lib/sites';
import { companyStats, monthly, monthLabel, fmt } from '../../lib/stats';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return companies().map(c => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const pt = partners(c);
const supportAll = supportOf(c.id);
const support3y = recentSupport(supportAll, 3);
const fin = financialsOf(c.name).slice(0, 3);
const dartEmp = employeesOf(c.name).slice(0, 3);
const dartRndRows = rndOf(c.name).slice(0, 3);
const dartInv = investOf(c.name);
const fut = fin.length ? futureDisclosures().filter(d => normName(d.name) === normName(c.name)).slice(0, 8) : [];
const Row = (x: any) => x;
const related = (await getCollection('posts', p => !p.data.draft))
  .filter(p => p.data.title.includes(c.name) || p.data.summary.includes(c.name) || p.data.tags.includes(c.name))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 10);
const fromNps = (c.source || '').startsWith('국민연금');
const cs = companyStats(); const st = cs?.companies?.[c.id] ?? null; const m = monthly();
const series: (number | null)[] = st?.s ?? (st?.e != null ? [st.e] : []);
const months: string[] = (cs?.months ?? []).slice(-series.length);
const emp = series.length ? series.at(-1) : (st?.e ?? null);
const prev = series.length > 1 ? series.at(-2) : null;
const empDelta = emp != null && prev != null ? emp - prev : null;
const basis = st?.b === 'nps' ? '국민연금 가입자수' : '공장등록 신고값';
// 12개월 스파크라인 (자료가 1개월이면 점 하나)
const last12 = series.slice(-12); const vals = last12.filter((v): v is number => v != null);
const W = 240, H = 56, P = 6; const lo = vals.length ? Math.min(...vals) : 0, hi = vals.length ? Math.max(...vals) : 1;
const pts = last12.map((v, i) => v == null ? null : [P + (last12.length > 1 ? (i * (W - 2 * P)) / (last12.length - 1) : (W - 2 * P) / 2), H - P - (hi === lo ? (H - 2 * P) / 2 : ((v - lo) * (H - 2 * P)) / (hi - lo))] as [number, number]);
const poly = pts.filter(Boolean).map(q => `${q![0].toFixed(1)},${q![1].toFixed(1)}`).join(' ');
const srcName = fromNps ? '국민연금 사업장 내역' : '팩토리온';
const workersNote = fromNps ? '국민연금 가입자수' : '공장등록 신고값';
const desc = `${c.name} — ${c.district}${c.eupmyeon ? ' ' + c.eupmyeon : ''}, ${c.complex === '개별입지' ? '개별입지' : c.complex === '산단 외' ? '산단 외' : `${c.complex} 입주`}, ${c.sector.replace(/ 외 \d+ 종/, '')}${c.workers_band ? `, ${fromNps ? '가입자' : '종사자'} ${c.workers_band}` : ''}${c.product ? `, 생산품 ${c.product.split(',')[0]}` : ''}. ${srcName} ${c.as_of} 기준`;
const jsonld = [{ '@context': 'https://schema.org', '@type': 'Organization', name: c.name, address: c.address, description: desc,
  location: { '@type': 'Place', name: c.complex } }];
// 기업 카드 한 장(HWP·인쇄) — 화면과 같은 값만 담는다(src/scripts/company_card.ts). 대표자 등 개인정보 없음
const card = {
  id: c.id, name: c.name, district: c.district, desc, url: `https://daitda.co.kr/companies/${c.id}/`,
  rows: ([
    ['소재', `${c.district}${c.eupmyeon ? ' ' + c.eupmyeon : ''} · ${c.complex}`],
    ['업종', `${c.sector}${[c.sector_code, c.sector_group].filter(Boolean).length ? ` (${[c.sector_code, c.sector_group].filter(Boolean).join(', ')})` : ''}`],
    ['입지·구분', `${c.site_type}${c.tags.length ? ' · ' + c.tags.map(t => tagName(t)).join(', ') + ' (공개 명단 기준)' : ''}`],
    !fromNps && ['생산품', c.product || '—'],
    [fromNps ? '가입자' : '종사자', `${c.workers_band || '—'} (${workersNote})`],
    ['고용 인원', emp == null ? '자료 없음' : `${emp.toLocaleString('ko-KR')}명 (${basis}${m ? `, ${monthLabel(m.month)} 기준` : ''}${empDelta != null ? `, 전월 대비 ${empDelta > 0 ? '+' : ''}${empDelta.toLocaleString('ko-KR')}명` : ''})`],
    c.reg_type && ['공장 등록', `${c.reg_type === '등록' ? '등록 완료' : '설립 승인(등록 전)'}${c.first_registered ? ` · 최초 등록 ${c.first_registered}년` : ''}`],
    c.mfg_area_band && ['제조시설 규모', c.mfg_area_band],
    [`${fromNps ? '사업장 주소' : '공장 주소'}${Number(c.sites) > 1 ? ` (${c.sites}곳)` : ''}`, c.address],
  ] as any[]).filter(Boolean),
  support: support3y.map(s => [s.year, s.program, `${s.funder}${s.layer ? ` (${s.layer})` : ''}`, s.type || '—', fmtAmount(s)]),
  supportNote: support3y.length
    ? `공개 자료(NTIS 과제·대구시 보조금 공개·기관 선정 공고) 기준 ${support3y.length}건${supportAll.length > support3y.length ? `, 이전 ${supportAll.length - support3y.length}건` : ''}. 출처: ${[...new Set(support3y.map(s => s.source))].join(', ')}.`
    : `공개 자료(NTIS 과제·대구시 보조금 공개·기관 선정 공고)에서 확인된 최근 3년 이력 없음${supportAll.length ? ` (이전 ${supportAll.length}건)` : ''}. 비공개 자료는 싣지 않습니다.`,
  fin: fin.map(f => [f.year, fmtEokWon(f.revenue), fmtEokWon(f.operating_income), fmtEokWon(f.net_income)]),
  finNote: fin.length ? `금융감독원 전자공시 정기보고서(${fin[0].fs})의 값을 억 원으로 나눠 표시.` : '',
  partners: { stage: pt.stage, note: '업종 분류와 생산품으로 추정한 후보입니다. 거래 관계가 아니라 같은 단지·구군 안의 탐색용 목록이며, 확인은 기업이 직접 합니다. 순서는 같은 단지 → 같은 구·군 → 규모 순.',
    groups: [['공급 후보', pt.suppliers], ['수요 후보', pt.buyers], ['동종 업체', pt.peers]].map(([g, list]: any) => [g, list.slice(0, 4).map((x: any) => [x.name, shortComplex(x.complex), x.sector.replace(/ 외 \d+ 종/, ''), x.workers_band || '—'])]) },
  source: `${c.source}, 기준 ${c.as_of}`,
};
---
<Base title={c.name} description={desc} current="companies" jsonld={jsonld} nocrumb>
  <article class="post">
    <header>
      <p class="meta"><a href="/companies/">대구 기업 사전</a> › <a href={`/companies/?district=${encodeURIComponent(c.district)}`}>{c.district}</a> › {c.complex}</p>
      <h1>{c.name}</h1>
      <p class="lede">{desc}</p>
      <div class="tools co-actions">
        <button type="button" class="btn secondary" id="card-hwp" title="이 기업의 개요·지원 이력·재무·협업 후보를 PDF 한 장으로 받습니다">기업 카드 PDF</button>
        <button type="button" class="btn secondary" id="card-print" title="브라우저 인쇄 창으로 인쇄합니다">인쇄</button>
      </div>
    </header>
    <ul class="tiles co-tiles" aria-label="핵심 숫자">
      <li class="tile"><p class="label">고용 인원</p><p class="num">{emp == null ? <span class="unit">자료 없음</span> : <>{emp.toLocaleString('ko-KR')}<span class="unit">명</span></>}</p><p class="sub">{basis}{m ? ` · ${monthLabel(m.month)} 기준` : ''}{empDelta != null && ` · 전월 대비 ${empDelta > 0 ? '+' : ''}${empDelta.toLocaleString('ko-KR')}명`}{vals.length === 1 && ' · 월별 추이는 자료가 2개월부터'}</p></li>
      <li class="tile"><p class="label">지원 이력 (최근 3년)</p><p class="num">{support3y.length.toLocaleString('ko-KR')}<span class="unit">건</span></p><p class="sub">공개 자료 기준{supportAll.length > support3y.length && ` · 전체 ${supportAll.length}건`}</p></li>
      {vals.length >= 2 && <li class="tile spark"><p class="label">최근 12개월 고용 추이</p>
        {vals.length >= 2 ? (
          <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={`최근 ${last12.length}개월 고용 인원 추이`}>
            {poly.includes(' ') && <polyline points={poly} fill="none" stroke="var(--primary)" stroke-width="2" />}
            {pts.map(q => q && <circle cx={q[0]} cy={q[1]} r="3" fill="var(--primary)" />)}
          </svg>
        ) : <p class="sub">{vals.length === 1 ? `${vals[0].toLocaleString('ko-KR')}명 · 자료 1개월, 다음 달부터 추이` : '고용 자료 없음'}</p>}
        <p class="sub">{months.length ? `${months[Math.max(0, months.length - last12.length)]} ~ ${months.at(-1)} · 자료 ${last12.length}개월` : '월별 자료가 쌓이면 표시'}</p>
      </li>}
    </ul>
    <table class="card">
      <tbody>
        <tr><th>소재</th><td>{c.district}{c.eupmyeon && ` ${c.eupmyeon}`} · <a href={`/companies/?complex=${encodeURIComponent(c.complex)}`}>{c.complex}</a></td></tr>
        <tr><th>업종</th><td>{c.sector} <span class="meta">({[c.sector_code, c.sector_group].filter(Boolean).join(', ')})</span></td></tr>
        <tr><th>입지·구분</th><td>{c.site_type}{c.tags.length > 0 && <span> · {c.tags.map(t => <span class="tag primary" title={tagDesc(t)}>{tagName(t)}</span>)}</span>}{c.tags.length > 0 && <span class="meta"> (공개 명단 기준, 인증 여부는 원 기관에서 확인)</span>}</td></tr>
        {!fromNps && <tr><th>생산품</th><td>{c.product || '—'}</td></tr>}
        <tr><th>{fromNps ? '가입자' : '종사자'}</th><td>{c.workers_band || '—'}<span class="meta"> ({workersNote})</span></td></tr>
        {c.reg_type && <tr><th>공장 등록</th><td>{c.reg_type === '등록' ? '등록 완료' : '설립 승인(등록 전)'}{c.first_registered && ` · 최초 등록 ${c.first_registered}년`}</td></tr>}
        {c.mfg_area_band && <tr><th>제조시설 규모</th><td>{c.mfg_area_band}</td></tr>}
        <tr><th>{fromNps ? '사업장 주소' : '공장 주소'}{Number(c.sites) > 1 && ` (${c.sites}곳)`}</th><td>{c.address.split(' / ').map(a => <div>{a}</div>)}{fromNps && <div class="meta">국민연금 자료는 건물번호 없이 도로명까지만 제공합니다.</div>}</td></tr>
      </tbody>
    </table>
    <section class="partners" aria-label="협업 후보">
      <div class="section-head"><h2>협업 후보 찾기</h2><span class="meta">공정 단계: {pt.stage}</span></div>
      <p class="meta">업종 분류와 생산품으로 추정한 후보입니다. 거래 관계가 아니라 같은 단지·구군 안의 탐색용 목록이며, 확인은 기업이 직접 합니다. 순서는 같은 단지 → 같은 구·군 → 규모 순.</p>
      <div class="pt-grid">
        {[['공급 후보', pt.suppliers, '이 회사에 소재·가공·금형을 공급할 만한 곳'], ['수요 후보', pt.buyers, '이 회사 제품을 쓸 만한 다음 공정'], ['동종 업체', pt.peers, '같은 업종의 이웃 기업']].map(([title, list, hint]: any) => (
          <div class="pt-col">
            <h3>{title}</h3>
            <p class="meta">{hint}</p>
            {list.length === 0 ? <p class="empty">해당 후보 없음</p> : (<>
              <ul>{list.slice(0, 4).map((x: any) => (<li><a href={`/companies/${x.id}/`}>{x.name}</a><span class="co-meta">{shortComplex(x.complex)} · {x.sector.replace(/ 외 \d+ 종/, '')}{x.workers_band && ` · ${x.workers_band}`}</span></li>))}</ul>
              {list.length > 4 && <details class="pt-more"><summary>{list.length - 4}곳 더 보기</summary><ul>{list.slice(4).map((x: any) => (<li><a href={`/companies/${x.id}/`}>{x.name}</a><span class="co-meta">{shortComplex(x.complex)} · {x.sector.replace(/ 외 \d+ 종/, '')}{x.workers_band && ` · ${x.workers_band}`}</span></li>))}</ul></details>}
            </>)}
          </div>
        ))}
      </div>
    </section>
    {support3y.length === 0 ? <p class="meta empty-line"><strong>지원사업 이력(최근 3년)</strong> 공개 자료(NTIS 과제·대구시 보조금 공개·기관 선정 공고)에서 확인된 이력 없음{supportAll.length > 0 && ` · 이전 ${supportAll.length}건`}. 비공개 자료는 싣지 않습니다.</p> : (
    <section class="support" aria-label="지원사업 이력">
      <div class="section-head"><h2>지원사업 이력 (최근 3년)</h2><span class="meta">{support3y.length}건{supportAll.length > support3y.length && ` · 이전 ${supportAll.length - support3y.length}건`}</span></div>
      {(
        <div class="scroll-x"><table class="data-table">
          <thead><tr><th>연도</th><th>사업명</th><th>지원기관</th><th>유형</th><th class="n">금액</th><th>출처</th></tr></thead>
          <tbody>{support3y.map(s => (<tr><td>{s.year}</td><td>{s.program}</td><td>{s.funder}{s.layer && ` (${s.layer})`}</td><td>{s.type || '—'}</td><td class="n">{fmtAmount(s)}</td><td>{s.source_url ? <a href={s.source_url} rel="noopener">{s.source}</a> : s.source}{s.as_of && <span class="meta"> {s.as_of}</span>}</td></tr>))}</tbody>
        </table></div>
      )}
    </section>)}
    {(fin.length > 0 || dartEmp.length > 0 || dartRndRows.length > 0 || dartInv.length > 0) && (
      <section class="fin" aria-label="공시 재무">
        {fin.length > 0 && (<>
        <div class="section-head"><h2>재무 (DART 공시)</h2><span class="meta">{fin[0].fs} 기준</span></div>
        <div class="scroll-x"><table class="data-table">
          <thead><tr><th>사업연도</th><th class="n">매출액</th><th class="n">영업이익</th><th class="n">당기순이익</th><th class="n">자산총계</th><th class="n">부채총계</th><th class="n">자본총계</th><th>원문</th></tr></thead>
          <tbody>{fin.map(f => (<tr><td>{f.year}</td><td class="n">{fmtEokWon(f.revenue)}</td><td class="n">{fmtEokWon(f.operating_income)}</td><td class="n">{fmtEokWon(f.net_income)}</td><td class="n">{fmtEokWon(f.total_assets ?? '')}</td><td class="n">{fmtEokWon(f.total_liabilities ?? '')}</td><td class="n">{fmtEokWon(f.total_equity ?? '')}</td><td>{f.source_url ? <a href={f.source_url} rel="noopener">사업보고서</a> : '—'}</td></tr>))}</tbody>
        </table></div>
        <p class="meta">금융감독원 전자공시 사업보고서의 값을 억 원으로 나눠 표시. 상장·공시대상 기업만 자료가 있습니다. 직원·연구개발비·출자·공시를 모은 <a href={`/listed/${fin[0].corp_code}/`}>회사 공시 페이지</a> · 전체는 <a href="/listed/">대구시 상장기업</a>.</p>
        </>)}
        {dartEmp.length > 0 && (<>
          <h3>직원 현황 (DART 사업보고서)</h3>
          <div class="scroll-x"><table class="data-table">
            <thead><tr><th>사업연도</th><th class="n">직원 수</th><th class="n">정규직</th><th class="n">기간제</th><th class="n">남</th><th class="n">여</th><th class="n">평균 근속(년)</th><th class="n">1인 평균 급여(백만 원)</th><th>원문</th></tr></thead>
            <tbody>{dartEmp.map(e => (<tr><td>{e.year}</td><td class="n">{n0(e.employees)}</td><td class="n">{n0(e.regular)}</td><td class="n">{n0(e.contract)}</td><td class="n">{n0(e.male)}</td><td class="n">{n0(e.female)}</td><td class="n">{e.avg_tenure ? Number(e.avg_tenure).toFixed(1) : '—'}</td><td class="n">{mil(e.avg_salary)}</td><td>{e.source_url ? <a href={e.source_url} rel="noopener">사업보고서</a> : '—'}</td></tr>))}</tbody>
          </table></div>
          <p class="meta">사업보고서 '직원 등의 현황'(회사 단위 집계). 1인 평균 급여는 연간 급여 총액 ÷ 직원 수, 평균 근속은 사업부문·성별 행을 직원 수로 가중한 값입니다.</p>
        </>)}
        {dartRndRows.length > 0 && (<>
          <h3>연구개발비 (DART 사업보고서)</h3>
          <div class="scroll-x"><table class="data-table">
            <thead><tr><th>사업연도</th><th class="n">연구개발비(억 원)</th><th class="n">매출액 대비(%)</th></tr></thead>
            <tbody>{dartRndRows.map(r => <tr><td>{r.year}</td><td class="n">{(Number(r.rnd_won) / 1e8).toLocaleString('ko-KR', { maximumFractionDigits: 1, minimumFractionDigits: 1 })}</td><td class="n">{r.ratio_pct ? Number(r.ratio_pct).toFixed(2) : '—'}</td></tr>)}</tbody>
          </table></div>
          <p class="meta">사업보고서 원문 '연구개발 활동' 표의 연구개발비용 합계·매출액 대비 비율(공시 값). <a href={dartRndRows[0].source_url} rel="noopener">원문</a></p>
        </>)}
        {dartInv.length > 0 && (<>
          <h3>타법인 출자 현황 (DART 사업보고서, {dartInv[0].year}년)</h3>
          <div class="scroll-x"><table class="data-table">
            <thead><tr><th>피출자 법인</th><th>목적</th><th class="n">기말 지분율(%)</th><th>최초 취득</th></tr></thead>
            <tbody>{dartInv.slice(0, 15).map(r => <tr><td>{r.inv_name}</td><td>{purposeOf(r.purpose)}</td><td class="n">{r.end_share_pct || '—'}</td><td>{r.first_acq_date || '—'}</td></tr>)}</tbody>
          </table></div>
          <p class="meta">기말 지분율 높은 순{dartInv.length > 15 && ` 15건(전체 ${dartInv.length}건은 원문)`}. 장부가액은 공시 단위가 회사마다 달라 싣지 않았습니다. <a href={dartInv[0].source_url} rel="noopener">원문</a></p>
        </>)}
        {fut.length > 0 && (<>
          <h3>미래 산업 관련 공시 (최근 12개월)</h3>
          <ul class="fut">{fut.map(d => <li><span class="meta">{ymd(d.rcept_dt)}</span> <a href={d.url} rel="noopener">{d.report_nm}</a> <span class="meta">· {d.fields}</span></li>)}</ul>
          <p class="meta">공시 원문에 미래 산업 낱말이 나온 투자·계약·지분·특허 공시입니다(분야는 낱말 기준이며 주력 사업이라는 뜻이 아님).</p>
        </>)}
      </section>
    )}
    {related.length > 0 ? <div class="print-hide"><section class="section-head"><h2>관련 글</h2></section><PostList posts={related} /></div> : <p class="meta empty-line print-hide"><strong>관련 글</strong> 아직 이 기업을 다룬 글 없음 · 공개된 뉴스·공시가 수집되면 여기에 쌓입니다.</p>}
    <aside class="source-box">
      <strong>출처</strong> {c.source}, 기준 {c.as_of}. 공개 자료를 그대로 옮긴 것으로 평가·추천이 아닙니다. 종사자(또는 가입자) 수는 구간으로만 표시합니다. 지원 이력·재무는 공개 자료(NTIS·대구시 보조금 공개·기관 선정 공고·DART)에서만 가져오며 비공개 자료는 싣지 않습니다. 정정 요청은 소개 페이지 연락처로.
    </aside>
  </article>
  <script type="application/json" id="card-data" set:html={JSON.stringify(card)} />
