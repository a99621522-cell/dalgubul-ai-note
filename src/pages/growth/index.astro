---
import Base from '../../layouts/Base.astro';
import GrowthCommentary from '../../components/GrowthCommentary.astro';
import GrowthAsk from '../../components/GrowthAsk.astro';
import GrowthStructure from '../../components/GrowthStructure.astro';
import GrdpCalculator from '../../components/GrdpCalculator.astro';
import GrowthPolicy from '../../components/GrowthPolicy.astro';
import GrowthMethod from '../../components/GrowthMethod.astro';
/** /growth/ — 성장 계산기(메뉴, 운영자 지시 2026-10-05). 2026-10-07 단순화(운영자 지시 '5가지 그대로 해'): ① 첫 화면은 질문 하나(목표 성장률)와 표 하나(GrowthAsk)
 *  ② 계산기 셋은 탭(업종별 가정 / 정책 과제 / 목표에서 거꾸로) ③ 정책 과제는 5개만 보이고 나머지는 '더 보기', 과제마다 세부 칸은 '자세히'
 *  ④ 설명은 한 줄 요약 + 맨 아래 '계산 방법' 한 곳(GrowthMethod) ⑤ 머리 숫자 넷만 크게, 폭·범위·검산은 작게/자세히. 계산은 그대로. 전망·평가가 아니다. 대구시 예산액은 싣지 않는다. */
---
<Base title="성장 계산기" description="대구 업종별 성장률 가정으로 실질 GRDP 성장률과 고부가 3부문 비중·산업집중도를 함께 계산하고, 목표 성장률에 닿으려면 어느 업종 묶음이 몇 % 성장해야 하는지 보여 주는 계산기(산업구조지수 리포트와 같은 정의)." current="growth">
  <div class="section-head"><h1>성장 계산기</h1><span class="meta">대구 GRDP · 2015→2024년 · 국가데이터처·한국은행·한국관광공사 자료</span></div>
  <p class="lede">목표 성장률을 넣으면 어느 업종 묶음이 몇 % 성장해야 하는지 보이고, 아래 탭에서 업종별 가정·대구시 정책 과제·목표에서 거꾸로를 따로 넣어 볼 수 있습니다. 정의는 산업구조지수 리포트와 같고, 가정에 따른 계산이지 전망이나 평가가 아닙니다.</p>
  <GrowthAsk />
  <details class="gc-wrap"><summary>AI 해설(운영자 확인본) 펼치기 — 계산값이 바뀌면 다시 쓰고 운영자가 다시 확인한 뒤 갱신됩니다</summary><GrowthCommentary /></details>
  <nav class="gtabs" role="tablist" aria-label="계산기 고르기">
    <button type="button" role="tab" data-tab="gs" aria-selected="true">업종별 가정</button>
    <button type="button" role="tab" data-tab="gp" aria-selected="false">대구시 정책 과제</button>
    <button type="button" role="tab" data-tab="calc" aria-selected="false">목표에서 거꾸로</button>
  </nav>
  <div class="gpanel" data-panel="gs"><GrowthStructure /></div>
  <div class="gpanel" data-panel="gp" hidden><GrowthPolicy /></div>
  <div class="gpanel" data-panel="calc" hidden><GrdpCalculator /></div>
  <GrowthMethod />
  <script>
    // 탭: 패널은 모두 DOM 에 있고(각 계산기 스크립트는 그대로 동작) 보이기만 바꾼다. 해시 #gs·#gp·#calc 로 열 수 있다
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.gtabs [data-tab]'));
    const show = (k: string) => { tabs.forEach(b => b.setAttribute('aria-selected', String(b.dataset.tab === k))); document.querySelectorAll<HTMLElement>('.gpanel').forEach(p => { p.hidden = p.dataset.panel !== k; }); };
    tabs.forEach(b => b.addEventListener('click', () => { show(b.dataset.tab!); history.replaceState(null, '', '#' + b.dataset.tab); }));
    const h = location.hash.replace('#', ''); if (['gs', 'gp', 'calc'].includes(h)) show(h); else if (h.startsWith('gp=')) show('gp');
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#gs"], a[href^="#gp"], a[href^="#calc"]').forEach(a => a.addEventListener('click', () => show(a.getAttribute('href')!.slice(1))));
    // 첫 화면 목표 칸 → 목표 계산기의 목표 칸에도 같은 값
    const t = document.getElementById('gst') as HTMLInputElement | null;
    t?.addEventListener('input', () => { const x = document.getElementById('gt') as HTMLInputElement | null; if (x) { x.value = t.value; x.dispatchEvent(new Event('input', { bubbles: true })); } });
  </script>
  <style>
    .gtabs { display: flex; gap: 6px; flex-wrap: wrap; margin: var(--s3) 0 var(--s2); border-bottom: 1px solid var(--line); }
    .gtabs button { border: 1px solid var(--line); border-bottom: 0; border-radius: 8px 8px 0 0; background: var(--surface); color: var(--ink); padding: 8px 14px; font: inherit; font-weight: 600; cursor: pointer; min-height: 40px; }
    .gtabs button[aria-selected="true"] { background: var(--primary); color: #fff; border-color: var(--primary); }
    .gpanel { margin-top: 0; }
    .gc-wrap { margin: var(--s2) 0; } .gc-wrap > summary { cursor: pointer; font-size: var(--small); color: var(--muted); }
  </style>
</Base>
