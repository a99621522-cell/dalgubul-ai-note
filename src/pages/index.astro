---
/** 첫 화면: 표제·인기 검색어·통합 검색창·사업 DB 건수(HomeHero) → 리포트 회전 카드 → 큰 숫자 4개 → 산업단지·특구별 기업(ZoneSummary) → 산업별 현황 표 → 고용 추이 → 최신 글 5개 */
import Base from '../layouts/Base.astro';
import StatTiles, { type Tile } from '../components/StatTiles.astro';
import IndustryTable from '../components/IndustryTable.astro';
import Chart from '../components/Chart.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { monthly, monthLabel, statMonths } from '../lib/stats';
import { supportHistory, recentSupport } from '../lib/csv';
import { policyReports } from '../lib/reports';
import HomeHero from '../components/HomeHero.astro';
import ReportCarousel from '../components/ReportCarousel.astro';
import ZoneSummary from '../components/ZoneSummary.astro';
const reports = await policyReports();

const all = (await getCollection('posts', p => !p.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = all.slice(0, 5);
const today = new Date(); today.setHours(0, 0, 0, 0);
const sup3 = recentSupport(supportHistory(), 3);
const supportedFirms = new Set(sup3.filter(s => s.id).map(s => s.id)).size;
const hasSupport = supportHistory().length > 0;

const m = monthly();
const nMonths = statMonths().length;
const ym = m ? monthLabel(m.month) : '';
// 등록 기업은 팩토리온 기준월(국민연금 달보다 앞설 수 있다 — 운영자 지적 2026-10-08 '8월 기준으로 표시되어 있는데'), 고용은 국민연금 기준월
const fo = m?.sources?.factoryon?.as_of ? monthLabel(m.sources.factoryon.as_of) : ym;
const ymHead = fo === ym ? `${ym} 기준` : `기업 등록 ${fo} · 고용 ${ym} 기준`;
const pct = (a: number, b: number) => (b ? `${Math.round((a / b) * 100)}%` : '—');
const tiles: Tile[] = m ? [
  { label: '등록 기업', value: m.total.firms, unit: '곳', sub: `${fo} 기준 · 팩토리온 공장등록`, href: '/companies/' },
  { label: '고용 인원', value: m.total.employment, unit: '명', delta: m.total.mom?.employment ?? null,
    sub: `${ym} 기준 · ${m.basis_label} · 집계 대상 ${m.total.covered.toLocaleString('ko-KR')}곳(${pct(m.total.covered, m.total.firms)})` },
  { label: '이달 신규 등록 기업', value: m.total.new_firms, unit: '곳', sub: m.total.new_firms === null ? `${ym} 기준 · 전월 자료가 쌓이면 표시` : `${ym} 기준 · 전월 대비 새로 등록` },
  { label: '지원사업 수혜 기업 (최근 3년)', value: hasSupport ? supportedFirms : null, unit: '곳', sub: hasSupport ? `NTIS·대구시 보조금 공개·기관 선정 공고 기준 · 이력 ${sup3.length.toLocaleString('ko-KR')}건` : '공개 자료(NTIS·보조금 공개·선정 공고) 투입 전', href: '/programs/' },
] : [];
const description = m
  ? `대구 공장등록 기업 ${m.total.firms.toLocaleString('ko-KR')}곳(${fo}), 고용 인원 ${m.total.employment.toLocaleString('ko-KR')}명(${ym}, ${m.basis_label}). 산업별 기업 수·고용과 월별 추이, 기업 사전, 지원사업 공고.`
  : '대구 산업단지·기업 현황과 산업별 고용 통계, 기업 사전, 지원사업 공고';
---
<Base description={description}>
  <HomeHero />
  <ReportCarousel reports={reports} />
  {m ? (
    <>
      <section aria-labelledby="h-now" class="section">
        <div class="section-head"><h2 id="h-now">대구 산단·기업 현황</h2><span class="meta">{ymHead}</span></div>
        <StatTiles tiles={tiles} />
      </section>
      <ZoneSummary />
      <section aria-labelledby="h-ind">
        <div class="section-head"><h2 id="h-ind">산업별 현황</h2><a href="/industry/">산업별 자세히</a></div>
        <IndustryTable compact={true} />
        <p class="meta">고용 인원은 {m.basis_label}. 집계 대상은 국민연금 사업장과 이어진 기업 {m.total.covered.toLocaleString('ko-KR')}곳 / 전체 {m.total.firms.toLocaleString('ko-KR')}곳(같은 사업장에 이어진 공장 기록은 고용을 한 번만 더함).{m.basis === 'nps' && m.total.fo_employment != null && ` 공장등록 종사자(팩토리온 신고값)는 ${m.total.fo_covered?.toLocaleString('ko-KR')}곳 ${m.total.fo_employment.toLocaleString('ko-KR')}명으로 근거가 달라 따로 적습니다.`} 산업 그룹은 표준산업분류(KSIC) 코드로 나눴습니다.</p>
      </section>
      <section aria-labelledby="h-trend">
        <div class="section-head"><h2 id="h-trend">고용 인원 추이</h2><a href={`/stats/${m.month}/`}>이달 통계표</a></div>
        {nMonths >= 2
          ? <Chart kind="total" name="employment" caption="대구 전체 고용 인원 추이" />
          : <p class="meta note-box">월간 자료가 {ym} 1개월뿐이라 추이 그래프는 다음 달부터 그립니다. 지금 값은 위 큰 숫자와 <a href={`/stats/${m.month}/`}>이달 통계표</a>에 있습니다.</p>}
      </section>
    </>
  ) : <p class="empty">통계가 아직 없습니다. scripts/build_stats.py 를 먼저 실행하세요.</p>}
  <section aria-labelledby="h-posts" class="section">
    <div class="section-head"><h2 id="h-posts">최신 글</h2><a href="/posts/">전체 글</a></div>
    <PostList posts={latest} />
  </section>
</Base>
<style>
  .note-box { margin: 0; padding: var(--s2); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
</style>
