---
import Base from '../../layouts/Base.astro';
import IndustryTable from '../../components/IndustryTable.astro';
import Chart from '../../components/Chart.astro';
import { monthly, monthLabel, fmt } from '../../lib/stats';
import { industryGroups } from '../../lib/industry';
/** /industry/ — 산업 그룹 11개 목록: 표(기업 수·고용·증감) → 막대 그래프 → 그룹별 카드(링크). 순위·평가 없음, 그룹 순서는 규칙 파일 순서. */
const m = monthly();
const ym = m ? monthLabel(m.month) : '';
const groups = industryGroups().filter(g => m?.by_industry[g.name]);
const description = m ? `대구 산업 그룹 11개의 기업 수·고용 인원(${ym}, ${m.basis_label})과 월별 추이. 그룹별 단지 분포·지원 이력·기업 목록으로 이어집니다.` : '대구 산업별 기업·고용 통계';
---
<Base title="산업별 현황" description={description} current="industry">
  <div class="section-head"><h1>산업별 현황</h1><span class="meta">{ym} 기준 · {m?.basis_label}</span></div>
  <p class="lede">표준산업분류(KSIC) 코드와 생산품 키워드로 11개 그룹으로 나눈 대구 기업 {fmt(m?.total.firms ?? null)}곳의 현황입니다. 고용 인원은 {m?.basis_label ?? '국민연금 가입자수'}이며 값이 있는 기업만 집계합니다. 순위나 평가는 하지 않습니다. 대구·경북 기업이 만드는 품목을 특정국 의존 품목과 맞춰 본 <a href="/supply-map/">대구·경북 품목 지도</a>도 있습니다.</p>
  {m ? (
    <>
      <IndustryTable />
      <p class="meta">그룹 규칙은 <code>config/industry_groups.yml</code> 하나로 관리하며, 산업명을 누르면 그룹별 페이지로 갑니다.</p>
      <section aria-labelledby="h-bar">
        <div class="section-head"><h2 id="h-bar">그룹별 고용·기업 수</h2><a href="/industry/compare/">추이 비교</a></div>
        <div class="chart-pair">
          <Chart kind="industry-bar" name="employment" caption={`산업 그룹별 고용 인원, ${ym}`} />
          <Chart kind="industry-bar" name="firms" caption={`산업 그룹별 기업 수, ${ym}`} />
        </div>
      </section>
      <section aria-labelledby="h-cards">
        <div class="section-head"><h2 id="h-cards">그룹별 페이지</h2></div>
        <ul class="ind-links">
          {groups.map(g => { const s = m.by_industry[g.name]; return (
            <li><a href={`/industry/${g.key}/`}>{g.name}</a> <span class="meta">{fmt(s.firms)}곳 · {fmt(s.employment)}명{s.support_3y ? ` · 지원 이력(3년) ${fmt(s.support_3y.firms)}곳` : ''}</span></li>
          ); })}
        </ul>
      </section>
    </>
  ) : <p class="empty">통계가 아직 없습니다. scripts/build_stats.py 를 먼저 실행하세요.</p>}
</Base>
<style>
  .ind-links { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: var(--s4); }
  @media (max-width: 600px) { .ind-links { columns: 1; } }
  .ind-links li { break-inside: avoid; padding: 6px 0; border-bottom: 1px solid var(--line); }
  .ind-links a { font-weight: 700; text-decoration: none; }
  .ind-links a:hover, .ind-links a:focus-visible { text-decoration: underline; }
</style>
