---
import Base from '../../layouts/Base.astro';
import { dartCorps, eok, ymd, opMargin, revGrowth, pct1, pct1n, debtRatio, n0, mil, purposeOf, isListed, productsByCode, empByCode, rndByCode, invByCode, futByCode, qByCode, qKey, qLabel, qPrev, perfByCode, mgmtByCode } from '../../lib/dart';
import { companies, normName } from '../../lib/csv';
/** /listed/<corp_code>/ — 대구시 상장기업 회사별 페이지(운영자 지시 2026-10-05). DART 공시 값만: 재무(최근 3개 사업연도)·직원·연구개발비·타법인 출자·
 *  미래 산업 관련 공시. 원 → 억 원 나눗셈만, 비율·순위·평가 없음. 대표자 등 개인 정보 없음. corp_code 는 DART 고유번호라 바뀌지 않는다. */
export function getStaticPaths() {
  return dartCorps().corps.map(c => ({ params: { code: c.code } }));
}
const { code } = Astro.params;
const { corps, years } = dartCorps();
const c = corps.find(x => x.code === code)!;
const listed = isListed(c.cls);
const prods = productsByCode(c.code);
const emp = empByCode(c.code);
const empYears = [...emp].reverse().slice(-3);
const rnd = rndByCode(c.code);
const rndRows = [...rnd].reverse().slice(-3);
const inv = invByCode(c.code);
const fut = futByCode(c.code);
const local = new Set([...companies().map(x => normName(x.name)), ...corps.map(x => normName(x.name))]);
const f = (won?: string) => { const v = eok(won); return v == null ? '—' : v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }); };
const ACC: [keyof typeof c.years[string], string][] = [['revenue', '매출액'], ['operating_income', '영업이익'], ['net_income', '당기순이익'], ['total_assets', '자산총계'], ['total_liabilities', '부채총계'], ['total_equity', '자본총계']];
const finYears = years.filter(y => c.years[y]);
const revAcc = finYears.map(y => c.years[y]?.revenue_account).find(a => a && a !== '매출액');   // 금융회사: 영업수익 등을 매출액 자리에(운영자 지시 2026-10-06)
if (revAcc) ACC[0] = ['revenue', `매출액(${revAcc})`];
const qs = qByCode(c.code).slice(-6);
const perf = perfByCode(c.code);
const mg = mgmtByCode(c.code);
const qYoYc = (q: (typeof qs)[number], col: 'revenue' | 'operating_income' | 'net_income') => { const a = Number(q[col]), b = Number(qPrev(q, col)); return q[col] && b > 0 && a > 0 ? pct1(((a / b) - 1) * 100) : '—'; };
const fsKind = [...new Set(finYears.map(y => c.years[y].fs))].join('·');
---
<Base title={`${c.name} — 대구시 상장기업`} description={`${c.name}(${c.cls}${c.stock ? ' ' + c.stock : ''}, 대구 ${c.district}) DART 공시: 최근 3개 사업연도 재무·직원·연구개발비·타법인 출자·미래 산업 관련 공시.`} current="listed" crumb={c.name}>
  <div class="section-head"><h1>{c.name}</h1><span class="meta">{listed ? `${c.cls} 상장` : '비상장(사업보고서 제출)'}{c.stock && ` · 종목코드 ${c.stock}`}</span></div>
  <dl class="facts">
    <div><dt>본사</dt><dd>대구 {c.district || '—'}</dd></div>
    <div><dt>분야(업종)</dt><dd>{c.ksicName || c.group}<span class="meta"> · {c.ksic || '—'}</span></dd></div>
    <div><dt>산업 그룹</dt><dd>{c.group}</dd></div>
    <div><dt>DART</dt><dd><a href={`https://dart.fss.or.kr/dsab007/main.do?option=corp&textCrpNm=${encodeURIComponent(c.name)}`} rel="noopener">공시 목록</a></dd></div>
    {c.companyId && <div><dt>기업 사전</dt><dd><a href={`/companies/${c.companyId}/`}>공장등록 기업 페이지</a></dd></div>}
  </dl>
  {c.companyId && <p class="meta">기업 사전 연결은 회사 이름이 공장등록 이름과 같은 경우입니다. 같은 이름의 다른 사업장일 수 있습니다.</p>}

  {mg && (mg.overview || mg.outlook || mg.new_biz) && (
  <section>
    <div class="section-head"><h2>경영진 진단·방향</h2><span class="meta">{mg.report_year}년 사업보고서 · 회사 공시 문구</span></div>
    <dl class="mgmt">
      {mg.overview && <div><dt>회사 상황</dt><dd>“{mg.overview}”</dd></div>}
      {mg.outlook && <div><dt>향후 방향</dt><dd>“{mg.outlook}”</dd></div>}
      {mg.new_biz && <div><dt>신사업·진출</dt><dd>“{mg.new_biz}”</dd></div>}
    </dl>
    <p class="meta">사업보고서 「이사의 경영진단 및 분석의견」과 「사업의 내용」에서 뽑은 회사 문장 그대로(항목마다 앞부분 220자까지)입니다. 이 사이트의 요약·평가가 아닙니다. <a href={mg.url} rel="noopener">사업보고서 원문</a></p>
  </section>)}

  <section>
    <div class="section-head"><h2>무엇을 만드나</h2><span class="meta">{prods.length ? `${prods[0].year}년 사업보고서 '주요 제품' 표` : '공장등록 생산품'}</span></div>
    {prods.length ? (<>
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 주요 제품`}>
      <thead><tr><th>사업부문</th><th>품목(제품)</th><th>용도</th><th class="n">매출 비율(%)</th></tr></thead>
      <tbody>{prods.map(p => <tr><td>{p.segment || '—'}</td><td>{p.product}</td><td>{p.use || '—'}</td><td class="n">{p.share_pct || '—'}</td></tr>)}</tbody>
    </table></div>
    <p class="meta">사업보고서 'II. 사업의 내용'의 주요 제품 표 글자 그대로(80자까지)입니다. <a href={prods[0].source_url} rel="noopener">사업보고서 원문</a></p>
    </>) : c.factoryProduct ? <p>{c.factoryProduct} <span class="meta">— 공장등록(팩토리온) 생산품. 사업보고서 주요 제품 표는 아직 읽지 못했습니다.</span></p>
      : <p class="meta">사업보고서 주요 제품 표를 아직 읽지 못했습니다. <a href={`https://dart.fss.or.kr/dsab007/main.do?option=corp&textCrpNm=${encodeURIComponent(c.name)}`} rel="noopener">DART 원문</a>의 'II. 사업의 내용'을 보세요.</p>}
  </section>

  <section>
    <div class="section-head"><h2>재무</h2><span class="meta">사업보고서 주요계정 · 억 원{fsKind && ` · ${fsKind}`}</span></div>
    {finYears.length === 0 ? <p class="meta">사업보고서 주요계정을 받지 못했습니다(코넥스·신규 상장 회사는 없을 수 있음). DART 원문을 확인하세요.</p> : (
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 재무 ${finYears[0]}~${finYears.at(-1)}`}>
      <thead><tr><th>계정</th>{finYears.map(y => <th class="n">{y}</th>)}</tr></thead>
      <tbody>{ACC.map(([k, label]) => <tr><th scope="row">{label}</th>{finYears.map(y => <td class="n">{f(c.years[y][k] as string)}</td>)}</tr>)}
        <tr><th scope="row">매출액 증가율(%)</th>{finYears.map((y, i) => <td class="n">{i ? pct1(revGrowth(c.years[y], c.years[finYears[i - 1]])) : '—'}</td>)}</tr>
        <tr><th scope="row">영업이익률(%)</th>{finYears.map(y => <td class="n">{pct1n(opMargin(c.years[y]))}</td>)}</tr>
        <tr><th scope="row">부채비율(%)</th>{finYears.map(y => <td class="n">{pct1n(debtRatio(c.years[y]))}</td>)}</tr>
        <tr><th scope="row">연구개발비</th>{finYears.map(y => { const r = rnd.find(x => x.year === y); return <td class="n">{r ? f(r.rnd_won) : '—'}</td>; })}</tr>
        <tr><th scope="row">직원 수(명)</th>{finYears.map(y => { const e = emp.find(x => x.year === y); return <td class="n">{e ? n0(e.employees) : '—'}</td>; })}</tr></tbody>
    </table></div>)}
    {finYears.length > 0 && <p class="meta">{revAcc && `이 회사는 매출액 계정이 없어(금융업) 사업보고서 손익계산서의 '${revAcc}'을 매출액 자리에 넣었습니다. `}매출액 증가율 = (그해 ÷ 전년 − 1) × 100, 영업이익률 = 영업이익 ÷ 매출액 × 100, 부채비율 = 부채총계 ÷ 자본총계 × 100 — 공시 값을 나눈 것. 연구개발비·직원 수는 사업보고서 '연구개발 활동'·'직원 등의 현황' 값(아래 표)(기준이 다른 해끼리는 계산하지 않음). 원문: {finYears.map((y, i) => <>{i ? ' · ' : ''}<a href={c.years[y].source_url} rel="noopener">{y}년 사업보고서</a></>)}</p>}
  </section>

  {qs.length > 0 && (
  <section>
    <div class="section-head"><h2>분기 실적</h2><span class="meta">분기·반기·사업보고서 · 억 원 · {qs.at(-1)!.fs}</span></div>
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 분기 실적`}>
      <thead><tr><th>계정</th>{qs.map(q => <th class="n">{qLabel(qKey(q))}{q.derived ? '※' : ''}</th>)}</tr></thead>
      <tbody>
        <tr><th scope="row">매출액</th>{qs.map(q => <td class="n">{f(q.revenue)}</td>)}</tr>
        <tr><th scope="row">매출액 전년 같은 분기 대비(%)</th>{qs.map(q => <td class="n">{qYoYc(q, 'revenue')}</td>)}</tr>
        <tr><th scope="row">영업이익</th>{qs.map(q => <td class="n">{f(q.operating_income)}</td>)}</tr>
        <tr><th scope="row">전년 같은 분기 영업이익</th>{qs.map(q => <td class="n">{f(qPrev(q, 'operating_income'))}</td>)}</tr>
        <tr><th scope="row">당기순이익</th>{qs.map(q => <td class="n">{f(q.net_income)}</td>)}</tr>
      </tbody>
    </table></div>
    <p class="meta">1~3분기는 보고서에 공시된 그 분기 3개월 값, ※ 4분기는 사업보고서 연간 값 − 3분기 누적(이 사이트 계산)입니다. 전년 같은 분기 값은 같은 보고서에 함께 공시된 값입니다. 원문: {qs.filter(q => q.source_url).map((q, i) => <>{i ? ' · ' : ''}<a href={q.source_url} rel="noopener">{qLabel(qKey(q))}</a></>)}</p>
  </section>)}

  {perf.length > 0 && (
  <section>
    <div class="section-head"><h2>실적 공시</h2><span class="meta">최근 15개월 · 변동 사유·전망·잠정실적</span></div>
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 실적 공시`}>
      <thead><tr><th>접수일</th><th>구분</th><th>공시</th><th>공시 문구(변동 주요원인·전망)</th></tr></thead>
      <tbody>{perf.map(p => <tr><td class="nw">{ymd(p.rcept_dt)}</td><td class="nw">{p.kind}</td><td><a href={p.url} rel="noopener">{p.report_nm}</a></td><td class="ex">{p.excerpt || '—'}</td></tr>)}</tbody>
    </table></div>
    <p class="meta">손익구조 변동은 매출액·손익이 전년보다 30%(대규모법인 15%) 이상 바뀌었을 때 내는 공시로, 회사가 적은 변동 주요원인 문구를 그대로(120자까지) 옮겼습니다. 실적 전망은 회사가 스스로 낸 전망 공시입니다. 잠정실적은 감사·검토 전 값이라 정기보고서와 다를 수 있습니다. 이 사이트의 해석·평가가 아닙니다.</p>
  </section>)}

  <section>
    <div class="section-head"><h2>직원</h2><span class="meta">사업보고서 '직원 등의 현황'</span></div>
    {empYears.length === 0 ? <p class="meta">받은 자료가 없습니다.</p> : (<>
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 직원 현황`}>
      <thead><tr><th>사업연도</th><th class="n">직원(명)</th><th class="n">정규직</th><th class="n">기간제</th><th class="n">남성</th><th class="n">여성</th><th class="n">평균 근속(년)</th><th class="n">1인 평균 급여(백만 원)</th><th>원문</th></tr></thead>
      <tbody>{empYears.map(e => <tr><th scope="row">{e.year}</th><td class="n">{n0(e.employees)}</td><td class="n">{n0(e.regular)}</td><td class="n">{n0(e.contract)}</td><td class="n">{n0(e.male)}</td><td class="n">{n0(e.female)}</td>
        <td class="n">{e.avg_tenure ? Number(e.avg_tenure).toFixed(1) : '—'}</td><td class="n">{mil(e.avg_salary)}</td><td>{e.source_url ? <a href={e.source_url} rel="noopener">DART</a> : '—'}</td></tr>)}</tbody>
    </table></div>
    <p class="meta">공시 행(사업부문·성별)을 더한 회사 단위 값입니다. 1인 평균 급여는 연간 급여 총액 ÷ 직원 수로, 공시 표의 '1인 평균 급여'와 다를 수 있습니다.{empYears.some(e => e.unit_note) && ' 급여 총액이 천원 단위로 공시돼 원으로 바꾼 해가 있습니다.'}</p>
    </>)}
  </section>

  <section>
    <div class="section-head"><h2>연구개발비</h2><span class="meta">사업보고서 '연구개발 활동' 표</span></div>
    {rndRows.length === 0 ? <p class="meta">사업보고서에서 연구개발비 표를 찾지 못했습니다. DART 원문을 확인하세요.</p> : (
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 연구개발비`}>
      <thead><tr><th>사업연도</th><th class="n">연구개발비(억 원)</th><th class="n">매출액 대비(%)</th></tr></thead>
      <tbody>{rndRows.map(r => <tr><th scope="row">{r.year}</th><td class="n">{f(r.rnd_won)}</td><td class="n">{r.ratio_pct ? Number(r.ratio_pct).toFixed(2) : '—'}</td></tr>)}</tbody>
    </table></div>)}
    {rndRows.length > 0 && <p class="meta">표 위 단위로 원 환산, 비율은 공시 값 그대로. <a href={rndRows[0].source_url} rel="noopener">사업보고서 원문</a></p>}
  </section>

  <section>
    <div class="section-head"><h2>타법인 출자 현황</h2><span class="meta">{inv.length ? `${inv[0].year}년 사업보고서 · ${inv.length}건` : '사업보고서'}</span></div>
    {inv.length === 0 ? <p class="meta">공시된 출자 현황이 없거나 받지 못했습니다.</p> : (<>
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 타법인 출자 현황`}>
      <thead><tr><th>피출자 법인</th><th>목적</th><th class="n">기말 지분율(%)</th><th>최초 취득</th></tr></thead>
      <tbody>{inv.map(r => <tr><td>{r.inv_name}{local.has(normName(r.inv_name)) && <span class="meta"> · 대구</span>}</td><td>{purposeOf(r.purpose)}</td><td class="n">{r.end_share_pct || '—'}</td><td class="nw">{r.first_acq_date || '—'}</td></tr>)}</tbody>
    </table></div>
    <p class="meta">목적은 공시 문구를 묶은 것입니다. '대구'는 피출자 법인 이름이 대구 기업 이름과 같은 경우로, 같은 이름의 다른 회사일 수 있습니다. 장부가액은 공시 단위가 회사마다 달라 싣지 않았습니다. <a href={inv[0].source_url} rel="noopener">사업보고서 원문</a></p>
    </>)}
  </section>

  <section>
    <div class="section-head"><h2>미래 산업 관련 공시</h2><span class="meta">최근 12개월</span></div>
    {fut.length === 0 ? <p class="meta">해당 공시가 없습니다.</p> : (<>
    <div class="scroll-x"><table class="data-table" data-title={`${c.name} 미래 산업 관련 공시`}>
      <thead><tr><th>접수일</th><th>공시</th><th>분야</th><th>근거 구절</th></tr></thead>
      <tbody>{fut.map(d => <tr><td class="nw">{ymd(d.rcept_dt)}</td><td><a href={d.url} rel="noopener">{d.report_nm}</a></td><td>{d.fields}</td><td class="ex">{d.excerpt}</td></tr>)}</tbody>
    </table></div>
    <p class="meta">시설투자·공급계약·지분 취득·특허·주요경영사항 공시 원문에 미래 산업 낱말이 나온 것입니다. 분야는 낱말 기준이지 주력 사업이라는 뜻이 아닙니다.</p>
    </>)}
  </section>

  <p class="meta">출처: 금융감독원 전자공시시스템(DART) OpenDART — 기업개황, 단일회사 주요계정(분기·반기·사업보고서), 실적 공시(잠정실적·손익구조 변동·실적 전망), 사업보고서(직원 현황·타법인 출자 현황·연구개발 활동), 공시서류원본. 대표자 등 개인 정보는 받지 않습니다.</p>
</Base>
<style>
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s2); margin: var(--s2) 0; }
  .facts div { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
  .facts dt { font-size: var(--small); color: var(--muted); }
  .facts dd { margin: 0; font-weight: 600; }
  td.nw { white-space: nowrap; }
  .mgmt div { margin: 6px 0; }
  .mgmt dt { font-weight: 600; }
  .mgmt dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  td.ex { font-size: var(--small); color: var(--muted); min-width: 16em; }
</style>
