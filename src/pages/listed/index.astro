<script>
  const q = document.getElementById('q') as HTMLInputElement | null;
  const cls = document.getElementById('cls') as HTMLSelectElement | null;
  const grp = document.getElementById('grp') as HTMLSelectElement | null;
  const count = document.getElementById('count');
  const rows = [...document.querySelectorAll<HTMLElement>('#fin tbody tr, #cards .ccard')];
  const apply = () => {
    const t = (q?.value || '').trim().toLowerCase();
    let n = 0;
    for (const r of rows) {
      const ok = (!t || (r.dataset.name || '').toLowerCase().includes(t)) && (!cls?.value || r.dataset.cls === cls.value) && (!grp?.value || r.dataset.grp === grp.value);
      r.hidden = !ok; if (ok && r.classList.contains('ccard')) n++;
    }
    if (count) count.textContent = `${n}곳`;
  };
  // 구분 카드(유가증권·코스닥·코넥스)를 누르면 구분 필터 — 다시 누르면 해제(운영자 지적 2026-10-12 '클릭이 안되')
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.clsbtn[data-cls]')];
  const sync = () => btns.forEach(b => b.setAttribute('aria-pressed', String(!!cls?.value && b.dataset.cls === cls.value)));
  btns.forEach(b => b.addEventListener('click', () => {
    if (!cls) return;
    cls.value = cls.value === b.dataset.cls ? '' : (b.dataset.cls || '');
    apply(); sync();
    const u = new URL(location.href); if (cls.value) u.searchParams.set('cls', cls.value); else u.searchParams.delete('cls'); history.replaceState(null, '', u);
    document.getElementById('q')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }));
  [q, cls, grp].forEach(el => el?.addEventListener('input', () => { apply(); sync(); }));
  const pc = new URLSearchParams(location.search).get('cls');
  if (cls && pc && [...cls.options].some(o => o.value === pc)) { cls.value = pc; apply(); sync(); }
</script>
