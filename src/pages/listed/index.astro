---
import Base from '../../layouts/Base.astro';
import { dartCorps, eok, countBy, futureDisclosures, ymd, dartEmployees, n0, mil, dartRnd, dartInvest, purposeOf, isListed, makesOf, opMargin, revGrowth, pct1, pct1n, debtRatio, dartQuarters, qKey, qLabel, qYoY, dartPerf, mgmtByCode, dartNotes, dartIR } from '../../lib/dart';
import type { DartQuarter } from '../../lib/dart';
import { companies, normName } from '../../lib/csv';
/** /listed/ — 메뉴 '상장기업'(운영자 지시 2026-10-05: DART 자료를 '대구시 상장기업' 메뉴로). 옛 /companies/dart/ 를 옮겼다.
 *  본사 주소가 대구인 유가증권·코스닥·코넥스 상장 회사의 재무·직원·연구개발비·출자·미래 산업 공시, 회사별 상세는 /listed/<corp_code>/.
 *  사업보고서를 내는 비상장 회사는 맨 아래 따로. 값은 공시 그대로(원 → 억 원 나눗셈만), 가나다순, 평가·순위·비율 계산 없음. */
const all = dartCorps();
const { years, asOf } = all;
const corps = all.corps.filter(c => isListed(c.cls));
const unlisted = all.corps.filter(c => !isListed(c.cls));
const listedCodes = new Set(corps.map(c => c.code));
const last = years.at(-1) ?? '';
const CLS_ORDER = ['유가증권', '코스닥', '코넥스'];
const byCls = countBy(corps, c => c.cls).sort((a, b) => CLS_ORDER.indexOf(a[0]) - CLS_ORDER.indexOf(b[0]));
const byGroup = countBy(corps, c => c.group).sort((a, b) => a[0].localeCompare(b[0], 'ko'));
const byDist = countBy(corps, c => c.district).sort((a, b) => a[0].localeCompare(b[0], 'ko'));
const groups = byGroup.map(g => g[0]);
const fut = futureDisclosures().filter(d => listedCodes.has(d.corp_code));
const futFields = countBy(fut.flatMap(d => d.fields.split(', ').filter(Boolean)), x => x).sort((a, b) => a[0].localeCompare(b[0], 'ko'));
const coId = new Map(corps.map(c => [c.code, c.companyId]));
const EMP = dartEmployees().filter(e => listedCodes.has(e.corp_code));
const empYears = [...new Set(EMP.map(e => e.year))].sort().slice(-3);
const empLast = empYears.at(-1) ?? '';
const byCodeCorp = new Map(corps.map(c => [c.code, c]));
const empCorps = [...new Set(EMP.map(e => e.corp_code))].map(code => {
  const rs = EMP.filter(e => e.corp_code === code);
  const y = Object.fromEntries(rs.map(e => [e.year, e]));
  const L = y[empLast] ?? [...rs].sort((a, b) => b.year.localeCompare(a.year))[0];
  const c = byCodeCorp.get(code);
  return { code, name: c?.name ?? L.name, cls: c?.cls ?? '', companyId: c?.companyId ?? null, y, L };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const empLastRows = EMP.filter(e => e.year === empLast);
const empSum = empLastRows.reduce((a, e) => a + (Number(e.employees) || 0), 0);
const empF = empLastRows.reduce((a, e) => a + (Number(e.female) || 0), 0);
const empC = empLastRows.reduce((a, e) => a + (Number(e.contract) || 0), 0);
const RND = dartRnd().filter(r => listedCodes.has(r.corp_code));
const rndYears = [...new Set(RND.map(r => r.year))].sort().slice(-3);
const rndLast = rndYears.at(-1) ?? '';
const rndCorps = [...new Set(RND.map(r => r.corp_code))].map(code => {
  const rs = RND.filter(r => r.corp_code === code); const y = Object.fromEntries(rs.map(r => [r.year, r]));
  const c = byCodeCorp.get(code); return { code, name: c?.name ?? rs[0].name, companyId: c?.companyId ?? null, y, url: rs[0].source_url };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const rndSum = RND.filter(r => r.year === rndLast).reduce((a, r) => a + (Number(r.rnd_won) || 0), 0);
const INV = dartInvest().filter(r => listedCodes.has(r.corp_code));
const local = new Set([...companies().map(c => normName(c.name)), ...all.corps.map(c => normName(c.name))]);
const invCorps = [...new Set(INV.map(r => r.corp_code))].map(code => {
  const rs = INV.filter(r => r.corp_code === code).sort((a, b) => (Number(b.end_share_pct) || 0) - (Number(a.end_share_pct) || 0));
  const c = byCodeCorp.get(code); return { code, name: c?.name ?? rs[0].name, companyId: c?.companyId ?? null, rs, year: rs[0].year, url: rs[0].source_url };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const rndCode = new Map(RND.filter(r => r.year === rndLast).map(r => [r.corp_code, r]));
const empCode = new Map(empLastRows.map(e => [e.corp_code, e]));
const invPurpose = countBy(INV, r => purposeOf(r.purpose)).sort((a, b) => b[1] - a[1]);
const invLocal = INV.filter(r => local.has(normName(r.inv_name))).length;
const eokS = (won?: string) => { const v = Number(won); return won && Number.isFinite(v) && v > 0 ? (v / 1e8).toLocaleString('ko-KR', { maximumFractionDigits: 1, minimumFractionDigits: 1 }) : '—'; };
/** 분기 실적(운영자 지시 2026-10-12): 최근 6개 분기, 회사마다 그 분기 행 */
const QS = dartQuarters().filter(q => listedCodes.has(q.corp_code));
const qKeys = [...new Set(QS.map(qKey))].sort().slice(-6);
const qCorps = [...new Set(QS.map(q => q.corp_code))].map(code => {
  const rs = QS.filter(q => q.corp_code === code); const by = Object.fromEntries(rs.map(q => [qKey(q), q])) as Record<string, DartQuarter>;
  const L = [...rs].sort((a, b) => qKey(b).localeCompare(qKey(a)))[0];
  return { code, name: byCodeCorp.get(code)?.name ?? L.name, cls: byCodeCorp.get(code)?.cls ?? L.corp_cls, by, L };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const qAsOf = QS.map(q => q.as_of).sort().at(-1) ?? '';
const PERF = dartPerf().filter(p => listedCodes.has(p.corp_code));
const perfWhy = PERF.filter(p => p.kind !== '잠정실적');
const perfPre = PERF.filter(p => p.kind === '잠정실적');
/** 보고서 본문·IR 의 실적 이유·전망 문구(운영자 지시 2026-10-12) — 회사별 최근 보고서 문장, IR 공시 */
const NOTES = dartNotes().filter(n => listedCodes.has(n.corp_code));
const noteReports = [...new Map(NOTES.map(n => [n.rcept_no, n])).values()];
const mdnaYes = noteReports.filter(n => n.mdna === '있음').length;
const noteCorps = [...new Set(NOTES.filter(n => n.kind).map(n => n.corp_code))].map(code => {
  const rs = NOTES.filter(n => n.corp_code === code && n.kind);
  const latest = [...rs].sort((a, b) => (b.year + b.quarter).localeCompare(a.year + a.quarter))[0];
  const cur = rs.filter(n => n.rcept_no === latest.rcept_no);
  return { code, name: byCodeCorp.get(code)?.name ?? latest.name, rep: latest, why: cur.filter(n => n.kind === '이유'), out: cur.filter(n => n.kind === '전망') };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const IR = dartIR().filter(r => listedCodes.has(r.corp_code));
const irGuide = IR.filter(r => r.guidance).length;
const f = (won?: string) => { const v = eok(won); return v == null ? '—' : v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }); };
/** 회사 카드(운영자 지시 2026-10-12 '기업 1개당 카드 하나 만들어서 필요한 정보를 다 넣어'): 흩어진 표(재무·분기·직원·연구개발비·출자·실적 공시·미래 산업 공시)를
 *  회사마다 한 장에. 값과 계산은 아래 표와 같다(공시 값, 억 원 나눗셈·비율만). 가나다순, 순위 없음. */
const qLatest = new Map(qCorps.map(q => [q.code, q.L]));
const invN = countBy(INV, r => r.corp_code); const invCount = new Map(invN);
const futBy = new Map<string, string[]>(); for (const d of fut) futBy.set(d.corp_code, [...(futBy.get(d.corp_code) ?? []), ...d.fields.split(', ').filter(Boolean)]);
const perfBy = new Map<string, typeof PERF>(); for (const p of PERF) perfBy.set(p.corp_code, [...(perfBy.get(p.corp_code) ?? []), p]);
const cardsData = corps.map(c => {
  const L = c.years[last] ?? c.latest; const P = c.years[years.at(-2) ?? ''];
  const ps = (perfBy.get(c.code) ?? []).sort((a, b) => b.rcept_dt.localeCompare(a.rcept_dt));
  return { c, L, P, ly: L?.year ?? '', mk: makesOf(c), q: qLatest.get(c.code), em: empCode.get(c.code), rd: rndCode.get(c.code),
    inv: invCount.get(c.code) ?? 0, fut: [...new Set(futBy.get(c.code) ?? [])], futN: fut.filter(d => d.corp_code === c.code).length,
    why: ps.find(p => p.kind !== '잠정실적' && p.excerpt), pre: ps.find(p => p.kind === '잠정실적'), mg: mgmtByCode(c.code) };
});
---
<Base title="대구시 상장기업" description={`본사가 대구인 상장 회사 ${corps.length}곳(유가증권·코스닥·코넥스)의 최근 3개 사업연도 매출액·영업이익·직원·연구개발비·타법인 출자·미래 산업 관련 공시(DART 공시 값 그대로).`} current="listed" wide>
  <div class="section-head"><h1>대구시 상장기업</h1><span class="meta">{corps.length}곳 · {years[0]}~{last} 사업연도 · {asOf} 받음 · 금융감독원 DART</span></div>
  <p class="lede">금융감독원 전자공시(DART) 기업개황의 본사 주소가 대구인 상장 회사 {corps.length}곳입니다. 회사마다 카드 한 장에 무엇을 만드는지, 최근 사업연도 재무, 최근 분기 실적, 직원·연구개발비, 실적 변동 사유·전망 공시를 모았고, 회사 이름을 누르면 전체 자료를 한 페이지에서 봅니다. 재무는 연결재무제표가 있으면 연결, 없으면 개별 값이고 원 단위 공시 값을 억 원으로 나눠 적었습니다. 가나다순이며 순위나 평가가 아닙니다.</p>
  <nav class="jump meta"><a href="#cards">회사 카드</a> · <a href="#fin-head">재무 표</a> · <a href="#quarter">분기 실적</a> · <a href="#perf">실적 공시(사유·전망)</a> · <a href="#notes">보고서·IR 실적 설명</a> · <a href="#employees">직원</a> · <a href="#rnd">연구개발비</a> · <a href="#invest">출자</a> · <a href="#future">미래 산업 공시</a> · <a href="#dist">분포</a> · <a href="#unlisted">비상장 공시 회사</a></nav>

  {corps.length === 0 ? <p class="meta">아직 받은 자료가 없습니다.</p> : (<>
  <div class="cards">
    {byCls.map(([k, n]) => <button type="button" class="card clsbtn" data-cls={k} aria-pressed="false" aria-controls="cards"><span class="big">{n}</span><span class="meta">{k} 보기</span></button>)}
  </div>

  <div class="tools">
    <input id="q" type="search" placeholder="회사명·제품 검색 (예: 변속기, 렌즈)" aria-label="회사명·제품 검색" />
    <select id="cls" aria-label="상장 구분"><option value="">모든 구분</option>{byCls.map(([k]) => <option value={k}>{k}</option>)}</select>
    <select id="grp" aria-label="산업"><option value="">모든 산업</option>{groups.map(g => <option value={g}>{g}</option>)}</select>
    <span id="count" class="meta">{corps.length}곳</span>
  </div>
  <section id="cards">
    <div class="ccards">{cardsData.map(({ c, L, P, ly, mk, q, em, rd, inv, fut: fs, futN, why, pre, mg }) => (
      <article class="ccard" data-name={`${c.name} ${c.ksicName} ${mk.text}`} data-cls={c.cls} data-grp={c.group}>
        <header><h3><a href={`/listed/${c.code}/`}>{c.name}</a></h3><span class="meta">{c.cls}{c.stock && ` · ${c.stock}`}{c.district && ` · ${c.district}`}</span></header>
        <p class="cc-what"><b>{c.ksicName || c.group}</b>{mk.text && <> · {mk.text}{mk.kind === 'factory' && <span class="meta"> (공장등록)</span>}</>}</p>
        <dl class="cc-grid">
          <div><dt>매출액{ly && ` (${ly})`}</dt><dd>{f(L?.revenue)}억 <small>{P ? `전년 대비 ${pct1(revGrowth(L, P))}%` : ''}</small></dd></div>
          <div><dt>영업이익</dt><dd>{f(L?.operating_income)}억 <small>이익률 {pct1n(opMargin(L))}%</small></dd></div>
          <div><dt>최근 분기{q && ` (${qLabel(qKey(q))})`}</dt><dd>{q ? <>매출 {f(q.revenue)}억 <small>전년 같은 분기 {pct1(qYoY(q))}%</small><br />영업이익 {f(q.operating_income)}억</> : '—'}</dd></div>
          <div><dt>부채비율 · 순이익</dt><dd>{pct1n(debtRatio(L))}% <small>순이익 {f(L?.net_income)}억</small></dd></div>
          <div><dt>직원{em && ` (${em.year})`}</dt><dd>{em ? <>{n0(em.employees)}명 <small>1인 평균 급여 {mil(em.avg_salary)}백만 원</small></> : '—'}</dd></div>
          <div><dt>연구개발비{rd && ` (${rd.year})`}</dt><dd>{rd ? <>{eokS(rd.rnd_won)}억 <small>매출 대비 {rd.ratio_pct ? Number(rd.ratio_pct).toFixed(1) : '—'}%</small></> : '—'}</dd></div>
        </dl>
        {mg && (mg.overview || mg.outlook || mg.new_biz) && <details class="cc-mgmt"><summary>경영진 진단·방향 <span class="meta">{mg.report_year}년 사업보고서</span></summary>
          {mg.overview && <p><b>회사 상황</b> “{mg.overview}”</p>}
          {mg.outlook && <p><b>향후 방향</b> “{mg.outlook}”</p>}
          {mg.new_biz && <p><b>신사업·진출</b> “{mg.new_biz}”</p>}
          <p class="meta"><a href={mg.url} rel="noopener">사업보고서 원문</a> · 회사 공시 문구 그대로</p>
        </details>}
        {why && <p class="cc-perf"><span class="cc-tag">{why.kind}</span> <a href={why.url} rel="noopener">{ymd(why.rcept_dt)}</a> {why.excerpt}</p>}
        <p class="meta cc-more">
          {pre && <><a href={pre.url} rel="noopener">잠정실적 {ymd(pre.rcept_dt)}</a> · </>}
          {futN > 0 && <>미래 산업 공시 {futN}건({fs.join('·')}) · </>}
          {inv > 0 && <>타법인 출자 {inv}건 · </>}
          <a href={`/listed/${c.code}/`}>회사 페이지</a> · <a href={c.url} rel="noopener">DART</a>{c.companyId && <> · <a href={`/companies/${c.companyId}/`}>기업 사전</a></>}
        </p>
      </article>))}</div>
    <p class="meta">카드의 값은 아래 표와 같은 공시 값입니다: 매출액·영업이익·순이익·부채비율은 최근 사업보고서(연결 우선), 최근 분기는 분기·반기보고서(4분기는 연간 − 3분기 누적), 직원·연구개발비는 사업보고서 표, 사유·전망 문구와 '경영진 진단·방향'(최근 사업보고서 「이사의 경영진단 및 분석의견」·사업의 내용에서 앞부분 220자까지)은 회사 공시 문구 그대로이며 이 사이트의 요약이나 평가가 아닙니다. 전년 대비·이익률·부채비율은 공시 값을 나눈 것이고 — 는 공시가 없거나 계산하지 않은 칸입니다. 가나다순이며 순위나 평가가 아닙니다.</p>
  </section>

  <div class="section-head" id="fin-head"><h2>재무 표 — 전체 열</h2><span class="meta">{years[0]}~{last} 사업연도</span></div>
  <div class="scroll-x" id="fin-wrap"><table class="data-table" id="fin" data-grid data-title={`대구시 상장기업 재무 ${years[0]}~${last}`}>
    <thead>
      <tr><th rowspan="2">회사</th><th rowspan="2">분야(업종)</th><th rowspan="2">무엇을 만드나</th><th rowspan="2">시장</th><th rowspan="2">종목코드</th><th rowspan="2">구·군</th>
        <th colspan={years.length} class="c">매출액(억 원)</th><th colspan={years.length - 1} class="c">매출액 증가율(%)</th><th colspan={years.length} class="c">영업이익(억 원)</th><th colspan={years.length} class="c">영업이익률(%)</th>
        <th colspan="5" class="c">{last}년 재무상태</th><th colspan="2" class="c">연구개발비({rndLast}년)</th><th rowspan="2" class="n">직원 수<br />({empLast}년)</th><th rowspan="2">공시</th></tr>
      <tr>{years.map(y => <th class="n">{y}</th>)}{years.slice(1).map(y => <th class="n">{y}</th>)}{years.map(y => <th class="n">{y}</th>)}{years.map(y => <th class="n">{y}</th>)}<th class="n">당기순이익<br />(억 원)</th><th class="n">자산총계<br />(억 원)</th><th class="n">부채총계<br />(억 원)</th><th class="n">자본총계<br />(억 원)</th><th class="n">부채비율<br />(%)</th><th class="n">억 원</th><th class="n">매출 대비<br />(%)</th></tr>
    </thead>
    <tbody>{corps.map(c => { const L = c.years[last]; const mk = makesOf(c); const rd = rndCode.get(c.code); const em = empCode.get(c.code); return (
      <tr data-name={`${c.name} ${c.ksicName} ${mk.text}`} data-cls={c.cls} data-grp={c.group}>
        <th scope="row"><a href={`/listed/${c.code}/`}>{c.name}</a></th>
        <td class="wrap">{c.ksicName || c.group}{c.ksicName && <span class="meta"> · {c.group}</span>}</td>
        <td class="wrap">{mk.text || '—'}{mk.kind === 'factory' && <span class="meta"> (공장등록)</span>}</td>
        <td>{c.cls}</td><td class="nw">{c.stock || '—'}</td><td>{c.district}</td>
        {years.map(y => <td class="n" title={c.years[y]?.revenue_account && c.years[y]!.revenue_account !== '매출액' ? `${c.years[y]!.revenue_account}(매출액 계정 없음)` : undefined}>{f(c.years[y]?.revenue)}{c.years[y]?.revenue_account && c.years[y]!.revenue_account !== '매출액' ? '※' : ''}</td>)}
        {years.slice(1).map((y, i) => <td class="n">{pct1(revGrowth(c.years[y], c.years[years[i]]))}</td>)}
        {years.map(y => <td class="n">{f(c.years[y]?.operating_income)}</td>)}
        {years.map(y => <td class="n">{pct1n(opMargin(c.years[y]))}</td>)}
        <td class="n">{f(L?.net_income)}</td><td class="n">{f(L?.total_assets)}</td><td class="n">{f(L?.total_liabilities)}</td><td class="n">{f(L?.total_equity)}</td>
        <td class="n">{pct1n(debtRatio(L))}</td>
        <td class="n">{rd ? eokS(rd.rnd_won) : '—'}</td><td class="n">{rd?.ratio_pct ? Number(rd.ratio_pct).toFixed(1) : '—'}</td>
        <td class="n">{em ? n0(em.employees) : '—'}</td>
        <td><a href={c.url} rel="noopener">DART</a>{L?.fs === '개별' ? <span class="meta"> 개별</span> : ''}</td>
      </tr>); })}</tbody>
  </table></div>
  <p class="meta">매출액 증가율은 (그해 매출액 ÷ 전년 매출액 − 1) × 100, 영업이익률은 영업이익 ÷ 매출액 × 100, 부채비율은 부채총계 ÷ 자본총계 × 100(자본총계가 0 이하면 —)으로 이 사이트가 공시 값을 나눈 것입니다(두 해의 재무제표 기준이 연결·개별로 다르면 증가율은 —). 연구개발비·직원 수는 아래 '연구개발비'·'직원 현황'과 같은 사업보고서 값입니다(표를 못 찾은 회사는 —). 가나다순이며 이 값으로 줄 세우지 않습니다. '분야(업종)'은 DART 기업개황의 업종 코드(KSIC) 이름(공장등록 자료에 같은 코드가 있을 때, 없으면 이 사이트의 산업 그룹)이고, '무엇을 만드나'는 최근 사업보고서 '주요 제품' 표의 품목을 매출 비율이 큰 순서로 3개까지 옮긴 것입니다. 사업보고서 표를 아직 못 읽은 회사는 공장등록(팩토리온) 생산품을 '(공장등록)'으로 적었습니다. ※ 는 금융회사(은행·금융지주 등)처럼 매출액 계정이 없어 사업보고서 손익계산서의 영업수익(없으면 순영업수익·이자수익)을 매출액 자리에 넣은 것입니다(운영자 지시 2026-10-06). — 는 그 해 사업보고서가 없거나 그 계정이 공시되지 않은 경우입니다(코넥스 회사는 사업보고서 주요계정이 없을 수 있음). 회사 상세 페이지에서 기업 사전(공장등록) 이름이 같은 기업으로 이어집니다. 산업은 공시된 업종 코드(KSIC)로 이 사이트의 11개 산업 그룹 규칙에 맞춘 것입니다.</p>

  {qCorps.length > 0 && (
  <section id="quarter">
    <div class="section-head"><h2>분기 실적</h2><span class="meta">분기·반기·사업보고서 · {qCorps.length}곳 · {qLabel(qKeys[0])}~{qLabel(qKeys.at(-1)!)} · {qAsOf} 받음</span></div>
    <p class="meta">유가증권·코스닥 상장회사는 분기가 끝나고 45일 안에 분기·반기보고서를, 사업연도가 끝나고 90일 안에 사업보고서를 냅니다(코넥스는 분기·반기보고서 의무가 없어 뺐습니다). 1~3분기는 보고서에 공시된 그 분기 3개월 값이고, 4분기는 따로 공시되지 않아 사업보고서 연간 값에서 3분기 누적을 뺀 값입니다(※, 이 사이트 계산). 연결재무제표가 있으면 연결, 없으면 개별입니다.</p>
    <div class="scroll-x"><table class="data-table" id="qtr" data-grid data-title={`대구시 상장기업 분기 실적 ${qLabel(qKeys[0])}~${qLabel(qKeys.at(-1)!)}`}>
      <thead>
        <tr><th rowspan="2">회사</th><th colspan={qKeys.length} class="c">매출액(억 원)</th><th colspan={qKeys.length} class="c">영업이익(억 원)</th><th rowspan="2" class="n">최근 분기 매출액<br />전년 같은 분기 대비(%)</th><th rowspan="2">공시</th></tr>
        <tr>{qKeys.map(k => <th class="n">{qLabel(k)}</th>)}{qKeys.map(k => <th class="n">{qLabel(k)}</th>)}</tr>
      </thead>
      <tbody>{qCorps.map(c => (
        <tr>
          <th scope="row"><a href={`/listed/${c.code}/`}>{c.name}</a>{c.L.fs === '개별' && <span class="meta"> 개별</span>}</th>
          {qKeys.map(k => <td class="n">{f(c.by[k]?.revenue)}{c.by[k]?.derived ? '※' : ''}</td>)}
          {qKeys.map(k => <td class="n">{f(c.by[k]?.operating_income)}{c.by[k]?.derived ? '※' : ''}</td>)}
          <td class="n" title={qLabel(qKey(c.L))}>{pct1(qYoY(c.L))}</td>
          <td>{c.L.source_url ? <a href={c.L.source_url} rel="noopener">DART</a> : '—'}</td>
        </tr>))}</tbody>
    </table></div>
    <p class="meta">'최근 분기 전년 같은 분기 대비'는 그 회사의 가장 최근 분기 매출액을 같은 보고서에 공시된 전년 같은 분기 값(4분기는 전년 4분기 계산 값)과 나눈 것입니다(두 값이 0 보다 클 때만). — 는 그 분기 보고서가 없거나 계정이 공시되지 않은 경우입니다. 가나다순이며 순위가 아닙니다.</p>
  </section>)}

  {PERF.length > 0 && (
  <section id="perf">
    <div class="section-head"><h2>실적 공시 — 변동 사유·전망·잠정실적</h2><span class="meta">최근 15개월 · {PERF.length}건</span></div>
    <p class="meta">회사가 거래소에 낸 실적 관련 공시입니다. <b>손익구조 변동</b>은 매출액이나 손익이 전년보다 30%(대규모법인 15%) 이상 바뀌었을 때 내는 공시로, 회사가 적은 '변동 주요원인' 문구를 그대로 옮겼습니다. <b>실적 전망</b>은 회사가 스스로 낸 매출·이익 전망(공정공시)으로, 내는 회사가 많지 않습니다. 문구는 공시 원문 앞부분(120자까지)이며 이 사이트의 해석이나 평가가 아닙니다.</p>
    {perfWhy.length > 0 && <div class="scroll-x"><table class="data-table" data-grid data-title="대구시 상장기업 손익구조 변동 사유·실적 전망 공시">
      <thead><tr><th>접수일</th><th>회사</th><th>구분</th><th>공시</th><th>공시 문구(변동 주요원인·전망)</th></tr></thead>
      <tbody>{perfWhy.map(p => <tr><td class="nw">{ymd(p.rcept_dt)}</td><td><a href={`/listed/${p.corp_code}/`}>{p.name}</a></td><td class="nw">{p.kind}</td><td class="wrap"><a href={p.url} rel="noopener">{p.report_nm}</a></td><td class="ex">{p.excerpt || '—'}</td></tr>)}</tbody>
    </table></div>}
    {perfPre.length > 0 && <details class="stat-details"><summary>영업(잠정)실적 공시 {perfPre.length}건 — 정기보고서보다 먼저 내는 실적 속보</summary>
      <div class="scroll-x"><table class="data-table compact" data-title="대구시 상장기업 영업(잠정)실적 공시">
        <thead><tr><th>접수일</th><th>회사</th><th>공시</th></tr></thead>
        <tbody>{perfPre.map(p => <tr><td class="nw">{ymd(p.rcept_dt)}</td><td><a href={`/listed/${p.corp_code}/`}>{p.name}</a></td><td><a href={p.url} rel="noopener">{p.report_nm}</a></td></tr>)}</tbody>
      </table></div>
      <p class="meta">잠정 수치는 감사·검토 전 값이라 뒤에 나오는 분기·사업보고서 값과 다를 수 있습니다. 수치는 공시 원문을 보세요.</p>
    </details>}
  </section>)}


  {(noteCorps.length > 0 || IR.length > 0) && (
  <section id="notes">
    <div class="section-head"><h2>보고서·IR 실적 설명 — 이유와 전망</h2><span class="meta">정기보고서 {noteReports.length}건 · 문장 있는 회사 {noteCorps.length}곳 · IR 공시 {IR.length}건</span></div>
    <p class="meta">분기·반기·사업보고서 본문(이사의 경영진단 및 분석의견, 사업의 내용 중 사업의 개요·매출 및 수주상황·기타 참고사항)에서 <b>이유</b>(실적 낱말 + 증감 + 원인 표현이 함께 든 문장)와 <b>전망</b>(향후·하반기·내년 같은 시점 + 전망·계획·목표 표현이 든 문장)을 낱말 규칙으로 골라 회사 문구 그대로 옮겼습니다(문장당 260자, 보고서마다 각 4문장까지). 표 안 글자와 예측정보 주의 문구는 뺐습니다. 경영진단 장은 분기·반기보고서에서 생략할 수 있어 {noteReports.length}건 가운데 {mdnaYes}건에만 있습니다. 규칙으로 고른 것이라 빠지거나 덜 맞는 문장이 있을 수 있으니 원문을 함께 보세요. 이 사이트의 해석이나 평가가 아닙니다.</p>
    {noteCorps.length > 0 && <div class="scroll-x"><table class="data-table" data-grid data-title="대구시 상장기업 정기보고서 실적 이유·전망 문장">
      <thead><tr><th>회사</th><th>보고서</th><th>이유(회사 문구)</th><th>전망(회사 문구)</th></tr></thead>
      <tbody>{noteCorps.map(c => <tr><td class="nw"><a href={`/listed/${c.code}/`}>{c.name}</a></td><td class="nw"><a href={c.rep.url} rel="noopener">{c.rep.report_nm}</a></td>
        <td class="ex">{c.why.length ? c.why.map(n => <p>{n.sentence}</p>) : '—'}</td><td class="ex">{c.out.length ? c.out.map(n => <p>{n.sentence}</p>) : '—'}</td></tr>)}</tbody>
    </table></div>}
    {IR.length > 0 && <>
      <h3>기업설명회(IR)</h3>
      <p class="meta">거래소에 낸 '기업설명회(IR) 개최' 공시 {IR.length}건입니다. 목적·내용은 공시 문구이고, IR 자료는 대부분 회사 IR 페이지에 따로 올라가 공시에는 게재일과 주소만 있습니다(그 주소는 이 사이트가 수집하지 않습니다). 첨부 IR 자료(PDF)를 받을 수 있었던 {IR.filter(r => r.pdf === '예').length}건은 자료 글자 가운데 전망·목표·계획·가이던스 낱말과 숫자가 함께 든 줄을 8줄까지 옮겼습니다({irGuide}건). 자료의 표가 줄 단위로 쪼개져 읽기 어려울 수 있으니 원문을 함께 보세요.</p>
      <div class="scroll-x"><table class="data-table" data-grid data-title="대구시 상장기업 기업설명회(IR) 공시">
        <thead><tr><th>접수일</th><th>회사</th><th>목적·내용</th><th>IR 자료의 전망·목표 줄</th></tr></thead>
        <tbody>{IR.map(r => <tr><td class="nw"><a href={r.url} rel="noopener">{ymd(r.rcept_dt)}</a></td><td class="nw"><a href={`/listed/${r.corp_code}/`}>{r.name}</a></td>
          <td class="ex">{[r.purpose, r.content].filter(Boolean).join(' · ') || '—'}</td>
          <td class="ex">{r.guidance ? r.guidance.split(' / ').map(g => <p>{g}</p>) : (r.pdf === '예' ? '(해당 줄 없음)' : '—')}{r.att_url && <p><a href={r.att_url} rel="noopener">IR 자료</a></p>}{!r.att_url && r.ir_page && <p class="meta">IR 자료 게재 {r.posted || ''} · 회사 IR 페이지 {r.ir_page}</p>}</td></tr>)}</tbody>
      </table></div>
    </>}
  </section>)}

  {fut.length > 0 && (
