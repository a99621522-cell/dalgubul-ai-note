---
import Base from '../../layouts/Base.astro';
import { dartCorps, eok, countBy, futureDisclosures, ymd, dartEmployees, n0, mil, dartRnd, dartInvest, purposeOf, isListed, makesOf, opMargin, revGrowth, pct1, pct1n } from '../../lib/dart';
import { companies, normName } from '../../lib/csv';
/** /listed/ — 메뉴 '상장기업'(운영자 지시 2026-10-05: DART 자료를 '대구시 상장기업' 메뉴로). 옛 /companies/dart/ 를 옮겼다.
 *  본사 주소가 대구인 유가증권·코스닥·코넥스 상장 회사의 재무·직원·연구개발비·출자·미래 산업 공시, 회사별 상세는 /listed/<corp_code>/.
 *  사업보고서를 내는 비상장 회사는 맨 아래 따로. 값은 공시 그대로(원 → 억 원 나눗셈만), 가나다순, 평가·순위·비율 계산 없음. */
const all = dartCorps();
const { years, asOf } = all;
const corps = all.corps.filter(c => isListed(c.cls));
const unlisted = all.corps.filter(c => !isListed(c.cls));
const listedCodes = new Set(corps.map(c => c.code));
const last = years.at(-1) ?? '';
const CLS_ORDER = ['유가증권', '코스닥', '코넥스'];
const byCls = countBy(corps, c => c.cls).sort((a, b) => CLS_ORDER.indexOf(a[0]) - CLS_ORDER.indexOf(b[0]));
const byGroup = countBy(corps, c => c.group).sort((a, b) => a[0].localeCompare(b[0], 'ko'));
const byDist = countBy(corps, c => c.district).sort((a, b) => a[0].localeCompare(b[0], 'ko'));
const groups = byGroup.map(g => g[0]);
const fut = futureDisclosures().filter(d => listedCodes.has(d.corp_code));
const futFields = countBy(fut.flatMap(d => d.fields.split(', ').filter(Boolean)), x => x).sort((a, b) => a[0].localeCompare(b[0], 'ko'));
const coId = new Map(corps.map(c => [c.code, c.companyId]));
const EMP = dartEmployees().filter(e => listedCodes.has(e.corp_code));
const empYears = [...new Set(EMP.map(e => e.year))].sort().slice(-3);
const empLast = empYears.at(-1) ?? '';
const byCodeCorp = new Map(corps.map(c => [c.code, c]));
const empCorps = [...new Set(EMP.map(e => e.corp_code))].map(code => {
  const rs = EMP.filter(e => e.corp_code === code);
  const y = Object.fromEntries(rs.map(e => [e.year, e]));
  const L = y[empLast] ?? [...rs].sort((a, b) => b.year.localeCompare(a.year))[0];
  const c = byCodeCorp.get(code);
  return { code, name: c?.name ?? L.name, cls: c?.cls ?? '', companyId: c?.companyId ?? null, y, L };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const empLastRows = EMP.filter(e => e.year === empLast);
const empSum = empLastRows.reduce((a, e) => a + (Number(e.employees) || 0), 0);
const empF = empLastRows.reduce((a, e) => a + (Number(e.female) || 0), 0);
const empC = empLastRows.reduce((a, e) => a + (Number(e.contract) || 0), 0);
const RND = dartRnd().filter(r => listedCodes.has(r.corp_code));
const rndYears = [...new Set(RND.map(r => r.year))].sort().slice(-3);
const rndLast = rndYears.at(-1) ?? '';
const rndCorps = [...new Set(RND.map(r => r.corp_code))].map(code => {
  const rs = RND.filter(r => r.corp_code === code); const y = Object.fromEntries(rs.map(r => [r.year, r]));
  const c = byCodeCorp.get(code); return { code, name: c?.name ?? rs[0].name, companyId: c?.companyId ?? null, y, url: rs[0].source_url };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const rndSum = RND.filter(r => r.year === rndLast).reduce((a, r) => a + (Number(r.rnd_won) || 0), 0);
const INV = dartInvest().filter(r => listedCodes.has(r.corp_code));
const local = new Set([...companies().map(c => normName(c.name)), ...all.corps.map(c => normName(c.name))]);
const invCorps = [...new Set(INV.map(r => r.corp_code))].map(code => {
  const rs = INV.filter(r => r.corp_code === code).sort((a, b) => (Number(b.end_share_pct) || 0) - (Number(a.end_share_pct) || 0));
  const c = byCodeCorp.get(code); return { code, name: c?.name ?? rs[0].name, companyId: c?.companyId ?? null, rs, year: rs[0].year, url: rs[0].source_url };
}).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const invPurpose = countBy(INV, r => purposeOf(r.purpose)).sort((a, b) => b[1] - a[1]);
const invLocal = INV.filter(r => local.has(normName(r.inv_name))).length;
const eokS = (won?: string) => { const v = Number(won); return won && Number.isFinite(v) && v > 0 ? (v / 1e8).toLocaleString('ko-KR', { maximumFractionDigits: 1, minimumFractionDigits: 1 }) : '—'; };
const f = (won?: string) => { const v = eok(won); return v == null ? '—' : v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }); };
---
<Base title="대구시 상장기업" description={`본사가 대구인 상장 회사 ${corps.length}곳(유가증권·코스닥·코넥스)의 최근 3개 사업연도 매출액·영업이익·직원·연구개발비·타법인 출자·미래 산업 관련 공시(DART 공시 값 그대로).`} current="listed">
  <div class="section-head"><h1>대구시 상장기업</h1><span class="meta">{corps.length}곳 · {years[0]}~{last} 사업연도 · {asOf} 받음 · 금융감독원 DART</span></div>
  <p class="lede">금융감독원 전자공시(DART) 기업개황의 본사 주소가 대구인 상장 회사 {corps.length}곳입니다. 회사 이름을 누르면 재무·직원·연구개발비·출자·공시를 한 페이지에서 봅니다. 재무는 연결재무제표가 있으면 연결, 없으면 개별 값이고 원 단위 공시 값을 억 원으로 나눠 적었습니다. 가나다순이며 순위나 평가가 아닙니다.</p>
  <nav class="jump meta"><a href="#fin">재무</a> · <a href="#employees">직원</a> · <a href="#rnd">연구개발비</a> · <a href="#invest">출자</a> · <a href="#future">미래 산업 공시</a> · <a href="#dist">분포</a> · <a href="#unlisted">비상장 공시 회사</a></nav>

  {corps.length === 0 ? <p class="meta">아직 받은 자료가 없습니다.</p> : (<>
  <div class="cards">
    {byCls.map(([k, n]) => <div class="card"><div class="big">{n}</div><div class="meta">{k}</div></div>)}
  </div>

  <div class="tools">
    <input id="q" type="search" placeholder="회사명·제품 검색 (예: 변속기, 렌즈)" aria-label="회사명·제품 검색" />
    <select id="cls" aria-label="상장 구분"><option value="">모든 구분</option>{byCls.map(([k]) => <option value={k}>{k}</option>)}</select>
    <select id="grp" aria-label="산업"><option value="">모든 산업</option>{groups.map(g => <option value={g}>{g}</option>)}</select>
    <span id="count" class="meta">{corps.length}곳</span>
  </div>
  <div class="scroll-x" id="fin-wrap"><table class="data-table" id="fin" data-title={`대구시 상장기업 재무 ${years[0]}~${last}`}>
    <thead>
      <tr><th rowspan="2">회사</th><th rowspan="2">분야(업종)</th><th rowspan="2">무엇을 만드나</th><th rowspan="2">시장</th><th rowspan="2">종목코드</th><th rowspan="2">구·군</th>
        <th colspan={years.length} class="c">매출액(억 원)</th><th colspan={years.length - 1} class="c">매출액 증가율(%)</th><th colspan={years.length} class="c">영업이익(억 원)</th><th colspan={years.length} class="c">영업이익률(%)</th>
        <th colspan="4" class="c">{last}년(억 원)</th><th rowspan="2">공시</th></tr>
      <tr>{years.map(y => <th class="n">{y}</th>)}{years.slice(1).map(y => <th class="n">{y}</th>)}{years.map(y => <th class="n">{y}</th>)}{years.map(y => <th class="n">{y}</th>)}<th class="n">당기순이익</th><th class="n">자산총계</th><th class="n">부채총계</th><th class="n">자본총계</th></tr>
    </thead>
    <tbody>{corps.map(c => { const L = c.years[last]; const mk = makesOf(c); return (
      <tr data-name={`${c.name} ${c.ksicName} ${mk.text}`} data-cls={c.cls} data-grp={c.group}>
        <th scope="row"><a href={`/listed/${c.code}/`}>{c.name}</a></th>
        <td class="wrap">{c.ksicName || c.group}{c.ksicName && <span class="meta"> · {c.group}</span>}</td>
        <td class="wrap">{mk.text || '—'}{mk.kind === 'factory' && <span class="meta"> (공장등록)</span>}</td>
        <td>{c.cls}</td><td class="nw">{c.stock || '—'}</td><td>{c.district}</td>
        {years.map(y => <td class="n">{f(c.years[y]?.revenue)}</td>)}
        {years.slice(1).map((y, i) => <td class="n">{pct1(revGrowth(c.years[y], c.years[years[i]]))}</td>)}
        {years.map(y => <td class="n">{f(c.years[y]?.operating_income)}</td>)}
        {years.map(y => <td class="n">{pct1n(opMargin(c.years[y]))}</td>)}
        <td class="n">{f(L?.net_income)}</td><td class="n">{f(L?.total_assets)}</td><td class="n">{f(L?.total_liabilities)}</td><td class="n">{f(L?.total_equity)}</td>
        <td><a href={c.url} rel="noopener">DART</a>{L?.fs === '개별' ? <span class="meta"> 개별</span> : ''}</td>
      </tr>); })}</tbody>
  </table></div>
  <p class="meta">매출액 증가율은 (그해 매출액 ÷ 전년 매출액 − 1) × 100, 영업이익률은 영업이익 ÷ 매출액 × 100 으로 이 사이트가 공시 값을 나눈 것입니다(두 해의 재무제표 기준이 연결·개별로 다르면 증가율은 —). 가나다순이며 이 값으로 줄 세우지 않습니다. '분야(업종)'은 DART 기업개황의 업종 코드(KSIC) 이름(공장등록 자료에 같은 코드가 있을 때, 없으면 이 사이트의 산업 그룹)이고, '무엇을 만드나'는 최근 사업보고서 '주요 제품' 표의 품목을 매출 비율이 큰 순서로 3개까지 옮긴 것입니다. 사업보고서 표를 아직 못 읽은 회사는 공장등록(팩토리온) 생산품을 '(공장등록)'으로 적었습니다. — 는 그 해 사업보고서가 없거나 그 계정이 공시되지 않은 경우입니다(코넥스 회사는 사업보고서 주요계정이 없을 수 있음). 회사 상세 페이지에서 기업 사전(공장등록) 이름이 같은 기업으로 이어집니다. 산업은 공시된 업종 코드(KSIC)로 이 사이트의 11개 산업 그룹 규칙에 맞춘 것입니다.</p>

  {fut.length > 0 && (
  <section id="future">
    <div class="section-head"><h2>미래 산업 관련 공시</h2><span class="meta">최근 12개월 · {fut.length}건</span></div>
    <p class="meta">위 회사들의 시설투자·공급계약·지분 취득·특허·주요경영사항 공시 가운데, 공시 원문에 미래 산업 낱말(반도체·2차전지·전기차·자율주행·로봇·인공지능·수소·바이오·방산 등)이 나온 것입니다. 분야는 원문에 나온 낱말로 붙인 것이라 그 사업의 주력이라는 뜻은 아닙니다. 근거 구절은 원문에서 낱말이 처음 나온 곳입니다.</p>
    <p class="meta">분야별: {futFields.map(([k, n], i) => <>{i ? ' · ' : ''}{k} {n}건</>)}</p>
    <div class="scroll-x"><table class="data-table" data-title="대구시 상장기업 미래 산업 관련 공시">
      <thead><tr><th>접수일</th><th>회사</th><th>공시</th><th>분야</th><th>근거 구절</th></tr></thead>
      <tbody>{fut.map(d => { const id = coId.get(d.corp_code); return (
        <tr><td class="nw">{ymd(d.rcept_dt)}</td><td><a href={`/listed/${d.corp_code}/`}>{d.name}</a></td>
          <td><a href={d.url} rel="noopener">{d.report_nm}</a></td><td>{d.fields}</td><td class="ex">{d.excerpt}</td></tr>); })}</tbody>
    </table></div>
  </section>)}

  {empCorps.length > 0 && (
  <section id="employees">
    <div class="section-head"><h2>직원 현황</h2><span class="meta">사업보고서 · {empYears[0]}~{empLast} 사업연도 · {empCorps.length}곳</span></div>
    <div class="cards">
      <div class="card"><div class="big">{empSum.toLocaleString('ko-KR')}</div><div class="meta">{empLast}년 직원 합계({empLastRows.length}곳)</div></div>
      <div class="card"><div class="big">{empC.toLocaleString('ko-KR')}</div><div class="meta">그 가운데 기간제</div></div>
      <div class="card"><div class="big">{empF.toLocaleString('ko-KR')}</div><div class="meta">그 가운데 여성</div></div>
    </div>
    <div class="scroll-x"><table class="data-table" id="emp" data-title={`대구시 상장기업 직원 현황 ${empYears[0]}~${empLast}`}>
      <thead>
        <tr><th rowspan="2">회사</th><th colspan={empYears.length} class="c">직원 수(명)</th><th colspan="5" class="c">{empLast}년</th><th rowspan="2">공시</th></tr>
        <tr>{empYears.map(y => <th class="n">{y}</th>)}<th class="n">정규직</th><th class="n">기간제</th><th class="n">여성</th><th class="n">평균 근속(년)</th><th class="n">1인 평균 급여(백만 원)</th></tr>
      </thead>
      <tbody>{empCorps.map(c => (
        <tr>
          <th scope="row"><a href={`/listed/${c.code}/`}>{c.name}</a>{c.cls && <span class="meta"> {c.cls}</span>}</th>
          {empYears.map(y => <td class="n">{n0(c.y[y]?.employees)}</td>)}
          <td class="n">{n0(c.L.regular)}</td><td class="n">{n0(c.L.contract)}</td><td class="n">{n0(c.L.female)}</td>
          <td class="n">{c.L.avg_tenure ? Number(c.L.avg_tenure).toFixed(1) : '—'}</td><td class="n">{mil(c.L.avg_salary)}</td>
          <td>{c.L.source_url ? <a href={c.L.source_url} rel="noopener">DART</a> : '—'}</td>
        </tr>))}</tbody>
    </table></div>
    <p class="meta">사업보고서 '직원 등의 현황'의 회사 단위 값입니다. 공시 행(사업부문·성별)을 더했고, 평균 근속은 직원 수로 가중했습니다. 1인 평균 급여는 연간 급여 총액 ÷ 직원 수로, 공시마다 단위·기준(월·연)이 달라 공시 표의 '1인 평균 급여'와 다를 수 있습니다. 총액이 천원 단위로 공시된 곳은 원으로 바꿨습니다. 직원 수가 없는 해는 —. 가나다순이며 순위가 아닙니다.</p>
  </section>)}

  {rndCorps.length > 0 && (
  <section id="rnd">
    <div class="section-head"><h2>연구개발비</h2><span class="meta">사업보고서 '연구개발 활동' 표 · {rndYears[0]}~{rndLast} · {rndCorps.length}곳</span></div>
    <div class="cards">
      <div class="card"><div class="big">{(rndSum / 1e8).toLocaleString('ko-KR', { maximumFractionDigits: 0 })}억</div><div class="meta">{rndLast}년 연구개발비 합계({RND.filter(r => r.year === rndLast).length}곳)</div></div>
    </div>
    <div class="scroll-x"><table class="data-table" data-title={`대구시 상장기업 연구개발비 ${rndYears[0]}~${rndLast}`}>
      <thead><tr><th rowspan="2">회사</th><th colspan={rndYears.length} class="c">연구개발비(억 원)</th><th colspan={rndYears.length} class="c">매출액 대비(%)</th><th rowspan="2">공시</th></tr>
        <tr>{rndYears.map(y => <th class="n">{y}</th>)}{rndYears.map(y => <th class="n">{y}</th>)}</tr></thead>
      <tbody>{rndCorps.map(c => (
        <tr><th scope="row"><a href={`/listed/${c.code}/`}>{c.name}</a></th>
          {rndYears.map(y => <td class="n">{eokS(c.y[y]?.rnd_won)}</td>)}
          {rndYears.map(y => <td class="n">{c.y[y]?.ratio_pct ? Number(c.y[y].ratio_pct).toFixed(2) : '—'}</td>)}
          <td><a href={c.url} rel="noopener">DART</a></td></tr>))}</tbody>
    </table></div>
    <p class="meta">최근 사업보고서 원문의 '연구개발 활동' 표에서 연구개발비용 합계 행과 매출액 대비 비율 행을 읽어 표 위 단위(원·천원·백만원)로 원 환산했습니다. 비율은 공시 값 그대로(회사마다 별도·연결 기준이 다를 수 있음). 표를 찾지 못한 회사({empCorps.length - rndCorps.length}곳 남짓)는 싣지 않았습니다. 가나다순이며 순위가 아닙니다.</p>
  </section>)}

  {invCorps.length > 0 && (
  <section id="invest">
    <div class="section-head"><h2>타법인 출자 현황</h2><span class="meta">사업보고서 · {invCorps.length}곳 · {INV.length}건</span></div>
    <div class="cards">
      {invPurpose.slice(0, 4).map(([k, n]) => <div class="card"><div class="big">{n}</div><div class="meta">{k}</div></div>)}
      <div class="card"><div class="big">{invLocal}</div><div class="meta">피출자 법인 이름이 대구 기업과 같은 건</div></div>
    </div>
    <p class="meta">회사를 누르면 출자한 법인 목록이 펼쳐집니다(기말 지분율 높은 순). 출자 목적은 공시 문구를 경영참여·사업 관련(시장 진출·생산·개발 등)·단순·일반투자·조합 출자·지분 취득·출자로 묶었습니다. '대구 기업과 같은 건'은 피출자 법인 이름이 기업 사전·대구 본사 공시 기업 이름과 같은 경우로, 같은 이름의 다른 회사일 수 있습니다. 장부가액은 회사마다 공시 단위가 달라 싣지 않았습니다(원문 링크).</p>
    <div class="inv-list">{invCorps.map(c => (
      <details class="stat-details"><summary>{c.name} <span class="meta">{c.rs.length}건 · {c.year}년</span></summary>
        <div class="scroll-x"><table class="data-table compact" data-title={`${c.name} 타법인 출자 현황 ${c.year}`}>
          <thead><tr><th>피출자 법인</th><th>목적</th><th class="n">기말 지분율(%)</th><th>최초 취득</th></tr></thead>
          <tbody>{c.rs.map(r => <tr><td>{r.inv_name}{local.has(normName(r.inv_name)) && <span class="meta"> · 대구</span>}</td><td>{purposeOf(r.purpose)}</td><td class="n">{r.end_share_pct || '—'}</td><td class="nw">{r.first_acq_date || '—'}</td></tr>)}</tbody>
        </table></div>
        <p class="meta"><a href={`/listed/${c.code}/`}>회사 페이지</a> · <a href={c.url} rel="noopener">사업보고서 원문</a></p>
      </details>))}</div>
  </section>)}

  <section id="dist">
    <div class="section-head"><h2>분포</h2></div>
    <div class="two">
      <div class="scroll-x"><table class="data-table" data-title="대구시 상장기업 산업별 수">
        <thead><tr><th>산업</th><th class="n">회사 수</th></tr></thead>
        <tbody>{byGroup.map(([k, n]) => <tr><th scope="row">{k}</th><td class="n">{n}</td></tr>)}</tbody>
      </table></div>
      <div class="scroll-x"><table class="data-table" data-title="대구시 상장기업 구·군별 수">
        <thead><tr><th>구·군</th><th class="n">회사 수</th></tr></thead>
        <tbody>{byDist.map(([k, n]) => <tr><th scope="row">{k}</th><td class="n">{n}</td></tr>)}</tbody>
      </table></div>
    </div>
  </section>
  {unlisted.length > 0 && (
  <section id="unlisted">
    <div class="section-head"><h2>사업보고서를 내는 비상장 회사</h2><span class="meta">{unlisted.length}곳</span></div>
    <p class="meta">상장하지 않았지만 사업보고서를 DART 에 내는 대구 본사 회사입니다(위 표·합계에는 넣지 않음). 상장 폐지된 회사가 들어 있을 수 있습니다.</p>
    <p>{unlisted.map((c, i) => <>{i ? ' · ' : ''}<a href={`/listed/${c.code}/`}>{c.name}</a></>)}</p>
  </section>)}
  </>)}
  <p class="meta">출처: 금융감독원 전자공시시스템(DART) OpenDART — 공시검색(사업보고서 제출 회사, 확장 공시), 공시서류원본(미래 산업 낱말 확인), 사업보고서 직원 현황·타법인 출자 현황·연구개발 활동 표, 기업개황(본사 주소·업종 코드·상장 구분), 단일회사 주요계정(사업보고서). 사업보고서를 내지 않는 비상장 기업은 들어 있지 않습니다. 대표자 등 개인 정보는 받지 않습니다.</p>
</Base>
<script>
  const q = document.getElementById('q') as HTMLInputElement | null;
  const cls = document.getElementById('cls') as HTMLSelectElement | null;
  const grp = document.getElementById('grp') as HTMLSelectElement | null;
  const count = document.getElementById('count');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#fin tbody tr')];
  const apply = () => {
    const t = (q?.value || '').trim().toLowerCase();
    let n = 0;
    for (const r of rows) {
      const ok = (!t || (r.dataset.name || '').toLowerCase().includes(t)) && (!cls?.value || r.dataset.cls === cls.value) && (!grp?.value || r.dataset.grp === grp.value);
      r.hidden = !ok; if (ok) n++;
    }
    if (count) count.textContent = `${n}곳`;
  };
  [q, cls, grp].forEach(el => el?.addEventListener('input', apply));
</script>
