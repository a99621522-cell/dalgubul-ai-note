---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import Notice from './_Notice.astro';
import { orgs, orgName, summary, listItems, byOrdin } from '../../lib/ordinance';
/** /ordinance/expc/ — 대구시·9개 구군이 법제처에 질의해 회답받은 법령해석례(data/ordinance/expc_daegu.json, signals.py)
 *  + 같은 지자체에서 그 법령 조문을 인용한 자치법규. 회답은 앞부분만 옮기고 원문은 링크로 본다. 해석을 평가하지 않는다. */
const p = path.join(process.cwd(), 'data', 'ordinance', 'expc_daegu.json');
const items: any[] = fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')).items : [];
const os = orgs();
const s = summary();
const L = new Map(listItems().map(x => [`${x.org}-${x.id}`, x]));
const pages = byOrdin();
const cnt = (k: string) => items.filter(x => x.dg === k).length;
---
<Base title="법제처 해석례 — 자치법규 정비 검토" description="대구광역시와 9개 구·군이 법제처에 질의해 회답받은 법령해석례와, 같은 법령 조문을 인용한 자치법규" crumb="법제처 해석례" noindex wide>
  <div class="section-head"><h1>대구 지자체가 법제처에 질의한 해석례</h1><span class="meta">{items.length.toLocaleString()}건 · 법제처 해석례 보유 {s?.expc_held?.toLocaleString() ?? 0}건</span></div>
  <Notice />
  <p><a href="/ordinance/">← 전체</a> · 법제처가 공개한 법령해석례(국가법령정보센터) 중 질의기관이나 안건 머리가 대구광역시·구·군인 것입니다(군위군은 편입 전 경상북도 군위군 질의 포함). '인용 자치법규'는 같은 지자체의 현행 자치법규 가운데 해석례가 다룬 법령 조문을 인용한 것입니다 — 회답이 반영됐는지는 원문으로 확인합니다. 다른 지자체·부처가 질의한 해석례 중 자치법규에 관한 것은 각 자치법규 화면에 이어 붙였습니다.</p>
  <p class="meta">{os.map(o => `${o.name} ${cnt(o.key)}`).join(' · ')}</p>
  {items.length === 0 ? <p class="callout info">아직 해석례 수집 결과가 없습니다.</p> :
  <div class="scroll-x"><table class="data-table">
    <thead><tr><th>지자체</th><th>안건</th><th>회답일</th><th>다룬 법령 조문</th><th>회답 앞부분</th><th>인용 자치법규</th></tr></thead>
    <tbody>{items.map(x => <tr>
      <td>{orgName(x.dg)}</td>
      <td><a href={x.url} rel="noopener">{x.t}</a><div class="meta">{x.no}{x.local && ' · 자치법규 관련'}</div></td>
      <td class="n">{x.d}</td>
      <td>{x.refs.join(', ')}</td>
      <td>{x.a.length >= 220 ? x.a + '…' : x.a}</td>
      <td>{x.ordins.length ? x.ordins.map((oid: string, i: number) => { const k = `${x.dg}-${oid}`; const o = L.get(k); return <>{i > 0 && ', '}<a href={pages.has(k) ? `/ordinance/o/${k}/` : `https://www.law.go.kr/LSW/ordinInfoP.do?ordinSeq=${o?.mst ?? ''}`}>{o?.name ?? oid}</a></>; }) : '—'}</td>
    </tr>)}</tbody>
  </table></div>}
</Base>
