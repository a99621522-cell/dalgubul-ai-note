---
import Base from '../../layouts/Base.astro';
import Notice from './_Notice.astro';
import { summary, signals, cands, orgs, byOrdin } from '../../lib/ordinance';
/** /ordinance/ — 대구 자치법규 정비 검토 첫 화면. 신호별·지자체별 후보 수(행정 순서, 정렬·순위 없음) */
const s = summary();
const sigs = signals();
const shown = sigs.filter(x => x.show);
const os = orgs();
const n = (sig: string, org: string) => s?.by_signal?.[sig]?.[org] ?? 0;
const ordCount = (org: string) => [...byOrdin().values()].filter(v => v.org === org).length;
const rate = s && s.refs ? Math.round((s.refs_resolved / s.refs) * 1000) / 10 : 0;
---
<Base title="자치법규 정비 검토" description="대구광역시와 9개 구·군 자치법규 가운데 상위법령 변경·폐지에 맞춰 정비를 검토할 후보를 근거 원문과 함께 보여 줍니다. 자동 대조이며 법적 판단이 아닙니다." crumb="자치법규 정비 검토" noindex wide>
  <div class="section-head"><h1>자치법규 정비 검토</h1>{s && <span class="meta">자치법규 {os.reduce((a, o) => a + o.count, 0).toLocaleString()}건 · 받은 날 {s.fetched}</span>}</div>
  <Notice />
  <p class="lede">대구광역시와 9개 구·군(중구·동구·서구·남구·북구·수성구·달서구·달성군·군위군)의 현행 조례·규칙이 인용한 상위법령을 국가법령정보센터의 현행 법령·연혁·조문 변경 이력과 맞춰 보고, <strong>정비를 검토해 볼 만한 조문</strong>을 근거와 함께 모았습니다. 이름이 바뀐 법령, 현행 목록에 없는 법령, 없어지거나 삭제된 조문, 근거 조문이 전부개정된 뒤 고치지 않은 조문, 옛 기관 이름, 지난 유효기간 등입니다. 글자만 바꾸면 되는 항목은 신구조문대비표 초안을 붙였습니다.</p>
  {!s ? <p class="callout info">아직 수집 결과가 없습니다. 워크플로 「자치법규 정비 검토」가 돌면 채워집니다.</p> : <>
  <div class="section-head"><h2>신호별·지자체별 후보 수</h2><span class="meta">행정 순서 · 정렬 없음</span></div>
  <div class="scroll-x"><table class="data-table">
    <thead><tr><th>신호</th><th>확인</th>{os.map(o => <th class="n"><a href={`/ordinance/org/${o.key}/`}>{o.name}</a></th>)}<th class="n">합계</th></tr></thead>
    <tbody>
      {shown.map(x => <tr><td><a href={`/ordinance/signal/${x.key}/`}>{x.name}</a></td><td>{x.conf === 'auto' ? '사실 대조' : '사람 확인'}</td>{os.map(o => <td class="n">{n(x.key, o.key).toLocaleString()}</td>)}<td class="n">{os.reduce((a, o) => a + n(x.key, o.key), 0).toLocaleString()}</td></tr>)}
      <tr><td><strong>후보가 있는 자치법규</strong></td><td></td>{os.map(o => <td class="n"><strong>{ordCount(o.key).toLocaleString()}</strong></td>)}<td class="n"><strong>{byOrdin().size.toLocaleString()}</strong></td></tr>
      <tr><td>현행 자치법규</td><td></td>{os.map(o => <td class="n">{o.count.toLocaleString()}</td>)}<td class="n">{os.reduce((a, o) => a + o.count, 0).toLocaleString()}</td></tr>
    </tbody>
  </table></div>
  <p class="meta">한 조문에 신호가 여러 개면 각각 셉니다. 지자체끼리 비교하는 표가 아닙니다 — 자치법규 수와 인용 방식이 달라 건수가 다를 수 있습니다.</p>

  <div class="section-head"><h2>검증 중인 신호(화면에 내지 않음)</h2></div>
  <ul>{sigs.filter(x => !x.show).map(x => <li>{x.name} — {(Object.values(s.by_signal[x.key] ?? {}) as number[]).reduce((a, b) => a + b, 0).toLocaleString()}건. {x.rule}</li>)}</ul>
  <p class="meta">표본을 사람이 확인해 맞는 비율이 80% 이상인 신호만 목록에 냅니다(<a href="/ordinance/about/#eval">방법</a>).</p>

  <div class="section-head"><h2>더 보기</h2></div>
  <ul>
    <li><a href="/ordinance/law/">법령으로 찾기</a> — 이 법령(조문)이 바뀌면 어느 대구 자치법규를 봐야 하나(인용 역색인)</li>
    <li><a href="/ordinance/about/">자료·방법·한계</a> — 인용 {s.refs.toLocaleString()}건 중 현행 법령·자치법규로 이은 것 {rate}%</li>
  </ul>
  </>}
</Base>
