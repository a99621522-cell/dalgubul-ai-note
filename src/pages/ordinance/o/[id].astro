---
import Base from '../../../layouts/Base.astro';
import Notice from '../_Notice.astro';
import OrdinCand from '../../../components/OrdinCand.astro';
import { byOrdin, orgName, draftTable, mark, ymd } from '../../../lib/ordinance';
/** /ordinance/o/<org>-<자치법규ID>/ — 후보가 있는 자치법규 한 건: 후보 카드 + 신구조문대비표 초안(글자 바꿈 신호만) */
export function getStaticPaths() { return [...byOrdin().entries()].map(([id, g]) => ({ params: { id }, props: { g } })); }
const { g } = Astro.props;
const items = [...g.items].sort((a, b) => a.no.localeCompare(b.no, 'ko', { numeric: true }));
const draft = draftTable(items);
---
<Base title={g.oname} description={`${g.oname}의 정비 검토 후보 ${items.length}건과 근거 원문`} crumb={g.oname} noindex wide>
  <div class="section-head"><h1>{g.oname}</h1><span class="meta">{orgName(g.org)} · {g.kind} · 최종 공포 {ymd(g.prom)}{g.dept && ` · ${g.dept}`}</span></div>
  <Notice />
  <p><a href={`/ordinance/org/${g.org}/`}>← {orgName(g.org)}</a> · <a href={g.url} rel="noopener">국가법령정보센터 원문</a></p>
  <div class="section-head"><h2>정비 검토 후보 {items.length}건</h2></div>
  {items.map(c => <OrdinCand c={c} />)}
  {draft.length > 0 && <>
    <div class="section-head"><h2>신구조문대비표 초안</h2></div>
    <p class="callout info">자동 생성 초안 — 글자만 바꾸는 항목(법령 이름·기관 이름)입니다. 조문 체계·부칙(시행일·경과조치)은 입안 담당자가 작성합니다. 밑줄이 바뀌는 부분입니다.</p>
    <div class="scroll-x"><table class="data-table" data-stack="off">
      <thead><tr><th>현행</th><th>개정안(초안)</th></tr></thead>
      <tbody>{draft.map(r => <tr><td class="txt" set:html={mark(r.cur)} /><td class="txt" set:html={mark(r.neu)} /></tr>)}</tbody>
    </table></div>
  </>}
</Base>
<style>.txt { white-space: pre-wrap; vertical-align: top; min-width: 16em; }</style>
