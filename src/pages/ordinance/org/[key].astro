---
import Base from '../../../layouts/Base.astro';
import Notice from '../_Notice.astro';
import { orgs, cands, listItems, signals, ymd, CATS, catLabel } from '../../../lib/ordinance';
/** /ordinance/org/<key>/ — 지자체 하나의 '정비 대상 목록': 정비 성격별로 자치법규·조문·정비 사유·정비 방향(규칙 문장).
 *  표는 한글 표 복사·CSV(table_tools). 자치법규 가나다 → 조문 순. 판정이 아니라 검토 목록이다. */
export function getStaticPaths() { return orgs().map(o => ({ params: { key: o.key }, props: { org: o } })); }
const { org } = Astro.props;
const mine = cands().filter(c => c.org === org.key)
  .sort((a, b) => a.oname.localeCompare(b.oname, 'ko') || a.no.localeCompare(b.no, 'ko', { numeric: true }));
const sigName = new Map(signals().map(s => [s.key, s.name]));
const all = listItems().filter(x => x.org === org.key).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const has = new Map<string, number>();
for (const c of mine) has.set(c.oid, (has.get(c.oid) ?? 0) + 1);
---
<Base title={`${org.name} 자치법규 정비 대상`} description={`${org.name} 현행 자치법규 ${org.count}건 중 정비를 검토할 ${has.size}건의 정비 사유와 정비 방향`} crumb={org.name} noindex wide>
  <div class="section-head"><h1>{org.name} 자치법규 정비 대상</h1><span class="meta">현행 {org.count.toLocaleString()}건 · 정비 검토 {has.size.toLocaleString()}건 · 항목 {mine.length.toLocaleString()}개</span></div>
  <Notice />
  <p><a href="/ordinance/">← 전체</a> · 아래 표의 '정비 사유'는 국가법령정보센터·법제처 자료와 맞춰 본 사실이고, '정비 방향'은 규칙으로 만든 검토 문장입니다. 표 아래 단추로 한글에 붙이거나 CSV 로 받을 수 있습니다. 조문 원문과 근거 원문은 자치법규 이름을 누르면 나옵니다.</p>
  <nav class="cats">{CATS.map(k => { const n = mine.filter(c => c.cat === k).length; return n > 0 && <a href={`#${encodeURIComponent(k)}`}>{catLabel[k]} {n}</a>; })}</nav>
  {CATS.map(k => {
    const rows = mine.filter(c => c.cat === k);
    return rows.length > 0 && (
      <section id={k}>
        <div class="section-head"><h2>{catLabel[k]}</h2><span class="meta">{rows.length.toLocaleString()}개</span></div>
        <div class="scroll-x"><table class="data-table">
          <thead><tr><th>자치법규</th><th>조문</th><th data-pri="2">구분</th><th>정비 사유</th><th>정비 방향</th></tr></thead>
          <tbody>{rows.map(c => <tr>
            <td><a href={`/ordinance/o/${c.org}-${c.oid}/`}>{c.oname}</a></td>
            <td>{c.no || '—'}</td>
            <td>{sigName.get(c.sig)}</td>
            <td>{c.why}</td>
            <td>{c.how}</td>
          </tr>)}</tbody>
        </table></div>
      </section>);
  })}
  <details><summary>현행 자치법규 전체 {all.length.toLocaleString()}건</summary>
    <div class="scroll-x"><table class="data-table">
      <thead><tr><th>자치법규</th><th>종류</th><th>최종 공포</th><th>제·개정</th><th>정비 항목</th></tr></thead>
      <tbody>{all.map(x => <tr><td><a href={`https://www.law.go.kr/LSW/ordinInfoP.do?ordinSeq=${x.mst}`} rel="noopener">{x.name}</a></td><td>{x.kind}</td><td class="n">{ymd(x.prom)}</td><td>{x.rev}</td><td class="n">{has.has(x.id) ? <a href={`/ordinance/o/${org.key}-${x.id}/`}>{has.get(x.id)}</a> : '—'}</td></tr>)}</tbody>
    </table></div>
  </details>
</Base>
<style>.cats { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 8px 0 4px; }</style>
