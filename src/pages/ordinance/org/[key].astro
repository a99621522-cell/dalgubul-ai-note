---
import Base from '../../../layouts/Base.astro';
import Notice from '../_Notice.astro';
import OrdinCand from '../../../components/OrdinCand.astro';
import { orgs, byOrdin, listItems, signals, ymd } from '../../../lib/ordinance';
/** /ordinance/org/<key>/ — 지자체 하나의 후보(자치법규 가나다순) + 현행 자치법규 전체 목록 */
export function getStaticPaths() { return orgs().map(o => ({ params: { key: o.key }, props: { org: o } })); }
const { org } = Astro.props;
const groups = [...byOrdin().values()].filter(v => v.org === org.key).sort((a, b) => a.oname.localeCompare(b.oname, 'ko'));
const all = listItems().filter(x => x.org === org.key).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
const has = new Map(groups.map(g => [g.oid, g.items.length]));
const sigs = signals().filter(s => s.show);
---
<Base title={`${org.name} 자치법규 정비 검토`} description={`${org.name} 현행 자치법규 ${org.count}건 중 정비 검토 후보가 있는 ${groups.length}건과 근거`} crumb={org.name} noindex wide>
  <div class="section-head"><h1>{org.name} 자치법규 정비 검토</h1><span class="meta">현행 {org.count.toLocaleString()}건 · 후보 있는 자치법규 {groups.length.toLocaleString()}건</span></div>
  <Notice />
  <p><a href="/ordinance/">← 전체</a> · 신호: {sigs.map((s, i) => <>{i > 0 && ' · '}<a href={`/ordinance/signal/${s.key}/`}>{s.name}</a></>)}</p>
  <div class="section-head"><h2>후보가 있는 자치법규</h2></div>
  <div class="scroll-x"><table class="data-table">
    <thead><tr><th>자치법규</th><th>종류</th><th>최종 공포</th><th>소관 부서</th><th>후보</th><th>신호</th></tr></thead>
    <tbody>{groups.map(g => <tr>
      <td><a href={`/ordinance/o/${g.org}-${g.oid}/`}>{g.oname}</a></td><td>{g.kind}</td><td class="n">{ymd(g.prom)}</td><td>{g.dept}</td>
      <td class="n">{g.items.length}</td><td>{[...new Set(g.items.map(c => sigs.find(s => s.key === c.sig)?.name))].join(' · ')}</td></tr>)}</tbody>
  </table></div>
  <details><summary>현행 자치법규 전체 {all.length.toLocaleString()}건</summary>
    <div class="scroll-x"><table class="data-table">
      <thead><tr><th>자치법규</th><th>종류</th><th>최종 공포</th><th>제·개정</th><th>후보</th></tr></thead>
      <tbody>{all.map(x => <tr><td><a href={`https://www.law.go.kr/LSW/ordinInfoP.do?ordinSeq=${x.mst}`} rel="noopener">{x.name}</a></td><td>{x.kind}</td><td class="n">{ymd(x.prom)}</td><td>{x.rev}</td><td class="n">{has.has(x.id) ? <a href={`/ordinance/o/${org.key}-${x.id}/`}>{has.get(x.id)}</a> : '—'}</td></tr>)}</tbody>
    </table></div>
  </details>
</Base>
