---
import Base from '../../layouts/Base.astro';
import AttachList from '../../components/AttachList.astro';
import { REPORT_FILES, type ReportFile } from '../../lib/reportFiles';
/** /policy/<slug>/ — 리포트 자료 상세(리디자인 v3 2026-10-12, 참조 디자인의 간행물 상세: 제목 띠 · 주제 칩 · 첨부 목록 · 문서 미리보기).
 *  내용은 운영자가 올린 파일 그대로, 요약 한 줄은 reportFiles.ts summary. 조회수·담당 전화는 싣지 않는다. */
export function getStaticPaths() { return REPORT_FILES.map(f => ({ params: { slug: f.slug }, props: { f } })); }
const { f } = Astro.props as { f: ReportFile };
const items = [
  ...(f.pdf ? [{ label: `${f.name}.pdf`, href: f.pdf, kind: 'PDF' as const, size: f.pdfSize, pages: f.pages, download: `${f.name}.pdf` }] : []),
  ...(f.hwpx ? [{ label: `${f.name}.hwpx`, href: f.hwpx, kind: '한글' as const, size: f.hwpxSize, download: `${f.name}.hwpx` }] : []),
  ...(f.href ? [{ label: `${f.name}.docx`, href: f.href, kind: 'Word' as const, size: f.size, download: `${f.name}.docx` }] : []),
];
const mb = (s?: string) => Number((s || '').replace(/MB$/, '')) || 0;
const others = REPORT_FILES.filter(x => x.slug !== f.slug);
---
<Base title={f.title} description={f.summary} current="policy" crumb={f.name}>
  <div class="section-head report-head"><h1>{f.title}</h1><span class="meta">리포트 자료 · {f.date.replaceAll('-', '. ')}.</span></div>
  <p class="lede">{f.summary}</p>
  <p class="topics" aria-label="주제">{f.topics.map(t => <span class="chip">{t}</span>)}</p>
  <AttachList items={items} />
  {f.pdf && (
    <details class="viewer" open={mb(f.pdfSize) <= 3 ? true : undefined} data-src={f.pdf}>
      <summary>문서 미리보기(PDF{f.pages ? ` ${f.pages}쪽` : ''})</summary>
      <div class="viewer-box"><iframe title={`${f.name} 미리보기`} loading="lazy"></iframe></div>
      <p class="meta">미리보기가 보이지 않으면 위 「열기」로 새 창에서 보거나 내려받으세요. 휴대폰에서는 내려받기를 권합니다.</p>
    </details>)}
  {others.length > 0 && (
    <section>
      <div class="section-head"><h2>다른 리포트 자료</h2></div>
      <ul class="others">{others.map(o => <li><a href={`/policy/${o.slug}/`}>{o.title}</a> <span class="meta">· {o.date}</span></li>)}</ul>
    </section>)}
  <script>
    // 미리보기는 펼칠 때만 PDF 를 받는다(768px 이상에서 작은 파일은 처음부터 펼침, 휴대폰은 닫아 둠)
    const d = document.querySelector<HTMLDetailsElement>('details.viewer');
    if (d) {
      if (innerWidth < 768) d.open = false;
      const load = () => { const fr = d.querySelector('iframe')!; if (d.open && !fr.src) fr.src = d.dataset.src + '#view=FitH'; };
      d.addEventListener('toggle', load); load();
    }
  </script>
  <style>
    .topics { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--s2) 0 0; }
    .chip { display: inline-flex; align-items: center; min-height: 30px; padding: 0 12px; border: 1px solid var(--band-line); border-radius: 999px; background: var(--band); font-size: var(--small); color: var(--primary-deep); }
    .viewer { margin: var(--s3) 0; }
    .viewer > summary { cursor: pointer; font-weight: 600; min-height: var(--touch); display: flex; align-items: center; }
    .viewer-box { border: 1px solid var(--line-strong); border-top: 6px solid var(--ink); height: min(80vh, 900px); }
    .viewer-box iframe { width: 100%; height: 100%; border: 0; display: block; }
    .others { list-style: none; padding: 0; }
    .others li { padding: 8px 0; border-bottom: 1px solid var(--line); }
  </style>
</Base>
