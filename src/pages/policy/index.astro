---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import { REPORT_FILES } from '../../lib/reportFiles';
/** /policy/ — 리포트(메뉴 이름 '리포트', 운영자 지시 2026-09-30): 운영자가 올린 자료의 PDF·Word 내려받기만 둔다.
 *  파일은 public/files/ 에 두고 `src/lib/reportFiles.ts` 의 REPORT_FILES 에 한 줄씩 더한다(첫 화면 회전 카드도 같은 목록). 한글(HWPX)판은 2026-09-30 에 내렸다가 공무원 양식 복제(`scripts/docx_to_hwpx.py`)로 다시 만들어 올렸다(운영자 지시 2026-10-06). PDF 는 Word 를 LibreOffice 로 변환(맑은 고딕 → Pretendard, 운영자 지시 2026-10-01).
 *  정책제안 리포트 목록·산업 정책 글·국비↔시비 매칭 표는 이 페이지에서 뺐다. */
// 대구 지역산업진흥계획(대구광역시 수립, KIAT 과제관리시스템 자료실 공개본 원문 그대로) — scripts/fetch_kpass_plans.py·regional_plan.yml 이 받는다
const PLANS: { year: string; title: string; orig: string; file: string; bytes: number; pages: number | null; posted: string; source_url: string }[] =
  fs.existsSync('data/regional_plan/index.json') ? JSON.parse(fs.readFileSync('data/regional_plan/index.json', 'utf-8')) : [];
const mb = (b: number) => `${(b / 1048576).toFixed(1)}MB`;
const FILES = REPORT_FILES;
---
<Base title="리포트" description={`리포트 자료 내려받기 ${FILES.length}건(PDF·Word·한글)과 대구 지역산업진흥계획 ${PLANS.length}개 연도(PDF).`} current="policy">
  <div class="section-head"><h1>리포트</h1><span class="meta">자료 {FILES.length}건</span></div>
  <ul class="files">
    {FILES.map(f => (
      <li>
        <span class="t">{f.title}</span>
        <span class="dl">{f.pdf && <><a href={f.pdf} download={`${f.name}.pdf`}>PDF 내려받기</a> <span class="meta">{f.pdfSize}</span> · </>}<a href={f.href} download={`${f.name}.docx`}>Word 내려받기</a> <span class="meta">{f.size}</span>{f.hwpx && <> · <a href={f.hwpx} download={`${f.name}.hwpx`}>한글 내려받기</a> <span class="meta">{f.hwpxSize}</span></>}</span>
      </li>
    ))}
  </ul>

  {PLANS.length > 0 && <section id="regional-plan">
    <div class="section-head"><h2>대구 지역산업진흥계획</h2><span class="meta">{PLANS.length}개 연도 · PDF</span></div>
    <p class="meta">대구광역시가 해마다 수립해 한국산업기술진흥원(KIAT) 과제관리시스템 자료실에 공개한 계획서 원문입니다(손대지 않은 원본). 자료실의 대구 계획은 {PLANS[PLANS.length - 1].year}~{PLANS[0].year}년분이며, 그 뒤 연도의 계획은 공개된 원문을 찾지 못했습니다.</p>
    <ul class="files">
      {PLANS.map(p => (
        <li>
          <span class="t">{p.title}</span>
          <span class="dl"><a href={p.file} download={`${p.year}년 대구 지역산업진흥계획.pdf`}>PDF 내려받기</a> <span class="meta">{mb(p.bytes)}{p.pages ? ` · ${p.pages}쪽` : ''} · 자료실 게시 {p.posted} · <a href={p.source_url} rel="noopener">원문 게시글</a></span></span>
        </li>
      ))}
    </ul>
  </section>}
  <style>
    ul.files { list-style: none; padding: 0; }
    ul.files li { padding: var(--s2) 0; border-bottom: 1px solid var(--line); }
    ul.files .t { display: block; font-weight: 600; }
    ul.files .dl { display: block; margin-top: .3em; }
  </style>
</Base>
