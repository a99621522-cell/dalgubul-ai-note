---
import Base from '../../layouts/Base.astro';
import { REPORT_FILES } from '../../lib/reportFiles';
/** /policy/ — 리포트(메뉴 이름 '리포트', 운영자 지시 2026-09-30): 운영자가 올린 자료의 PDF·Word 내려받기만 둔다.
 *  파일은 public/files/ 에 두고 `src/lib/reportFiles.ts` 의 REPORT_FILES 에 한 줄씩 더한다(첫 화면 회전 카드도 같은 목록). 한글(HWPX)판은 2026-09-30 에 내렸다가 공무원 양식 복제(`scripts/docx_to_hwpx.py`)로 다시 만들어 올렸다(운영자 지시 2026-10-06). PDF 는 Word 를 LibreOffice 로 변환(맑은 고딕 → Pretendard, 운영자 지시 2026-10-01).
 *  정책제안 리포트 목록·산업 정책 글·국비↔시비 매칭 표는 이 페이지에서 뺐다. */
// 대구 지역산업진흥계획 묶음은 내렸다(운영자 지시 2026-10-12 '지역산업진흥계획은 다 내려') — PDF 도 public 에서 지웠고 data/regional_plan/index.json 만 남김
const FILES = REPORT_FILES;
---
<Base title="리포트" description={`리포트 자료 내려받기 ${FILES.length}건(PDF·Word·한글).`} current="policy">
  <div class="section-head"><h1>리포트</h1><span class="meta">자료 {FILES.length}건</span></div>
  <ul class="rlist">
    {FILES.map(f => (
      <li>
        <div class="r-main">
          <a class="r-title" href={`/policy/${f.slug}/`}>{f.title}</a>
          <p class="r-sum">{f.summary}</p>
          <p class="r-meta"><span>{f.date.replaceAll('-', '. ')}.</span>{f.topics.map(t => <span class="chip">{t}</span>)}</p>
        </div>
        <div class="r-dl" aria-label={`${f.name} 내려받기`}>
          {f.pdf && <a href={f.pdf} download={`${f.name}.pdf`}><b>PDF</b> {f.pdfSize}</a>}
          {f.hwpx && <a href={f.hwpx} download={`${f.name}.hwpx`}><b>한글</b> {f.hwpxSize}</a>}
          <a href={f.href} download={`${f.name}.docx`}><b>Word</b> {f.size}</a>
        </div>
      </li>
    ))}
  </ul>

  <section id="research-data">
    <div class="section-head"><h2>연구 보고서 수치</h2><span class="meta">보고서 값 그대로</span></div>
    <ul class="files">
      <li>
        <span class="t"><a href="/policy/dpi-industry/">대구 주력·미래 신산업 현황(2023년)</a></span>
        <span class="dl meta">대구정책연구원 「지역과 대학의 상생발전을 위한 전략 수립」(연구 2026-09)의 대구 산업별 사업체·종사자·생산액·부가가치 — 통계 › 산업 구조와 같은 표</span>
      </li>
    </ul>
  </section>

  <style>
    .rlist { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
    .rlist > li { display: grid; grid-template-columns: 1fr auto; gap: var(--s1) var(--s3); padding: var(--s3) 0; border-bottom: 1px solid var(--line); }
    @media (max-width: 767px) { .rlist > li { grid-template-columns: 1fr; } }
    .r-title { font-size: 1.15rem; font-weight: 700; color: var(--ink); text-decoration: none; }
    .r-title:hover { color: var(--primary); text-decoration: underline; }
    .r-sum { margin: 6px 0 0; color: var(--muted); font-size: var(--small); }
    .r-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin: 8px 0 0; font-size: var(--small); color: var(--muted); }
    .r-meta .chip { display: inline-flex; align-items: center; min-height: 26px; padding: 0 10px; border: 1px solid var(--band-line); border-radius: 999px; background: var(--band); color: var(--primary-deep); }
    .r-dl { display: flex; flex-direction: column; gap: 4px; min-width: 9.5em; }
    @media (max-width: 767px) { .r-dl { flex-direction: row; flex-wrap: wrap; } }
    .r-dl a { display: flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: var(--radius); font-size: var(--small); color: var(--muted); text-decoration: none; }
    .r-dl a b { color: var(--ink); min-width: 2.6em; }
    .r-dl a:hover { border-color: var(--primary); color: var(--primary); }
    ul.files { list-style: none; padding: 0; }
    ul.files li { padding: var(--s2) 0; border-bottom: 1px solid var(--line); }
    ul.files .t { display: block; font-weight: 600; }
    ul.files .dl { display: block; margin-top: .3em; }
  </style>
</Base>
