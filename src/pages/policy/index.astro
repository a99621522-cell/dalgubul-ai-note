---
import Base from '../../layouts/Base.astro';
/** /policy/ — 리포트(메뉴 이름 '리포트', 운영자 지시 2026-09-30): 운영자가 올린 자료의 Word 내려받기만 둔다.
 *  파일은 public/files/ 에 두고 아래 FILES 에 한 줄씩 더한다. 한글(HWPX)판은 한글에서 제대로 열리지 않아 내렸다(운영자 확인 2026-09-30, Word 만).
 *  정책제안 리포트 목록·산업 정책 글·국비↔시비 매칭 표는 이 페이지에서 뺐다. */
const FILES = [
  { title: '지역 산업구조 특성이 경제성장에 미치는 영향 — 대구판(산업구조지수를 중심으로)', name: '지역 산업구조 특성이 경제성장에 미치는 영향 — 대구판',
    href: '/files/daegu-industry-structure.docx', size: '1.7MB' },
  { title: '주요 제조업 공급망 지도 해설', name: '주요 제조업 공급망 지도 해설',
    href: '/files/supply-chain-map-guide.docx', size: '11.4MB' },
];
---
<Base title="리포트" description={`리포트 자료 내려받기 ${FILES.length}건(Word).`} current="policy">
  <div class="section-head"><h1>리포트</h1><span class="meta">자료 {FILES.length}건</span></div>
  <ul class="files">
    {FILES.map(f => (
      <li>
        <span class="t">{f.title}</span>
        <span class="dl"><a href={f.href} download={`${f.name}.docx`}>Word 내려받기</a> <span class="meta">{f.size}</span></span>
      </li>
    ))}
  </ul>
  <style>
    ul.files { list-style: none; padding: 0; }
    ul.files li { padding: var(--s2) 0; border-bottom: 1px solid var(--line); }
    ul.files .t { display: block; font-weight: 600; }
    ul.files .dl { display: block; margin-top: .3em; }
  </style>
</Base>
