---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES } from '../../categories';
import BudgetSource from '../../components/BudgetSource.astro';
import { isReport, downloadUrls } from '../../lib/reports';
import fs from 'node:fs';
export async function getStaticPaths() {
  const posts = await getCollection('posts', p => !p.data.draft);
  return posts.map(p => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
// 차례: 2단계 제목 4개 이상인 긴 글(정책제안 리포트·월보)만. 슬러그는 Astro 가 붙인 id.
const toc = headings.filter(h => h.depth === 2);
const d = post.data;
const dl = isReport(post) ? downloadUrls(post.id) : null;
const insight = d.format === 'insight';
const heroSrc = insight && fs.existsSync(`public/figures/${post.id}/hero.png`) ? `/figures/${post.id}/hero.png` : null;
const showToc = !insight && toc.length >= 4;
const fmt = (x: Date) => x.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const jsonld: object[] = [{
  '@context': 'https://schema.org', '@type': 'Article',
  headline: d.seoTitle || d.title, description: d.description || d.summary,
  datePublished: d.date.toISOString(), articleSection: CATEGORIES[d.category].name,
  keywords: d.tags.join(', '), mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: '다잇다' },
  publisher: { '@type': 'Organization', name: '다잇다' },
  ...(d.sourceUrl ? { citation: d.sourceUrl } : d.sources.length ? { citation: d.sources.map(s => s.url) } : {}),
}];
if (d.faq.length > 0) jsonld.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: d.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<Base title={d.title} seoTitle={d.seoTitle} description={d.description || d.summary} current={d.category} tags={d.tags} jsonld={jsonld}>
  <article class:list={["post", { insight }]}>
    <header>
      <h1 class:list={{ long: d.title.length > 60 }}>{d.title}</h1>
      <div class="meta">
        <span class="cat">{CATEGORIES[d.category].name}</span>{' · '}{fmt(d.date)}
        {d.deadline && <>{' · '}마감 {fmt(d.deadline)}</>}
        {d.auto && <span class="auto">AI 작성</span>}
        {dl && <span class="dl"> · 내려받기 {dl.hwpx && <><a href={dl.hwpx} download title="공무원 보고서 양식(절 머리표·○·-·※) 한글 파일">한글</a> · </>}<a href={dl.docx} download>Word</a> · <a href={dl.md} download>MD</a></span>}
      </div>
    </header>
    {insight && heroSrc && d.hero && (
      <figure class="hero"><img src={heroSrc} alt={d.hero.alt ?? d.hero.caption} width="1600" height="900" loading="eager" /><figcaption>{d.hero.caption}</figcaption></figure>
    )}
    {insight && d.outline.length > 0 && (
      <nav class="outline" aria-label="요약"><ul>{d.outline.map(o => <li><a href={`#${headings.find(h => h.depth === 2 && h.text.includes(o))?.slug ?? ''}`}>{o}</a></li>)}</ul></nav>
    )}
    {!insight && d.description && <p class="lede">{d.description}</p>}
    {d.program_code && d.program_name && <BudgetSource code={d.program_code} name={d.program_name} ministry={d.program_ministry} budget2026={d.program_budget_2026} score={d.program_score} />}
    {showToc && (
      <nav class="toc" aria-label="차례">
        <p class="toc-title">차례</p>
        <ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="body"><Content /></div>
    {d.faq.length > 0 && (
      <section class="faq" aria-label="자주 묻는 질문">
        <h2>자주 묻는 질문</h2>
        {d.faq.map(f => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </section>
    )}
    {d.sources.length > 0 && (
      <section class="sources" aria-label="출처 목록">
        <h2>출처 ({d.sources.length}건)</h2>
        <ol>{d.sources.map(s => <li><a href={s.url} rel="noopener">{s.title}</a>{s.date && <span class="meta"> · {s.date}</span>}</li>)}</ol>
        <p class="meta">날짜가 '미확인'인 항목과 본문에 '요지'로 표시한 수치는 검색 결과 요약을 옮긴 것이라 원문 확인이 필요합니다. 기업 수·고용·예산은 저장소의 기업 사전(팩토리온)과 사업설명자료 DB를 코드로 센 값입니다.</p>
      </section>
    )}
    {d.tags.length > 0 && <p class="tags">{d.tags.map(t => <span>#{t}</span>)}</p>}
    {(d.source || d.sourceUrl) && (
      <aside class="source-box">
        <strong>출처</strong>{' '}{d.source}
        {d.sourceUrl && <> — <a href={d.sourceUrl} rel="noopener">원문 보기</a></>}
        <br />요약은 원문을 바탕으로 작성했으며 수치·날짜는 원문 확인을 권합니다.
      </aside>
    )}
  </article>
</Base>
