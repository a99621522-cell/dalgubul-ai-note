---
import Base from '../../../layouts/Base.astro';
import { cityPrograms, fmtCheon } from '../../../lib/csv';
/** /programs/daegu/ — 대구시 본예산 사업설명서(부서별, 홈페이지 공개용)에서 뽑은 세부사업.
 *  실국·부서·상태·기업 수혜로 거른다. 금액은 자료 값 그대로(천 원 → 억·만 원 환산만). 담당자 성명·전화는 싣지 않는다. 평가·순위 없음. */
const all = cityPrograms();
const list = all.filter(p => !p.admin);
const orgs = [...list.reduce((m, p) => m.set(p.org, (m.get(p.org) ?? 0) + 1), new Map<string, number>())].sort((a, b) => b[1] - a[1]);
const depts = [...new Set(list.map(p => `${p.org}|${p.dept}`))].sort();
const sources = [...new Set(all.map(p => p.source))];
const year = all[0]?.year ?? '2026';
const inc = list.filter(p => p.b25 > 0 && p.b26 > p.b25).length, dec = list.filter(p => p.b25 > 0 && p.b26 < p.b25).length, nw = list.filter(p => p.isNew).length;
const pct = (p: typeof list[number]) => p.b25 > 0 ? `${p.b26 >= p.b25 ? '+' : ''}${(((p.b26 - p.b25) / p.b25) * 100).toFixed(1)}%` : '';
const fundText = (p: typeof list[number]) => {
  const f = p.funds; const t = f.city + f.national + f.balanced + f.other; if (!t) return '';
  return [f.city && `시비 ${Math.round((f.city / t) * 100)}%`, f.national && `국비 ${Math.round((f.national / t) * 100)}%`, f.balanced && `균특 ${Math.round((f.balanced / t) * 100)}%`, f.other && `기타 ${Math.round((f.other / t) * 100)}%`].filter(Boolean).join(' · ');
};
---
<Base title="대구시 사업 예산" description={`대구시 ${year}년 본예산 사업설명서(부서별)에서 뽑은 세부사업 ${list.length}건 — 실국·부서·신규 여부·기업 수혜로 찾고, 재원 구성과 전년 대비를 함께 봅니다`} current="programs">
  <p class="meta"><a href="/programs/">사업 예산</a> › 대구시</p>
  <div class="section-head"><h1>대구시 사업 예산</h1><span class="meta">{year}년 본예산 · 세부사업 {list.length}건 · 실국 {orgs.length}곳</span></div>
  {list.length === 0 ? <p class="empty">아직 자료가 없습니다. 대구시 사업설명서(부서별 PDF)를 <code>scripts/parse_city_budget.py</code> 로 읽으면 여기에 나옵니다.</p> : <>
  <p class="lede">대구시가 시의회에 낸 본예산 사업설명서(홈페이지 공개용)에서 세부사업을 같은 형식으로 옮겼습니다. 예산은 자료의 값 그대로이며(천 원 → 억·만 원 환산), 평가나 순위는 하지 않습니다. 부서 운영비 같은 행정경비 {all.length - list.length}건은 빼고 보여 줍니다.</p>
  <ul class="tiles" aria-label="올해 달라진 사업">
    <li class="tile"><p class="label">신규 사업</p><p class="num">{nw}<span class="unit">건</span></p><p class="sub">사업설명서에 '신규' 로 표시</p></li>
    <li class="tile"><p class="label">증액 사업</p><p class="num">{inc}<span class="unit">건</span></p><p class="sub">{Number(year) - 1}년 당초 대비</p></li>
    <li class="tile"><p class="label">감액 사업</p><p class="num">{dec}<span class="unit">건</span></p><p class="sub">{Number(year) - 1}년 당초 대비</p></li>
    <li class="tile"><p class="label">기업 수혜 사업</p><p class="num">{list.filter(p => p.corp).length}<span class="unit">건</span></p><p class="sub">목적·내용에 기업·소상공인·창업이 있는 사업</p></li>
  </ul>
  <div class="tools">
    <input id="q" type="search" placeholder="사업명·내용 검색" aria-label="검색" />
    <select id="org" aria-label="실국"><option value="">모든 실국</option>{orgs.map(([o, n]) => <option value={o}>{o} ({n})</option>)}</select>
    <select id="dp" aria-label="부서"><option value="">모든 부서</option>{depts.map(d => <option value={d} data-org={d.split('|')[0]}>{d.split('|')[1]}</option>)}</select>
    <select id="st" aria-label="상태"><option value="">모든 상태</option><option value="신규">신규</option><option value="계속">계속</option><option value="up">증액</option><option value="down">감액</option></select>
    <label class="chk"><input id="co" type="checkbox" /> 기업 수혜만</label>
    <span id="count" class="meta">{list.length}건</span>
  </div>
  <ul class="pg-list" id="list">
    {list.map(p => (
      <li data-org={p.org} data-dp={`${p.org}|${p.dept}`} data-st={p.status} data-dir={p.b25 > 0 ? (p.b26 > p.b25 ? 'up' : p.b26 < p.b25 ? 'down' : 'same') : 'new'} data-co={p.corp ? '1' : ''} data-text={`${p.name} ${p.purpose} ${p.content} ${p.dept}`.toLowerCase()}>
        <div class="row1"><span class="name">{p.name}</span>{p.isNew && <span class="tag">신규</span>}{p.corp && <span class="tag">기업 수혜</span>}</div>
        <div class="row2">{p.org} {p.dept}{p.policy_program && <> · {p.policy_program} › {p.unit_program}</>}{p.period && <> · {p.period}</>}</div>
        <div class="row3">{year}년 {fmtCheon(p.b26) ?? '—'}{p.b25 > 0 && <span class="prev"> ({Number(year) - 1}년 {fmtCheon(p.b25)}, {pct(p)})</span>}{fundText(p) && <> · {fundText(p)}</>}</div>
        {(p.purpose || p.content) && <details class="more"><summary>목적·내용·근거</summary>
          {p.purpose && <p><strong>목적</strong> {p.purpose}</p>}
          {p.content && <p><strong>내용</strong> {p.content}</p>}
          {p.basis && <p><strong>근거</strong> {p.basis}</p>}
        </details>}
      </li>
    ))}
  </ul>
  <p class="meta src">출처: {sources.join(' · ')} (대구광역시 홈페이지 공개 자료). 세부사업 쪽의 예산총괄·재원별 내역·사업설명을 그대로 옮겼으며, 담당자 정보는 싣지 않습니다. 국비 사업과의 연결은 <a href="/policy/#city-match">정책 › 국비↔시비 매칭 표</a>.</p>
  </>}
  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const org = document.getElementById('org') as HTMLSelectElement, dp = document.getElementById('dp') as HTMLSelectElement, st = document.getElementById('st') as HTMLSelectElement;
    const co = document.getElementById('co') as HTMLInputElement; const count = document.getElementById('count');
    const items = Array.from(document.querySelectorAll<HTMLLIElement>('#list > li'));
    const dpOpts = Array.from(dp.options);
    function apply() {
      const t = q.value.trim().toLowerCase(); const o = org.value, d = dp.value, s = st.value; let n = 0;
      for (const li of items) {
        const ok = (!o || li.dataset.org === o) && (!d || li.dataset.dp === d) && (!co.checked || li.dataset.co === '1') && (!t || (li.dataset.text ?? '').includes(t))
          && (!s || (s === 'up' || s === 'down' ? li.dataset.dir === s : li.dataset.st === s));
        li.hidden = !ok; if (ok) n++;
      }
      if (count) count.textContent = `${n.toLocaleString('ko-KR')}건`;
    }
    org.addEventListener('change', () => { for (const op of dpOpts) op.hidden = !!op.value && !!org.value && op.dataset.org !== org.value; if (dp.selectedOptions[0]?.hidden) dp.value = ''; apply(); });
    q.addEventListener('input', apply); [dp, st].forEach(x => x.addEventListener('change', apply)); co.addEventListener('change', apply);
    const sp = new URLSearchParams(location.search); if (sp.get('org')) org.value = sp.get('org')!; if (sp.get('q')) q.value = sp.get('q')!;
    apply();
  </script>
</Base>
<style>
  .tools { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin: 1.25rem 0 0.5rem; }
  .tools input[type=search], .tools select { font: inherit; padding: 0.45rem 0.6rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); max-width: 100%; }
  .tools input[type=search] { flex: 1 1 14rem; }
  .chk { display: inline-flex; gap: 0.3rem; align-items: center; font-size: 0.9rem; }
  .tiles { margin-top: var(--s2); }
  .pg-list { list-style: none; padding: 0; margin: 0; }
  .pg-list > li { padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .row1 { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; }
  .name { font-weight: 600; }
  .row2, .row3 { font-size: 0.85rem; color: var(--muted); margin-top: 0.15rem; }
  .prev { color: var(--muted); }
  .tag { font-size: 0.75rem; padding: 0.05rem 0.4rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }
  .more { margin-top: 0.3rem; font-size: 0.88rem; }
  .more summary { cursor: pointer; color: var(--primary); }
  .more p { margin: 0.3rem 0 0; }
  .src { margin-top: 1.25rem; }
</style>
