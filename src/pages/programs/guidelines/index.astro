---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../layouts/Base.astro';
/** /programs/guidelines/ — 사업 지침 창고: 예산요구서·결산서 검토 근거가 되는 법령·행정규칙·자치법규 목록(data/guidelines/index.json)과
 *  지침별 검토표(data/guidelines/checks/*.json). 조문을 그대로 옮기며 지침을 평가하지 않는다. 표마다 「한글 표 복사」「HWP 내려받기」가 붙는다(table_tools). */
type Entry = { key: string; name: string; kind: string; issuer: string; found?: string; found_kind?: string; found_issuer?: string; date?: string; eff?: string; url?: string; status: string; chars?: number; articles?: number; annexes?: string[]; review: string[]; applies?: Record<string, any>; candidates?: string[] };
type Item = { id: string; stage: string; item: string; check: string; basis: string; quote: string; doc: string };
type Check = { key: string; name: string; eff: string; status: string; added: string; note?: string; items: Item[] };
const dir = path.join(process.cwd(), 'data', 'guidelines');
const idx = fs.existsSync(path.join(dir, 'index.json')) ? JSON.parse(fs.readFileSync(path.join(dir, 'index.json'), 'utf-8')) : { fetched: '', items: {} };
const entries: Entry[] = Object.values(idx.items ?? {});
const checks: Check[] = fs.existsSync(path.join(dir, 'checks')) ? fs.readdirSync(path.join(dir, 'checks')).filter(f => f.endsWith('.json') && f !== 'rules.json').map(f => JSON.parse(fs.readFileSync(path.join(dir, 'checks', f), 'utf-8'))) : [];
const checkOf = new Map(checks.map(c => [c.key, c]));
const groupOf = (k: string) => k.startsWith('daegu-') ? '대구광역시' : k.startsWith('local-') ? '지방자치단체 공통' : /^(motie|mss|msit)-/.test(k) ? '중앙부처 고시' : '국비 공통(보조금·국가연구개발)';
const groups = ['국비 공통(보조금·국가연구개발)', '중앙부처 고시', '지방자치단체 공통', '대구광역시'];
const ymd = (s?: string) => (s && s.length === 8 ? `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6)}` : s || '');
const stages = ['예산요구서', '집행', '결산서'];
const ok = entries.filter(e => e.status === 'OK').length;
---
<Base title="사업 지침 창고" description={`지원사업 예산요구서·결산서 검토 근거가 되는 법령·고시·조례 ${entries.length}개(본문 확보 ${ok}개)와 지침별 검토표. 조문을 그대로 옮기며 평가하지 않습니다.`} current="programs">
  <p class="meta"><a href="/programs/">사업 예산</a> › 사업 지침</p>
  <div class="section-head"><h1>사업 지침 창고</h1><span class="meta">지침 {entries.length}개 · 본문 확보 {ok}개 · 갱신 {idx.fetched}</span></div>
  <p class="lede">기업지원기관이 낸 예산요구서·집행 서류·결산서(정산보고서)가 지침대로 작성·집행됐는지 볼 때 근거가 되는 법령·행정규칙·자치법규입니다. 국가법령정보센터에서 현행 본문을 받아 두고, 지침별로 <strong>예산요구서 → 집행 → 결산서</strong> 단계의 검토 항목에 근거 조문을 붙였습니다. 조문을 그대로 옮긴 것이며 지침에 대한 해석이나 평가는 하지 않습니다. 검토표는 표 아래 단추로 한글에 붙여넣거나 HWP 로 받을 수 있습니다. 예산을 집행하는 사업계획서 파일을 올려 검토표와 바로 대조하려면 <a href="/programs/guidelines/check/"><strong>사업계획서 지침 검토기</strong></a>를 씁니다(파일은 브라우저 안에서만 읽습니다).</p>

  <div class="section-head"><h2>지침 목록</h2></div>
  {groups.map(g => {
    const rows = entries.filter(e => groupOf(e.key) === g);
    return rows.length > 0 && (
      <section>
        <h3>{g}</h3>
        <div class="scroll-x"><table class="data-table">
          <thead><tr><th>지침</th><th>종류 · 소관</th><th>시행일</th><th>검토 단계</th><th>본문</th><th>검토표</th></tr></thead>
          <tbody>{rows.map(e => (
            <tr>
              <td>{e.url && e.status === 'OK' ? <a href={e.url} rel="noopener">{e.found || e.name}</a> : (e.found || e.name)}</td>
              <td>{e.found_kind || e.kind} · {e.found_issuer || e.issuer}</td>
              <td class="n">{ymd(e.eff) || '—'}</td>
              <td>{(e.review || []).join(' · ')}</td>
              <td>{e.status === 'OK' ? `확보 (조문 ${e.articles ?? '—'}개, 별표 ${(e.annexes ?? []).length}개)` : '법령정보센터에 없음'}</td>
              <td>{checkOf.has(e.key) ? <a href={`#check-${e.key}`}>{checkOf.get(e.key)!.items.length}항목{checkOf.get(e.key)!.status === 'draft' ? ' (초안)' : ''}</a> : '—'}</td>
            </tr>
          ))}</tbody>
        </table></div>
      </section>
    );
  })}
  <p class="meta">「법령정보센터에 없음」은 행정규칙으로 등록되지 않았거나 이름이 다른 지침입니다. 부처·시 홈페이지 첨부로 받는 길을 이어서 붙입니다. 목록과 본문은 매월 12일 갱신됩니다(`data/guidelines`).</p>

  {checks.map(c => (
    <section id={`check-${c.key}`} class="check">
      <div class="section-head"><h2>검토표 · {c.name}</h2><span class="meta">대조 본문 시행 {c.eff} · {c.status === 'draft' ? '초안(운영자 검토 전)' : '검토 완료'} · {c.items.length}항목</span></div>
      {c.note && <p class="meta">{c.note}</p>}
      {stages.map(s => {
        const items = c.items.filter(i => i.stage === s);
        return items.length > 0 && (
          <>
            <h3>{s} 검토 ({items.length})</h3>
            <div class="scroll-x"><table class="data-table check-table">
              <thead><tr><th>번호</th><th>검토 항목</th><th>확인 방법</th><th>근거</th><th>원문 문구</th><th>검토 서류</th></tr></thead>
              <tbody>{items.map((i, n) => (
                <tr><td class="n">{n + 1}</td><td>{i.item}</td><td>{i.check}</td><td>{i.basis}</td><td class="quote">{i.quote}</td><td>{i.doc}</td></tr>
              ))}</tbody>
            </table></div>
          </>
        );
      })}
      <p class="meta">출처: {c.name} 본문(국가법령정보센터, 시행 {c.eff}). 조문을 그대로 옮긴 것으로 해석·평가가 아니며, 지침이 개정되면 다시 대조합니다.</p>
    </section>
  ))}
</Base>
<style>
  section h3 { margin: var(--s4) 0 var(--s1); font-size: 1.05rem; }
  .check { margin-top: var(--s5); }
  .check-table { min-width: 900px; font-size: 0.9rem; }
  .check-table td.quote { color: var(--muted); font-size: 0.85rem; }
  .check-table th:nth-child(2), .check-table td:nth-child(2) { min-width: 14em; }
</style>
