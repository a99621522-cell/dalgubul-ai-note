---
import Base from '../../layouts/Base.astro';
import StartupFirms from '../../components/StartupFirms.astro';
import StartupFunds from '../../components/StartupFunds.astro';
import { startupFirms } from '../../lib/startups';
/** /startups/ — 메뉴 '창업·벤처'(운영자 지시 2026-10-06 '벤처기업은 어디 있어?' → 헤더 '기업' 묶음에 넣음).
 *  기업 사전의 창업·벤처 기업 집계(StartupFirms)·대구시 출자·조성 펀드(StartupFunds, data/funds, 운영자 지시 2026-10-08)와 명단 바로가기(벤처기업·7년 이내 벤처·창업보육센터 입주·창업기업), 창업기업동향 통계 링크.
 *  공개 명단 기준, 값 그대로, 평가·순위 없음. 벤처 확인 유형·유효 기간은 기업별 페이지 '창업·벤처 정보'. */
const S = startupFirms();
const n = (v: number) => v.toLocaleString('ko-KR');
const cnt = (k: string) => S.tags.find(t => t.key === k)?.count ?? 0;
const LINKS = [
  { name: '벤처기업', desc: '벤처기업확인 공시(중소벤처기업부 벤처기업명단). 확인 유형·유효 기간은 기업 페이지에', href: '/companies/?tag=venture', count: cnt('venture') },
  { name: '7년 이내 벤처기업', desc: '설립 7년 이내이면서 벤처기업확인 — 스타트업에 가장 가까운 집합', href: '/companies/?tag=startup_venture', count: cnt('startup_venture') },
  { name: '창업기업(설립 7년 이내)', desc: '설립일이 있는 기업만 판정(국민연금·수성알파시티·창업보육센터 자료)', href: '/companies/?tag=startup', count: cnt('startup') },
  { name: '창업보육센터 입주', desc: '중소벤처기업부 창업보육센터 입주기업현황(보육 중인 기업)', href: '/companies/?tag=bi', count: cnt('bi') },
  { name: '연구소기업', desc: '연구개발특구 연구소기업', href: '/companies/?tag=labfirm', count: cnt('labfirm') },
].filter(l => l.count > 0);
---
<Base title="창업·벤처 기업" description={`대구 기업 사전의 창업·벤처 기업: 벤처기업 ${n(cnt('venture'))}곳, 7년 이내 벤처기업 ${n(cnt('startup_venture'))}곳, 창업보육센터 입주 ${n(cnt('bi'))}곳. 공개 명단 기준 명단·산업 그룹별·구군별 집계.`} current="startups">
  <div class="section-head"><h1>창업·벤처 기업</h1><span class="meta">기업 사전 {S.asOf} · 공개 명단 기준</span></div>
  <p class="lede">대구 기업 사전에서 공개 명단으로 확인되는 창업·벤처 기업입니다. 명단은 기업 사전 필터로 열리고, 기업마다 벤처 확인 유형·유효 기간·확인받은 지, 창업보육센터·입주일 같은 정보는 기업 페이지의 '창업·벤처 정보'에 있습니다. 매달 창업기업 수(중소벤처기업부 창업기업동향)와 기업 신생·소멸 통계는 <a href="/stats/business/#startup">통계 › 기업·사업체</a>에 있습니다.</p>
  <ul class="links" aria-label="명단 바로가기">
    {LINKS.map(l => (<li><a class="lk" href={l.href}><b>{l.name}</b><span class="cnt">{n(l.count)}곳</span><span class="desc">{l.desc}</span></a></li>))}
  </ul>
  <StartupFirms />
  <StartupFunds />
  <p class="meta">투자 유치 사실은 벤처 확인 유형 '벤처투자유형'(적격 투자기관의 투자를 받아 확인)으로만 보이며, 금액·투자사는 공개 명단에 없습니다. 공공데이터포털의 투자기업 파일(기술보증기금·신용보증기금·중진공)은 기업명이 없어 잇지 못했습니다. 창업보육센터 졸업 기업 명단도 공개 파일에 없습니다.</p>
  <style>
    .lede { margin: 0 0 var(--s3); }
    .links { list-style: none; padding: 0; margin: 0 0 var(--s4); display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--s2); }
    .lk { display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); text-decoration: none; }
    .lk:hover { background: var(--surface); border-color: var(--line-strong); }
    .lk b { font-size: 1.05rem; }
    .lk .cnt { color: var(--primary); font-weight: 600; font-variant-numeric: tabular-nums; }
    .lk .desc { grid-column: 1 / -1; font-size: var(--small); color: var(--muted); }
  </style>
</Base>
