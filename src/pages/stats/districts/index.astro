---
import Base from '../../../layouts/Base.astro';
import StatsNav from '../../../components/StatsNav.astro';
import SourceBadge from '../../../components/SourceBadge.astro';
import DistrictTrends from '../../../components/DistrictTrends.astro';
import { TOPICS } from '../../../lib/statsTopics';
import { GU, NPS_GROUPS, population, employed, nps, firms, complexesByGu, commute, tourism, migration, stores, trends, legalDongs, unsold } from '../../../lib/districts';
/** /stats/districts/ — 구·군 경제 현황(운영자 지시 2026-10-26). 공개 자료만 9개 구·군으로 나눠 나란히. 근거마다 기준이 달라 더하거나 나누지 않는다.
 *  행 순서는 행정 순서, 값은 원 자료 그대로(묶음 합·비중·증감 나눗셈만), 평가·순위 없음. */
const t = TOPICS.find(x => x.key === 'districts')!;
const pop = population(), emp = employed(), np = nps(), fi = firms(), cx = complexesByGu(), cm = commute(), tr = tourism(), mg = migration(), st = stores(), td = trends(), ld = legalDongs(), us = unsold();
const f0 = (v: number | null | undefined) => (v == null ? '—' : Math.round(v).toLocaleString('ko-KR'));
const f1 = (v: number | null | undefined) => (v == null ? '—' : v.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }));
const pct = (a: number | null | undefined, b: number | null | undefined) => (a == null || !b ? null : (a / b - 1) * 100);
const sgn = (v: number | null) => (v == null ? '—' : `${v > 0 ? '+' : ''}${f1(v)}`);
const sgn0 = (v: number | null) => (v == null ? '—' : `${v > 0 ? '+' : ''}${f0(v)}`);
const share = (a: number | null | undefined, b: number | null | undefined) => (a == null || !b ? '—' : f1((a / b) * 100));
const man = (v: number | null | undefined) => (v == null ? '—' : f1(v / 10000));            // 명 → 만 명
const eok = (thou: number | null | undefined) => (thou == null ? '—' : f0(thou / 100000));  // 천 원 → 억 원
const firmsHref = (g: string, grp?: string) => `/companies/?district=${encodeURIComponent(g)}${grp ? `&group=${encodeURIComponent(grp)}` : ''}`;
const foYm = fi.asOf ? `${fi.asOf.slice(0, 4)}년 ${Number(fi.asOf.slice(5, 7))}월` : '';

// 통근 순유입 막대(대구·경북 안 이동만)
const nets = cm ? GU.map(g => ({ g, v: cm.by.get(g)!.net })) : [];
const maxNet = Math.max(1, ...nets.map(n => Math.abs(n.v)));
const mnets = mg ? GU.map(g => ({ g, v: mg.by.get(g)!.net ?? 0 })) : [];
const maxM = Math.max(1, ...mnets.map(n => Math.abs(n.v)));
// 구·군 한 장 요약(Word·PDF) 자료 — 화면 값과 같은 것만(src/scripts/district_card.ts)
const guData = {
  url: 'https://daitda.co.kr/stats/districts/', built: new Date().toISOString().slice(0, 10),
  sources: ['주민등록인구·국내인구이동통계·지역별고용조사·인구총조사(KOSIS)', '국토교통부 미분양주택현황보고', '국민연금공단 가입 사업장 내역', '팩토리온 공장등록·기업 사전', st ? '소상공인시장진흥공단 상가(상권)정보' : '', tr ? '한국관광 데이터랩' : ''].filter(Boolean).join(' · '),
  gu: GU.map(g => {
    const p = pop?.by.get(g), e = emp?.by.get(g), n = np?.now.get(g), n0 = np?.prev?.get(g), c = fi.by.get(g)!, k = cm?.by.get(g), v = tr?.by.get(g), m = mg?.by.get(g), s2 = st?.by.get(g);
    const rows: [string, string, string][] = [
      ['인구', `${f0(p?.now)}명`, `주민등록, ${pop?.latest ?? ''}`],
      ['인구 증감(2015→연말)', `${sgn(pct(p?.yEnd, p?.y2015))}%`, `주민등록, ${pop?.endLabel ?? ''}`],
      ...(us ? [['미분양 주택', `${f0(us.by.get(g)!.now)}호`, `국토교통부, ${us.latest}${us.yearAgo ? ` (${us.yearAgo} ${f0(us.by.get(g)!.yearAgo)}호)` : ''}`] as [string, string, string]] : []),
      ...(m ? [['전입 − 전출', `${sgn0(m.net)}명`, `최근 12개월(${mg!.from}~${mg!.latest}), 대구 안 ${sgn0(m.innerNet)} · 다른 시도 ${sgn0(m.sidoNet)}`] as [string, string, string]] : []),
      ['취업자(사는 곳)', `${f1(e?.total)}천 명`, `지역별고용조사, ${emp?.period ?? ''}`],
      ['국민연금 사업장', `${f0(n?.sites)}곳`, `사업장 주소, ${np?.latestLabel ?? ''}`],
      ['국민연금 가입자', `${f0(n?.members)}명`, `${np?.baseLabel ?? ''} 대비 ${sgn(pct(n?.members, n0?.members))}%`],
      ['기업 사전 기업', `${f0(c.total)}곳`, `공장등록 ${foYm} + 산단 외 기업`],
      ['공장등록 종사자', `${f0(c.foWorkers)}명`, `팩토리온 신고값, ${foYm}`],
      ...(k ? [['통근·통학 순유입', `${sgn0(k.net)}명`, `인구총조사 ${cm!.year}년(대구·경북 안 이동)`] as [string, string, string]] : []),
      ...(s2 ? [['상가 점포', `${f0(s2.total)}곳`, `소상공인시장진흥공단, ${st!.q}`] as [string, string, string]] : []),
      ...(v ? [['외지인 방문자', `${man(v.vis)}만 명`, `데이터랩, ${tr!.from}~${tr!.to}`], ['관광소비', `${eok(v.sp)}억 원`, `데이터랩 내국인 신용카드, 같은 기간`]] as [string, string, string][] : []),
    ];
    const tables = [
      ...(emp && e ? [{ title: `취업자 산업 구성 (${emp.period}, 사는 곳)`, head: ['산업', '취업자(천 명)', '비중(%)'], rows: emp.groups.map((x, i) => [x, f1(e.g[i]), share(e.g[i], e.total)]) }] : []),
      ...(n ? [{ title: `국민연금 가입자 업종 구성 (${np!.latestLabel}, 사업장 주소)`, head: ['업종 묶음', '가입자(명)', '비중(%)'], rows: NPS_GROUPS.map((x, i) => [x, f0(n.g[i]), share(n.g[i], n.members)]), note: '업종은 공개 파일 업종 코드 앞 두 자리를 이 사이트가 묶은 것입니다.' }] : []),
      { title: `기업 사전 산업 그룹별 기업 수 (${foYm})`, head: ['산업 그룹', '기업(곳)'], rows: fi.groups.filter(x => c.g.get(x)).map(x => [x, f0(c.g.get(x))]) },
      { title: '구·군 안의 산업단지', head: ['산업단지', '입주 공장(곳)', '종사자(명)'], rows: (cx.by.get(g) ?? []).map(x => [x.name + (x.shared ? ' ※' : ''), f0(x.firms), f0(x.workers)]), note: (cx.by.get(g) ?? []).some(x => x.shared) ? '※ 두 구·군에 걸친 단지는 단지 전체 값입니다.' : undefined },
      ...(st && s2 ? [{ title: `상가 점포 업종 구성 (${st.q})`, head: ['업종 대분류', '점포(곳)'], rows: st.large.map((l, i) => [l, f0(s2.l[i])]) }] : []),
    ];
    return { name: g, rows, tables };
  }),
};
const NPS_COLOR = ['var(--chart-3)', 'var(--chart-1)', 'var(--chart-2)', 'var(--chart-4)', 'var(--chart-6)', 'var(--chart-5)', 'var(--line-strong, #b8bec7)'];
---
<Base title={`${t.name} 경제 현황`} description={`대구 9개 구·군의 인구·취업자·국민연금 사업장과 가입자·기업 수·산업단지·통근·관광 소비를 같은 표에. ${t.desc}`} current="stats" crumb={t.name} wide>
  <StatsNav current={t.key} />
  <div class="section-head"><h1>구·군 경제 현황</h1><span class="meta">{t.period} · 공개 자료만</span></div>
  <p class="lede">대구 9개 구·군을 인구 → 취업자 → 사업장·고용 → 출퇴근 → 인구이동 → 기업 → 상가 점포 → 관광 소비 순서로 나란히 놓았습니다. 행 순서는 행정 순서이고, 값은 원 자료 그대로입니다(합계·비중·증감만 계산). 평가·순위가 아닙니다.</p>

  <details class="basis" open>
    <summary>이 숫자의 기준 — 근거마다 '어디'를 세는지가 다릅니다</summary>
    <ul class="notes">
      <li><b>사는 곳 기준</b>: 주민등록인구, 지역별고용조사 취업자(그 구·군에 사는 취업자), 인구총조사 통근·통학의 '현 거주지'.</li>
      <li><b>일하는 곳(사업장) 기준</b>: 국민연금 가입 사업장·가입자(사업장 주소). 본사에서 지점 직원까지 함께 신고하면 본사 구·군으로 잡힙니다.</li>
      <li><b>공장 등록 기준</b>: 기업 사전(팩토리온 공장등록 {foYm} 말 + 산단 외 기업 목록). 제조·지식서비스 기업만이고 도소매·음식·건설은 넣지 않습니다.</li>
      <li>그래서 사는 곳 기준 취업자와 사업장 기준 가입자를 더하거나 나누지 않습니다. 둘의 차이는 아래 '일하는 곳과 사는 곳' 표(통근)로 봅니다.</li>
      <li><b>신고 기준</b>: 전입·전출(주민등록 신고), 상가 점포(소상공인시장진흥공단 명단 — 점포 단위).</li>
      <li>군위군은 2023년 7월 대구에 편입됐습니다. 2020년 인구총조사 값은 경북 군위군 때의 값입니다.</li>
    </ul>
  </details>

  <div class="gu-dl" id="gu-dl">
    <label for="gu-sel">구·군 한 장 요약</label>
    <select id="gu-sel">{GU.map(g => <option value={g}>{g}</option>)}</select>
    <button type="button" class="btn secondary" id="gu-docx" title="한글(HWP)·워드에서 바로 열어 고칠 수 있는 Word 파일">Word 내려받기</button>
    <button type="button" class="btn secondary" id="gu-pdf">PDF 내려받기</button>
    <span id="gu-status" class="meta" role="status"></span>
  </div>

  <div class="gu-cards">
    {GU.map(g => {
      const p = pop?.by.get(g), e = emp?.by.get(g), n = np?.now.get(g), c = fi.by.get(g), k = cm?.by.get(g), v = tr?.by.get(g);
      return (
        <section class="gu" aria-labelledby={`gu-${g}`}>
          <h2 id={`gu-${g}`}>{g}</h2>
          <dl>
            <div><dt>인구</dt><dd>{f0(p?.now)}명</dd></div>
            <div><dt>취업자(사는 곳)</dt><dd>{f1(e?.total)}천 명</dd></div>
            <div><dt>국민연금 가입자(사업장)</dt><dd>{f0(n?.members)}명</dd></div>
            <div><dt>기업 사전 기업</dt><dd><a href={firmsHref(g)}>{f0(c?.total)}곳</a></dd></div>
            {k && <div><dt>통근·통학 순유입({cm!.year})</dt><dd>{sgn0(k.net)}명</dd></div>}
            {mg && <div><dt>전입 − 전출(12개월)</dt><dd>{sgn0(mg.by.get(g)!.net)}명</dd></div>}
            {st && <div><dt>상가 점포({st.q})</dt><dd>{f0(st.by.get(g)!.total)}곳</dd></div>}
            {v && <div><dt>외지인 방문자(12개월)</dt><dd>{man(v.vis)}만 명</dd></div>}
          </dl>
          <p class="one"><a href="#gu-dl" data-gu={g}>{g} 한 장 받기</a></p>
          {(cx.by.get(g)?.length ?? 0) > 0 && <p class="cx">산업단지: {cx.by.get(g)!.map(x => x.name.replace(/일반산업단지|지방산업단지|첨단산업단지|산업단지/, '')).join(' · ')}</p>}
        </section>
      );
    })}
  </div>

  <section aria-labelledby="h-sum">
    <div class="section-head"><h2 id="h-sum">한 표로 보기</h2></div>
    <div class="scroll-x"><table class="data-table" data-title="대구 구·군 경제 현황 요약">
      <thead><tr>
        <th>구·군</th>
        <th class="n">인구(명)<br />{pop?.latest}</th><th class="n" data-pri="2">인구 증감(%)<br />2015→{pop?.endLabel}</th>
        {mg && <th class="n" data-pri="2">전입 − 전출(명)<br />최근 12개월</th>}
        <th class="n">취업자(천 명)<br />{emp?.period}</th><th class="n" data-pri="2">그중 광·제조업(%)</th>
        <th class="n">국민연금 사업장(곳)<br />{np?.latestLabel}</th><th class="n">가입자(명)</th><th class="n" data-pri="2">가입자 증감(%)<br />{np?.baseLabel} 대비</th>
        <th class="n">기업 사전 기업(곳)</th>
        {st && <th class="n" data-pri="2">상가 점포(곳)<br />{st.q}</th>}
        <th class="n" data-pri="3">외지인 방문자(만 명)<br />최근 12개월</th><th class="n" data-pri="3">관광소비(억 원)<br />최근 12개월</th>
      </tr></thead>
      <tbody>{GU.map(g => {
        const p = pop?.by.get(g), e = emp?.by.get(g), n = np?.now.get(g), n0 = np?.prev?.get(g), c = fi.by.get(g), v = tr?.by.get(g);
        return <tr><th scope="row"><a href={`#gu-${g}`}>{g}</a></th>
          <td class="n">{f0(p?.now)}</td><td class="n">{sgn(pct(p?.yEnd, p?.y2015))}</td>
          {mg && <td class="n">{sgn0(mg.by.get(g)!.net)}</td>}
          <td class="n">{f1(e?.total)}</td><td class="n">{share(e?.g[1], e?.total)}</td>
          <td class="n">{f0(n?.sites)}</td><td class="n">{f0(n?.members)}</td><td class="n">{sgn(pct(n?.members, n0?.members))}</td>
          <td class="n"><a href={firmsHref(g)}>{f0(c?.total)}</a></td>
          {st && <td class="n">{f0(st.by.get(g)!.total)}</td>}
          <td class="n">{man(v?.vis)}</td><td class="n">{eok(v?.sp)}</td></tr>;
      })}</tbody>
    </table></div>
    <p class="src"><SourceBadge kind="국가통계" /> 주민등록인구·국내인구이동통계·지역별고용조사(KOSIS) · <SourceBadge kind="행정자료" /> 국민연금공단 가입 사업장 내역(공공데이터포털)·팩토리온 공장등록·소상공인시장진흥공단 상가(상권)정보 · <SourceBadge kind="기관 자료" /> 한국관광 데이터랩{tr && ` (${tr.from}~${tr.to})`}. 군위군 인구 증감은 편입 전 값이 없어 비웁니다.</p>
  </section>

  {emp && (
  <section aria-labelledby="h-emp">
    <div class="section-head"><h2 id="h-emp">사는 곳 기준 — 인구와 취업자 산업 구성</h2><span class="meta">KOSIS · 취업자 {emp.period}</span></div>
    <div class="scroll-x"><table class="data-table" data-title={`대구 구·군 취업자 산업 구성 (${emp.period}, 사는 곳 기준)`}>
      <thead><tr><th>구·군</th><th class="n">인구 2015(명)</th><th class="n">인구 {pop?.latest}(명)</th><th class="n">취업자(천 명)</th>{emp.groups.map(x => <th class="n" data-pri="2">{x}(%)</th>)}</tr></thead>
      <tbody>{GU.map(g => { const p = pop?.by.get(g), e = emp.by.get(g); return <tr><th scope="row">{g}</th><td class="n">{f0(p?.y2015)}</td><td class="n">{f0(p?.now)}</td><td class="n">{f1(e?.total)}</td>{emp.groups.map((_, i) => <td class="n">{share(e?.g[i], e?.total)}</td>)}</tr>; })}</tbody>
    </table></div>
    <p class="src"><SourceBadge kind="국가통계" /> {emp.source} · {pop?.source}. 지역별고용조사는 표본조사라 구·군 값에 오차가 있습니다(천 명 단위). 산업 비중은 그 구·군 취업자 합계로 나눈 값입니다.</p>
  </section>
  )}

  {np && (
  <section aria-labelledby="h-nps">
    <div class="section-head"><h2 id="h-nps">일하는 곳 기준 — 국민연금 사업장·가입자</h2><span class="meta">{np.latestLabel} 공개 파일</span></div>
    <p>국민연금 가입 사업장 공개 파일을 사업장 주소의 구·군으로 나눴습니다. 기업 사전과 이어진 곳만이 아니라 대구 사업장 전부(서비스업 포함)입니다. 취득·상실은 그달 새로 가입하거나 빠진 사람 수입니다.</p>
    <div class="scroll-x"><table class="data-table" data-title={`대구 구·군 국민연금 가입 사업장·가입자 (${np.latestLabel})`}>
      <thead><tr><th>구·군</th><th class="n">사업장(곳)</th><th class="n">가입자(명)</th><th class="n" data-pri="2">{np.baseLabel} 가입자(명)</th><th class="n">증감(명)</th><th class="n" data-pri="2">증감(%)</th><th class="n" data-pri="2">그달 취득(명)</th><th class="n" data-pri="2">그달 상실(명)</th></tr></thead>
      <tbody>{GU.map(g => { const n = np.now.get(g)!, n0 = np.prev?.get(g); return <tr><th scope="row">{g}</th><td class="n">{f0(n.sites)}</td><td class="n">{f0(n.members)}</td><td class="n">{f0(n0?.members)}</td><td class="n">{sgn0(n0 ? n.members - n0.members : null)}</td><td class="n">{sgn(pct(n.members, n0?.members))}</td><td class="n">{f0(n.gain)}</td><td class="n">{f0(n.loss)}</td></tr>; })}</tbody>
    </table></div>

    <h3 class="sub">가입자의 업종 구성</h3>
