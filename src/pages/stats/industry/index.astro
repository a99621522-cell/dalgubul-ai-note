---
import Base from '../../../layouts/Base.astro';
import StatsNav from '../../../components/StatsNav.astro';
import KosisSections from '../../../components/KosisSections.astro';
import HighValueFirms from '../../../components/HighValueFirms.astro';
import IndustryBundles from '../../../components/IndustryBundles.astro';
import { TOPICS, KOSIS_TOPICS } from '../../../lib/statsTopics';
import { kosisIndex } from '../../../lib/kosis';
/** /stats/industry/ — 통계 주제 페이지(src/lib/statsTopics.ts). KOSIS 표·그래프만, 값 그대로, 평가 없음. */
const t = TOPICS.find(x => x.key === 'industry')!;
const idx = kosisIndex();
---
<Base title={`${t.name} 통계`} description={`대구 ${t.name} 통계(${t.period}): ${t.desc}`} current="stats" crumb={t.name} wide>
  <StatsNav current={t.key} />
  <div class="section-head"><h1>{t.name}</h1><span class="meta">{t.period} · 국가데이터처 KOSIS · 갱신 {idx.generated}</span></div>
  <p class="lede">{t.desc} 그래프 아래 표는 눌러서 펼칩니다. 값은 KOSIS 그대로이고 평가·순위가 아닙니다. 업종별 성장 가정에 따른 성장률과 목표 성장률에 필요한 산업별 기여는 <a href="/growth/">성장 계산기</a>에서 계산해 볼 수 있습니다.</p>
  <KosisSections sections={KOSIS_TOPICS[t.key]} />
  <IndustryBundles />
  <HighValueFirms />
</Base>
