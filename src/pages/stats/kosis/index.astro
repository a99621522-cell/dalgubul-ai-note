---
import Base from '../../../layouts/Base.astro';
import { kosisIndex, kosisTable, kosisChart, fmtCell } from '../../../lib/kosis';
/** /stats/kosis/ — 국가데이터처 KOSIS 통계표(대구·17개 시도)와 이 사이트가 계산한 산업구조 지표. render_kosis.py 산출물을 빌드 때 읽는다.
 *  값은 KOSIS 그대로, 평가·순위 표현 없음. 모든 표는 table.data-table 이라 「한글 표 복사」·「HWP 내려받기」가 붙는다. */
const idx = kosisIndex();
const T = (id: string) => kosisTable(id);
const C = (name: string) => kosisChart(name);
const sections: { title: string; desc: string; tables: string[]; charts: string[] }[] = [
  { title: '산업구조 지표 — 17개 시도 비교', desc: 'KOSIS 지역소득(시도별 경제활동별 총부가가치, 24개 부문)으로 이 사이트가 계산한 입지계수·산업집중도·산업구조 변화속도. 정의는 저장소 scripts/structure_index.py 에 있습니다.', tables: ['structure17'], charts: ['hhi17'] },
  { title: '대구 부문별 부가가치와 입지계수', desc: '대구 총부가가치 24개 부문의 비중과 전국 대비 입지계수(2015년 대비). 고부가 3부문 비중 추이.', tables: ['daegu_sectors'], charts: ['lq-daegu', 'high-share'] },
  { title: '대구 산업별 기업·종사자 (중소기업기본통계)', desc: '산업중분류별 전체 기업·중소기업·소상공인 수와 종사자 수. 행정통계라 개인사업자를 포함합니다.', tables: ['sme_daegu'], charts: [] },
  { title: '대구 산업 중분류별 사업체·종사자 (전국사업체조사)', desc: '전국사업체조사(2020년부터 등록센서스 기반)의 대구 산업 대·중분류별 사업체 수·종사자 수와, 중분류 종사자 비중을 전국과 비교한 입지계수.', tables: ['census_daegu'], charts: ['lq-employment'] },
  { title: '대구 구·군별·산업별 취업자 (지역별고용조사)', desc: '반기마다 조사하는 시군구 취업자를 산업 대분류 묶음으로.', tables: ['employment_gu'], charts: [] },
  { title: '대구 고용·생산·인구이동 (월간)', desc: '경제활동인구조사(취업자·고용률·실업률), 광공업생산지수, 국내인구이동통계의 대구 월간 값.', tables: [], charts: ['employed', 'rates', 'mfg-index', 'migration'] },
];
const has = (s: typeof sections[number]) => s.tables.some(t => T(t)) || s.charts.some(c => C(c));
---
<Base title="KOSIS 통계표" description={`국가데이터처 KOSIS 통계표의 대구 값과 17개 시도 산업구조 지표(입지계수·산업집중도·변화속도): 부문별 부가가치, 산업별 기업·종사자, 구·군별 취업자, 월간 고용·생산·인구이동. 표 ${idx.tables.length}개, 그래프 ${Object.keys(idx.charts).length}개.`} current="dashboard">
  <p class="meta"><a href="/dashboard/">현황판</a> › KOSIS 통계표</p>
  <div class="section-head"><h1>KOSIS 통계표 — 대구와 17개 시도</h1><span class="meta">생성 {idx.generated} · 매월 9일 갱신</span></div>
  <p class="lede">국가데이터처 KOSIS 오픈API 로 받은 통계표의 대구 값과, 그 표로 이 사이트가 계산한 산업구조 지표입니다. 값은 KOSIS 그대로이고 평가·순위 표현은 없습니다(표의 정렬은 값 크기순일 뿐입니다). 표마다 출처 표 이름과 조회일을 적었고, 표 아래 도구로 한글 문서에 그대로 옮길 수 있습니다. 기업 사전 기준 집계는 <a href="/dashboard/">현황판</a>과 <a href="/industry/">산업별</a> 페이지에 있습니다.</p>
  <nav class="toc" aria-label="차례"><ol>{sections.filter(has).map((s, i) => <li><a href={`#s${i}`}>{s.title}</a></li>)}</ol></nav>
  {sections.map((s, i) => has(s) && (
    <section id={`s${i}`}>
      <div class="section-head"><h2>{s.title}</h2></div>
      <p class="meta">{s.desc}</p>
      {s.charts.map(name => { const c = C(name); return c && (
        <figure class="chart">
          <div class="chart-wide" set:html={c.wide} />
          <div class="chart-narrow" set:html={c.narrow} />
          <figcaption>{c.table?.title}{c.table?.note && ` · ${c.table.note}`}</figcaption>
        </figure>
      ); })}
      {s.tables.map(id => { const t = T(id); return t && (
        <div class="tbl">
          <h3>{t.title}</h3>
          <div class="scroll-x"><table class="data-table" data-title={t.title}>
            <thead><tr>{t.columns.map((h, j) => <th class={j ? 'n' : ''}>{h}</th>)}</tr></thead>
            <tbody>{t.rows.map(r => <tr>{r.map((v, j) => j === 0 ? <th scope="row">{v}</th> : <td class="n">{fmtCell(v)}</td>)}</tr>)}</tbody>
          </table></div>
          <p class="meta">출처: {t.source}{t.note && ` · ${t.note}`}</p>
        </div>
      ); })}
    </section>
  ))}
  <style>
    .toc ol { columns: 2; padding-left: 1.2em; font-size: 0.95em; }
    .tbl { margin: 0.8rem 0 1.6rem; }
    .tbl h3 { font-size: 1.02rem; margin: 0.6rem 0 0.3rem; }
    .chart { margin: 0.6rem 0 1.2rem; }
    .chart svg { max-width: 100%; height: auto; }
    .chart-narrow { display: none; }
    @media (max-width: 600px) { .chart-wide { display: none; } .chart-narrow { display: block; } }
    @media (max-width: 600px) { .toc ol { columns: 1; } }
  </style>
</Base>
