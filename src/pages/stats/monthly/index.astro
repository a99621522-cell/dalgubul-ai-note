---
import Base from '../../../layouts/Base.astro';
import { monthlySeries, change, latest, groups, fmt, fmtChg, trendChart, industryRows } from '../../../lib/monthly';
/** /stats/monthly/ — 월간 대구 경제지표(운영자 지시 2026-10-02). 원 통계(KOSIS·ECOS)에서 직접 읽고, 원 통계를 아직 받지 않는 지표만
 *  data/refs/dpi-*.json 정리값을 쓴다(src/lib/monthly.ts). 지표마다 원 통계 기관을 출처로 적는다 — 페이지에 자료 정리 기관·간행물 이름은 쓰지 않는다
 *  (운영자 지시 2026-10-02, 경기종합지수는 작성 기관이라 그 지표의 출처로만). 그 해 1월부터 추세 그림(값 표시). 값 그대로, 평가 없음. */
const S = monthlySeries();
const G = groups(S);
const ind = industryRows();
const newest = S.map(s => latest(s).m).sort().at(-1) ?? '';
const from = `${newest.slice(0, 4)}-01`;
const unitChg = (s: typeof S[number]) => (s.change === '%' ? '%' : s.change === '%p' ? '%p' : s.unit === '명' ? '명' : s.unit === '백만 달러' ? '백만 달러' : 'p');
/** 부문별 월별 표: 최근 13개월(그 부문 계열의 달을 합쳐서), 최근 달이 위. */
const monthsOf = (ss: typeof S) => [...new Set(ss.flatMap(s => s.pts.map(p => p.m)))].sort().reverse().slice(0, 13);
const KEY_IND = ['자동차 및 트레일러 제조업', '기타 기계 및 장비 제조업', '금속 가공제품 제조업; 기계 및 가구 제외', '1차 금속 제조업', '섬유제품 제조업; 의복 제외', '전기장비 제조업', '의료 정밀 광학 기기 및 시계 제조업', '전자 부품 컴퓨터 영상 음향 및 통신장비 제조업', '고무 및 플라스틱제품 제조업', '화학 물질 및 화학제품 제조업; 의약품 제외', '식료품 제조업'];
const indRows = [...ind.rows].sort((a, b) => (KEY_IND.indexOf(a.name) + 1 || 99) - (KEY_IND.indexOf(b.name) + 1 || 99));
const srcText = (s: typeof S[number]) => s.source;
---
<Base title="월간 대구 경제지표" description={`대구의 생산·고용·인구이동·소비·투자·수출입·금융·창업·경기 지표 ${S.length}개를 한 화면에. ${from.slice(0, 4)}년 1월부터 추세 그래프(값 표시), 최근 기준월 ${newest}, 전년 같은 달·전월 대비.`} current="stats">
  <p class="meta"><a href="/stats/kosis/">통계</a> › 월간 대구 경제지표</p>
  <div class="section-head"><h1>월간 대구 경제지표</h1><span class="meta">최근 기준월 {newest}</span></div>
  <p class="lede">대구 경제를 매달 보는 지표 {S.length}개를 한 화면에 모았습니다. {from.slice(0, 4)}년 1월부터의 추세를 그래프로, 최근 값과 증감을 표로 보여 줍니다. 지표마다 원 통계 기관을 출처로 적었습니다. 월간 값은 잠정치라 나중에 고쳐질 수 있습니다. 평가·전망이 아닙니다.</p>
  <nav class="toc" aria-label="차례"><ol>
    <li><a href="#trend">{from.slice(0, 4)}년 1월부터 추세</a></li>
    <li><a href="#summary">한눈에 — 지표별 최근 값</a></li>
    <li><a href="#industry">업종별 생산·출하·재고</a></li>
    {G.map((g, i) => <li><a href={`#g${i}`}>{g} — 월별 값</a></li>)}
    <li><a href="#sources">출처와 읽는 법</a></li>
  </ol></nav>

  <section id="trend">
    <div class="section-head"><h2>{from.slice(0, 4)}년 1월부터 추세</h2></div>
    <p class="meta">점마다 그 달 값을 적었습니다. 세로 눈금은 지표마다 값 범위에 맞췄으므로 그래프끼리 높이를 비교하지 않습니다. 비어 있는 달은 아직 공표 전이거나 이 사이트가 값을 받지 못한 달입니다. 같은 값은 아래 표에도 있습니다.</p>
    {G.map(g => (
      <>
        <h3 class="tg">{g}</h3>
        <div class="trend-grid">
          {S.filter(s => s.group === g).map(s => { const svg = trendChart(s, from, newest); return svg && (
            <figure class="tcard">
              <figcaption><strong>{s.name}</strong> <span class="u">({s.unit})</span></figcaption>
              <div set:html={svg} />
              <p class="tsrc">출처: {srcText(s)}{s.note && ` · ${s.note}`}</p>
            </figure>); })}
        </div>
      </>
    ))}
  </section>

  <section id="summary">
    <div class="section-head"><h2>한눈에 — 지표별 최근 값</h2></div>
    <div class="scroll-x"><table class="data-table" data-title="월간 대구 경제지표 — 지표별 최근 값">
      <thead><tr><th>지표</th><th>기준월</th><th class="n">값</th><th>단위</th><th class="n">전년 같은 달 대비</th><th class="n">전월 대비</th><th>출처</th></tr></thead>
      {G.map(g => <tbody><tr class="grp"><th colspan="7" scope="colgroup">{g}</th></tr>{S.filter(s => s.group === g).map(s => { const p = latest(s); return (
        <tr>
          <th scope="row">{s.name}</th>
          <td class="nw">{p.m}</td>
          <td class="n">{fmt(p.v, s.digits)}</td>
          <td>{s.unit}</td>
          <td class="n">{fmtChg(change(s, p, 12), s.unit, s.change === '%p' ? Math.max(1, s.digits) : 1)}{change(s, p, 12) != null && <span class="u">{unitChg(s)}</span>}</td>
          <td class="n">{fmtChg(change(s, p, 1), s.unit, s.change === '%p' ? Math.max(1, s.digits) : 1)}{change(s, p, 1) != null && <span class="u">{unitChg(s)}</span>}</td>
          <td class="src">{s.url ? <a href={s.url} rel="noopener">{s.source}</a> : s.source}{s.note && <span class="meta"> · {s.note}</span>}</td>
        </tr>); })}</tbody>)}
    </table></div>
    <p class="meta">증감: 지수·금액·건수는 증감률(%), 비율(고용률·실업률·연체율 등)은 %p 차, 소비자심리지수·BSI 는 포인트 차, 순이동은 명 차, 무역수지는 백만 달러 차. △는 감소. 같은 계열의 전년 같은 달·전월 값으로 계산했고, 비교 달 값이 없는 지표는 공표 자료에 적힌 증감을 옮겼습니다.</p>
  </section>

  {ind.rows.length > 0 && (
  <section id="industry">
    <div class="section-head"><h2>업종별 생산·출하·재고 ({ind.latest})</h2></div>
    <div class="scroll-x"><table class="data-table" data-title={`대구 업종별 생산·출하·재고지수 ${ind.latest}`}>
      <thead><tr><th>업종(산업중분류)</th><th class="n">생산지수</th><th class="n">전년 같은 달 대비(%)</th><th class="n">출하지수</th><th class="n">전년 같은 달 대비(%)</th><th class="n">재고지수</th><th class="n">전년 같은 달 대비(%)</th></tr></thead>
      <tbody>{indRows.map(r => (
        <tr><th scope="row">{r.name}</th><td class="n">{fmt(r.ip, 1)}</td><td class="n">{fmtChg(r.ipYoy, '')}</td><td class="n">{fmt(r.sh, 1)}</td><td class="n">{fmtChg(r.shYoy, '')}</td><td class="n">{fmt(r.inv, 1)}</td><td class="n">{fmtChg(r.invYoy, '')}</td></tr>
      ))}</tbody>
    </table></div>
    <p class="meta">원지수(2020=100). 표에 없는 칸(—)은 KOSIS 가 그 업종의 재고지수 등을 내지 않거나 값이 없는 경우입니다. 위쪽은 대구 비중이 큰 업종 순으로 놓았을 뿐 순위가 아닙니다. 출처: <a href={ind.url} rel="noopener">{ind.source}</a>. 연도별·업종별 추이는 <a href="/stats/kosis/">통계청 통계</a> 페이지에 있습니다.</p>
  </section>)}

  {G.map((g, i) => { const ss = S.filter(s => s.group === g); const ms = monthsOf(ss); return (
  <section id={`g${i}`}>
    <div class="section-head"><h2>{g} — 월별 값</h2></div>
    <div class="scroll-x"><table class="data-table" data-title={`대구 ${g} 월별 값`}>
      <thead><tr><th>기준월</th>{ss.map(s => <th class="n">{s.name}<br /><span class="u">({s.unit})</span></th>)}</tr></thead>
      <tbody>{ms.map(m => (
        <tr><th scope="row">{m}</th>{ss.map(s => { const p = s.pts.find(q => q.m === m); return <td class="n">{p ? fmt(p.v, s.digits) : '—'}</td>; })}</tr>
      ))}</tbody>
    </table></div>
    <p class="meta">출처: {[...new Map(ss.map(s => [s.source, s])).values()].map((s, k) => <>{k > 0 && ', '}{s.url ? <a href={s.url} rel="noopener">{s.source}</a> : s.source}</>)}. — 는 그 달 값이 없음(아직 공표 전이거나 이 사이트가 값을 받지 못한 달).</p>
  </section>); })}

  <section id="sources">
    <div class="section-head"><h2>출처와 읽는 법</h2></div>
    <ul>
      <li>국가데이터처 KOSIS(광공업생산지수, 경제활동인구조사, 국내인구이동통계)는 매월 9일, 한국은행 ECOS(소비자동향조사, 지역별 연체율·대출금·어음부도율)는 매월 10일 이 사이트가 받아 갱신합니다.</li>
      <li>서비스업·대형소매점 판매액, 자동차 신규등록, 자본재 수입, 건설수주, 수출입, 창업기업, 기업경기실사지수(BSI), 경기종합지수는 이 사이트가 아직 원 통계를 직접 받지 않아, 각 기관이 공표한 대구 값을 정리한 자료에서 옮겼습니다. 같은 달 값이 여러 번 실리면 가장 늦게 실린 값입니다. 원 통계를 직접 받게 되면 바꿉니다.</li>
      <li>원화대출금은 십억 원을 1,000으로 나눠 조 원으로 적었습니다.</li>
      <li>월간 수출입의 품목·국가별 비교(대구본부세관·산업통상부)는 <a href="/stats/trade/">월간 수출입</a> 페이지에 있습니다.</li>
    </ul>
  </section>
  <style>
    .u { color: var(--muted); font-size: var(--small); font-weight: 400; margin-left: 2px; }
    .nw { white-space: nowrap; }
    tr.grp th { background: var(--surface); font-size: var(--small); color: var(--muted); padding-top: 6px; padding-bottom: 6px; }
    td.src { font-size: var(--small); min-width: 12rem; }
    h3.tg { margin: var(--s3) 0 var(--s1); }
    .trend-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--s2); }
    .tcard { margin: 0; padding: 12px 12px 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); min-width: 0; }
    .tcard figcaption { font-size: var(--small); margin-bottom: 4px; }
    .tcard :global(svg.trend) { display: block; width: 100%; height: auto; color: var(--primary); overflow: visible; }
    .tcard :global(.tc-line) { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
    .tcard :global(.tc-dot) { fill: currentColor; stroke: var(--bg); stroke-width: 2; }
    .tcard :global(.tc-val) { fill: var(--ink); font-size: 11px; font-variant-numeric: tabular-nums; }
    .tcard :global(.tc-ax) { fill: var(--muted); font-size: 10.5px; }
    .tcard :global(.tc-base) { stroke: var(--line); stroke-width: 1; }
    .tsrc { margin: 4px 0 0; font-size: 12px; color: var(--muted); }
  </style>
</Base>
