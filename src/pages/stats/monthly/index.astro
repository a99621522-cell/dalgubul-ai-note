---
import Base from '../../../layouts/Base.astro';
import StatsNav from '../../../components/StatsNav.astro';
import { monthlySeries, change, latest, groups, fmt, fmtChg, trendChart, CYCLES, CYCLE_DESC, cycleSentence } from '../../../lib/monthly';
/** /stats/monthly/ — 경기 동향(월간). 원 통계(KOSIS·ECOS)에서 직접 읽고, 원 통계를 아직 받지 않는 지표만
 *  data/refs/dpi-*.json 정리값을 쓴다(src/lib/monthly.ts). 지표마다 원 통계 기관을 출처로 적는다 — 페이지에 자료 정리 기관·간행물 이름은 쓰지 않는다
 *  (운영자 지시 2026-10-02, 경기종합지수는 작성 기관이라 그 지표의 출처로만). 값 그대로, 평가 없음.
 *  구성(운영자 지적 2026-10-02 '복잡하고 분류가 없다'): 핵심 숫자 6개 → 선행·동행·후행 한 줄씩 → 부문별 그래프(표는 펼쳐 보기) → 출처. */
const S = monthlySeries();
const G = groups(S);
const newest = S.map(s => latest(s).m).sort().at(-1) ?? '';
const from = `${newest.slice(0, 4)}-01`;
type Ser = typeof S[number];
const unitChg = (s: Ser) => (s.change === '%' ? '%' : s.change === '%p' ? '%p' : s.unit === '명' ? '명' : s.unit === '백만 달러' ? '백만 달러' : 'p');
const dig = (s: Ser) => (s.change === '%p' ? Math.max(1, s.digits) : 1);
const chg = (s: Ser, lag: 12 | 1) => { const v = change(s, latest(s), lag); return v == null ? '—' : `${fmtChg(v, s.unit, dig(s))}${unitChg(s)}`; };
const HEAD = ['ip', 'exp', 'er', 'csi', 'smed', 'cli'];
const heads = HEAD.map(k => S.find(s => s.key === k)).filter(Boolean) as Ser[];
const monthsOf = (ss: Ser[]) => [...new Set(ss.flatMap(s => s.pts.map(p => p.m)))].sort().reverse().slice(0, 13);
const GROUP_DESC: Record<string, string> = {
  '생산': '광공업 생산·출하·재고와 재고순환지표, 서비스업 생산',
  '고용·인구': '취업자·고용률·실업률과 인구 순이동',
  '소비·투자': '소비자심리, 대형소매점 판매, 자동차 등록, 자본재 수입, 건설수주',
  '수출입': '대구 수출·수입·무역수지(품목·국가별은 수출입 페이지)',
  '금융': '연체율, 대출금, 어음부도율',
  '창업·경기': '창업기업, 경기동행·선행지수, 기업경기실사지수(BSI)',
};
---
<Base title="경기 동향" description={`대구 경기 동향(월간) — 생산·고용·소비·투자·수출입·금융·경기지수 ${S.length}개. 핵심 숫자, 선행·동행·후행 구분, ${from.slice(0, 4)}년 1월부터 추세. 최근 기준월 ${newest}.`} current="stats" crumb="경기 동향">
  <StatsNav current="monthly" />
  <div class="section-head"><h1>경기 동향</h1><span class="meta">월간 · 최근 기준월 {newest}</span></div>
  <p class="lede">대구 경제를 매달 보는 지표 {S.length}개입니다. 맨 위 핵심 숫자 6개, 그다음 선행·동행·후행 구분, 아래는 부문별 {from.slice(0, 4)}년 1월부터 추세입니다. 월간 값은 잠정치라 고쳐질 수 있고, 평가·전망이 아닙니다.</p>

  <section aria-labelledby="h-key">
    <h2 id="h-key" class="sr-only">핵심 숫자</h2>
    <div class="tiles">
      {heads.map(s => { const p = latest(s); return (
        <a class="tile" href={`#g${G.indexOf(s.group)}`}>
          <span class="tl">{s.name}</span>
          <span class="tv">{fmt(p.v, s.digits)}<small> {s.unit === '2020=100' || s.unit === '지수' ? '' : s.unit}</small></span>
          <span class="ty">{p.m} · {change(s, p, 12) != null ? `전년 같은 달 대비 ${chg(s, 12)}` : `전월 대비 ${chg(s, 1)}`}</span>
        </a>); })}
    </div>
  </section>

  <section id="cycle" aria-labelledby="h-cycle">
    <div class="section-head"><h2 id="h-cycle">선행·동행·후행으로 보면</h2></div>
    <ul class="cycles">
      {CYCLES.map(c => { const ss = S.filter(s => s.cycle === c); return ss.length > 0 && (
        <li><span class="ctag">{c}</span><span><strong>{CYCLE_DESC[c]}</strong><br />{cycleSentence(S, c)} <span class="meta">({ss.map(s => s.name).join(', ')})</span></span></li>); })}
    </ul>
    <details>
      <summary>지표별 값과 경기종합지수 구성지표와의 관계 보기</summary>
      <div class="scroll-x"><table class="data-table" data-title="대구 선행·동행·후행 지표">
        <thead><tr><th>구분</th><th>지표</th><th>구성지표와의 관계</th><th>기준월</th><th class="n">값</th><th class="n">전년 같은 달 대비</th><th class="n">전월 대비</th></tr></thead>
        <tbody>{CYCLES.flatMap(c => S.filter(s => s.cycle === c).map(s => (
          <tr><td>{c}</td><th scope="row">{s.name}</th><td class="src">{s.rel}</td><td class="nw">{latest(s).m}</td><td class="n">{fmt(latest(s).v, s.digits)} <span class="u">{s.unit}</span></td><td class="n">{chg(s, 12)}</td><td class="n">{chg(s, 1)}</td></tr>)))}</tbody>
      </table></div>
      <p class="meta">국가데이터처 경기종합지수 구성지표 — 선행: 재고순환지표·경제심리지수·기계류내수출하지수·건설수주액·수출입물가비율·코스피·장단기금리차 / 동행: 광공업생산지수·서비스업생산지수·건설기성액·소매판매액지수·내수출하지수·수입액·비농림어업취업자수 / 후행: 생산자제품재고지수 등. 이 가운데 대구 값을 이 사이트가 받는 것과 비슷한 지표만 나눴습니다. 재고순환지표는 KOSIS 대구 제조업 출하지수 전년동월비 − 재고지수 전년동월비(이 사이트 계산). 문장은 증감 방향의 개수만 셉니다(종합지수 제외).</p>
    </details>
  </section>

  {G.map((g, i) => { const ss = S.filter(s => s.group === g); const ms = monthsOf(ss); return (
  <section id={`g${i}`} aria-labelledby={`h-g${i}`}>
    <div class="section-head"><h2 id={`h-g${i}`}>{g}</h2><span class="meta">{GROUP_DESC[g] ?? ''}</span></div>
    <div class="trend-grid">
      {ss.map(s => { const svg = trendChart(s, from, newest); return svg && (
        <figure class="tcard">
          <figcaption>{s.cycle && <span class="ctag">{s.cycle}</span>}<strong>{s.name}</strong> <span class="u">({s.unit})</span></figcaption>
          <div set:html={svg} />
          <p class="tsrc">{latest(s).m} · 전년 같은 달 대비 {chg(s, 12)} · 출처: {s.source}</p>
        </figure>); })}
    </div>
    <details>
      <summary>{g} 표로 보기</summary>
      <div class="scroll-x"><table class="data-table" data-title={`대구 ${g} — 최근 값`}>
        <thead><tr><th>지표</th><th>기준월</th><th class="n">값</th><th>단위</th><th class="n">전년 같은 달 대비</th><th class="n">전월 대비</th><th>출처</th></tr></thead>
        <tbody>{ss.map(s => (
          <tr><th scope="row">{s.name}</th><td class="nw">{latest(s).m}</td><td class="n">{fmt(latest(s).v, s.digits)}</td><td>{s.unit}</td><td class="n">{chg(s, 12)}</td><td class="n">{chg(s, 1)}</td>
            <td class="src">{s.url ? <a href={s.url} rel="noopener">{s.source}</a> : s.source}{s.note && <span class="meta"> · {s.note}</span>}</td></tr>))}</tbody>
      </table></div>
      <div class="scroll-x"><table class="data-table" data-title={`대구 ${g} — 월별 값`}>
        <thead><tr><th>기준월</th>{ss.map(s => <th class="n">{s.name}<br /><span class="u">({s.unit})</span></th>)}</tr></thead>
        <tbody>{ms.map(m => (
          <tr><th scope="row">{m}</th>{ss.map(s => { const p = s.pts.find(q => q.m === m); return <td class="n">{p ? fmt(p.v, s.digits) : '—'}</td>; })}</tr>))}</tbody>
      </table></div>
    </details>
  </section>); })}

  <details class="srcs">
    <summary>출처와 읽는 법</summary>
    <ul>
      <li>국가데이터처 KOSIS(광공업생산지수, 경제활동인구조사, 국내인구이동통계)는 매월 9일, 한국은행 ECOS(소비자동향조사, 지역별 연체율·대출금·어음부도율)는 매월 10일 이 사이트가 받아 갱신합니다.</li>
      <li>서비스업·대형소매점 판매액, 자동차 신규등록, 자본재 수입, 건설수주, 수출입, 창업기업, 기업경기실사지수(BSI), 경기종합지수는 이 사이트가 아직 원 통계를 직접 받지 않아, 각 기관이 공표한 대구 값을 정리한 자료에서 옮겼습니다. 같은 달 값이 여러 번 실리면 가장 늦게 실린 값입니다.</li>
      <li>증감: 지수·금액·건수는 증감률(%), 비율(고용률·실업률·연체율)은 %p 차, 소비자심리지수·BSI 는 포인트 차, 순이동은 명 차, 무역수지는 백만 달러 차. △는 감소. 그래프 세로 눈금은 지표마다 다릅니다. 원화대출금은 십억 원을 1,000으로 나눠 조 원으로 적었습니다.</li>
      <li>업종별 생산·출하·재고는 <a href="/stats/manufacturing/">제조업</a>, 품목·국가별 수출입은 <a href="/stats/trade/">수출입</a> 페이지에 있습니다.</li>
    </ul>
  </details>
  <style>
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .u { color: var(--muted); font-size: var(--small); font-weight: 400; margin-left: 2px; }
    .nw { white-space: nowrap; }
    td.src { font-size: var(--small); min-width: 12rem; }
    .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s2); margin: var(--s2) 0 var(--s3); }
    @media (min-width: 640px) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .tile { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); text-decoration: none; }
    .tile:hover { background: var(--surface); }
    .tl { font-size: var(--small); color: var(--muted); }
    .tv { font-size: 1.4rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; }
    .tv small { font-size: var(--small); font-weight: 400; color: var(--muted); }
    .ty { font-size: 12px; color: var(--muted); }
    .cycles { list-style: none; padding: 0; margin: 0 0 var(--s2); display: grid; gap: 10px; }
    .cycles li { display: flex; gap: 10px; align-items: flex-start; }
    .ctag { display: inline-block; flex: none; font-size: 11px; line-height: 1; padding: 4px 6px; margin-right: 5px; border: 1px solid var(--line-strong); border-radius: 4px; color: var(--muted); vertical-align: 1px; }
    details { margin: var(--s1) 0 var(--s3); }
    details > summary { cursor: pointer; color: var(--primary); padding: 6px 0; }
    .trend-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--s2); }
    .tcard { margin: 0; padding: 12px 12px 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); min-width: 0; }
    .tcard figcaption { font-size: var(--small); margin-bottom: 4px; }
    .tcard :global(svg.trend) { display: block; width: 100%; height: auto; color: var(--primary); overflow: visible; }
    .tcard :global(.tc-line) { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
    .tcard :global(.tc-dot) { fill: currentColor; stroke: var(--bg); stroke-width: 2; }
    .tcard :global(.tc-val) { fill: var(--ink); font-size: 11px; font-variant-numeric: tabular-nums; }
    .tcard :global(.tc-ax) { fill: var(--muted); font-size: 10.5px; }
    .tcard :global(.tc-base) { stroke: var(--line); stroke-width: 1; }
    .tsrc { margin: 4px 0 0; font-size: 12px; color: var(--muted); }
  </style>
</Base>
