---
import Base from '../../../layouts/Base.astro';
import StatsNav from '../../../components/StatsNav.astro';
import { change, latest, fmt, fmtChg, trendChart, shift } from '../../../lib/monthly';
import { serviceSeries, serviceIndustryRows, retailSeries, selfEmployedSeries, marketSeries } from '../../../lib/services';
/** /stats/services/ — 서비스업·자영업(운영자 지시 2026-10-02). KOSIS 원 통계만(src/lib/services.ts). 값 그대로, 평가 없음. */
const SV = serviceSeries(), RT = retailSeries(), SE = selfEmployedSeries(), MK = marketSeries();
const ind = serviceIndustryRows();
type Ser = typeof SV[number];
const unitChg = (s: Ser) => (s.change === '%' ? '%' : s.change === '%p' ? '%p' : 'p');
const chg = (s: Ser, lag: 12 | 1) => { const v = change(s, latest(s), lag); return v == null ? '—' : `${fmtChg(v, s.unit, 1)}${unitChg(s)}`; };
const lastM = (ss: Ser[]) => ss.map(s => latest(s).m).sort().at(-1) ?? '';
const yearFrom = (ss: Ser[]) => `${lastM(ss).slice(0, 4)}-01`;
const qFrom = (ss: Ser[]) => shift(lastM(ss), -21);   // 최근 8개 분기
const heads = [SV[0], RT[0], SE[0], SE.find(s => s.key === 'seS'), MK[0]].filter(Boolean) as Ser[];
const blocks: { id: string; title: string; desc: string; ss: Ser[]; from: string; step: number }[] = [
  { id: 'svc', title: '서비스업 생산 (분기)', desc: '서비스업동향조사의 대구 업종별 서비스업생산지수(불변지수, 2020=100). 최근 8개 분기.', ss: SV, from: qFrom(SV), step: 3 },
  { id: 'retail', title: '대형소매점 판매 (월간)', desc: '대형소매점(백화점·대형마트) 판매액지수(불변지수, 2020=100).', ss: RT, from: yearFrom(RT), step: 1 },
  { id: 'self', title: '자영업 (월간)', desc: '경제활동인구조사의 대구 종사상지위별 취업자 가운데 자영업자·무급가족종사자와 자영업자 비중.', ss: SE, from: yearFrom(SE), step: 1 },
  { id: 'market', title: '소상공인·전통시장 체감경기 (월간)', desc: '소상공인시장경기동향조사의 대구 소상공인·전통시장 체감(이번 달)·전망(다음 달) 경기지수. 100이 넘으면 전월보다 좋다는 응답이 많다는 뜻입니다.', ss: MK, from: yearFrom(MK), step: 1 },
].filter(b => b.ss.length);
---
<Base title="서비스업·자영업 통계" description="대구 서비스업 생산지수(업종별, 분기), 대형소매점 판매액지수, 자영업자 수·비중, 소상공인·전통시장 체감경기(BSI) — 국가데이터처·소상공인시장진흥공단 KOSIS 원 통계." current="stats">
  <p class="meta"><a href="/stats/">통계</a> › 서비스업·자영업</p>
  <StatsNav current="services" />
  <div class="section-head"><h1>서비스업·자영업</h1><span class="meta">분기·월간 · KOSIS</span></div>
  <p class="lede">대구 서비스업 생산, 대형소매점 판매, 자영업자, 소상공인·전통시장 체감경기입니다. 모두 KOSIS 원 통계 그대로이고, 평가·전망이 아닙니다. 그래프마다 점에 그 달(분기) 값을 적었고, 표는 펼쳐서 봅니다.</p>

  <div class="stat-tiles">
    {heads.map(s => { const p = latest(s); const y = change(s, p, 12); return (
      <div class="tile">
        <span class="tl">{s.name}</span>
        <span class="tv">{fmt(p.v, s.digits)}<small> {s.unit === '2020=100' || s.unit === '지수' ? '' : s.unit}</small></span>
        <span class="ty">{s.quarterly ? `${p.m.slice(0, 4)}년 ${Number(p.m.slice(5)) / 3}분기` : p.m} · {y != null ? `전년 같은 ${s.quarterly ? '분기' : '달'} 대비 ${chg(s, 12)}` : `전월 대비 ${chg(s, 1)}`}</span>
      </div>); })}
  </div>

  {blocks.map(b => (
    <section id={b.id}>
      <div class="section-head"><h2>{b.title}</h2></div>
      <p class="meta">{b.desc}</p>
      <div class="trend-grid">
        {b.ss.map(s => { const svg = trendChart(s, b.from, lastM(b.ss), b.step); return svg && (
          <figure class="tcard">
            <figcaption><strong>{s.name}</strong> <span class="meta">({s.unit})</span></figcaption>
            <div set:html={svg} />
            <p class="tsrc">전년 같은 {s.quarterly ? '분기' : '달'} 대비 {chg(s, 12)}{s.note && ` · ${s.note}`}</p>
          </figure>); })}
      </div>
      {b.id === 'svc' && ind.rows.length > 0 ? (
        <details class="stat-details">
          <summary>업종별 서비스업 생산지수 표 ({ind.q.slice(0, 4)}년 {Number(ind.q.slice(5)) / 3}분기)</summary>
          <div class="scroll-x"><table class="data-table" data-title={`대구 업종별 서비스업생산지수 ${ind.q.slice(0, 4)}년 ${Number(ind.q.slice(5)) / 3}분기`}>
            <thead><tr><th>업종</th><th class="n">불변지수(2020=100)</th><th class="n">전년 같은 분기 대비(%)</th></tr></thead>
            <tbody>{ind.rows.map(r => <tr><th scope="row">{r.name}</th><td class="n">{fmt(r.v, 1)}</td><td class="n">{fmtChg(r.yoy, '', 1)}</td></tr>)}</tbody>
          </table></div>
          <p class="meta">표의 위아래는 KOSIS 표 순서이며 순위가 아닙니다. 출처: <a href={ind.url} rel="noopener">{ind.source}</a></p>
        </details>
      ) : (
        <details class="stat-details">
          <summary>{b.title} 표로 보기</summary>
          <div class="scroll-x"><table class="data-table" data-title={`대구 ${b.title}`}>
            <thead><tr><th>기준월</th>{b.ss.map(s => <th class="n">{s.name}<br /><span class="meta">({s.unit})</span></th>)}</tr></thead>
            <tbody>{[...new Set(b.ss.flatMap(s => s.pts.map(p => p.m)))].sort().reverse().slice(0, 13).map(m => (
              <tr><th scope="row">{m}</th>{b.ss.map(s => { const p = s.pts.find(q => q.m === m); return <td class="n">{p ? fmt(p.v, s.digits) : '—'}</td>; })}</tr>))}</tbody>
          </table></div>
          <p class="meta">출처: <a href={b.ss[0].url} rel="noopener">{b.ss[0].source}</a></p>
        </details>
      )}
    </section>
  ))}
  <p class="meta">관광 방문자 수(구·군별, 한국관광공사)는 공공데이터포털 인증키 등록 뒤 더합니다. 월간 경기 지표 전체는 <a href="/stats/monthly/">경기 동향</a>에 있습니다.</p>
</Base>
