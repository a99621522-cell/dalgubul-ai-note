---
import Base from '../../../layouts/Base.astro';
import StatsNav from '../../../components/StatsNav.astro';
import { change, latest, fmt, fmtChg, trendChart, shift } from '../../../lib/monthly';
import { serviceSeries, serviceIndustryRows, retailSeries, selfEmployedSeries, marketSeries, cardSeries, cardRows, tourismSeries, tourismIndustryRows, tourismDistrictRows, DATALAB_SRC, DATALAB_URL, TOUR_API_SRC, TOUR_API_URL } from '../../../lib/services';
/** /stats/services/ — 서비스업·자영업(운영자 지시 2026-10-02). KOSIS 원 통계만(src/lib/services.ts). 값 그대로, 평가 없음. */
const SV = serviceSeries(), RT = retailSeries(), SE = selfEmployedSeries(), MK = marketSeries(), CD = cardSeries(), TR = tourismSeries();
const tInd = tourismIndustryRows(), tDist = tourismDistrictRows();
// 방문자 구분 설명 표의 예시 값(각 계열의 최근 달)
const tLast = (k: string, d: number) => { const s = TR.find(x => x.key === k), p = s?.pts.at(-1); return p ? `${fmt(p.v, d)}만 명(${p.m.slice(0, 4)}년 ${Number(p.m.slice(5))}월)` : '—'; };
const ymKo = (m: string) => `${m.slice(0, 4)}년 ${Number(m.slice(5))}월`;
const card = cardRows();
const ind = serviceIndustryRows();
type Ser = typeof SV[number];
const unitChg = (s: Ser) => (s.change === '%' ? '%' : s.change === '%p' ? '%p' : 'p');
const chg = (s: Ser, lag: 12 | 1) => { const v = change(s, latest(s), lag); return v == null ? '—' : `${fmtChg(v, s.unit, 1)}${unitChg(s)}`; };
const lastM = (ss: Ser[]) => ss.map(s => latest(s).m).sort().at(-1) ?? '';
const yearFrom = (ss: Ser[]) => `${lastM(ss).slice(0, 4)}-01`;
const qFrom = (ss: Ser[]) => shift(lastM(ss), -21);   // 최근 8개 분기
const heads = [SV[0], RT[0], SE[0], SE.find(s => s.key === 'seS'), MK[0], TR[0]].filter(Boolean) as Ser[];
const blocks: { id: string; title: string; desc: string; ss: Ser[]; from: string; step: number }[] = [
  { id: 'svc', title: '서비스업 생산 (분기)', desc: '서비스업동향조사의 대구 업종별 서비스업생산지수(불변지수, 2020=100). 최근 8개 분기.', ss: SV, from: qFrom(SV), step: 3 },
  { id: 'retail', title: '대형소매점 판매 (월간)', desc: '대형소매점(백화점·대형마트) 판매액지수(불변지수, 2020=100).', ss: RT, from: yearFrom(RT), step: 1 },
  { id: 'self', title: '자영업 (월간)', desc: '경제활동인구조사의 대구 종사상지위별 취업자 가운데 자영업자·무급가족종사자와 자영업자 비중.', ss: SE, from: yearFrom(SE), step: 1 },
  { id: 'market', title: '소상공인·전통시장 체감경기 (월간)', desc: '소상공인시장경기동향조사의 대구 소상공인·전통시장 체감(이번 달)·전망(다음 달) 경기지수. 100이 넘으면 전월보다 좋다는 응답이 많다는 뜻입니다.', ss: MK, from: yearFrom(MK), step: 1 },
  { id: 'tour', title: '관광 방문자·관광소비 (월간)', desc: '한국관광공사 관광빅데이터의 대구 방문자 수 — 외지인(대구 밖 거주자)·외국인·현지인(대구 주민), 이동통신 연인원으로 같은 사람이 여러 날 오면 날마다 셉니다 — 와 신용카드 관광소비액. 데이터랩은 이 값을 총량이 아니라 추세 분석에 쓰라고 안내합니다. 최근 12개월.', ss: TR, from: shift(lastM(TR), -11), step: 1 },
  { id: 'card', title: `카드 소비 (월간, ${card.m.slice(0, 4)}년 ${Number(card.m.slice(5))}월까지)`, desc: `한국은행 「지역별 소비유형별 개인 신용카드」의 대구 월 사용액(억 원). 이 표는 ${card.m.slice(0, 4)}년 ${Number(card.m.slice(5))}월에서 멈춰 그 뒤 값이 없습니다. 지금 공개된 대구 카드 통계는 이 표뿐입니다.`, ss: CD, from: shift(lastM(CD), -11), step: 1 },
].filter(b => b.ss.length);
---
<Base title="서비스업·자영업 통계" description="대구 서비스업 생산지수(업종별, 분기), 대형소매점 판매액지수, 자영업자 수·비중, 소상공인·전통시장 체감경기(BSI), 관광 방문자·관광소비, 업종별 카드 사용액 — 국가데이터처·소상공인시장진흥공단(KOSIS)·한국은행(ECOS)·한국관광공사(데이터랩) 원 통계." current="stats">
  <p class="meta"><a href="/stats/">통계</a> › 서비스업·자영업</p>
  <StatsNav current="services" />
  <div class="section-head"><h1>서비스업·자영업</h1><span class="meta">분기·월간 · KOSIS·ECOS·데이터랩</span></div>
  <p class="lede">대구 서비스업 생산, 대형소매점 판매, 자영업자, 소상공인·전통시장 체감경기, 관광 방문자·관광소비, 업종별 카드 사용액입니다. 모두 원 통계 그대로이고, 평가·전망이 아닙니다. 그래프마다 점에 그 달(분기) 값을 적었고, 표는 펼쳐서 봅니다.</p>

  <div class="stat-tiles">
    {heads.map(s => { const p = latest(s); const y = change(s, p, 12); return (
      <div class="tile">
        <span class="tl">{s.name}</span>
        <span class="tv">{fmt(p.v, s.digits)}<small> {s.unit === '2020=100' || s.unit === '지수' ? '' : s.unit}</small></span>
        <span class="ty">{s.quarterly ? `${p.m.slice(0, 4)}년 ${Number(p.m.slice(5)) / 3}분기` : p.m} · {y != null ? `전년 같은 ${s.quarterly ? '분기' : '달'} 대비 ${chg(s, 12)}` : `전월 대비 ${chg(s, 1)}`}</span>
      </div>); })}
  </div>

  {blocks.map(b => (
    <section id={b.id}>
      <div class="section-head"><h2>{b.title}</h2></div>
      <p class="meta">{b.desc}</p>
      {b.id === 'tour' && (
        <details class="stat-details" open>
          <summary>방문자 수 읽는 법 — 외지인·외국인·현지인</summary>
          <div class="scroll-x"><table class="data-table" data-title="대구 방문자 수 구분">
            <thead><tr><th>구분</th><th>뜻(대구광역시 기준)</th><th class="n">최근 값</th></tr></thead>
            <tbody>
              <tr><th scope="row">외지인</th><td>대구 밖(다른 시·도)에 사는 국내 거주자가 대구에 온 수</td><td class="n">{tLast('tvis', 0)}</td></tr>
              <tr><th scope="row">외국인</th><td>대구를 찾은 외국인 방문자 수</td><td class="n">{tLast('tfor', 1)}</td></tr>
              <tr><th scope="row">현지인</th><td>대구에 사는 사람이 대구 안에서 다닌 수</td><td class="n">{tLast('tloc', 0)}</td></tr>
            </tbody>
          </table></div>
          <ul class="meta">
            <li><strong>사람 수가 아니라 연인원입니다.</strong> 같은 사람이 사흘 머물면 3번 셉니다. 날마다 센 방문을 한 달 동안 더한 값입니다.</li>
            <li><strong>휴대전화 이동통신 위치로 추정한 값입니다.</strong> 실제로 센 값이 아니어서 데이터랩은 총량보다 증감 추세를 보라고 안내합니다.</li>
            <li><strong>방문 목적은 구분하지 않습니다.</strong> 관광·출장·통근 등 목적별 값이 아닙니다.</li>
            <li><strong>구·군 표의 외지인은 그 구·군 밖에 사는 사람입니다.</strong> 예를 들어 중구 외지인에는 대구의 다른 구·군 주민도 들어가므로, 구·군 값을 더해도 대구 외지인 값이 되지 않습니다.</li>
            <li>외지인은 데이터랩 화면 값, 외국인·현지인은 같은 관광빅데이터의 오픈API 값입니다. 같은 달 외지인 값이 두 경로에서 일치합니다.</li>
          </ul>
        </details>
      )}
      <div class="trend-grid">
        {b.ss.map(s => { const svg = trendChart(s, b.from, lastM(b.ss), b.step); return svg && (
          <figure class="tcard">
            <figcaption><strong>{s.name}</strong> <span class="meta">({s.unit})</span></figcaption>
            <div set:html={svg} />
            <p class="tsrc">전년 같은 {s.quarterly ? '분기' : '달'} 대비 {chg(s, 12)}{s.note && ` · ${s.note}`}</p>
          </figure>); })}
      </div>
      {b.id === 'tour' ? (<>
        <details class="stat-details" open>
          <summary>업종별 관광소비 ({ymKo(tInd.m)}, 내국인)</summary>
          <div class="scroll-x"><table class="data-table" data-title={`대구 업종별 관광소비 ${tInd.m}`}>
            <thead><tr><th>업종</th><th class="n">관광소비(억 원)</th><th class="n">전체 대비 비중(%)</th><th class="n">전년 같은 달 대비(%)</th></tr></thead>
            <tbody>{tInd.rows.map(r => <tr><th scope="row">{r.name}</th><td class="n">{fmt(r.v, 0)}</td><td class="n">{fmt(r.share, 1)}</td><td class="n">{fmtChg(r.yoy, '', 1)}</td></tr>)}
              <tr><th scope="row">전체</th><td class="n">{fmt(tInd.total, 0)}</td><td class="n">—</td><td class="n">—</td></tr></tbody>
          </table></div>
          <p class="meta">업종은 데이터랩의 관광 업종 분류이고 화면 순서대로 놓았습니다(순위 아님). 천 원을 100,000으로 나눠 억 원으로 적었고, 비중·증감은 같은 표 안의 나눗셈입니다.</p>
        </details>
        <details class="stat-details">
          <summary>구·군별 방문자·관광소비 ({ymKo(tDist.m)})</summary>
          <div class="scroll-x"><table class="data-table" data-title={`대구 구군별 외지인 방문자·관광소비 ${tDist.m}`}>
            <thead><tr><th>구·군</th><th class="n">외지인 방문자(만 명)</th><th class="n">전년 같은 달 대비(%)</th><th class="n">외국인 방문자(만 명)</th><th class="n">관광소비(억 원, 내국인)</th><th class="n">전년 같은 달 대비(%)</th></tr></thead>
            <tbody>{tDist.rows.map(r => <tr><th scope="row">{r.name}</th><td class="n">{fmt(r.vis, 1)}</td><td class="n">{fmtChg(r.visYoy, '', 1)}</td><td class="n">{fmt(r.fr, 1)}</td><td class="n">{fmt(r.sp, 0)}</td><td class="n">{fmtChg(r.spYoy, '', 1)}</td></tr>)}</tbody>
          </table></div>
          <p class="meta">구·군의 외지인은 그 구·군 밖에 사는 사람이라(다른 구·군 주민 포함) 구·군 값을 더해도 대구 값이 되지 않습니다. 구·군 순서는 행정 코드 순입니다. 방문자 전년 같은 달 대비는 데이터랩이 낸 값입니다.</p>
        </details>
        <details class="stat-details">
          <summary>관광 방문자·관광소비 표로 보기</summary>
          <div class="scroll-x"><table class="data-table" data-title="대구 관광 방문자·관광소비 월별">
            <thead><tr><th>기준월</th>{b.ss.map(s => <th class="n">{s.name}<br /><span class="meta">({s.unit})</span></th>)}</tr></thead>
            <tbody>{[...new Set(b.ss.flatMap(s => s.pts.map(p => p.m)))].sort().reverse().slice(0, 13).map(m => (
              <tr><th scope="row">{m}</th>{b.ss.map(s => { const p = s.pts.find(q => q.m === m); return <td class="n">{p ? fmt(p.v, s.digits) : '—'}</td>; })}</tr>))}</tbody>
          </table></div>
          <p class="meta">2020년 1월부터의 값을 받아 두었습니다(위 표는 최근 13개월). 출처: <a href={DATALAB_URL} rel="noopener">{DATALAB_SRC}</a>(외지인 방문자·관광소비, 로그인 없이 열리는 화면의 값) · <a href={TOUR_API_URL} rel="noopener">{TOUR_API_SRC}</a>(외국인·현지인 방문자, 일별 값을 달마다 더함, 2024년부터) — 방문자는 이동통신, 관광소비는 신용카드 빅데이터 추정값입니다.</p>
        </details>
      </>) : b.id === 'card' ? (
        <details class="stat-details" open>
          <summary>업종별 카드 사용액 ({card.m.slice(0, 4)}년 {Number(card.m.slice(5))}월)</summary>
          <div class="scroll-x"><table class="data-table" data-title={`대구 업종별 개인 신용카드 사용액 ${card.m}`}>
            <thead><tr><th>업종(소비유형)</th><th class="n">사용액(억 원)</th><th class="n">합계 대비 비중(%)</th><th class="n">전년 같은 달 대비(%)</th></tr></thead>
            <tbody>{card.rows.map(r => <tr><th scope="row">{r.name}</th><td class="n">{fmt(r.v, 0)}</td><td class="n">{fmt(r.share, 1)}</td><td class="n">{fmtChg(r.yoy, '', 1)}</td></tr>)}
              <tr><th scope="row">합계</th><td class="n">{fmt(card.total, 0)}</td><td class="n">—</td><td class="n">—</td></tr></tbody>
          </table></div>
          <p class="meta">업종은 표의 대분류 13개이며, 사용액이 큰 순서로 놓았을 뿐 순위가 아닙니다. 대분류 합과 합계는 표에서 조금 다를 수 있습니다. 백만 원을 100으로 나눠 억 원으로 적었습니다. 출처: <a href={card.url} rel="noopener">{card.source}</a></p>
        </details>
      ) : b.id === 'svc' && ind.rows.length > 0 ? (
        <details class="stat-details">
          <summary>업종별 서비스업 생산지수 표 ({ind.q.slice(0, 4)}년 {Number(ind.q.slice(5)) / 3}분기)</summary>
          <div class="scroll-x"><table class="data-table" data-title={`대구 업종별 서비스업생산지수 ${ind.q.slice(0, 4)}년 ${Number(ind.q.slice(5)) / 3}분기`}>
            <thead><tr><th>업종</th><th class="n">불변지수(2020=100)</th><th class="n">전년 같은 분기 대비(%)</th></tr></thead>
            <tbody>{ind.rows.map(r => <tr><th scope="row">{r.name}</th><td class="n">{fmt(r.v, 1)}</td><td class="n">{fmtChg(r.yoy, '', 1)}</td></tr>)}</tbody>
          </table></div>
          <p class="meta">표의 위아래는 KOSIS 표 순서이며 순위가 아닙니다. 출처: <a href={ind.url} rel="noopener">{ind.source}</a></p>
        </details>
      ) : (
        <details class="stat-details">
          <summary>{b.title} 표로 보기</summary>
          <div class="scroll-x"><table class="data-table" data-title={`대구 ${b.title}`}>
            <thead><tr><th>기준월</th>{b.ss.map(s => <th class="n">{s.name}<br /><span class="meta">({s.unit})</span></th>)}</tr></thead>
            <tbody>{[...new Set(b.ss.flatMap(s => s.pts.map(p => p.m)))].sort().reverse().slice(0, 13).map(m => (
              <tr><th scope="row">{m}</th>{b.ss.map(s => { const p = s.pts.find(q => q.m === m); return <td class="n">{p ? fmt(p.v, s.digits) : '—'}</td>; })}</tr>))}</tbody>
          </table></div>
          <p class="meta">출처: <a href={b.ss[0].url} rel="noopener">{b.ss[0].source}</a></p>
        </details>
      )}
    </section>
  ))}
  <p class="meta">월간 경기 지표 전체는 <a href="/stats/monthly/">경기 동향</a>에 있습니다.</p>
</Base>
