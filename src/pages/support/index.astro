---
import Base from '../../layouts/Base.astro';
import { supportFirms } from '../../lib/supportFirms';
/** /support/ — 공개 자료(공공데이터포털 과제·선정 명단)에서 확인된 '지원받은 대구 기업' 전수 목록.
 *  기업 사전에 연결된 기업은 링크, 대구시 지역중소기업 명단으로만 확인된 기업은 이름만.
 *  가나다순, 평가·순위 없음. 금액은 원문에 있을 때만 원문 단위 그대로. */
const { rows, list, funders, years, groupsList, PAGE, sources, withAmount, row } = supportFirms();
---
<Base title="지원받은 기업" description={`공개 자료에서 확인된 지원사업 수혜 대구 기업 ${list.length.toLocaleString('ko-KR')}곳, 이력 ${rows.length.toLocaleString('ko-KR')}건. 기관·연도·사업명으로 찾고 기업 페이지로 이어집니다.`} current="support">
  <div class="section-head"><h1>지원받은 기업</h1><span class="meta">기업 {list.length.toLocaleString('ko-KR')}곳 · 이력 {rows.length.toLocaleString('ko-KR')}건 · 금액 있는 이력 {withAmount}건</span></div>
  <p class="lede">공공데이터포털에 공개된 과제·선정 명단에서 대구 기업(기업 사전 또는 대구시 지역중소기업 명단과 이름이 맞는 곳)을 모두 모았습니다. 가나다순이며 평가·순위가 아닙니다. 금액은 원문에 있을 때만 원문 단위 그대로 적고, 없으면 '금액 미공개'로 둡니다. 대구시 스타기업·Pre-스타기업·3030기업만 모아 보려면 <a href="/support/star/">스타기업 명단</a>.</p>
  <nav class="sub-tabs" aria-label="지원 기업 보기">
    <a href="/support/" aria-current="page">전체 지원 기업</a>
    <a href="/support/participation/">특구·특화단지·샌드박스 참여</a>
    <a href="/support/star/">대구 스타기업·Pre-스타기업·3030기업</a>
    <a href="/support/before-after/">지원 전후 고용 변화</a>
  </nav>
  <div class="tools">
    <input id="q" type="search" placeholder="기업명·사업명 검색" aria-label="검색" />
    <select id="funder" aria-label="지원기관"><option value="">지원기관 전체</option>{funders.map(f => <option value={f}>{f}</option>)}</select>
    <select id="group" aria-label="산업"><option value="">산업 전체</option>{groupsList.map(x => <option value={x}>{x}</option>)}</select>
    <select id="year" aria-label="연도"><option value="">연도 전체</option><option value="recent">최근 3년</option>{years.map(y => <option value={y}>{y}</option>)}</select>
    <span class="meta" id="count"></span>
  </div>
  <div class="scroll-x"><table class="data-table support-table" id="tbl">
    <thead><tr><th>기업</th><th class="col-opt">구·군</th><th class="col-opt">산업</th><th class="n">이력</th><th>연도</th><th>사업명 · 지원기관</th><th class="n col-opt">금액(원문 합)</th></tr></thead>
    <tbody>{list.slice(0, PAGE).map(f => { const r = row(f);
      return (<tr>
        <td>{f.id ? <a href={`/companies/${f.id}/`}>{f.name}</a> : <span>{f.name}<span class="meta"> (명단만)</span></span>}</td>
        <td class="col-opt">{f.district || '—'}</td><td class="col-opt">{f.group || '—'}</td><td class="n">{r.recs.length}</td>
        <td>{r.years}</td>
        <td>{r.top.map(t => <div>{t.head} <span class="meta">{t.meta}</span></div>)}{r.recs.length > 3 && <div class="meta">외 {r.recs.length - 3}건 (기업 페이지에서 전체)</div>}</td>
        <td class="n col-opt">{r.sum}</td>
      </tr>);
    })}</tbody>
  </table></div>
  <p class="more-row"><button type="button" class="btn" id="more" hidden>다음 {PAGE}곳 더 보기</button></p>
  <p class="meta">출처: {sources.join(' · ')}. 기업 사전에 없는 기업은 이름만 표시하며(명단만), 같은 이름의 다른 기업일 수 있으므로 원문 링크는 기업 페이지의 이력 표에서 확인합니다.</p>
  <script is:inline define:vars={{ total: list.length }}>
    // 처음 50곳은 HTML, 검색·필터·더 보기는 /support-index.json 을 받아 그린다(리디자인 v3 감사: 전체 HTML 812KB 를 줄임)
    const $ = id => document.getElementById(id);
    const q = $('q'), fu = $('funder'), gr = $('group'), yr = $('year'), cnt = $('count'), more = $('more'), body = document.querySelector('#tbl tbody');
    const RECENT = new Date().getFullYear() - 2, PAGE = 50;
    let limit = PAGE, data = null;
    const load = async () => data ??= await (await fetch('/support-index.json')).json();
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    function tr(r) {
      const [name, id, dist, grp, n, yrs, top, sum] = r, t = document.createElement('tr');
      const c1 = el('td'); if (id) { const a = el('a', '', name); a.href = `/companies/${id}/`; c1.append(a); } else { const s = el('span', '', name); s.append(el('span', 'meta', ' (명단만)')); c1.append(s); }
      const c6 = el('td'); for (const [h, m] of top) { const d = el('div', '', h + ' '); d.append(el('span', 'meta', m)); c6.append(d); } if (n > 3) c6.append(el('div', 'meta', `외 ${n - 3}건 (기업 페이지에서 전체)`));
      t.append(c1, el('td', 'col-opt', dist || '—'), el('td', 'col-opt', grp || '—'), el('td', 'n', String(n)), el('td', '', yrs), c6, el('td', 'n col-opt', sum));
      return t;
    }
    const plain = () => !q.value.trim() && !fu.value && !gr.value && !yr.value;
    async function apply(keep) {
      if (!keep) limit = PAGE;
      if (plain() && limit === PAGE && !data) { cnt.textContent = `${total.toLocaleString('ko-KR')}곳 중 ${PAGE}곳 표시`; more.hidden = total <= PAGE; return; }
      const all = await load(), s = q.value.trim().toLowerCase(), f = fu.value, g = gr.value, y = yr.value;
      const hit = all.filter(r => (!s || (r[0] + ' ' + r[10]).toLowerCase().includes(s)) && (!f || r[8].split('|').includes(f)) && (!g || r[3] === g)
        && (!y || (y === 'recent' ? r[9].split('|').some(v => Number(v) >= RECENT) : r[9].split('|').includes(y))));
      body.replaceChildren(...hit.slice(0, limit).map(tr));
      cnt.textContent = hit.length > limit ? `${hit.length.toLocaleString('ko-KR')}곳 중 ${limit.toLocaleString('ko-KR')}곳 표시` : `${hit.length.toLocaleString('ko-KR')}곳 표시`;
      more.hidden = hit.length <= limit;
    }
    q.addEventListener('input', () => apply()); fu.addEventListener('change', () => apply()); gr.addEventListener('change', () => apply()); yr.addEventListener('change', () => apply());
    more.addEventListener('click', () => { limit += PAGE; apply(true); });
    const sp = new URLSearchParams(location.search); if (sp.get('funder')) fu.value = sp.get('funder'); if (sp.get('group')) gr.value = sp.get('group'); if (sp.get('q')) q.value = sp.get('q');
    apply();
  </script>
</Base>
