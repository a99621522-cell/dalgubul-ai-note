---
import Base from '../../../layouts/Base.astro';
import VatData from '../../../components/VatData.astro';
import VatNav from '../../../components/VatNav.astro';
import '../../../styles/vat.css';
/** /vat/monthly/ — 시설 지출 기록(신고 담당 공무원이 직접, 또는 수탁기관·시설 부서가 대신 — 운영자 지시 2026-10-27 '사용목적은 신고하는 공무원용'. v2 1단계 2026-10-27). 기관 설정(org.json)을 열고 시설·달을 고른 뒤 지출을 한 건씩 현장 질문 5개로 넣으면 신호등 판정과 '지금 할 일'이 나오고, 월말에 매입 인계표(한글 표 복사·CSV·JSON)를 만든다. 판정은 vat_rules.judge(공용). 서버 없음. 스크립트 src/scripts/vat_monthly.ts */
---
<Base title="시설 지출 기록" description="신고 담당 공무원이 홈택스 매입 목록·카드 내역을 붙여넣거나 한 건씩 넣어 시설별로 기록하면 부가세 매입세액을 공제받을 수 있는지 신호등으로 알려 줍니다. 수탁기관·시설 부서가 대신 기록해 인계표로 보낼 수도 있습니다. 브라우저 안에서만 저장." current="vat" crumb="시설 지출 기록">
  <div class="section-head"><h1>④ 지출 기록 — 시설별로 어디에 쓴 돈인지 남기기</h1><span class="meta" id="m-dday"></span></div>
  <VatNav current="monthly" />
  <p class="lede">신고 담당이 홈택스 「전자세금계산서 목록(매입)」·사업용 카드 내역을 아래 「여러 건 한꺼번에」에 붙여넣고 건마다 <strong>어느 시설에 썼는지</strong>만 고르는 것이 기본입니다. 영수증 한 장씩 넣을 수도 있습니다(영수증 종류·받는 사람·어디에·무엇). 수탁기관·시설 부서에 기록을 맡길 때는 이 주소와 기관 설정 파일을 보내면 같은 화면으로 기록해 월말에 「매입 인계표」를 돌려줍니다. 입력은 이 브라우저에만 저장됩니다. <strong>빨강(다른 명의·증빙 미달)을 기한 안에 처리하는 것이 곧 절감</strong>입니다 — 처리하지 않으면 그 세액은 영구히 빠집니다.</p>

  <section id="m-org" class="vc-card no-print">
    <h3>기관 설정</h3>
    <p id="m-org-state" class="meta">확인 중…</p>
    <p class="meta">카드 지출이 많으면 신고 담당에게 기관 법인카드의 홈택스 <strong>「사업용 신용카드 등록」</strong>을 부탁하세요 — 등록 뒤에는 카드 매입이 홈택스에 자동 집계됩니다(여기 기록은 '어디에 썼는지'를 남기는 용도).</p>
    <p class="meta">신고 담당에게 받은 <strong>기관 설정 파일(org.json)</strong>을 여세요: <input type="file" id="m-open" aria-label="기관 설정 파일 열기" accept=".json,application/json" /> · 파일이 없으면 신고 담당 부서에 요청하거나 <a href="/vat/setup/">기관 설정</a>에서 만듭니다.</p>
  </section>

  <form class="vc-form no-print" id="m-sel" autocomplete="off">
    <label>시설 <select id="m-fac"><option value="">— 기관 설정을 먼저 여세요 —</option></select></label>
    <label>달 <input type="month" id="m-month" /></label>
    <p class="note full" id="m-facnote"></p>
  </form>

  <form class="vc-form no-print" id="m-form" autocomplete="off" hidden>
    <p class="q-title full">지출 한 건 넣기</p>
    <label>날짜 <input type="date" id="m-d" /></label>
    <label class="full">내용(영수증에 적힌 대로 짧게) <input type="text" id="m-desc" placeholder="예: 9월 전기요금, 체육관 바닥 수선" maxlength="80" /></label>
    <label>공급가액(부가세 뺀 금액, 원) <input type="text" id="m-amt" inputmode="numeric" placeholder="예: 1,500,000" /></label>
    <label>부가세(세액, 원) <input type="text" id="m-tax" inputmode="numeric" placeholder="영수증의 세액 칸 · 비우면 10%" /></label>
    <div class="q full"><span class="q-title">① 영수증이 어떤 것인가요</span><div class="choices" id="m-proof"></div></div>
    <div class="q full" id="m-payee-q"><span class="q-title">② 영수증의 "받는 사람(공급받는 자)" 이름이 누구인가요</span><div class="choices" id="m-payee"></div><span class="note">세금계산서는 오른쪽 "공급받는 자" 칸, 카드 전표는 카드 명의입니다.</span></div>
    <div class="q full" id="m-vat-q" hidden><span class="q-title">②-1 전표에 부가세(세액) 금액이 따로 적혀 있나요</span><div class="choices"><label><input type="radio" name="m-vatsep" value="1" checked /> 네, 따로 적혀 있다</label><label><input type="radio" name="m-vatsep" value="0" /> 아니요 · 모름</label></div></div>
    <div class="q full"><span class="q-title">③ 이 돈은 어디에 쓰였나요 <button type="button" class="help" data-term="common_tax" aria-expanded="false" aria-label="공통매입세액 설명">?</button></span><div class="choices" id="m-use"></div></div>
    <div class="q full"><span class="q-title">④ 무엇을 샀나요</span><div class="choices" id="m-what"></div></div>
    <div class="q full" id="m-evid-q"><span class="q-title">⑤ '이 시설만' 썼다는 근거가 무엇인가요 <button type="button" class="help" data-term="actual_use" aria-expanded="false" aria-label="실지귀속 설명">?</button></span><div class="choices" id="m-evid"></div><span class="note">과세·면세를 함께 하는 기관은 전용 지출의 실지귀속을 서류로 입증해야 안분을 피합니다(시행령 제81조 제1항). '아직 없음'이면 신고 준비의 '처리할 것'에 올라옵니다.</span></div>
    <div class="q full" id="m-asset-q" hidden><label class="choices"><span><input type="checkbox" id="m-asset" /> 건물 공사·장비처럼 <strong>여러 해 쓰는 것</strong>입니다(500만 원 넘는 수선·설비 등)</span></label></div>
    <div class="q full"><label class="choices"><span><input type="checkbox" id="m-late" /> 지난 과세기간(6개월 전 이전) 지출인데 영수증을 이제 받았다</span></label><label class="choices"><span><input type="checkbox" id="m-subsidy" /> 국비·시비 <strong>보조금</strong>으로 집행한 지출이다(보조금이라서 공제가 안 되는 것은 아닙니다 — 표시만 남깁니다)</span></label></div>
    <div class="actions"><button type="submit" class="btn">판정하고 기록에 넣기</button><button type="reset" class="btn secondary">비우기</button></div>
  </form>
  <div id="m-result" aria-live="polite"></div>

  <details class="vat-more no-print" id="mb-wrap" hidden><summary><strong>여러 건 한꺼번에</strong> — 홈택스 매입 목록·카드사 이용내역·엑셀 장부를 붙여넣기</summary>
    <p class="meta">홈택스 「전자세금계산서 목록 조회(매입)」나 카드사 이용내역을 엑셀로 내려받아 <strong>머리글 줄부터 복사해 붙여넣으세요</strong>(탭·쉼표 구분 모두 됩니다). 열은 머리글로 짐작하고, 틀리면 아래에서 고칩니다. 그다음 행마다 '어디에 썼나'와 '무엇'만 고르면 됩니다.</p>
    <form class="vc-form" id="mb-form" autocomplete="off">
      <label class="full">붙여넣기 <textarea id="mb-text" rows="6" placeholder="작성일자	공급자상호	품목	공급가액	세액	공급받는자등록번호&#10;2026-10-02	○○전력	전기요금	1,500,000	150,000	555-83-00001" style="min-height:8em;padding:8px;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--bg);color:var(--ink);font:inherit"></textarea></label>
      <div class="q full"><span class="q-title">이 목록의 영수증 종류</span><div class="choices"><label><input type="radio" name="mb-proof" value="e_invoice" checked /> 전자세금계산서 목록</label><label><input type="radio" name="mb-proof" value="card" /> 신용카드 이용내역</label><label><input type="radio" name="mb-proof" value="cash" /> 현금영수증 내역</label></div></div>
      <div class="q full" id="mb-payee-q"><span class="q-title">받는 사람(공급받는 자)이 우리 기관인가요 — 등록번호 열이 있으면 자동으로 견줍니다</span><div class="choices"><label><input type="radio" name="mb-payee" value="org" checked /> 모두 우리 기관</label><label><input type="radio" name="mb-payee" value="contractor" /> 모두 공단·수탁기관 명의</label><label><input type="radio" name="mb-payee" value="unknown" /> 모름(노랑으로)</label></div></div>
      <div class="q full" id="mb-evid-q"><span class="q-title">'이 시설만' 쓴 지출의 근거(기본값 — 행마다 바꿀 수 있음)</span><div class="choices"><label><input type="radio" name="mb-evid" value="contract" checked /> 계약·발주서에 시설이 적혀 있다</label><label><input type="radio" name="mb-evid" value="meter" /> 시설별 계량기·검침</label><label><input type="radio" name="mb-evid" value="inspection" /> 검수 조서·작업 일지</label><label><input type="radio" name="mb-evid" value="none" /> 아직 없음</label></div></div>
      <div class="q full" id="mb-vat-q" hidden><span class="q-title">카드 전표에 부가세가 따로 적혀 있나요</span><div class="choices"><label><input type="radio" name="mb-vatsep" value="1" checked /> 네(세액 열이 있음)</label><label><input type="radio" name="mb-vatsep" value="0" /> 아니요·모름</label></div></div>
      <div class="actions"><button type="submit" class="btn secondary">열 읽기</button></div>
    </form>
    <p class="meta">붙여넣은 표에 <strong>사업명(세부사업·예산과목)이나 부서 열</strong>이 있으면 그 글자로 시설을 자동으로 고릅니다 — 처음엔 행마다 시설을 고르고, 그 선택을 <strong>매핑표</strong>로 기억해 다음 달부터 자동으로 채웁니다(e호조 지출 목록을 그대로 붙여넣는 길).</p>
    <div id="mb-map"></div>
    <div id="mb-preview"></div>
    <details class="vat-more" id="mb-rules-wrap"><summary><strong>사업·부서 → 시설 매핑표</strong> <span id="mb-rules-n" class="note"></span></summary><p class="meta">기관 설정(org.json)에 함께 저장되고 인수인계 꾸러미에 들어갑니다. 틀린 줄은 지우면 다음 붙여넣기 때 다시 고릅니다.</p><div id="mb-rules"></div></details>
  </details>

  <section id="m-list" hidden>
    <div class="section-head"><h2 id="m-list-title">이 달 기록</h2><span class="meta" id="m-sum"></span></div>
    <div class="scroll-x" tabindex="0" role="region" aria-label="표 가로 스크롤"><table class="data-table vat-table" id="m-table" data-stack="off">
      <caption id="m-caption">매입 인계표</caption>
      <thead><tr><th scope="col">날짜</th><th scope="col">내용</th><th scope="col">공급가액</th><th scope="col">부가세</th><th scope="col">영수증</th><th scope="col">받는 사람</th><th scope="col">어디에</th><th scope="col">무엇</th><th scope="col">근거·사업</th><th scope="col">신호</th><th scope="col">지금 할 일</th><th scope="col">근거</th><th scope="col" class="no-print">처리</th></tr></thead>
      <tbody></tbody></table></div>
    <div class="actions no-print"><button type="button" class="btn" id="m-csv">매입 인계표 CSV 내려받기</button><button type="button" class="btn secondary" id="m-json">인계 파일(JSON) 내려받기</button><button type="button" class="btn secondary" id="m-print">인쇄</button><button type="button" class="link-btn" id="m-clear">이 달 기록 지우기</button></div>
    <p class="meta">표 아래 「한글 표 복사」로 공문에 바로 붙일 수 있습니다. 빨강·노랑이 남아 있으면 '지금 할 일'을 먼저 처리하고(수정세금계산서 요청 등) 처리 칸에 표시하세요. 인계표는 신고 담당이 신고서 칸으로 옮깁니다(참고용 판정, 신고 책임은 신고인).</p>
  </section>

  <details class="vat-more"><summary>신호등이 뜻하는 것</summary>
    <ul class="meta-list">
      <li><span class="sig ok"></span><strong>초록</strong> — 이 영수증의 부가세는 돌려받습니다(매입세액 공제). 그대로 인계.</li>
      <li><span class="sig split"></span><strong>파랑</strong> — 과세 시설과 면세·행정 일에 함께 쓴 돈입니다. 신고 담당이 면세 비율만큼 빼고 공제합니다(공통매입세액 안분). 시설별로 나눌 수 있으면 다음부터 나눠 받으세요.</li>
      <li><span class="sig no"></span><strong>빨강</strong> — 지금 상태로는 공제가 안 됩니다. '지금 할 일'(수정세금계산서 요청 등)을 하면 바뀔 수 있는 것과 원래 안 되는 것(토지·승용차·접대)이 있습니다.</li>
      <li><span class="sig none"></span><strong>회색</strong> — 부가세가 애초에 없는 지출(급여·보험·수도·세금)입니다. 기록만 남깁니다.</li>
      <li><span class="sig check"></span><strong>노랑</strong> — 영수증이나 시설 성격을 확인해야 판정할 수 있습니다.</li>
    </ul>
  </details>
  <VatData />
  <script>import '../../../scripts/vat_monthly';</script>
</Base>
