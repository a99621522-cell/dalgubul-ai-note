---
import Base from '../../../layouts/Base.astro';
import VatData from '../../../components/VatData.astro';
import VatNav from '../../../components/VatNav.astro';
import '../../../styles/vat.css';
import { vatCases, vatBai } from '../../../lib/vat';
const ALL = vatCases(); const BAI = vatBai(); const CLAIMS = ALL.filter(c => /경정청구|권익위/.test(c.kind)); const AUDITS = ALL.filter(c => /감사/.test(c.kind));
const KEY_NAME: Record<string, string> = { claim: '경정청구', build: '신축·대수선', sports: '체육시설', lease: '임대', cashout: '납부잔액·환급금 세입 처리', lodging: '숙박·캠핑장', subsidy: '보조사업 환급금', venue: '대관', parking: '주차장', transit: '버스', agency: '대행', use_permit: '사용허가' };
/** /vat/review/ — 지난 돈 돌려받기(경정청구 후보, 핵심 기능 — 운영자 2026-11-03 '경정청구 후보를 잘 구현하는 게 핵심' · '지난 돈 돌려받기 쉽게 만들어').
 *  홈택스 매입 목록 5년치를 붙여넣고 건마다 시설을 정하면 과세기간별로 '있어야 할 공제 세액 − 신고한 공제 세액' = 돌려받을 후보와 기한(국세기본법 제45조의2, 5년)·붙임 서류가 나온다.
 *  입력은 이 브라우저에 남고(localStorage vat-review-v1) JSON 으로 이어 한다. 서버 없음. 스크립트 src/scripts/vat_review.ts */
---
<Base title="지난 부가세 돌려받기" description="지자체가 지난 5년 부가가치세 신고에서 덜 돌려받은 매입세액을 찾아, 얼마를 왜 어떻게 돌려받는지(경정청구)와 낼 자료를 만듭니다. 파일은 브라우저 안에서만 읽습니다." current="vat" crumb="지난 부가세 돌려받기">
  <div class="section-head"><h1>지난 부가세 돌려받기</h1><span class="meta">경정청구 · 지난 5년</span></div>
  <VatNav current="review" />
  <p class="lede rf-lede">지난 5년 신고에서 덜 돌려받은 부가세를 찾아 <strong>얼마를, 왜, 어떻게</strong> 돌려받는지 보여 줍니다. 파일은 이 브라우저 안에서만 읽습니다.</p>
  <!-- 쉬운 화면(2026-11-05 docs/prompts/vat_review_ux_easiest.md · 설계 docs/design/vat-review-ux-spec.md): ① 기관 → ② 파일 → ③ 결과 순서, 나머지는 접힘 -->
  <section class="rf-go rf-step" id="rf-s1" aria-labelledby="rf-s1-h"><div class="rf-h"><span class="rf-n" aria-hidden="true">1</span><h2 id="rf-s1-h">기관 고르기</h2><span class="rf-st" id="rf-s1-st"></span></div>
    <div id="rv-noorg" hidden></div>
    <div id="rf-s1-body"></div></section>
  <section class="rf-go rf-step" id="rf-go2" aria-labelledby="rf-go2-h"><div class="rf-h"><span class="rf-n" aria-hidden="true">2</span><h2 id="rf-go2-h">홈택스 파일 올리기</h2><span class="rf-st" id="rf-go2-st"></span></div>
    <p class="rf-lock" id="rf-lock" hidden>기관을 고르면 열립니다.</p>
    <div id="rf-all" class="rf-all"></div>
    <details class="vat-more rf-where" id="rf-where"><summary>어떤 파일을, 홈택스 어디서 받나요?</summary><ul class="meta-list">
      <li><b>지난 신고서(꼭)</b> — 홈택스 → 신고/납부 → 세금신고 → 신고내역 조회 → 신고서 보기 → PDF 로 저장. 예정·확정 신고서와 함께 낸 「공제받지 못할 매입세액 명세서」까지, 5년치를 한꺼번에 놓으면 됩니다.</li>
      <li><b>매입 목록(선택 — 더 찾을 때)</b> — 홈택스 → 조회/발급 → 전자세금계산서 → 목록조회 → 매입 → 엑셀 내려받기(법인은 3개월씩). 사업용 신용카드 매입 엑셀도 됩니다.</li>
      <li>스캔한 PDF 는 글자가 없어 읽지 못합니다 — 홈택스 화면에서 다시 출력해 'PDF 로 저장'하세요.</li></ul></details>
    <div id="rf-cover"></div></section>
  <section class="rf-go rf-step" id="rf-go3" aria-labelledby="rf-go3-h"><div class="rf-h"><span class="rf-n" aria-hidden="true">3</span><h2 id="rf-go3-h">결과</h2><span class="rf-st" id="rf-go3-st"></span></div>
    <div id="rf-sum" aria-live="polite"></div>
    <div id="rf-ask"></div></section>
  <details class="vat-more rf-sec" id="rf-detail"><summary><strong>자세히</strong> — 돌려받을 돈 표 전체 · 고친 신고서 · 지난 신고 진단 · 할 일</summary>
  <div class="rf-band" id="rf-band" aria-live="polite"></div>
  <div id="rf-calc"></div>
  <section class="rf-diag-wrap" id="rf-diag-wrap"><div class="section-head"><h2>지난 신고 진단 — 무엇이 틀렸고, 어떻게 고치면, 얼마를 돌려받나</h2><span class="meta">과세기간마다 신고서 칸으로 대조 — 판정은 참고이며 기관의 판단이 아닙니다</span></div><div id="rf-diag"><p class="note">② 지난 신고서와 ③ 매입 목록을 올리면 과세기간마다 잘못·누락된 것, 고칠 칸, 돌려받는 돈이 나옵니다.</p></div></section>
  <section class="rf-todo-wrap" id="rf-todo-wrap"><div class="section-head"><h2>할 일</h2><span class="meta">금액 큰 순 · 기한 급한 순 — 판정은 참고이며 기관의 판단이 아닙니다</span></div><div id="rf-todo"></div></section>
  <details class="vat-more" id="rf-more"><summary><strong>자세히 보기</strong> — 금액 카드·자료별 금액·과세기간별 신고 값(②)·결과(④)·근거·사유 초안 <span class="meta" id="rv-stat"></span></summary>
    <p class="note">신고서를 올리면 과세기간마다 <strong>공제받은 매입세액 (18)·불공제 (17)·면세비율(불공제 명세서 ⑪·⑭)·과세 매출 (1)~(4)</strong>를 읽어 ②에 넣고, 결과 맨 위 <a href="#rv-unlock">돌려받을 금액 — 자료별</a>에 '지금 자료로 / 자료를 올리면 +얼마 / 판단 필요'가 나옵니다. 매입 목록(①)과 함께 쓰세요.</p>
    <div id="rv-result" aria-live="polite"></div>
  </details>
  </details>
  <details class="vat-more rf-sec" id="rf-files"><summary><strong>파일별로 보기·고치기</strong> — 올린 신고서 · 매입 목록 · 공급자 시설 정하기 · 다른 방법</summary>
  <ol class="rf-steps">
    <li class="rf-sub" id="rf-s2"><div class="rf-h"><span class="rf-n" aria-hidden="true">가</span><h3>올린 신고서</h3><span class="rf-st" id="rf-s2-st"></span></div>
      <p class="note">홈택스 → 신고/납부 → 세금신고 → 신고내역 조회 → 신고서 보기 → PDF 저장. <strong>5년치 예정·확정 신고서를 한꺼번에</strong> 놓으면 과세기간마다 공제받은 매입세액 (18)·불공제 (17)·면세비율을 읽습니다.</p>
      <details class="vat-more rf-s2-more" id="rf-s2-more" open><summary id="rf-s2-more-sum">올린 신고서 목록 · 과세기간별 신고 값</summary>
      <div id="rv-filedup" class="no-print"></div>
      <div id="rf-s2-cmp"></div></details></li>
    <li class="rf-sub" id="rf-s3"><div class="rf-h"><span class="rf-n" aria-hidden="true">나</span><h3>매입 목록 · 공급자 시설 정하기</h3><span class="rf-st" id="rf-s3-st"></span></div>
      <p class="note">홈택스 → 조회/발급 → 전자세금계산서 → 목록조회 → <b>매입</b> → 엑셀 내려받기(법인은 3개월씩). <strong>여러 파일을 한꺼번에</strong> 골라 놓으세요 — 같은 건은 한 번만 셉니다. 시설은 나라장터 계약 업체 번호·매핑표·시설 이름으로 저절로 붙이고, <strong>못 붙인 공급자만</strong> 세액 큰 순으로 아래에 남깁니다.</p>
      <div class="vc-form no-print" id="rv-common"><label>우리 기관(과세사업) 사업자등록번호 — 공급받는 자가 다른 번호인 행을 가려냅니다 <input type="text" id="rv-reg" placeholder="000-00-00000" inputmode="numeric" /></label></div>
      <div id="rv-drop" class="no-print"></div>
      <div id="rv-cols" class="no-print"></div>
      <div id="rv-sup-box"></div>
      <details class="vat-more no-print" id="rf-other"><summary>다른 방법 — 붙여넣기 · 공개 지출 자료로 시설 정하기 · JSON 이어 하기</summary>
        <div class="rv-src-tabs no-print" role="tablist" aria-label="자료를 넣는 방법"><button type="button" role="tab" data-rvsrc="pub" aria-selected="false">공개 지출 자료로 후보 찾기 <span class="note">(붙여넣기 없음)</span></button><button type="button" role="tab" data-rvsrc="paste" aria-selected="false">붙여넣기</button></div>
        <details class="vat-more no-print"><summary><strong>자료는 어디서 — 붙여넣기 없이 가는 길</strong></summary><ol class="meta-list">
    <li><strong>공개 지출 자료(대구 10개 지자체, 2021년 2기~2023년 2기)</strong> — 지자체만 고르면 이 화면이 받습니다. 거래처·세액은 없지만 '어느 부서의 어느 사업에서 얼마나 돌려받을 수 있나'와 '어느 사업의 세금계산서만 받아오면 되나'가 나옵니다. 2024년 뒤 건별 자료는 포털에 없습니다.</li>
    <li><strong>e호조+ 지출 내역 엑셀을 파일로 놓기</strong> — 회계과가 날마다 쓰는 시스템에서 지출(세금계산서 증빙) 목록을 엑셀로 내려 여기에 놓습니다. 2024년 뒤를 덮습니다. 거래처 사업자번호·세액 열이 있으면 그대로 읽습니다.</li>
    <li><strong>세무대리인에게 받기</strong> — 신고를 맡긴 세무법인·회계사는 수임 기관의 홈택스 자료를 5년치 조회할 수 있습니다. 기관 설정 1단계가 '대리인 의뢰'면 신고 준비 결과에 인계 꾸러미가 있습니다.</li>
    <li><strong>홈택스 합계표 조회</strong> — 전자세금계산서 → 합계표·통계조회 → 매입처별 명세서 → 파일 내려받기: 과세기간마다 1개 파일(공급자별 합계)이라 목록조회(법인은 3개월씩)보다 적습니다.</li></ol></details>
        <div id="rv-pub" class="no-print" hidden></div>
        <form class="vc-form no-print" id="rv-form" autocomplete="off" hidden>
    <div class="full" id="rv-src-row"><span class="q-title">무엇을 붙여넣나요</span> <label><input type="radio" name="rv-src" id="rv-src-inv" checked /> 전자세금계산서 매입 목록</label> <label><input type="radio" name="rv-src" id="rv-src-card" /> 사업용 신용카드 매입 내역</label></div>
    <label class="full">매입 목록 — 홈택스 「전자세금계산서 목록 조회(매입)」을 과세기간마다 엑셀로 내려받아 <strong>시트 전체</strong>를 붙여넣습니다(5년치를 여러 번 나눠 넣어도 됩니다. 위쪽 제목·조회조건 줄은 알아서 버리고, 같은 건은 한 번만 둡니다)
      <textarea id="rv-a" rows="7" placeholder="작성일자	공급자등록번호	공급자상호	품목	공급가액	세액	공급받는자등록번호&#10;2024-03-05	123-45-67890	○○전력	전기요금	1,500,000	150,000	555-83-00001" style="min-height:9em;padding:8px;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--bg);color:var(--ink);font:inherit"></textarea></label>
    <div class="actions"><button type="submit" class="btn">열 읽기</button> <button type="button" class="btn secondary" id="rv-json-dl">지금까지 한 것 JSON 내려받기</button> <label class="btn secondary" style="cursor:pointer">JSON 열기 <input type="file" id="rv-json-up" accept="application/json,.json" hidden /></label> <button type="button" class="link-btn" id="rv-clear">모두 지우기</button></div>
  </form>
      </details></li>
  </ol>
  </details>
  <details class="vat-more rf-sec" id="rf-ref"><summary><strong>참고</strong> — 가산세 계산기 · 다른 지자체가 돌려받은 사례·감사 · 무엇을 보는 것인가</summary>
  <details class="vat-more"><summary>가산세 계산기 — 수정신고·기한후신고</summary><section id="pn-box" class="vc-card"></section></details>
  <details class="vat-more"><summary>다른 지자체가 돌려받은 사례 · 감사에서 지적된 것</summary>
  <section id="rv-cases" class="vc-cards">
    <div class="vc-card"><h3>다른 지자체가 돌려받은 사례 {CLAIMS.length}건</h3><p class="note">체육센터·문화센터 신축, 캠핑장·휴양림, 공유재산 임대의 매입세액 — 공표 자료의 사실만, 평가 아님</p>
      <ul class="meta-list">{CLAIMS.map(c => <li><strong>{c.org}</strong> <span class="meta">{c.date}</span> — {c.title}{c.amount && <> (<strong>{c.amount}</strong>)</>}<br /><span class="note">{c.facts}</span> <span class="meta">{c.keys.filter(k => KEY_NAME[k] && k !== 'claim').map(k => KEY_NAME[k]).join('·')} · {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.src}</a> : c.src}{c.verify && ' · 원문 확인 필요'}</span></li>)}</ul>
      <p class="note">권익위 의결(2011·2013)은 경정청구 기간이 지난 뒤에도 '세법에 명백히 위배된 처분은 직권 시정'으로 경정을 권고한 사례입니다.</p></div>
    <div class="vc-card"><h3>감사에서 지적된 것 {AUDITS.length}건</h3><p class="note">정부합동감사·감사원 — 부가가치세 신고와 관련해 지자체가 지적받은 사실</p>
      <ul class="meta-list">{AUDITS.map(c => <li><strong>{c.org}</strong> <span class="meta">{c.date} · {c.kind}</span> — {c.title}{c.amount && <> (<strong>{c.amount}</strong>)</>}<br /><span class="note">{c.facts}</span> <span class="meta">{c.keys.filter(k => KEY_NAME[k]).map(k => KEY_NAME[k]).join('·')} · {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.src}</a> : c.src}{c.verify && ' · 원문 확인 필요'}</span></li>)}</ul>
      </div>
    <div class="vc-card" id="rv-bai"><h3>감사원 감사결과 공개문에서 부가가치세 신고·납부가 나온 지적 {BAI.reports.filter(r => r.core > 0).length}건</h3><p class="note">지방 분야 공개문 {BAI.scanned}건의 PDF 를 읽어 부가가치세·매입세액·경정청구·세금계산서 문단을 그대로 발췌(배포용 한글 {BAI.noPdf}건은 못 읽음). 낱말이 나온 문단이라 모두 지적은 아닙니다.</p>
      <ul class="meta-list">{BAI.reports.filter(r => r.core > 0).slice(0, 12).map(r => <li><a href={r.url} target="_blank" rel="noopener">{r.title}</a> <span class="meta">{r.openDt.replace(/(\d{4})(\d{2})(\d{2})/, '$1-$2-$3')} · {r.field} · 관련 문단 {r.core}</span>{[...new Set(r.hits.filter(h => h.rel === 'core').map(h => h.head).filter(Boolean))].slice(0, 2).map(h => <><br /><span class="note">{h}</span></>)}</li>)}</ul>{BAI.reports.filter(r => r.core > 0).length > 12 && <p class="note">나머지는 참고 도구 6절에.</p>}</div>
  </section>
  </details>
  <details class="vat-more"><summary>무엇을 보는 것인가</summary>
    <ul class="meta-list">
      <li>과세기간은 확정신고 기준(1~6월 → 7월 25일, 7~12월 → 다음 해 1월 25일)으로 묶습니다. 예정신고 때 넣은 것도 확정 기간 안에 있으면 같은 묶음이므로 ②의 신고 값은 예정+확정을 더한 값입니다.</li>
      <li>경정청구 기한 = 법정신고기한이 지난 후 5년(국세기본법 제45조의2 제1항). 기한이 지난 과세기간은 되돌리지 못합니다.</li>
      <li>'있어야 할 공제 세액'은 건마다 시설·용도로 판정한 결과입니다 — 과세 시설 전용은 전액, 공통(여러 시설·행정과 함께)은 그 과세기간 면세비율만큼 뺀 금액, 면세·행정 전용·토지·승용차·접대·다른 명의는 0. 규칙은 지출 건 판정기와 같습니다.</li>
      <li>신고 자체를 안 한 과세기간은 '신고' 칸을 '안 함'으로 — 경정청구가 아니라 기한후신고(국세기본법 제45조의3)입니다.</li>
      <li>우리 명의가 아닌 세금계산서는 경정청구가 아니라 수정세금계산서(시행령 제70조 제1항 제6호, 확정신고기한 다음 날부터 1년) 문제입니다.</li>
      <li>참고용 계산입니다. 경정청구 여부와 금액은 신고인이 정하고, 큰 금액은 세무대리인과 확인합니다.</li>
    </ul>
  </details>
