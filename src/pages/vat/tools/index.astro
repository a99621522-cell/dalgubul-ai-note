---
import Base from '../../../layouts/Base.astro';
import VatNav from '../../../components/VatNav.astro';
import { vatRules, lawUrl, lawName, STATUS_LABEL, type Basis } from '../../../lib/vat';
/** /vat/tools/ — 지자체 부가가치세 매입세액 점검 도구(아는 사람이 한 건씩 확인; v2 1단계 2026-10-27 에 /vat/ 에서 옮김 — /vat/ 는 역할 선택 시작 화면)(운영자 지시 2026-10-27: '군청이나 대구시청 같은 지자체가 신고하는 부가가치세의 매입세액을 누락 없이 할 수 있는 사이트').
 *  규칙은 data/vat/rules.yml(조문 번호·뜻만, 평가 없음). 지출 건 판정·공통매입세액 안분·재계산·점검표는 브라우저 안에서만 계산한다(서버·AI 호출 없음, 입력값은 밖으로 나가지 않음). 스크립트 src/scripts/vat_check.ts */
const R = vatRules();
const ADMIN_RULINGS = (R.rules.admin_common?.rulings ?? []).map((id: string) => (R.rulings ?? []).find((r: { id: string }) => r.id === id)).filter(Boolean) as { id: string; kind: string; no: string; title: string; gist: string; note?: string; src?: string; url?: string; verify?: boolean; text?: string }[];
if (!R) throw new Error('data/vat/rules.yml 없음');
const basisLinks = (b: Basis[]) => b.map(x => ({ name: lawName(R, x), url: lawUrl(R, x) }));
const json = JSON.stringify(R).replace(/</g, '\\u003c');
const stages = [...new Set(R.checklist.map(c => c.stage))];
const nVerify = R.facilities.filter(f => f.verify).length;
const nInterp = R.facilities.filter(f => f.interp).length;
const V = R.verified;
---
<Base title="지자체 부가가치세 매입세액 점검기" description="시·군·구가 하는 과세사업(임대·체육시설·식당·숙박 등)의 지출을 한 건씩 넣으면 매입세액 공제·불공제·공통매입세액 안분·확인 필요로 나눠 근거 조문과 할 일을 보여 줍니다. 공통매입세액 안분·재계산 계산기와 신고 전 점검표. 브라우저 안에서만 계산합니다." current="vat" crumb="도구 — 한 건씩 확인">
  <div class="section-head"><h1>지자체 부가가치세 매입세액 점검 도구</h1><span class="meta">규칙 {R.version} · 시설 유형 {R.facilities.length} · 점검 항목 {R.checklist.length}</span></div>
  <VatNav current="tools" />
  <p class="lede">시·군·구가 하는 <strong>과세사업</strong>(공유재산 임대, 체육시설, 직영 식당·매점, 숙박시설 등)에 쓴 지출을 한 건씩 넣으면 <strong>매입세액을 공제할 수 있는지, 불공제인지, 과세·면세 공통이라 안분해야 하는지</strong>를 부가가치세법 조문과 함께 보여 줍니다. 위탁(대행) 시설에서 생기는 지출이 어느 사업에 귀속되는지 가르는 것이 핵심이며, 실지귀속이 분명한 과세사업 지출은 안분하지 않고 전액 공제합니다. 모든 계산은 <strong>이 브라우저 안에서만</strong> 하고 입력값은 어디로도 보내지 않습니다.</p>
  <p class="callout warn">판정은 조문을 낱말 규칙으로 맞춘 <strong>참고용</strong>이며 세무 해석·평가가 아닙니다. 조문은 국가법령정보센터 본문{V && <>(부가가치세법 {V.act} 시행 · 시행령 {V.decree} 시행 · 시행규칙 {V.rule} 시행 판, {V.date} 대조)</>}과 맞췄습니다. '유권해석·분류 확인' 표시가 있는 항목({nInterp}개 시설 유형)은 법령 글자가 아니라 표준산업분류·국세청 유권해석으로 정해지므로 담당자가 확인해야 하고{nVerify > 0 && <>, '원문 확인 필요' 표시({nVerify}개)는 아직 조문과 대조하지 못한 것입니다</>}. 신고 책임은 신고인에게 있습니다. 금액 기준(5%·500만 원·5만 원 등)은 법령이 바뀌면 달라집니다.</p>

  <nav class="vat-toc" aria-label="이 페이지 차례"><a href="#judge">지출 건 판정</a><a href="#common">공통매입세액 안분·재계산</a><a href="#facility">우리 시설은 과세인가</a><a href="#rules">불공제 사유·증빙 요건</a><a href="#items">위탁 시설 지출 사례</a><a href="#checklist">신고 전 점검표</a></nav>

  <section id="judge">
    <div class="section-head"><h2>1. 지출 건 판정 — 이 매입세액은 공제되나</h2></div>
    <p class="meta">지출 하나를 고르고 「판정」을 누르면 결과와 근거 조문, 해야 할 일이 나옵니다. 「표에 추가」로 모아 두면 아래 표를 「한글 표 복사」「CSV」로 옮길 수 있습니다(새로고침하면 지워집니다).</p>
    <form class="vc-form" id="vc-form" autocomplete="off">
      <label class="full">지출 내용 <input id="vc-desc" type="text" placeholder="예: ○○체육관 청소 용역 9월분" maxlength="80" /></label>
      <label>어느 사업에 쓰였나 <select id="vc-use">{R.inputs.use.map(o => <option value={o.key}>{o.name}</option>)}</select></label>
      <label>지출 종류 <select id="vc-kind">{R.inputs.kind.map(o => <option value={o.key}>{o.name}</option>)}</select></label>
      <label>증빙 <select id="vc-proof">{R.inputs.proof.map(o => <option value={o.key}>{o.name}</option>)}</select></label>
      <label>공급자 <select id="vc-supplier">{R.inputs.supplier.map(o => <option value={o.key}>{o.name}</option>)}</select></label>
      <label>시기 <select id="vc-timing">{R.inputs.timing.map(o => <option value={o.key}>{o.name}</option>)}</select></label>
      <label>공급가액(원, 선택) <input id="vc-amount" type="text" inputmode="numeric" placeholder="예: 3,000,000" /></label>
      <label>세액(원, 선택) <input id="vc-tax" type="text" inputmode="numeric" placeholder="비우면 공급가액의 10%" /></label>
      <div class="actions"><button type="submit" class="btn" id="vc-judge">판정</button><button type="button" class="btn secondary" id="vc-add" disabled>표에 추가</button></div>
    </form>
    <div id="vc-result" aria-live="polite"></div>
    <div class="scroll-x" id="vc-table-wrap" hidden>
      <table class="data-table vat-table" id="vc-table" data-stack="off">
        <caption>지출 건 판정 결과 (이 브라우저에서 입력한 값, 참고용)</caption>
        <thead><tr><th scope="col">지출 내용</th><th scope="col">귀속</th><th scope="col">종류</th><th scope="col">증빙</th><th scope="col">공급가액</th><th scope="col">세액</th><th scope="col">판정</th><th scope="col">공제 가능 세액</th><th scope="col">근거</th><th scope="col">해야 할 일</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="meta" id="vc-sum" hidden></p>
    <p class="meta"><button type="button" class="link-btn" id="vc-clear" hidden>표 비우기</button></p>
  </section>

  <section id="common">
    <div class="section-head"><h2>2. 공통매입세액 안분 계산기</h2></div>
    <p>{R.rules.common.summary}</p>
    <p class="meta">식: {R.rules.common.formula}. {R.rules.common.prelim} 근거: {basisLinks(R.rules.common.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</p>
    <form class="vc-form" id="ap-form" autocomplete="off">
      <label>과세 공급가액(원) <input id="ap-t" type="text" inputmode="numeric" placeholder="예: 250,000,000" /></label>
      <label>면세 공급가액(원) <input id="ap-e" type="text" inputmode="numeric" placeholder="예: 40,000,000" /></label>
      <label>공통매입세액(원) <input id="ap-c" type="text" inputmode="numeric" placeholder="예: 12,000,000" /></label>
      <label>신고 종류 <select id="ap-type"><option value="prelim">예정신고(예정신고기간 공급가액)</option><option value="final">확정신고(과세기간 전체 공급가액)</option></select></label>
      <div class="actions"><button type="submit" class="btn">계산</button></div>
    </form>
    <div id="ap-result" aria-live="polite"></div>
    <details class="vat-more"><summary>안분을 생략하는 경우 · 공급가액이 없을 때</summary>
      <ul>{R.rules.common.skip.map(s => <li><strong>{s.name}</strong> — {s.cond}</li>)}<li><strong>공급가액이 없거나 한쪽만 있을 때</strong> — {R.rules.common.no_supply}</li></ul>
    </details>

    <h3>감가상각자산 납부세액 재계산</h3>
    <p>{R.rules.recalc.summary}</p>
    <p class="meta">식: {R.rules.recalc.formula} 근거: {basisLinks(R.rules.recalc.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</p>
    <form class="vc-form" id="rc-form" autocomplete="off">
      <label>자산 종류 <select id="rc-asset"><option value="building">건물·구축물(체감률 5%)</option><option value="other">그 밖의 감가상각자산(체감률 25%)</option></select></label>
      <label>취득 때 공통매입세액(원) <input id="rc-c0" type="text" inputmode="numeric" placeholder="예: 50,000,000" /></label>
      <label>취득(직전 재계산) 때 면세비율(%) <input id="rc-r0" type="text" inputmode="decimal" placeholder="예: 10" /></label>
      <label>이번 과세기간 면세비율(%) <input id="rc-r1" type="text" inputmode="decimal" placeholder="예: 18" /></label>
      <label>경과 과세기간 수 <input id="rc-n" type="text" inputmode="numeric" placeholder="예: 3 (6개월 단위)" /></label>
      <div class="actions"><button type="submit" class="btn">계산</button></div>
    </form>
    <div id="rc-result" aria-live="polite"></div>
    <p class="meta">{R.rules.convert.summary} {R.rules.convert.verify && <span class="vbadge">원문 확인 필요</span>} 근거: {basisLinks(R.rules.convert.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</p>
      {ADMIN_RULINGS.length > 0 && <details class="vat-more rulings"><summary><strong>본청·행정 공통매입세액 안분의 근거 유권해석·판례</strong> {ADMIN_RULINGS.length}건 — 고유 행정사무(비과세)와 과세사업이 함께 쓴 지출. 번호·요지만, 평가 없음</summary>
      <p class="note">{R.rules.admin_common?.summary}</p><p class="note">{R.rules.admin_common?.caution}</p>
      <ul class="meta-list">{ADMIN_RULINGS.map(r => <li><span class="vbadge">{r.kind}</span> <strong>{r.no}</strong> {r.title}{r.verify && <span class="verdict check"> 원문 확인 필요</span>}<br/><span class="note">{r.gist}{r.note ? ' — ' + r.note : ''}{r.src && <em> ({r.src}{r.url && <>, <a href={r.url} target="_blank" rel="noopener">읽은 곳</a></>})</em>}</span>{r.text && <details class="vat-more"><summary>원문 보기 ({r.text.length.toLocaleString('ko-KR')}자)</summary><pre style="white-space:pre-wrap;font-size:var(--small);line-height:1.5;max-height:24rem;overflow:auto;border:1px solid var(--line-strong);padding:.75rem;border-radius:var(--radius)">{r.text}</pre></details>}</li>)}</ul></details>}
</section>

  <section id="inquiry">
    <div class="section-head"><h2>국세청 질의서 초안</h2><span class="meta">유권해석이 없거나 분류에 달린 자리 — 보내기 전 [ ] 안을 기관의 사실관계로 채웁니다</span></div>
    <p class="note">본청·행정 공통매입세액 안분 기준처럼 지자체 사안을 직접 다룬 회신이 없는 자리와, 행정재산 사용허가·종량제 봉투·대관·광고 게시료·파크골프장·야영장처럼 표준산업분류·유권해석에 달린 자리의 질의서 틀입니다. 국세청 홈택스 '서면질의'는 일반 질의, '세법해석 사전답변'(국세청 법규과, 신고기한 전 특정 거래)은 구속력 있는 답변 — 어느 길로 보낼지는 기관이 고릅니다. 갑설·을설은 쟁점을 보이는 두 읽기이지 기관 입장이 아닙니다. <a href="/vat/prepare/">신고 준비</a> 3절의 본청·행정 공통 펼침에서는 기관 이름·과세 시설·고른 안분 기준이 채워진 초안을 받습니다.</p>
    <div id="inq-list"></div>
  </section>

  <section id="facility">
    <div class="section-head"><h2>3. 우리 시설은 과세사업인가</h2></div>
    <p>{R.taxable_principle.summary}</p>
    <ul class="meta-list">{R.taxable_principle.notes.map(n => <li>{n}</li>)}</ul>
    <div class="scroll-x" tabindex="0" role="region" aria-label="표 가로 스크롤">
      <table class="data-table vat-table" data-stack="off">
        <caption>지자체 시설 유형별 과세·면세 (시행령 제46조 열거 업종 기준, 참고용)</caption>
        <thead><tr><th scope="col">시설·수입</th><th scope="col">과세 여부</th><th scope="col">어느 업종·조항</th><th scope="col">참고</th><th scope="col">근거</th></tr></thead>
        <tbody>{R.facilities.map(f => <tr class={`st-${f.status}`}>
          <th scope="row">{f.name}</th>
          <td><span class={`verdict ${f.status}`}>{STATUS_LABEL[f.status]}</span>{f.verify && <span class="vbadge">원문 확인 필요</span>}{f.interp && <span class="vbadge">유권해석·분류 확인</span>}</td>
          <td>{f.group}</td>
          <td class="note">{f.note}</td>
          <td class="note">{basisLinks(f.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="meta">근거: {basisLinks(R.taxable_principle.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</p>
  </section>

  <section id="rules">
    <div class="section-head"><h2>4. 공제하지 않는 매입세액 · 증빙 요건</h2></div>
    <p>{R.rules.deductible.summary} <span class="meta">({basisLinks(R.rules.deductible.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)})</span></p>
    <div class="scroll-x" tabindex="0" role="region" aria-label="표 가로 스크롤">
      <table class="data-table vat-table" data-stack="off">
        <caption>공제하지 아니하는 매입세액 (부가가치세법 제39조 제1항)</caption>
        <thead><tr><th scope="col">호</th><th scope="col">사유</th><th scope="col">실무에서 볼 것</th><th scope="col">근거</th></tr></thead>
        <tbody>{R.rules.nondeductible.map(n => <tr><td>{n.no}</td><th scope="row">{n.name}</th><td class="note">{n.fix}</td><td class="note">{basisLinks(n.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</td></tr>)}</tbody>
      </table>
    </div>
    <h3>신용카드매출전표·현금영수증으로 공제할 때 {R.rules.card.verify && <span class="vbadge">원문 확인 필요</span>}</h3>
    <p>{R.rules.card.summary}</p>
    <p class="meta">{R.rules.card.not_allowed} 근거: {basisLinks(R.rules.card.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</p>
    <h3>늦게 받은 세금계산서 {R.rules.late_invoice.verify && <span class="vbadge">원문 확인 필요</span>}</h3>
    <p>{R.rules.late_invoice.summary} <span class="meta">근거: {basisLinks(R.rules.late_invoice.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</span></p>
    <h3>신고 기간</h3>
    <div class="scroll-x" tabindex="0" role="region" aria-label="표 가로 스크롤"><table class="data-table compact" data-stack="off"><caption>부가가치세 예정·확정신고 (법인 기준 — 지방자치단체 포함)</caption>
      <thead><tr><th scope="col">신고</th><th scope="col">대상 기간</th><th scope="col">신고·납부 기한</th></tr></thead>
      <tbody>{R.rules.filing.periods.map(p => <tr><th scope="row">{p.name}</th><td>{p.span}</td><td>{p.due}</td></tr>)}</tbody></table></div>
    <ul class="meta-list">{R.rules.filing.notes.map(n => <li>{n}</li>)}</ul>
    <p class="meta">{R.rules.filing.verify && <span class="vbadge">국세기본법 조문은 원문 미대조</span>} 근거: {basisLinks(R.rules.filing.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</p>
  </section>

  <section id="items">
    <div class="section-head"><h2>5. 위탁 시설 운영에서 자주 나오는 지출</h2></div>
    <p class="meta">매입세액이 있는 지출인지, 어느 시설에 귀속되는지 적는 방법. 시설별 계량기·계약·원장으로 실지귀속을 남기면 안분 대상이 줄어듭니다(시행령 제81조 제1항).</p>
    <div class="scroll-x" tabindex="0" role="region" aria-label="표 가로 스크롤">
      <table class="data-table vat-table" data-stack="off">
        <caption>위탁 시설 운영 지출과 매입세액</caption>
        <thead><tr><th scope="col">지출</th><th scope="col">매입세액</th><th scope="col">확인할 것</th></tr></thead>
        <tbody>{R.common_items.map(c => <tr><th scope="row">{c.item}</th><td>{c.vat}</td><td class="note">{c.tip}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section id="checklist">
    <div class="section-head"><h2>6. 신고 전 점검표</h2><span class="meta">체크 상태는 이 브라우저에만 저장</span></div>
    {stages.map(st => <div class="ck-stage"><h3>{st === '상시' ? '상시 — 지출할 때마다' : st === '신고' ? '예정·확정신고 때' : '확정신고 때 더 볼 것'}</h3>
      <ul class="ck-list">{R.checklist.filter(c => c.stage === st).map(c => <li><label><input type="checkbox" data-ck={c.id} /> <span>{c.text}</span></label> <span class="note">{basisLinks(c.basis).map((b, i) => <> {i ? ' · ' : ''}<a href={b.url} target="_blank" rel="noopener">{b.name}</a></>)}</span></li>)}</ul></div>)}
    <p class="actions"><button type="button" class="btn secondary" id="ck-print">점검표 인쇄</button> <button type="button" class="btn secondary" id="ck-reset">체크 지우기</button> <span class="meta" id="ck-count"></span></p>
  </section>

  <section class="how">
    <h2>이 점검기의 기준과 한계</h2>
    <ul>
      <li>규칙은 <code>data/vat/rules.yml</code> 에 조문 번호와 조문의 뜻으로 적혀 있고, 조문 링크는 국가법령정보센터(law.go.kr) 현행 법령으로 갑니다. 부가가치세법·시행령·시행규칙 본문은 <a href="/programs/guidelines/">사업 지침 창고</a>에 받아 두고 조문과 대조했습니다{V && <>({V.date})</>}. 기준 금액·비율은 법령 값이라 개정되면 규칙 파일을 고칩니다.</li>
      <li>'유권해석·분류 확인' 표시는 법령 글자가 아니라 한국표준산업분류나 국세청 해석에 따라 결론이 달라지는 항목입니다. 국세청 상담(126)·국세법령정보시스템 유권해석 검색으로 확인한 뒤 적용합니다. '원문 확인 필요' 표시는 아직 본문을 받지 못한 법령(국세기본법)의 조문입니다.</li>
      <li>판정은 입력한 선택지만으로 하므로 계약 내용·시설 운영 방식에 따라 결론이 달라질 수 있습니다. 평가·해석이 아니며 신고 책임은 신고인에게 있습니다.</li>
      <li>개별 기관의 신고 금액·내부 자료는 싣지 않습니다. 입력값은 서버로 보내지 않고 새로고침하면 지워집니다(점검표 체크만 이 브라우저에 남습니다).</li>
    </ul>
  </section>
  <script type="application/json" id="vat-data" set:html={json}></script>
  <script>import '../../../scripts/vat_check';</script>
</Base>
