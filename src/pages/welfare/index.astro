---
import Base from '../../layouts/Base.astro';
import { welfareData, facet, guGunTable, GUGUN, lifeKey } from '../../lib/welfare';
/** /welfare/ — 메뉴 '복지' › 복지서비스 찾기 (운영자 지시 2026-10-21 '복지분야 … 일단 해봐').
 *  읍면동·구군 창구 직원이 주민 상황(나이·가구·지역)을 넣으면 중앙부처·대구시·구군 복지서비스 중 확인해 볼 후보를 추린다.
 *  규칙 필터 + 낱말 일치만(AI 판정 없음). 값은 복지로 오픈API 그대로. 자격 판정이 아니다 — 원문·담당 부서 확인 문구 필수.
 *  아래 '구·군별 등록 현황'은 복지로에 등록된 서비스 수일 뿐 복지 수준 비교가 아니다(평가 없음). */
const D = welfareData();
const items = D?.items ?? [];
const n = (v: number) => v.toLocaleString('ko-KR');
const LIFE_ORDER = ['영유아', '아동', '청소년', '청년', '중장년', '노년', '임신·출산'];
const lifes = LIFE_ORDER.filter(l => items.some(s => s.life.some(v => lifeKey(v) === l)));
const targets = facet(items, s => s.target).slice(0, 14);
const themes = facet(items, s => s.theme).slice(0, 16);
const T = guGunTable(items);
---
<Base title="복지서비스 찾기" description={D ? `중앙부처 ${n(D.counts.central)}개·대구시 ${n(D.counts.city)}개·구군 ${n(D.counts.gugun)}개 복지서비스를 나이·가구 상황·지역으로 찾는 창구용 도구. 복지로 오픈API ${D.fetchedAt} 기준.` : '중앙부처·대구시·구군 복지서비스를 상황으로 찾는 창구용 도구.'} current="welfare">
  <div class="section-head"><h1>복지서비스 찾기</h1><span class="meta">{D ? `복지로 ${D.fetchedAt} 기준 · 중앙 ${n(D.counts.central)} · 대구시 ${n(D.counts.city)} · 구군 ${n(D.counts.gugun)}` : '수집 대기'}</span></div>
  <p class="lede">주민의 나이·가구 상황·사는 곳을 적으면 중앙부처와 대구시·구군 복지서비스 가운데 <b>확인해 볼 후보</b>를 추립니다. 자격을 판정하지 않습니다. 선정기준·소득 기준은 카드의 원문과 담당 부서로 꼭 확인하세요.</p>

  {!D ? (
    <p class="empty">복지서비스 자료를 아직 받지 못했습니다. 공공데이터포털 수집(매일 새벽)이 끝나면 이 화면이 채워집니다.</p>
  ) : (
    <>
      <form id="wf" class="wf" onsubmit="return false" data-gugun={JSON.stringify(GUGUN)} data-lifes={JSON.stringify(lifes)}>
        <label class="q"><span class="lb">상황을 한 줄로</span>
          <input id="wf-q" type="search" placeholder="예: 78세 혼자 사는 어르신, 기초생활수급, 달성군" autocomplete="off" />
        </label>
        <div class="row">
          <label><span class="lb">지역</span>
            <select id="wf-g"><option value="">대구 전체(구군 선택 안 함)</option>{GUGUN.map(g => <option value={g}>{g}</option>)}</select>
          </label>
          <label><span class="lb">생애주기</span>
            <select id="wf-l"><option value="">전체</option>{lifes.map(l => <option value={l}>{l}</option>)}</select>
          </label>
          <label><span class="lb">관심 주제</span>
            <select id="wf-th"><option value="">전체</option>{themes.map(t => <option value={t.name}>{t.name}</option>)}</select>
          </label>
          <label><span class="lb">범위</span>
            <select id="wf-sc"><option value="">중앙+대구</option><option value="중앙">중앙부처만</option><option value="local">대구시·구군만</option></select>
          </label>
        </div>
        <fieldset class="chips"><legend class="lb">가구·대상 특성(여럿 고르기)</legend>
          {targets.map(t => <label class="chip"><input type="checkbox" name="wf-t" value={t.name} /><span>{t.name}</span></label>)}
        </fieldset>
        <p class="hint" id="wf-read" aria-live="polite"></p>
      </form>
      <div class="res-head"><b id="wf-count">—</b><button type="button" id="wf-reset" class="btn-lite">조건 지우기</button></div>
      <ol id="wf-list" class="list"></ol>
      <button type="button" id="wf-more" class="btn-more" hidden>더 보기</button>

      <section class="gt" id="gugun">
        <h2>구·군별 등록 현황</h2>
        <p class="meta">복지로에 등록된 대구시·구군 자체 복지서비스 수(중앙부처 서비스 제외). 생애주기는 복지로 분류이며 한 서비스가 여러 칸에 셀 수 있습니다. 등록 건수일 뿐 복지 수준 비교가 아닙니다.</p>
        <div class="tbl-wrap"><table>
          <thead><tr><th scope="col">구분</th><th scope="col">전체</th>{T.lifes.map(l => <th scope="col">{l}</th>)}</tr></thead>
          <tbody>{T.rows.map(r => <tr><th scope="row">{r.name}</th><td>{n(r.total)}</td>{r.byLife.map(v => <td>{v ? n(v) : '·'}</td>)}</tr>)}</tbody>
        </table></div>
      </section>
    </>
  )}

  <p class="meta src">출처: 한국사회보장정보원 복지로 오픈API(중앙부처복지서비스·지자체복지서비스), 공공데이터포털. 값을 고치거나 요약하지 않고 그대로 싣습니다. 개인정보·수급자 정보는 다루지 않습니다(대상자 조회는 사회보장정보시스템).</p>

  <script>
    type D = { target?: string; crit?: string; benefit?: string; how?: string; contacts?: string[]; laws?: string[]; until?: string };
    type It = { i: string; sc: string; g: string; n: string; o: string; dp: string; sm: string; l: string[]; t: string[]; th: string[]; cy: string; pv: string; ap: string; ct: string; v: number; u: string; d: D | null };
    const form = document.getElementById('wf') as HTMLFormElement | null;
    if (form) {
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const q = $<HTMLInputElement>('wf-q'), sg = $<HTMLSelectElement>('wf-g'), sl = $<HTMLSelectElement>('wf-l'), sth = $<HTMLSelectElement>('wf-th'), ssc = $<HTMLSelectElement>('wf-sc');
      const list = $<HTMLOListElement>('wf-list'), cnt = $<HTMLElement>('wf-count'), more = $<HTMLButtonElement>('wf-more'), read = $<HTMLElement>('wf-read');
      const GUGUN: string[] = JSON.parse(form.dataset.gugun || '[]');
      const tChecks = () => [...form.querySelectorAll<HTMLInputElement>('input[name="wf-t"]')];
      const esc = (s: string) => (s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
      const para = (s?: string) => s ? esc(s).replace(/\n{2,}/g, '\n').replace(/\n/g, '<br>') : '';

      // 상황 문장 → 조건. 나이 → 생애주기, 지역 이름 → 구군, 낱말 → 대상 특성(데이터에 있는 칩 이름 안에서만)
      const AGE = (a: number) => a <= 5 ? '영유아' : a <= 12 ? '아동' : a <= 18 ? '청소년' : a <= 39 ? '청년' : a <= 64 ? '중장년' : '노년';
      const SYN: [RegExp, RegExp][] = [
        [/혼자|독거|1인|홀로/, /1인|독거/], [/장애/, /장애/], [/한부모|조손|미혼모|미혼부/, /한부모|조손/],
        [/다문화|결혼이민|외국인|탈북|북한이탈/, /다문화|탈북|북한/], [/수급|차상위|저소득|기초생활|생계|의료급여/, /저소득/],
        [/다자녀|셋째|세\s*자녀/, /다자녀/], [/보훈|유공|참전/, /보훈/], [/임신|임산부|출산|산모/, /임신|출산/],
        [/질병|환자|암|치매|희귀|중증/, /질환|질병|환자/], [/실직|실업|구직|퇴직|폐업/, /실업|실직|구직/],
      ];
      const STOP = new Set(['어르신', '사는', '받음', '받는', '있음', '없음', '대구', '대구시', '주민', '가구', '세대', '혼자', '살고', '분']);
      let words: string[] = [];
      function parseQ() {
        const s = q.value.trim(); const notes: string[] = [];
        const age = s.match(/(\d{1,3})\s*(세|살)/);
        if (age) { const lf = AGE(+age[1]); const opt = [...sl.options].find(o => o.value === lf); if (opt) { sl.value = lf; notes.push(`${age[1]}세 → ${lf}`); } }
        else if (/어르신|노인|할머니|할아버지/.test(s) && [...sl.options].some(o => o.value === '노년')) { sl.value = '노년'; notes.push('노년'); }
        else if (/아기|영아|유아/.test(s)) { sl.value = '영유아'; notes.push('영유아'); }
        const g = GUGUN.find(x => s.includes(x) || (x.length > 2 && s.includes(x.slice(0, -1) + ' ')));
        if (g) { sg.value = g; notes.push(g); }
        for (const [re, chip] of SYN) if (re.test(s)) for (const c of tChecks()) if (chip.test(c.value) && !c.checked) { c.checked = true; notes.push(c.value); }
        words = s.replace(/\d{1,3}\s*(세|살)/g, ' ').split(/[\s,·.\/]+/).map(w => w.replace(/(은|는|이|가|을|를|의|에|과|와|도|로|으로)$/, '')).filter(w => w.length >= 2 && !STOP.has(w) && !GUGUN.includes(w));
        read.textContent = notes.length ? `읽은 조건: ${notes.join(' · ')}` + (words.length ? ` / 낱말: ${words.join(', ')}` : '') : (words.length ? `낱말: ${words.join(', ')}` : '');
      }

      let all: It[] = [], hits: It[] = [], shown = 0;
      const PAGE = 30;
      function score(it: It): number {
        const g = sg.value, lf = sl.value, th = sth.value, sc = ssc.value;
        if (sc === '중앙' && it.sc !== '중앙') return -1;
        if (sc === 'local' && it.sc === '중앙') return -1;
        if (it.sc === '구군' && g && it.g !== g) return -1;     // 다른 구군 서비스는 빼고
        if (lf && it.l.length && !it.l.includes(lf)) return -1;
        if (th && !it.th.includes(th)) return -1;
        const ts = tChecks().filter(c => c.checked).map(c => c.value);
        let s = 0;
        if (ts.length) { const m = ts.filter(t => it.t.includes(t)).length; if (!m) return -1; s += m * 10; }
        if (lf && it.l.includes(lf)) s += 4;
        if (it.sc === '구군' && g && it.g === g) s += 6; else if (it.sc === '대구시') s += 3;
        if (words.length) {
          const hay = `${it.n} ${it.sm} ${it.t.join(' ')} ${it.th.join(' ')} ${it.d?.target ?? ''} ${it.d?.crit ?? ''}`;
          const m = words.filter(w => hay.includes(w)).length;
          s += m * 5;
          if (!m && !ts.length && !lf && !g) return -1;
        }
        return s;
      }
      function card(it: It): string {
        const where = it.sc === '중앙' ? `<span class="b b-c">중앙</span>` : it.sc === '대구시' ? `<span class="b b-s">대구시</span>` : `<span class="b b-g">${esc(it.g)}</span>`;
        const org = [it.o, it.dp].filter(Boolean).map(esc).join(' · ');
        const tags = [...it.l, ...it.t].map(t => `<span class="tg">${esc(t)}</span>`).join('');
        const d = it.d; const rows: string[] = [];
        if (d?.target) rows.push(`<dt>지원 대상</dt><dd>${para(d.target)}</dd>`);
        if (d?.crit) rows.push(`<dt>선정 기준</dt><dd>${para(d.crit)}</dd>`);
        if (d?.benefit) rows.push(`<dt>지원 내용</dt><dd>${para(d.benefit)}</dd>`);
        if (d?.how || it.ap) rows.push(`<dt>신청 방법</dt><dd>${para(d?.how || it.ap)}</dd>`);
        if (d?.contacts?.length || it.ct) rows.push(`<dt>문의</dt><dd>${(d?.contacts?.length ? d.contacts : [it.ct]).map(esc).join('<br>')}</dd>`);
        if (d?.laws?.length) rows.push(`<dt>근거</dt><dd>${d.laws.map(esc).join('<br>')}</dd>`);
        const meta = [it.cy, it.pv].filter(Boolean).map(esc).join(' · ');
        return `<li class="card"><div class="ch">${where}<h3>${esc(it.n)}</h3></div>`
          + (org ? `<p class="org">${org}</p>` : '')
          + (it.sm ? `<p class="sm">${esc(it.sm)}</p>` : '')
          + (tags ? `<p class="tgs">${tags}</p>` : '')
          + (rows.length ? `<details><summary>대상·기준·신청 방법 보기${meta ? ` <span class="mt">${meta}</span>` : ''}</summary><dl>${rows.join('')}</dl></details>` : (meta ? `<p class="mt">${meta}</p>` : ''))
          + `<p class="lk"><a href="${esc(it.u)}" target="_blank" rel="noopener">복지로 원문 ↗</a></p></li>`;
      }
      function run() {
        hits = all.map(it => [score(it), it] as const).filter(([s]) => s >= 0).sort((a, b) => b[0] - a[0] || b[1].v - a[1].v).map(([, it]) => it);
        shown = 0; list.innerHTML = ''; page();
        const c = hits.filter(h => h.sc === '중앙').length;
        cnt.textContent = `${hits.length.toLocaleString('ko-KR')}개 (중앙 ${c.toLocaleString('ko-KR')} · 대구시·구군 ${(hits.length - c).toLocaleString('ko-KR')})`;
      }
      function page() { list.insertAdjacentHTML('beforeend', hits.slice(shown, shown + PAGE).map(card).join('')); shown += PAGE; more.hidden = shown >= hits.length; }
      more.addEventListener('click', page);
      let tm = 0;
      q.addEventListener('input', () => { clearTimeout(tm); tm = window.setTimeout(() => { parseQ(); run(); }, 250); });
      [sg, sl, sth, ssc].forEach(e => e.addEventListener('change', run));
      form.addEventListener('change', e => { if ((e.target as HTMLInputElement).name === 'wf-t') run(); });
      $<HTMLButtonElement>('wf-reset').addEventListener('click', () => { form.reset(); words = []; read.textContent = ''; run(); });
      cnt.textContent = '불러오는 중…';
      fetch('/welfare-index.json').then(r => r.json()).then(j => { all = j.items; run(); }).catch(() => { cnt.textContent = '목록을 불러오지 못했습니다. 새로고침해 주세요.'; });
    }
  </script>
  <style>
    .lede { margin: 0 0 var(--s3); }
    .empty { padding: 16px; border: 1px dashed var(--line-strong); border-radius: 8px; color: var(--muted); }
    .wf { display: grid; gap: var(--s2); padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); margin-bottom: var(--s3); }
    .wf label { display: grid; gap: 4px; }
    .lb { font-size: var(--small); color: var(--muted); font-weight: 600; }
    .wf input[type=search], .wf select { font: inherit; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--bg); color: var(--ink); min-width: 0; }
    .q input { font-size: 1.05rem; }
    .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s2); }
    .chips { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .chips legend { margin-bottom: 6px; }
    .chip input { position: absolute; opacity: 0; pointer-events: none; }
    .chip span { display: inline-block; padding: 6px 10px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--bg); font-size: var(--small); cursor: pointer; }
    .chip input:checked + span { background: var(--primary); border-color: var(--primary); color: #fff; }
    .chip input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 2px; }
    .hint { margin: 0; font-size: var(--small); color: var(--primary); min-height: 1.2em; }
    .res-head { display: flex; justify-content: space-between; align-items: center; margin: 0 0 var(--s2); }
    .btn-lite, .btn-more { font: inherit; padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--bg); color: var(--ink); cursor: pointer; }
    .btn-more { display: block; width: 100%; margin: var(--s2) 0 var(--s4); }
    .list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s2); }
    .list :global(.card) { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }
    .list :global(.ch) { display: flex; gap: 8px; align-items: baseline; }
    .list :global(h3) { margin: 0; font-size: 1.05rem; }
    .list :global(.b) { flex: none; font-size: 0.75rem; padding: 2px 7px; border-radius: 6px; font-weight: 700; }
    .list :global(.b-c) { background: var(--surface); border: 1px solid var(--line-strong); }
    .list :global(.b-s) { background: var(--primary); color: #fff; }
    .list :global(.b-g) { border: 1px solid var(--primary); color: var(--primary); }
    .list :global(.org), .list :global(.mt) { margin: 4px 0 0; font-size: var(--small); color: var(--muted); }
    .list :global(.sm) { margin: 6px 0 0; }
    .list :global(.tgs) { margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 4px; }
    .list :global(.tg) { font-size: 0.75rem; padding: 1px 6px; border-radius: 4px; background: var(--surface); color: var(--muted); }
    .list :global(details) { margin-top: 8px; }
    .list :global(summary) { cursor: pointer; font-size: var(--small); font-weight: 600; color: var(--primary); }
    .list :global(dl) { margin: 8px 0 0; display: grid; grid-template-columns: 6em 1fr; gap: 6px 10px; font-size: var(--small); }
    .list :global(dt) { color: var(--muted); font-weight: 600; }
    .list :global(dd) { margin: 0; overflow-wrap: anywhere; }
    .list :global(.lk) { margin: 8px 0 0; font-size: var(--small); }
    @media (max-width: 520px) { .list :global(dl) { grid-template-columns: 1fr; } .list :global(dd) { margin-bottom: 6px; } }
    .gt { margin-top: var(--s4); }
    .tbl-wrap { overflow-x: auto; }
    .gt table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; font-size: var(--small); }
    .gt th, .gt td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
    .gt th[scope=row], .gt thead th:first-child { text-align: left; }
    .src { margin-top: var(--s4); }
  </style>
</Base>
